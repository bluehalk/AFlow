import math

def solve():
    # Convert degrees to radians
    def deg_to_rad(degrees):
        return degrees * (math.pi / 180)
    
    # Calculate the numerator
    numerator = (math.cos(deg_to_rad(5)) * math.cos(deg_to_rad(20)) +
                 math.cos(deg_to_rad(35)) * math.cos(deg_to_rad(50)) -
                 math.sin(deg_to_rad(5)) * math.sin(deg_to_rad(20)) -
                 math.sin(deg_to_rad(35)) * math.sin(deg_to_rad(50)))
    
    # Calculate the denominator
    denominator = (math.sin(deg_to_rad(5)) * math.cos(deg_to_rad(20)) -
                   math.sin(deg_to_rad(35)) * math.cos(deg_to_rad(50)) +
                   math.cos(deg_to_rad(5)) * math.sin(deg_to_rad(20)) -
                   math.cos(deg_to_rad(35)) * math.sin(deg_to_rad(50)))
    
    # Calculate the tangent
    tangent_value = numerator / denominator
    
    # Calculate the angle in radians and then convert to degrees
    theta_radians = math.atan(tangent_value)
    theta_degrees = theta_radians * (180 / math.pi)
    
    # Ensure we return the least positive angle
    if theta_degrees < 0:
        theta_degrees += 180  # Adjust to get the least positive angle
    
    return theta_degrees

# Call the solve function and print the result
