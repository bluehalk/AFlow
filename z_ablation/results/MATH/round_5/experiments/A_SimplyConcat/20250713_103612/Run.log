def solve():
    # Size of the chessboard
    n = 8
    
    # Calculate the number of ways to place pieces in the same row
    # For each row, we can choose 2 columns from 8
    same_row_ways = n * (n * (n - 1) // 2)  # n rows, choose 2 columns in each row
    
    # Calculate the number of ways to place pieces in the same column
    # For each column, we can choose 2 rows from 8
    same_column_ways = n * (n * (n - 1) // 2)  # n columns, choose 2 rows in each column
    
    # Total ways is the sum of both cases
    total_ways = same_row_ways + same_column_ways
    
    return total_ways

# Call the solve function and print the result
