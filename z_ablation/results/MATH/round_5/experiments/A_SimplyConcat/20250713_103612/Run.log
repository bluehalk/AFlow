    b_squared = b ** 2
    c_squared = c ** 2
    
    # Calculate the sum of squares
    sum_of_squares = a_squared + b_squared + c_squared
    
    # Calculate the coefficients for the orthocenter
    x = a_squared / sum_of_squares
    y = b_squared / sum_of_squares
    z = c_squared / sum_of_squares
    
    # Return the ordered triple (x, y, z)
    return (x, y, z)

# Call the function and print the result
