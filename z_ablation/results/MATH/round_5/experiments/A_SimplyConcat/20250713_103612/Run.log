def sum_of_proper_divisors(n):
    """Calculate the sum of proper divisors of n."""
    proper_divisors_sum = 0
    # Loop through all numbers from 1 to n//2 to find proper divisors
    for i in range(1, n // 2 + 1):
        if n % i == 0:  # Check if i is a divisor of n
            proper_divisors_sum += i  # Add to the sum if it is a proper divisor
    return proper_divisors_sum

def solve():
    """Calculate the sum of proper divisors of 198."""
    number = 198
    result = sum_of_proper_divisors(number)
    return result

# Call the solve function and print the result
