def solve():
    # Define the start and end years
    start_year = 2008
    end_year = 2016
    
    # Initialize a counter for the total number of cake-eating days
    total_days = 0
    
    # Loop through each year from start_year to end_year
    for year in range(start_year, end_year + 1):
        # Define Amaretta's birthday and Enzo's birthday
        amaretta_birthday = datetime(year, 7, 27)
        enzo_birthday = datetime(year, 9, 3)
        
        # Calculate the number of days from Amaretta's birthday to Enzo's birthday (inclusive)
        days_count = (enzo_birthday - amaretta_birthday).days + 1
        
        # Add to the total days
        total_days += days_count
    
    return total_days

# Call the solve function and print the result
result = solve()
print(result)
```

### Explanation of the Code:
