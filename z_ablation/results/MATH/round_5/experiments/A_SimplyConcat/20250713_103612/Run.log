    D = (4, 8)
    E = (6.8284, 5.1716)
    F = (9.6569, 8)
    
    # Calculate the slope of line DF
    slope_DF = (F[1] - D[1]) / (F[0] - D[0])  # (y2 - y1) / (x2 - x1)
    
    # The slope of the perpendicular line (EM) is the negative reciprocal
    slope_EM = -1 / slope_DF
    
    # Equation of line DF: y - y1 = m(x - x1)
    # Rearranging gives us: y = slope_DF * (x - D[0]) + D[1]
    
    # To find the y-intercept of line DF
    intercept_DF = D[1] - slope_DF * D[0]
    
    # The equation of line DF is: y = slope_DF * x + intercept_DF
    
    # Now we need to find the perpendicular line from E to DF
    # The equation of line EM: y - E[1] = slope_EM * (x - E[0])
    # Rearranging gives us: y = slope_EM * (x - E[0]) + E[1]
    
    # Set the two equations equal to find the intersection point M
    # slope_DF * x + intercept_DF = slope_EM * (x - E[0]) + E[1]
    
    # Solve for x
