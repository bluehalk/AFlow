```python
import math

def solve():
    max_gcd = 0  # Initialize the maximum GCD found
    # We will check for a reasonable range of n
    for n in range(1, 100):  # We can adjust the range as needed
        m = 24 * n + 51
        two_m = 2 * m
        three_n = 3 * n
        current_gcd = math.gcd(two_m, three_n)
        max_gcd = max(max_gcd, current_gcd)  # Update max GCD if current is larger
    
    return max_gcd

# Call the solve function and print the result
