def solve():
    # Define the possible values for x and y
    values = [4, 8, 12]
    
    # Use a set to store unique fractions
    unique_fractions = set()
    
    # Iterate over all combinations of x and y
    for x in values:
        for y in values:
            # Calculate the fraction x/y
            fraction = x / y
            # Add the fraction to the set
            unique_fractions.add(fraction)
    
    # The number of unique fractions is the size of the set
    return len(unique_fractions)

# Call the solve function and print the result
