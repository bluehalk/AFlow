import numpy as np
from scipy.optimize import fsolve

def equation(x):
    tan_20 = np.tan(np.radians(20))
    tan_40 = np.tan(np.radians(40))
    tan_80 = np.tan(np.radians(80))
    
    return (1 / (x - tan_20)) + (1 / (x + tan_40)) + (1 / (x - tan_80))

def solve():
    # Initial guesses for the roots
    initial_guesses = [-1, 0, 1, 2]
    
    # Finding the roots using fsolve
    roots = fsolve(equation, initial_guesses)
    
    # Filtering out the unique roots and rounding for better readability
    unique_roots = np.unique(np.round(roots, decimals=6))
    
    return unique_roots

# Call the solve function and print the results
