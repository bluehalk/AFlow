def solve():
    # Define the digits Bekah has
    digits = ['2', '3', '5']
    
    # Set to hold unique numbers
    unique_numbers = set()
    
    # Generate permutations for lengths from 1 to the number of digits
    for length in range(1, len(digits) + 1):
        for perm in permutations(digits, length):
            # Join the tuple of characters to form a number
            number = ''.join(perm)
            # Add the number to the set
