from itertools import permutations

def solve():
    # Define the chips
    chips = ['R', 'R', 'R', 'W', 'W']  # 3 Red (R) and 2 White (W)
    
    # Generate all unique permutations of the chips
    unique_permutations = set(permutations(chips))
    
    # Count favorable outcomes where the last chip is white
    favorable_count = sum(1 for sequence in unique_permutations if sequence[-1] == 'W')
    
    # Total number of unique permutations
    total_count = len(unique_permutations)
    
    # Calculate the probability
    probability = favorable_count / total_count
    
    return probability

# Call the solve function and print the result
result = solve()
print(f"The probability that the last chip drawn is white is: {result:.4f}")
```

