        # Check if C_min is within the bounds
        if C_min <= C_max:
            # Calculate the total number of danishes
            total_danishes = C_min + H
            # Update the minimum total if the current total is smaller
            if total_danishes < min_total_danishes:
                min_total_danishes = total_danishes
    
    return min_total_danishes

# Call the solve function and print the result
