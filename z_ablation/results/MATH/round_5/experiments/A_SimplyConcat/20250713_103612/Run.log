```python
def solve():
    # Step 1: Define the number
    n = 6300
    
    # Step 2: Prime factorization of 6300
    # 6300 = 2^2 * 3^2 * 5^2 * 7^1
    # We only need the odd part: 3^2 * 5^2 * 7^1
    odd_factors = {3: 2, 5: 2, 7: 1}  # Dictionary to hold prime factors and their powers
    
    # Step 3: Calculate the sum of odd divisors
    sum_of_odd_divisors = 1  # Start with the multiplicative identity for sums
    
    for prime, exponent in odd_factors.items():
        # The formula for the sum of divisors for p^k is (p^(k+1) - 1) / (p - 1)
        sum_of_divisors_for_prime = (prime ** (exponent + 1) - 1) // (prime - 1)
        sum_of_odd_divisors *= sum_of_divisors_for_prime
    
    return sum_of_odd_divisors

# Call the function and print the result
result = solve()
print(result)
```

