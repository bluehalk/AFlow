    count = 0
    
    # Find all pairs (a, b) such that a * b = 54 and gcd(a, b) = 1
    for a in range(1, target_product + 1):
        if target_product % a == 0:  # a is a factor of 54
            b = target_product // a
            if gcd(a, b) == 1:  # Check if gcd(a, b) = 1
                count += 1  # Count the pair (a, b)
    
