    # Define the coefficient matrix
    A = sp.Matrix([[1, k, -1],
                    [k, -1, -1],
                    [1, 1, -k]])
    
    # Calculate the determinant
    determinant = A.det()
    
    # Solve for k when the determinant is zero
    k_values = sp.solve(determinant, k)
    
    return k_values

# Call the solve function and print the result
