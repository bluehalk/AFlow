```python
def solve():
    # Total number of books
    total_books = 7
    
    # Number of math books
    math_books = 2
    
    # Number of physics books
    physics_books = 1
    
    # Remaining books (total - math - physics)
    other_books = total_books - math_books - physics_books  # 7 - 2 - 1 = 4
    
    # Treat the two math books as a single unit
    # So we have 6 units to arrange: (Math unit, Physics book, and 4 other books)
    units_to_arrange = 6
    
    # The number of ways to arrange these 6 units
    arrangements_of_units = factorial(units_to_arrange)
    
    # The two math books can be arranged among themselves in 2! ways
    arrangements_of_math_books = factorial(math_books)
    
    # Total arrangements
    total_arrangements = arrangements_of_units * arrangements_of_math_books
    
    return total_arrangements

def factorial(n):
    if n == 0 or n == 1:
        return 1
    result = 1
    for i in range(2, n + 1):
        result *= i
    return result

# Call the solve function and print the result
result = solve()
print(result)
```

