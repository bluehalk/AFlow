```python
def extended_gcd(a, b):
    """Return gcd of a and b, and coefficients x, y such that ax + by = gcd(a, b)"""
    if a == 0:
        return b, 0, 1
    gcd, x1, y1 = extended_gcd(b % a, a)
    x = y1 - (b // a) * x1
    y = x1
    return gcd, x, y

def mod_inverse(a, m):
    """Return the modular inverse of a under modulo m, if it exists"""
    gcd, x, _ = extended_gcd(a, m)
    if gcd != 1:
        raise ValueError("Inverse does not exist")
    return x % m

def solve():
    # Given values
    a = 24
    b = 15
    m = 1199
    
    # Find the modular inverse of 24 modulo 1199
    inv_a = mod_inverse(a, m)
    
    # Calculate x
    x = (inv_a * b) % m
    
    # We want the largest negative integer, so we adjust x
    if x > 0:
        x -= m
    
    return x

# Call the solve function and print the result
result = solve()
print(result)
```

