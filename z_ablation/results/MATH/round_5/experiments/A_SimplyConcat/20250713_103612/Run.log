    hurricane_counts = []
    
    # Populate the list based on the histogram data
    for hurricanes, years in hurricane_data.items():
        hurricane_counts.extend([hurricanes] * years)
    
    # Sort the list to find the median
    hurricane_counts.sort()
    
    # Calculate the median
    n = len(hurricane_counts)
    if n % 2 == 1:
        # If odd, return the middle element
        median = hurricane_counts[n // 2]
    else:
        # If even, return the average of the two middle elements
        median = (hurricane_counts[n // 2 - 1] + hurricane_counts[n // 2]) / 2
    
    return median

# Call the solve function and print the result
result = solve()
print(f"The median number of hurricanes per year is: {result}")
```

### Explanation of the Code:
