import math

def solve():
    # Given diagonal length
    diagonal_length = 5 * math.sqrt(5)
    
    # Let width be w, then length l = 2w
    # Using the Pythagorean theorem: diagonal^2 = length^2 + width^2
    # (5 * sqrt(5))^2 = (2w)^2 + w^2
    # 125 = 4w^2 + w^2
    # 125 = 5w^2
    # w^2 = 125 / 5
    # w^2 = 25
    # w = sqrt(25) = 5
    
    # Calculate width
