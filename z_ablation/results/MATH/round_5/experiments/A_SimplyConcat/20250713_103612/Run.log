    arrangements_within_blocks = 2 ** couples_as_blocks  # Each couple can be arranged in 2 ways
    arrangements_of_blocks = math.factorial(couples_as_blocks)  # Arrangements of the blocks
    
    # Total favorable arrangements
    favorable_arrangements = arrangements_of_blocks * arrangements_within_blocks
    
    # Probability of sitting in a socially optimal configuration
    probability = favorable_arrangements / total_arrangements
    
    return probability

# Call the solve function and print the result
