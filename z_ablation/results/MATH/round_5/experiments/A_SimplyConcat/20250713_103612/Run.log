```python
import math

def solve():
    # Define the centers and radii of the spheres
    center1 = (3, -5, 7)
    radius1 = 5 * math.sqrt(5)
    
    center2 = (0, 1, 1)
    radius2 = 2 * math.sqrt(17)
    
    # Calculate the distance between the centers of the two spheres
    distance = math.sqrt((center1[0] - center2[0]) ** 2 +
                         (center1[1] - center2[1]) ** 2 +
                         (center1[2] - center2[2]) ** 2)
    
    # Using the formula for the radius of the circle of intersection
    r = math.sqrt(radius1**2 - ((radius1**2 - radius2**2 + distance**2) / (2 * distance))**2)
    
    return r

# Call the solve function and print the result
result = solve()
print(f"The radius of the circle of intersection is: {result}")
```

