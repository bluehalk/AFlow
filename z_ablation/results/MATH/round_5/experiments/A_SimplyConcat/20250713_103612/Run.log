    total_cards = 54
    # Number of jokers
    jokers = 2
    # Number of non-joker cards
    non_joker_cards = total_cards - jokers
    
    # The expected number of cards strictly between the two jokers
    # The possible number of cards between the jokers can be from 0 to 52
    # The expected value is the average of the possible values
    expected_value = (0 + non_joker_cards) / 2
    
    return expected_value

# Call the solve function and print the result
