    fixed_part = 14900  # This is 14,900
    smallest_N = None  # To store the smallest valid N

    # Iterate through all possible values of A and B (1 to 9)
    for A in range(1, 10):
        for B in range(1, 10):
            # Form the number N
            N = fixed_part + 10 * A + B
            
            # Check divisibility by 3
            digit_sum = 1 + 4 + 9 + A + B  # Sum of digits
            if digit_sum % 3 == 0:
                # Check divisibility by 4
                last_two_digits = 10 * A + B
                if last_two_digits % 4 == 0:
                    # If both conditions are satisfied, check if it's the smallest
                    if smallest_N is None or N < smallest_N:
                        smallest_N = N

    return smallest_N

# Call the function and print the result
