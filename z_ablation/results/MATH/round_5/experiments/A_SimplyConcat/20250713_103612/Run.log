        if n % 2 == 0:  # Even n
            Q -= (1 / (2 ** (n + 1))) * np.cos((n // 2) * theta)
        else:  # Odd n
            Q += (1 / (2 ** (n + 1))) * np.sin((n // 2) * theta)
