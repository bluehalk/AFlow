from math import comb

def solve():
    # Total number of tosses
    n = 4
    
    # Count the number of favorable outcomes
    favorable_outcomes = 0
    
    # We need at least as many heads as tails
    # This means we can have 2, 3, or 4 heads
    for heads in range(2, n + 1):
        favorable_outcomes += comb(n, heads)
    
    # Total possible outcomes when tossing a coin 4 times
    total_outcomes = 2 ** n
    
    # Calculate the probability
    probability = favorable_outcomes / total_outcomes
    
    return probability

# Call the solve function and print the result
