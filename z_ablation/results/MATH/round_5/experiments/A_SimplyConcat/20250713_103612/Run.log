To solve the problem of finding the equation of the plane that bisects the angle between the two given planes and contains a specific point, we can follow these steps in Python:

1. Extract the normal vectors from the equations of the planes.
2. Calculate the angle bisector's normal vector using the formula for the angle bisector of two planes.
3. Use the point-normal form of the plane equation to find the equation of the bisector plane.

Here is the complete Python code to achieve this:

```python
import numpy as np
from math import gcd
from functools import reduce

def solve():
    # Coefficients of the first plane 3x - 6y + 2z + 5 = 0
    A1, B1, C1, D1 = 3, -6, 2, 5
    
    # Coefficients of the second plane 4x - 12y + 3z - 3 = 0
    A2, B2, C2, D2 = 4, -12, 3, -3
    
    # Normal vectors of the planes
    n1 = np.array([A1, B1, C1])
    n2 = np.array([A2, B2, C2])
    
    # Point that the bisector plane must contain
    point = np.array([-5, -1, -5])
    
    # Calculate the angle bisector normal vector
    # Normalize the normal vectors
    n1_norm = n1 / np.linalg.norm(n1)
    n2_norm = n2 / np.linalg.norm(n2)
    
    # The angle bisector normal vector
    bisector_normal = n1_norm + n2_norm
    bisector_normal /= np.linalg.norm(bisector_normal)  # Normalize the bisector normal
    
    # Coefficients of the bisector plane
    A, B, C = bisector_normal
    
    # Using the point-normal form of the plane equation: A(x - x0) + B(y - y0) + C(z - z0) = 0
    # where (x0, y0, z0) is the point (-5, -1, -5)
    D = -(A * point[0] + B * point[1] + C * point[2])
    
    # Convert to integers
    A, B, C, D = map(lambda x: int(round(x)), [A, B, C, D])
    
    # Ensure A > 0 and gcd condition
    if A < 0:
        A, B, C, D = -A, -B, -C, -D
    
    # Calculate gcd
    common_gcd = reduce(gcd, [abs(A), abs(B), abs(C), abs(D)])
    
    # Normalize by gcd
    A //= common_gcd
    B //= common_gcd
    C //= common_gcd
    D //= common_gcd
    
    # Return the final equation in the required format
    return f"{A}x + {B}y + {C}z + {D} = 0"

# Call the solve function and print the result
result = solve()
print(result)
```

