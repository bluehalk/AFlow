    # The number is of the form 1xy4
    # where x is the tens digit and y is the hundreds digit
    for x in range(10):  # x can be from 0 to 9
        for y in range(10):  # y can be from 0 to 9
            # Calculate the sum of the digits in odd and even positions
            odd_sum = 1 + y  # 1 (hundreds) + y (tens)
            even_sum = x + 4  # x (tens) + 4 (units)
            # Check the divisibility condition for 11
