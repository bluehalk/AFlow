def solve():
    # Data from the histogram: number of hurricanes and their corresponding years
    hurricane_data = {
        1: 5,   # 5 years had 1 hurricane
        2: 14,  # 14 years had 2 hurricanes
        3: 17,  # 17 years had 3 hurricanes
