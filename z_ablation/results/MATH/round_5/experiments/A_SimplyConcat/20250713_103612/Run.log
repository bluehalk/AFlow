    number_of_players = 11
    # Each player passes to every other player
    number_of_other_players = number_of_players - 1
    # Each pair of players passes the ball 3 times
    passes_per_pair = 3
    
    # Calculate the total number of passes
    total_passes = number_of_players * number_of_other_players * passes_per_pair
    
    return total_passes

# Call the solve function and print the result
