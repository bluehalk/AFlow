    total_pairs = 0
    
    # A and B must be positive integers
    for A in range(1, 6):  # A can take values from 1 to 5
        B = 6 - A  # Since A + B = 6
        if B > 0:  # B must also be positive
            total_pairs += 1  # Count the valid pair (A, B)
    
    return total_pairs

# Call the solve function and print the result
