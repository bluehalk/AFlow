        cos2_x = np.cos(x)**2
        csc2_x = 1 / np.sin(x)**2
        cot2_x = np.cos(x)**2 / np.sin(x)**2
        
        # Construct the matrix
        A = np.array([[sec2_x, 1, 1],
                      [cos2_x, cos2_x, csc2_x],
                      [1, cos2_x, cot2_x]])
        
        # Calculate the determinant
        det = np.linalg.det(A)
        determinants.append(det)

    # Return the unique values of the determinant
    unique_determinants = set(determinants)
    return unique_determinants

# Call the solve function and print the result
