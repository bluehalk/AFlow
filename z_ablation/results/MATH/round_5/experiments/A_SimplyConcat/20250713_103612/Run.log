    n = 284
    divisors_of_284 = proper_divisors(n)
    
    # Step 2: Sum the proper divisors of 284
    sum_of_divisors = sum(divisors_of_284)
    
    # Step 3: Find the proper divisors of the sum obtained
    divisors_of_sum = proper_divisors(sum_of_divisors)
    
    # Step 4: Sum the proper divisors of the sum
    final_result = sum(divisors_of_sum)
    
    return final_result

# Call the solve function and print the result
