    # Total possible outcomes when rolling two 6-sided dice
    total_outcomes = 6 * 6  # 6 sides on the first die and 6 sides on the second die
    
    # Favorable outcomes where the sum of the two dice equals 4
    favorable_outcomes = 0
    
    # Check all combinations of the two dice
    for die1 in range(1, 7):  # Die 1 can be 1 to 6
        for die2 in range(1, 7):  # Die 2 can be 1 to 6
            if die1 + die2 == 4:  # Check if the sum is 4
                favorable_outcomes += 1  # Count this combination
    
    # Calculate the probability
    probability = favorable_outcomes / total_outcomes
    
    return probability

# Call the solve function and print the result
