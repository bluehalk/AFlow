    lower_bound_base3 = 27  # 1000_3
    upper_bound_base3 = 80   # 2222_3
    
    # Define the range of integers that have two digits in base 6
    lower_bound_base6 = 6    # 10_6
    upper_bound_base6 = 35    # 55_6
    
    # Find the intersection of the two ranges
    lower_bound = max(lower_bound_base3, lower_bound_base6)
    upper_bound = min(upper_bound_base3, upper_bound_base6)
    
    # Calculate the integers in the intersection range
    integers = list(range(lower_bound, upper_bound + 1))
    
    # Calculate the average
