Here's the Python code that implements this logic:

```python
from math import factorial

def solve():
    # Number of chocolate chip cookies and sugar cookies
    chocolate_chip_cookies = 3
    sugar_cookies = 4
    
    # Total cookies
    total_cookies = chocolate_chip_cookies + sugar_cookies
    
    # Function to calculate arrangements of cookies
    def arrangements(chocolate_chip, sugar):
        return factorial(chocolate_chip + sugar) // (factorial(chocolate_chip) * factorial(sugar))
    
    # Total arrangements without any restrictions
    total_arrangements = arrangements(chocolate_chip_cookies, sugar_cookies)
    
    # Arrangements where a chocolate chip cookie is first
    arrangements_first = arrangements(chocolate_chip_cookies - 1, sugar_cookies)
    
    # Arrangements where a chocolate chip cookie is last
    arrangements_last = arrangements(chocolate_chip_cookies - 1, sugar_cookies)
    
    # Arrangements where a chocolate chip cookie is both first and last
    arrangements_both = arrangements(chocolate_chip_cookies - 2, sugar_cookies)
    
    # Using the principle of inclusion-exclusion
    valid_arrangements = (arrangements_first + arrangements_last - arrangements_both)
    
    return valid_arrangements

# Call the solve function and print the result
