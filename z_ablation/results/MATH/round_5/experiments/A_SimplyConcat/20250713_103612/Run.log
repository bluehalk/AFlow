    u_plus_v = u + v
    two_u_minus_v = 2 * u - v

    # Calculate the dot product of (u + v) and (2u - v)
    dot_product = np.dot(u_plus_v, two_u_minus_v)

    # Calculate the magnitudes of (u + v) and (2u - v)
    norm_u_plus_v = np.linalg.norm(u_plus_v)
    norm_two_u_minus_v = np.linalg.norm(two_u_minus_v)

    # Calculate cos(theta)
