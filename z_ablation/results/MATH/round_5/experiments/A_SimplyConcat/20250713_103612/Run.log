def solve():
    # The center square is at (2, 2) in a 5x5 grid
    center_x, center_y = 2, 2
    count = 0
    
    # Check for each possible square size from 1 to 5
    for size in range(1, 6):
        # The top-left corner of the square can be at (i, j)
        # The square will cover from (i, j) to (i + size - 1, j + size - 1)
        
        # The square must be able to include the center square (2, 2)
        # This means:
        # i <= center_x < i + size
        # j <= center_y < j + size
        
        # The range for i (top-left x-coordinate)
        for i in range(max(0, center_x - size + 1), min(5 - size + 1, center_x + 1)):
            # The range for j (top-left y-coordinate)
            for j in range(max(0, center_y - size + 1), min(5 - size + 1, center_y + 1)):
                count += 1
    
    return count

# Call the solve function and print the result
