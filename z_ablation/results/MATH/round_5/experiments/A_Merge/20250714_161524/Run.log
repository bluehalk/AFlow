import math
from functools import reduce
from collections import Counter

def prime_factors(n):
    i = 2
    factors = []
    while i * i <= n:
        while (n % i) == 0:
            factors.append(i)
            n //= i
        i += 1
    if n > 1:
        factors.append(n)
    return factors

def lcm(a, b):
    return abs(a * b) // math.gcd(a, b)

def lcm_of_first_n(n):
    return reduce(lcm, range(1, n + 1))

def solve():
    lcm_value = lcm_of_first_n(25)
    lcm_str = str(lcm_value)
    A = int(lcm_str[2])
    B = int(lcm_str[7])
    C = int(lcm_str[9])
    return 100 * A + 10 * B + C
```

