===== STAGE 2 : PYTHON CODE =====
```python
def is_palindrome(s):
    return s == s[::-1]

def to_base_3(n):
    if n == 0:
        return "0"
    digits = []
    while n:
        digits.append(str(n % 3))
        n //= 3
    return ''.join(digits[::-1])

def solve():
    count = 0
    for i in range(1, 2008):
        base_3_representation = to_base_3(i)
        if is_palindrome(base_3_representation):
            count += 1
    return count
```

