def base3_to_decimal(n):
    return sum(int(digit) * (3 ** i) for i, digit in enumerate(reversed(n)))

def decimal_to_base3(n):
    if n == 0:
        return '0'
    base3 = []
    while n:
        base3.append(str(n % 3))
        n //= 3
    return ''.join(reversed(base3))

def solve():
    # Convert base 3 numbers to decimal
    num1 = base3_to_decimal('121')
    num2 = base3_to_decimal('2122')
    num3 = base3_to_decimal('1200')
    num4 = base3_to_decimal('2111')
    
    # Perform the arithmetic
    result_decimal = num1 + num2 - num3 - num4
    
    # Convert the result back to base 3
    return decimal_to_base3(result_decimal)
```

