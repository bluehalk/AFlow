    if n <= 1:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

def solve():
    primes = [41, 43, 47, 53, 59]
    successful_outcomes = 0
    total_primes = len(primes)
    
    for p in primes:
        if is_prime(p + 12):
            successful_outcomes += 1
            
    return successful_outcomes, total_primes

