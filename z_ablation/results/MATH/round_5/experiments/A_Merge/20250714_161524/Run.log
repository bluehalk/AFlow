===== STAGE 2 : PYTHON CODE =====
```python
def is_prime(n):
    if n <= 1:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

def solve():
    total_sum = 0
    for n in range(10, 15):  # n from 10 to 14
        for k in [1, 2]:  # Check n^2 + 1 and n^2 + 2
            candidate = n**2 + k
            if 100 <= candidate <= 200 and is_prime(candidate):
                total_sum += candidate
    return total_sum
```

