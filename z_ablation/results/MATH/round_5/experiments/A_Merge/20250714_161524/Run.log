def proper_divisors(n):
    divisors = []
    for i in range(1, n):
        if n % i == 0:
            divisors.append(i)
    return divisors

def solve():
    # Step 1: Find proper divisors of 284
    divisors_of_284 = proper_divisors(284)
    sum_of_divisors = sum(divisors_of_284)
    
    # Step 2: Find proper divisors of the sum
    divisors_of_sum = proper_divisors(sum_of_divisors)
    final_sum = sum(divisors_of_sum)
    
    return final_sum
```

