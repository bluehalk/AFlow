===== STAGE 2 : PYTHON CODE =====
```python
import math

def solve():
    # Calculate the innermost square root
    sqrt_768 = math.sqrt(768)  # = 16 * sqrt(3)
    sqrt_32_plus_sqrt_768 = math.sqrt(32 + sqrt_768)  # = sqrt(32 + 16 * sqrt(3))
    
    # Now calculate the outer square root
    sqrt_8_plus_inner = math.sqrt(8 + sqrt_32_plus_sqrt_768)
    
    # We need to express this in the form a * cos(pi/b)
    # We will find a and b
    a = sqrt_8_plus_inner
    b = 6  # since cos(pi/6) = sqrt(3)/2, we can find a
    a = a / (math.sqrt(3)/2)  # a = sqrt(8 + sqrt(32 + sqrt(768))) / (sqrt(3)/2)
    
    return (round(a), b)

```

