def solve():
    smallest = float('inf')
    
    for a in range(1, 10):  # a cannot be 0
        for b in range(1, 10):
            for c in range(1, 10):
                for d in range(1, 10):
                    ab = 10 * a + b
                    bc = 10 * b + c
                    cd = 10 * c + d
                    N = 1000 * a + 100 * b + 10 * c + d
                    
                    if ab != bc and bc != cd and ab != cd:  # distinct
                        if N % ab == 0 and N % bc == 0 and N % cd == 0:
                            smallest = min(smallest, N)
    
    return smallest
```

