import math

def solve():
    total = 0
    for i in range(3, 2020):
        angle = 2 ** i
        angle_mod = angle % 360
        if angle_mod == 0:
            continue
        total += 1 / math.sin(math.radians(angle_mod))
    
    sec_n = total
    n = round(math.degrees(math.acos(1 / sec_n)))
    return n

```

