    # Dimensions of the picture
    picture_width = 5
    picture_height = 7
    
    # Border width
    border_width = 0.5
    
    # Total dimensions of the paper
    total_width = picture_width + 2 * border_width
    total_height = picture_height + 2 * border_width
    
    # Areas
    area_paper = total_width * total_height
    area_picture = picture_width * picture_height
    
    # Area of the visible red border
    area_border = area_paper - area_picture
    
    return area_border
```

