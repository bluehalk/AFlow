import math

def solve():
    sin_A = 3 / 5
    sin_B = 24 / 25
    
    cos_A = math.sqrt(1 - sin_A**2)
    cos_B = math.sqrt(1 - sin_B**2)
    
    # Using the sine addition formula
    sin_C = sin_A * sin_B + cos_A * cos_B
    
    # Since C can also be 180 - (A + B), we need to consider the second case
    sin_C_neg = sin_A * sin_B - cos_A * cos_B
    
    return sin_C, sin_C_neg

result = solve()
