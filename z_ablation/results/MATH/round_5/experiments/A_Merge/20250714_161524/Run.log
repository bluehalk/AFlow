===== STAGE 2 : PYTHON CODE =====
```python
def solve():
    import math
    
    # Coordinates of points
    A = (0, 0)
    P = (4, 0)
    B = (4, 4)
    D = (4, -4)
    
    # C is horizontally aligned with B and D
    C = (12, -4)
    
    # Calculate lengths of sides
    AP = math.sqrt((P[0] - A[0])**2 + (P[1] - A[1])**2)  # AP
    BP = math.sqrt((P[0] - B[0])**2 + (P[1] - B[1])**2)  # BP
    AB = math.sqrt((B[0] - A[0])**2 + (B[1] - A[1])**2)  # AB
    BC = math.sqrt((C[0] - B[0])**2 + (C[1] - B[1])**2)  # BC
    CD = math.sqrt((D[0] - C[0])**2 + (D[1] - C[1])**2)  # CD
    DA = math.sqrt((A[0] - D[0])**2 + (A[1] - D[1])**2)  # DA
    
    # Perimeter of pentagon ABCDP
    perimeter = AP + BP + AB + BC + CD + DA
    return perimeter

```

