def solve():
    count_palindromes = 0
    count_multiples_of_99 = 0
    
    for a in range(1, 10):  # a can be 1 to 9
        for b in range(0, 10):  # b can be 0 to 9
            palindrome = 1000 * a + 100 * b + 10 * b + a  # Form abba
            count_palindromes += 1
            
            if palindrome % 99 == 0:
                count_multiples_of_99 += 1
                
    probability = count_multiples_of_99 / count_palindromes
    return probability

```

