            else:
                factors[i] = 1
            n //= i
    return factors

def factorial_prime_exponents(n):
    exponents = {}
    for p in range(2, n + 1):
        if all(p % d != 0 for d in range(2, int(p**0.5) + 1)):
            count = 0
            k = 1
            while (n // (p ** k)) > 0:
                count += n // (p ** k)
                k += 1
            exponents[p] = count
    return exponents

def solve():
    n = 10
    prime_exponents = factorial_prime_exponents(n)
    count = 1  # Start with 1 for the product
    for exponent in prime_exponents.values():
        count *= (exponent // 3) + 1  # Each exponent contributes (e_p // 3) + 1
    return count

