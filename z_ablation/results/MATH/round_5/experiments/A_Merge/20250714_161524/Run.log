===== STAGE 2 : PYTHON CODE =====
```python
def gcd(a, b):
    while b:
        a, b = b, a % b
    return a

def extended_gcd(a, b):
    if a == 0:
        return b, 0, 1
    gcd, x1, y1 = extended_gcd(b % a, a)
    x = y1 - (b // a) * x1
    y = x1
    return gcd, x, y

def mod_inverse(a, m):
    gcd, x, _ = extended_gcd(a, m)
    if gcd != 1:
        raise ValueError("Inverse doesn't exist")
    return x % m

def solve():
    a = 12500000
    m = 999999999
    remainder = 111
    
    inv_a = mod_inverse(a, m)
    n = (remainder * inv_a) % m
    return n

```

