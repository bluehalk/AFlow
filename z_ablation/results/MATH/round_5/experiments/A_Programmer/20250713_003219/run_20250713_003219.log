def solve():
    # We will find the smallest positive multiple of 14 that consists only of the digits 1 and 0.
    from collections import deque
    
    # Start with a queue to perform a breadth-first search (BFS)
    queue = deque(['1'])  # Start with '1' since we need a positive number
    while queue:
        # Get the current number from the queue
        current = queue.popleft()
        
        # Convert the current string to an integer
        current_num = int(current)
        
        # Check if the current number is a multiple of 14
        if current_num % 14 == 0:
            # If it is, we found our number T
            T = current_num
            break
        
        # If not, we generate the next numbers by appending '0' and '1'
        queue.append(current + '0')
        queue.append(current + '1')
    
    # Calculate the quotient when T is divided by 14
    quotient = T // 14
    
    # Return the result in the required format
    return f"\\boxed{{{quotient}}}"

# Call the solve function and print the result
print(solve())
