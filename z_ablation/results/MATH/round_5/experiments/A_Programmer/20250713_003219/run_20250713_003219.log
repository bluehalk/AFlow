    # Treat the two math books as a single unit (block)
    # So we have: [Math Block, Physics Book, Other Books]
    # This gives us 5 units to arrange: 1 Math Block + 1 Physics Book + 4 Other Books
    units_to_arrange = 5
    
    # Calculate the arrangements of the units
    arrangements_of_units = factorial(units_to_arrange)
    
    # Calculate the arrangements of the math books within their block
    arrangements_of_math_books = factorial(math_books)
    
    # Total arrangements
    total_arrangements = arrangements_of_units * arrangements_of_math_books
    
    # Format the result in LaTeX notation
    return f"\\boxed{{{total_arrangements}}}"

def factorial(n):
    if n == 0 or n == 1:
        return 1
    result = 1
    for i in range(2, n + 1):
        result *= i
    return result

