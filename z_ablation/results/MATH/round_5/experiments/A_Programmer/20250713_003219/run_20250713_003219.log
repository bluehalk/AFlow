def solve():
    # Calculate the right-hand side of the equation
    cos_50 = math.cos(math.radians(50))
    sin_50 = math.sin(math.radians(50))
    rhs = cos_50 / (1 - sin_50)
    
    # We need to find the smallest positive integer x such that
    # tan(x - 160) = rhs
    # This implies x - 160 = arctan(rhs) + k * 180 for some integer k
    # Therefore, x = arctan(rhs) + 160 + k * 180
    
    arctan_rhs = math.degrees(math.atan(rhs))
    
    # Calculate the first solution for k = 0
    x = arctan_rhs + 160
    
    # Since we need the smallest positive integer x, we will check
    # if x is positive, if not we will add 180 to find the next solution
    if x <= 0:
        x += 180
    
    # We need to return the smallest positive integer
    smallest_positive_x = math.ceil(x)
    
    return f"\\boxed{{{smallest_positive_x}}}"

