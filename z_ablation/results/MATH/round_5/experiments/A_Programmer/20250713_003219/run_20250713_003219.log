def solve():
    # The center square is located at (2, 2) in a 0-indexed 5x5 grid.
    center_x, center_y = 2, 2
    
    # Count the number of squares of each size that can contain the center square.
    count = 0
    
    # A square of size n can be placed in the grid if its top-left corner is within the bounds
    # that allow the square to include the center square (2, 2).
    for size in range(1, 6):  # sizes from 1x1 to 5x5
        # The top-left corner of the square can be at (x, y) where:
        # x can range from (center_x - (size - 1)) to center_x
        # y can range from (center_y - (size - 1)) to center_y
        # We need to ensure that the top-left corner is within the grid bounds.
        
        # Calculate the valid range for the top-left corner
        min_x = max(0, center_x - (size - 1))
        max_x = min(5 - size, center_x)
        min_y = max(0, center_y - (size - 1))
        max_y = min(5 - size, center_y)
        
        # Count the number of valid positions for the top-left corner
        count += (max_x - min_x + 1) * (max_y - min_y + 1)
    
    # Return the result in the required format
    return f"\\boxed{{{count}}}"

