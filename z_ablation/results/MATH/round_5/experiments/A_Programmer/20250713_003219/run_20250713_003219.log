    def has_four_factors(n):
        count = 0
        for i in range(1, int(n**0.5) + 1):
            if n % i == 0:
                count += 1  # i is a factor
                if i != n // i:
                    count += 1  # n // i is also a factor
            if count > 4:  # No need to count further if we already have more than 4
                return False
        return count == 4

    # List to store the smallest integers with exactly four factors
    result = []
    num = 1  # Start checking from the first positive integer

    # Continue until we find the first five integers with exactly four factors
    while len(result) < 5:
        if has_four_factors(num):
            result.append(num)
        num += 1

    # Calculate the sum of the found integers
    total_sum = sum(result)
    
    # Return the result in the required format
    return f"\\boxed{{{total_sum}}}"

