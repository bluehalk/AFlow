import numpy as np
from numpy.linalg import matrix_rank

def solve():
    # Define the projection matrix
    P = np.array([[13/14, -1/7, 3/14],
                  [-1/7, 5/7, 3/7],
                  [3/14, 3/7, 5/14]])
    
    # Calculate the normal vector of the plane
    # The normal vector can be found by calculating the null space of the projection matrix
    # We can do this by finding the eigenvalues and eigenvectors
    eigenvalues, eigenvectors = np.linalg.eig(P)
    
    # The normal vector corresponds to the eigenvalue 1 (since it's a projection matrix)
    normal_vector = eigenvectors[:, np.isclose(eigenvalues, 1)].flatten()
    
    # Normalize the normal vector to get integer values
    normal_vector = np.round(normal_vector * 14).astype(int)  # Scale to avoid fractions
    
    # Ensure the first component is positive and gcd is 1
    a, b, c = normal_vector
    if a < 0:
        normal_vector = -normal_vector
    elif a == 0 and b < 0:
        normal_vector = -normal_vector
    elif a == 0 and b == 0 and c < 0:
        normal_vector = -normal_vector
    
    # Calculate gcd
    from math import gcd
    from functools import reduce
    def gcd_multiple(numbers):
        return reduce(gcd, numbers)
    
    g = gcd_multiple([abs(a), abs(b), abs(c)])
    
    # Divide by gcd to ensure gcd is 1
    normal_vector //= g
    
    # Format the output
    result = f"\\boxed{{\\begin{{pmatrix}} {normal_vector[0]} \\\\ {normal_vector[1]} \\\\ {normal_vector[2]} \\end{{pmatrix}}}}"
    
    return result

