def solve():
    # Define the set of numbers
    numbers = {0, 1, 2, 4, 8, 16}
    
    # Initialize a set to hold the sums
    sums = set()
    
    # Convert the set to a list for easier indexing
    num_list = list(numbers)
    
    # Iterate over all possible combinations of the numbers
    n = len(num_list)
    
    # Use bit manipulation to generate all subsets
    for i in range(1, 1 << n):  # from 1 to 2^n - 1
        subset_sum = 0
        count = 0
        
        for j in range(n):
            if i & (1 << j):  # if the j-th bit is set in i
                subset_sum += num_list[j]
                count += 1
        
        # We only consider sums from subsets with two or more distinct elements
        if count >= 2:
            sums.add(subset_sum)
    
    # The result is the number of distinct sums
    result = len(sums)
    
    # Return the result formatted in LaTeX notation
    return f"\\boxed{{{result}}}"

# Call the solve function and print the result
print(solve())
