import random

def segments_intersect(A, B, C, D):
    # Check if segments AB and CD intersect
    return (A < C < B < D) or (C < A < D < B)

def simulate_intersections(trials):
    intersections = 0
    for _ in range(trials):
        # Randomly choose four points on the circle
        points = sorted(random.uniform(0, 1) for _ in range(4))
        A, B, C, D = points[0], points[1], points[2], points[3]
        
        # Check if segments AB and CD intersect
        if segments_intersect(A, B, C, D):
            intersections += 1
            
    return intersections / trials

def solve():
    trials = 1000000  # Number of trials for simulation
    probability = simulate_intersections(trials)
    return f"\\boxed{{{probability:.6f}}}"

