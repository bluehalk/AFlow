    tan_B = sp.tan(B)
    tan_A_plus_B = (tan_A + tan_B) / (1 - tan_A * tan_B)
    
    # We need to find tan(A + B) / tan(A)
    ratio = tan_A_plus_B / tan_A
    
    # Solve the equation for B in terms of A
    solutions = sp.solve(equation, B)
    
    # We will take the first solution for simplicity
    B_solution = solutions[0]
    
    # Substitute B in the ratio
    ratio_substituted = ratio.subs(B, B_solution)
    
    # Simplify the expression
    final_result = sp.simplify(ratio_substituted)
    
    # Return the result in the required format
    return f"\\boxed{{{final_result}}}"

