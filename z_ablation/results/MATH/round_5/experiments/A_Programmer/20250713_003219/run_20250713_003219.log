def solve():
    # Define the time
    hour = 2
    minute = 48
    
    # Calculate the position of the hour hand
    # Each hour represents 30 degrees (360 degrees / 12 hours)
    # Each minute contributes 0.5 degrees to the hour hand (30 degrees / 60 minutes)
    hour_angle = (hour % 12) * 30 + (minute / 60) * 30
    
    # Calculate the position of the minute hand
    # Each minute represents 6 degrees (360 degrees / 60 minutes)
    minute_angle = minute * 6
    
    # Calculate the angle between the two hands
    angle_between_hands = abs(hour_angle - minute_angle)
    
    # The smaller angle between the two hands
    smaller_angle = min(angle_between_hands, 360 - angle_between_hands)
    
    # Return the result in LaTeX format
    return f"\\boxed{{{smaller_angle}}}"

