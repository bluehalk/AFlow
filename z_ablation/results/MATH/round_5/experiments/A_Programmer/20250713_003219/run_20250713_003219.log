def solve():
    # Define the congruences
    congruences = [
        (2, 3),  # a ≡ 2 (mod 3)
        (4, 5),  # a ≡ 4 (mod 5)
        (6, 7),  # a ≡ 6 (mod 7)
        (8, 9)   # a ≡ 8 (mod 9)
    ]
    
    # Start with the first congruence
    a = congruences[0][0]
    mod = congruences[0][1]
    
    # Solve the system of congruences using the method of successive substitutions
    for remainder, modulus in congruences[1:]:
        while a % modulus != remainder:
            a += mod
        mod *= modulus  # Update the modulus to the product of the current modulus
    
    return f"\\boxed{{{a}}}"

