import sympy as sp

def solve():
    # Define the variable
    theta = sp.symbols('theta', real=True)
    
    # Given equation: sin(5*theta) = sin^5(theta)
    equation = sp.sin(5 * theta) - sp.sin(theta)**5
    
    # Solve the equation for theta
    solutions = sp.solve(equation, theta)
    
    # Filter solutions to find acute angles (0 < theta < pi/2)
    acute_solutions = [sol.evalf() for sol in solutions if sol.is_real and 0 < sol < sp.pi/2]
    
    # Calculate tan(2*theta) for the acute solutions
    tan_2_theta_values = [sp.tan(2 * sol) for sol in acute_solutions]
    
    # Return the first value in boxed format
    return f"\\boxed{{{tan_2_theta_values[0]}}}"

