def solve():
    # Given values
    g = 210
    l = 210**3
    
    # Since gcd(a, b) * lcm(a, b) = a * b
    # We can express a and b in terms of g and l
    # Let a = g * x and b = g * y where gcd(x, y) = 1
    # Then lcm(a, b) = g * lcm(x, y) = g * x * y
    # Therefore, g * x * y = l
    # This gives us x * y = l / g = 210^3 / 210 = 210^2 = 44100
    
    target_product = l // g  # This is x * y
    count = 0
    
    # We need to find pairs (x, y) such that x * y = 44100 and gcd(x, y) = 1
    for x in range(1, int(target_product**0.5) + 1):
        if target_product % x == 0:
            y = target_product // x
            if gcd(x, y) == 1:
                # We have found a valid pair (x, y)
                # Since a < b, we need to ensure x < y
                if x < y:
                    count += 1
    
    # Return the result in the required format
    return f"\\boxed{{{count}}}"

