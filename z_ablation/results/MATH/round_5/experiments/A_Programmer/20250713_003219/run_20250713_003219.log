2025-07-13 00:33:06 - INFO - ```python
from math import comb

def solve():
    # Total number of CDs
    total_cds = 12
    # Number of CDs in each category
    rap_cds = 4
    country_cds = 5
    metal_cds = 3
    # Total number of CDs to choose
    choose_cds = 5
    
    # Total ways to choose 5 CDs from 12
    total_ways = comb(total_cds, choose_cds)
    
    # Calculate the number of ways to choose 5 CDs without at least one from each category
    # Cases to exclude:
    # 1. No rap CDs
    no_rap_ways = comb(country_cds + metal_cds, choose_cds) if choose_cds <= (country_cds + metal_cds) else 0
    # 2. No country CDs
    no_country_ways = comb(rap_cds + metal_cds, choose_cds) if choose_cds <= (rap_cds + metal_cds) else 0
    # 3. No metal CDs
    no_metal_ways = comb(rap_cds + country_cds, choose_cds) if choose_cds <= (rap_cds + country_cds) else 0
    # 4. No rap and no country CDs (only metal)
    no_rap_country_ways = comb(metal_cds, choose_cds) if choose_cds <= metal_cds else 0
    # 5. No rap and no metal CDs (only country)
    no_rap_metal_ways = comb(country_cds, choose_cds) if choose_cds <= country_cds else 0
    # 6. No country and no metal CDs (only rap)
    no_country_metal_ways = comb(rap_cds, choose_cds) if choose_cds <= rap_cds else 0
    
    # Using Inclusion-Exclusion Principle to find the number of ways to choose without at least one from each category
    excluded_ways = (no_rap_ways + no_country_ways + no_metal_ways 
                     - no_rap_country_ways - no_rap_metal_ways - no_country_metal_ways)
    
    # Valid ways to choose at least one from each category
    valid_ways = total_ways - excluded_ways
    
    # Probability of choosing at least one from each category
    probability = valid_ways / total_ways
    
    # Return the result in the required format
    return f"\\boxed{{{valid_ways}/{total_ways}}}"

