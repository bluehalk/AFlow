import math

def solve():
    # We need to find the smallest possible value of lcm(n, k) / gcd(n, k)
    # We know that lcm(n, k) = (n * k) / gcd(n, k)
    # Therefore, lcm(n, k) / gcd(n, k) = (n * k) / (gcd(n, k) ** 2)
    
    # We need to find n and k such that 5 < n/k < 6
    # This implies 5k < n < 6k for positive integers n and k
    
    min_value = float('inf')
    
    # We will iterate over possible values of k
    for k in range(1, 100):  # Arbitrarily chosen upper limit for k
        # Calculate the range for n based on k
        n_start = math.ceil(5 * k)
        n_end = math.floor(6 * k)
        
        for n in range(n_start, n_end + 1):
            gcd_nk = math.gcd(n, k)
            lcm_nk = (n * k) // gcd_nk
            value = lcm_nk // gcd_nk
            
            if value < min_value:
                min_value = value
    
    return f"\\boxed{{{min_value}}}"

# Call the solve function and print the result
print(solve())
