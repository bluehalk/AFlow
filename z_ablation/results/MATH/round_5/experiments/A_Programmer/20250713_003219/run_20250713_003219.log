def solve():
    from math import gcd

    # Number of colors
    colors = 5
    # Number of squares
    squares = 4

    # Using Burnside's lemma to count distinct colorings considering rotations
    # The group of rotations for a 2x2 board has 4 elements: 0°, 90°, 180°, 270°
    # We will count the number of colorings fixed by each rotation.

    # 0° rotation (identity): All colorings are fixed
    fixed_0 = colors ** squares

    # 90° rotation: No coloring can be fixed because all four squares must be the same color
    fixed_90 = colors

    # 180° rotation: Opposite squares must be the same color
    fixed_180 = colors ** 2  # (top-left with bottom-right) and (top-right with bottom-left)

    # 270° rotation: Same as 90° rotation
    fixed_270 = colors

    # Total fixed colorings
    total_fixed = (fixed_0 + fixed_90 + fixed_180 + fixed_270) / 4

    # Return the result in the required format
    return f"\\boxed{{{int(total_fixed)}}}"

