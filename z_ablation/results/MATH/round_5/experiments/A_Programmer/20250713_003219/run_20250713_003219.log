    # Calculate v1 and v2
    v1_value = v1.subs(k, k_value)
    v2_value = v2.subs(k, k_value)
    
    # Return the result in the required format
    return f"\\boxed{{\\begin{{pmatrix}}{v1_value} \\\\ {v2_value} \\end{{pmatrix}}}}"

