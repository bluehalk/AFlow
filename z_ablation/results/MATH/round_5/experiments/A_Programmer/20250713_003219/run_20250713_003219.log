import math

def solve():
    # Given rectangular coordinates
    x, y, z = 2, -1, -2
    
    # Convert rectangular coordinates to spherical coordinates
    rho = math.sqrt(x**2 + y**2 + z**2)  # radius
    theta = math.atan2(y, x)              # azimuthal angle
    phi = math.acos(z / rho)               # polar angle
    
    # New polar angle is 2 * phi
    new_phi = 2 * phi
    
    # Convert back to rectangular coordinates
    new_x = rho * math.sin(new_phi) * math.cos(theta)
    new_y = rho * math.sin(new_phi) * math.sin(theta)
    new_z = rho * math.cos(new_phi)
    
    # Format the result in LaTeX notation
    result = f"\\boxed{{({new_x:.2f}, {new_y:.2f}, {new_z:.2f})}}"
    
    return result

# Call the solve function and print the result
