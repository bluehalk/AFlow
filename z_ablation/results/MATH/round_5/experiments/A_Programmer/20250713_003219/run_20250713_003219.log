    # Possible values for n that satisfy n % 10 = 4
    n_candidates = [4, 14, 24, 34, 44, 54, 64, 74, 84, 94]
    
    # We need to find the smallest LCM(a, b)
    # LCM(a, b) = (a * b) / GCD(a, b)
    # LCM(6*m, 6*n) = (6*m * 6*n) / 6 = 6 * m * n
    
    min_lcm = float('inf')
    
