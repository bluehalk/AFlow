    area3 = math.pi * r3**2  # Area of the largest circle
    
    # Areas of the regions
    area_X = area3 - area2  # Area of region X (between r2 and r3)
    area_Y = area2 - area1  # Area of region Y (between r1 and r2)
    area_Z = area1          # Area of region Z (inside r1)
    
    # Finding the maximum and minimum areas
    max_area = max(area_X, area_Y, area_Z)
    min_area = min(area_X, area_Y, area_Z)
    
    # Calculating the difference
    difference = max_area - min_area
    
    # Returning the result in the required format
    return f"\\boxed{{{difference}}}"

