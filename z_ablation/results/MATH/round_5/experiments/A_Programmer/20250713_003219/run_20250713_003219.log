from math import factorial
from collections import Counter

def prime_factors(n):
    """Return the prime factorization of n as a Counter."""
    i = 2
    factors = Counter()
    while i * i <= n:
        while (n % i) == 0:
            factors[i] += 1
            n //= i
        i += 1
    if n > 1:
        factors[n] += 1
    return factors

def solve():
    # Calculate 10!
    n = 10
    fact_n = factorial(n)
    
    # Get the prime factorization of 10!
    factors = prime_factors(fact_n)
    
    # We need to find x such that x^3 is a factor of 10!
    # This means for each prime p in the factorization, the exponent of p in x^3
    # must be less than or equal to the exponent of p in 10!.
    
    # For x = p1^a1 * p2^a2 * ... * pk^ak, we need:
    # 3 * ai <= exponent of pi in 10!
    # => ai <= (exponent of pi in 10!) / 3
    
    count = 1  # Start with 1 for the product of choices
    for exponent in factors.values():
        count *= (exponent // 3) + 1  # +1 for the choice of 0 to ai
    
    return f"\\boxed{{{count}}}"

