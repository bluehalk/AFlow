def modular_inverse(a, m):
    """Return the modular inverse of a under modulo m using Extended Euclidean Algorithm."""
    m0, x0, x1 = m, 0, 1
    if m == 1:
        return 0
    while a > 1:
        # q is quotient
        q = a // m
        m, a = a % m, m
        x0, x1 = x1 - q * x0, x0
    if x1 < 0:
        x1 += m0
    return x1

def solve():
    # Given modulo
    mod = 31
    
    # Calculate the modular inverses
    inv_3 = modular_inverse(3, mod)
    inv_5 = modular_inverse(5, mod)
    
    # Calculate (3^{-1} + 5^{-1})^{-1} mod 31
    sum_inv = (inv_3 + inv_5) % mod
    result = modular_inverse(sum_inv, mod)
    
    # Return the result in LaTeX boxed format
    return f"\\boxed{{{result}}}"

# Call the solve function and print the result
print(solve())
