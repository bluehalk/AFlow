    green_balls = 2
    red_balls = 2
    boxes = 3
    
    # Function to calculate the number of ways to distribute indistinguishable balls into distinguishable boxes
    def distribute_balls(balls, boxes):
        # Using the "stars and bars" theorem
        return factorial(balls + boxes - 1) // (factorial(balls) * factorial(boxes - 1))
    
    # Calculate the ways to distribute green and red balls separately
    ways_green = distribute_balls(green_balls, boxes)
    ways_red = distribute_balls(red_balls, boxes)
    
    # Total ways is the product of the ways to distribute green and red balls
    total_ways = ways_green * ways_red
    
    # Return the result in LaTeX format
    return f"\\boxed{{{total_ways}}}"

