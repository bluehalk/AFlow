import numpy as np

def solve():
    # Define the normal vectors of the planes
    normal1 = np.array([1, 1, 1])  # From the plane x + y + z - 6 = 0
    normal2 = np.array([2, 3, 4])  # From the plane 2x + 3y + 4z + 5 = 0
    
    # Find the direction vector of the line L (cross product of the normals)
    direction = np.cross(normal1, normal2)
    
    # A point on the line L can be found by solving the system of equations
    # We can set z = 0 and solve for x and y
    z = 0
    # From the first plane: x + y - 6 = 0  => y = 6 - x
    # From the second plane: 2x + 3y + 4*0 + 5 = 0 => 2x + 3(6 - x) + 5 = 0
    # => 2x + 18 - 3x + 5 = 0 => -x + 23 = 0 => x = 23
    # => y = 6 - 23 = -17
    point_on_line = np.array([23, -17, 0])
    
    # The point we want to include in the plane
    point = np.array([1, 1, 1])
    
    # The vector from the point on the line to the point (1, 1, 1)
    vector_to_point = point - point_on_line
    
    # The normal vector of the new plane is the cross product of the direction vector and the vector to the point
    normal_plane = np.cross(direction, vector_to_point)
    
    # The equation of the plane can be written as:
    # A(x - x0) + B(y - y0) + C(z - z0) = 0
    # where (x0, y0, z0) is a point on the plane (we can use point_on_line)
    A, B, C = normal_plane
    x0, y0, z0 = point_on_line
    
    # The equation becomes:
    # A(x - x0) + B(y - y0) + C(z - z0) = 0
    # => Ax + By + Cz - (Ax0 + By0 + Cz0) = 0
    D = -(A * x0 + B * y0 + C * z0)
    
    # Ensure A > 0 and gcd(|A|, |B|, |C|, |D|) = 1
    if A < 0:
        A, B, C, D = -A, -B, -C, -D
    
    # Function to compute gcd
    def gcd(a, b):
        while b:
            a, b = b, a % b
        return abs(a)
    
    def gcd_multiple(*args):
        result = args[0]
        for num in args[1:]:
            result = gcd(result, num)
        return result
    
    g = gcd_multiple(A, B, C, D)
    
    # Normalize the coefficients
    A //= g
    B //= g
    C //= g
    D //= g
    
    # Return the result in the required format
    return f"\\boxed{{{A}x + {B}y + {C}z + {D} = 0}}"

