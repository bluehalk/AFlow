    n = 12
    
    # Set to store unique values of (a + b)^12
    unique_values = set()
    
    # Generate all 12th roots of unity
    roots_of_unity = [complex(cos(2 * pi * k / n), sin(2 * pi * k / n)) for k in range(n)]
    
    # Iterate over all pairs (a, b) of roots of unity
