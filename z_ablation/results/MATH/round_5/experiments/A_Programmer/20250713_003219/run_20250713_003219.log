def solve():
    # The first four prime numbers
    primes = [2, 3, 5, 7]
    
    # Total number of outcomes when choosing a random integer from 0 to n-1 for each prime
    total_outcomes = 1
    for prime in primes:
        total_outcomes *= prime  # Multiply the number of choices for each prime
    
    # Calculate the number of outcomes where the sum is greater than 0
    # The only way the sum can be 0 is if Bob chooses 0 from all primes
    # There is exactly 1 way to choose 0 from each prime (0, 0, 0, 0)
    outcomes_sum_zero = 1
    
    # Therefore, the number of outcomes where the sum is greater than 0
    outcomes_sum_greater_than_zero = total_outcomes - outcomes_sum_zero
    
    # Probability that the sum is greater than 0
    probability = outcomes_sum_greater_than_zero / total_outcomes
    
    # Format the result in LaTeX notation
    return f"\\boxed{{{probability}}}"

