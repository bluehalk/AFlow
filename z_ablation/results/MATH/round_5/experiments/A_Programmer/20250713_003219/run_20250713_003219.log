from fractions import Fraction

def solve():
    # Probability of winning in one turn
    # Winning conditions: die shows 1 or 6 (2 outcomes) and coin shows heads (1 outcome)
    probability_win = (2 / 6) * (1 / 2)  # P(die is 1 or 6) * P(coin is heads)
    
    # Probability of not winning in one turn
    probability_lose = 1 - probability_win
    
    # Probability of winning before the fourth turn
    # This can be calculated as 1 - P(lose all 3 turns)
    probability_lose_all_3 = probability_lose ** 3
    probability_win_before_4 = 1 - probability_lose_all_3
    
    # Convert to a fraction
    result = Fraction(probability_win_before_4).limit_denominator()
    
    # Return the result in the required format
    return f"\\boxed{{{result}}}"

