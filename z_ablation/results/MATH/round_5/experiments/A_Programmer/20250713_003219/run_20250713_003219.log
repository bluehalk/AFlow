    tan_A_half = sp.tan(A / 2)
    tan_B_half = sp.tan(B / 2)
    tan_C_half = sp.tan(C / 2)
    
    # Set up the equations based on the problem statement
    eq1 = sp.Eq(sp.tan((B - C) / 2) * tan_A_half, tan_B_C_half)
    eq2 = sp.Eq(sp.tan((C - A) / 2) * tan_B_half, tan_C_A_half)
    
    # Solve the equations for tan(A/2), tan(B/2), tan(C/2)
    solutions = sp.solve((eq1, eq2), (tan_A_half, tan_B_half, tan_C_half))
    
    # Extract the solutions
    tan_A_half_val = solutions[tan_A_half]
    tan_B_half_val = solutions[tan_B_half]
    tan_C_half_val = solutions[tan_C_half]
    
    # Calculate tan((A - B) / 2) * tan(C / 2)
    tan_A_B_half = sp.tan((A - B) / 2)
    result = tan_A_B_half * tan_C_half_val
    
    # Return the result in the required format
    return f"\\boxed{{{result}}}"

