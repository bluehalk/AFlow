def solve():
    # The four-digit number is of the form 25AB
    # We need to find A and B such that 25AB is divisible by 9.
    
    # A four-digit number is divisible by 9 if the sum of its digits is divisible by 9.
    # The digits of the number 25AB are: 2, 5, A, B
    # The sum of the digits is: 2 + 5 + A + B = 7 + A + B
    
    count = 0
    
    # A can be from 0 to 9 (tens place)
    # B can be from 0 to 9 (units place)
    for A in range(10):
        for B in range(10):
            digit_sum = 7 + A + B
            if digit_sum % 9 == 0:
                count += 1
    
    # Return the result in the required format
    return f"\\boxed{{{count}}}"

