    # Set up the condition for collinearity
    # v1, v2, v3 are collinear if the determinant of the matrix formed by them is zero
    matrix = Matrix([v1, v2, v3]).T
    det = matrix.det()

    # Solve the equation det = 0
    equations = [Eq(det, 0)]
    solution = sym_solve(equations, (p, q))

    # Extract the values of p and q
    p_value = solution[p]
    q_value = solution[q]

    # Return the result in the required format
    return f"\\boxed{{({p_value}, {q_value})}}"

