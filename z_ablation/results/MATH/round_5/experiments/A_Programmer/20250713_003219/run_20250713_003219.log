def solve():
    # Camera A starts at 6 AM and takes a picture every 11 minutes
    start_A = 6 * 60  # 6 AM in minutes
    interval_A = 11    # interval in minutes

    # Camera B starts at 7 AM and takes a picture every 7 minutes
    start_B = 7 * 60  # 7 AM in minutes
    interval_B = 7     # interval in minutes

    # We will find the times when both cameras take pictures together
    # The times for Camera A are: start_A + n * interval_A
    # The times for Camera B are: start_B + m * interval_B

    # We need to find common times before noon (12 PM = 720 minutes)
    common_times = []
    for n in range((720 - start_A) // interval_A + 1):
        time_A = start_A + n * interval_A
        if time_A >= start_B:  # Only consider times after Camera B starts
            for m in range((720 - start_B) // interval_B + 1):
                time_B = start_B + m * interval_B
                if time_A == time_B:
                    common_times.append(time_A)

    # The last common time before noon
    last_common_time = common_times[-1]

    # Calculate how many minutes before noon this time is
    minutes_before_noon = 720 - last_common_time

    # Return the result in the required format
    return f"\\boxed{{{minutes_before_noon}}}"

# Call the solve function and print the result
print(solve())
