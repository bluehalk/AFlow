    # Calculate the vector a from the projection
    # proj_a = (v . a_hat) * a_hat
    # where a_hat is the unit vector of a
    # We can find the length of the projection
    a_hat_length = np.linalg.norm(proj_a)
    
    # Since proj_a = (v . a_hat) * a_hat, we can find a_hat
    a_hat = proj_a / a_hat_length
    
