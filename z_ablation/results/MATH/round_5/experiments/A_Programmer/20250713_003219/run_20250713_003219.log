from itertools import permutations

def solve():
    # Total number of lamps
    total_lamps = 6
    # Number of red and blue lamps
    red_lamps = 3
    blue_lamps = 3
    
    # Generate all unique arrangements of the lamps
    arrangements = set(permutations(['R'] * red_lamps + ['B'] * blue_lamps))
    
    # Count favorable outcomes
    favorable_count = 0
    total_count = len(arrangements)
    
    for arrangement in arrangements:
        # Check if the leftmost lamp is red
        if arrangement[0] == 'R':
            # Count the number of red lamps in the arrangement
            red_count = arrangement.count('R')
            # We can turn on 3 lamps, we need to check if the leftmost turned on lamp is red
            # The total ways to choose 3 lamps from 6
            total_ways_to_turn_on = 20  # C(6, 3)
            # The number of ways to choose 3 lamps with at least one red lamp
            # We can have 1, 2, or 3 red lamps turned on
            ways_with_red = 0
            
            # Case 1: 1 red, 2 blue
            if red_count >= 1 and blue_lamps >= 2:
                ways_with_red += (red_count * 3)  # Choose 1 red and 2 blue
            
            # Case 2: 2 red, 1 blue
            if red_count >= 2 and blue_lamps >= 1:
                ways_with_red += (red_count * (red_count - 1) // 2 * blue_lamps)  # Choose 2 red and 1 blue
            
            # Case 3: 3 red
            if red_count >= 3:
                ways_with_red += (red_count * (red_count - 1) * (red_count - 2) // 6)  # Choose 3 red
            
            # If at least one red lamp is turned on, we count this arrangement
            favorable_count += ways_with_red
    
    # Calculate the probability
