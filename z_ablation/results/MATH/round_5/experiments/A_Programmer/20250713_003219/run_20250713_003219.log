import math

def solve():
    # Given volume of the tetrahedron
    volume = 1 / math.sqrt(360)
    
    # The formula for the volume of a tetrahedron formed by three vectors a, b, c
    # is given by: V = (1/6) * |a . (b x c)|
    # Since a, b, c are unit vectors and the angle between any two is theta,
    # we can express the volume in terms of theta.
    
    # The scalar triple product can be expressed as:
    # |a . (b x c)| = |a| * |b| * |c| * sin(theta) = sin(theta)
    # Since |a| = |b| = |c| = 1, we have:
    # V = (1/6) * sin(theta)
    
    # Setting the volume equal to the given volume:
    # (1/6) * sin(theta) = 1 / sqrt(360)
    # sin(theta) = 6 / sqrt(360)
    
    sin_theta = 6 / math.sqrt(360)
    
    # Using the identity sin^2(theta) + cos^2(theta) = 1
    # We can find cos(theta):
    cos_theta = math.sqrt(1 - sin_theta**2)
    
    # Now we need to calculate 3 * cos^2(theta) - 2 * cos^3(theta)
    cos2_theta = cos_theta ** 2
    cos3_theta = cos_theta ** 3
    
    result = 3 * cos2_theta - 2 * cos3_theta
    
    # Return the result in the required format
    return f"\\boxed{{{result}}}"

