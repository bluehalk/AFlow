\[\renewcommand{\arraystretch}{1.5} \begin{pmatrix} \frac{13}{14} & -\frac{1}{7} & \frac{3}{14} \\ -\frac{1}{7} & \frac{5}{7} & \frac{3}{7} \\ \frac{3}{14} & \frac{3}{7} & \frac{5}{14} \end{pmatrix} \renewcommand{\arraystretch}{1}.\]Find the normal vector of plane $P.$  Enter your answer in the form $\begin{pmatrix} a \\ b \\ c \end{pmatrix},$ where $a,$ $b,$ and $c$ are integers, $a > 0,$ and $\gcd(|a|,|b|,|c|) = 1.$

2025-07-13 00:32:50 - INFO - ```python
import numpy as np
from numpy.linalg import matrix_rank

def solve():
    # Define the projection matrix
    P = np.array([[13/14, -1/7, 3/14],
                  [-1/7, 5/7, 3/7],
                  [3/14, 3/7, 5/14]])
    
    # Calculate the normal vector of the plane
    # The normal vector can be found by calculating the null space of the projection matrix
    # We can do this by finding the eigenvalues and eigenvectors
    eigenvalues, eigenvectors = np.linalg.eig(P)
    
    # The normal vector corresponds to the eigenvalue of 1 (since it's a projection matrix)
    normal_vector = eigenvectors[:, np.isclose(eigenvalues, 1)].flatten()
    
    # Normalize the normal vector to get integer values
    normal_vector = normal_vector / np.linalg.norm(normal_vector)
    
    # Scale to get integer values
    normal_vector_int = np.round(normal_vector * 14).astype(int)  # Scale by 14 to avoid fractions
    
    # Ensure the first component is positive and gcd is 1
    a, b, c = normal_vector_int
    if a < 0:
        normal_vector_int = -normal_vector_int
    elif a == 0 and b < 0:
        normal_vector_int = -normal_vector_int
    elif a == 0 and b == 0 and c < 0:
        normal_vector_int = -normal_vector_int
    
    # Calculate gcd
    from math import gcd
    from functools import reduce
    def gcd_multiple(numbers):
        return reduce(gcd, numbers)
    
    g = gcd_multiple([abs(a), abs(b), abs(c)])
    
    # Divide by gcd to ensure it's 1
    normal_vector_int //= g
    
    # Format the output
    result = f"\\boxed{{\\begin{{pmatrix}} {normal_vector_int[0]} \\\\ {normal_vector_int[1]} \\\\ {normal_vector_int[2]} \\end{{pmatrix}}}}"
    
    return result

# Call the solve function and print the result
print(solve())
