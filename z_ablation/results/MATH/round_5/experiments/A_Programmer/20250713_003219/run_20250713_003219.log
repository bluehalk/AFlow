def lcm(x, y):
    return x * y // gcd(x, y)

def factorial(n):
    return math.factorial(n)

def solve():
    # Calculate the values of 1! + 2!, 2! + 3!, ..., 8! + 9!
    values = [factorial(i) + factorial(i + 1) for i in range(1, 9)]
    
    # Calculate the least common multiple of the values
    least_common_multiple = reduce(lcm, values)
    
    # Find the largest b such that least_common_multiple can be expressed as a * b!
    b = 0
    while True:
        b_factorial = factorial(b)
        if least_common_multiple % b_factorial == 0:
            b += 1
        else:
            break
    b -= 1  # Decrement b to the last valid value
    
    a = least_common_multiple // factorial(b)
    
    # Return the result in the required format
    return f"\\boxed{{{a + b}}}"

# Call the solve function and print the result
print(solve())
