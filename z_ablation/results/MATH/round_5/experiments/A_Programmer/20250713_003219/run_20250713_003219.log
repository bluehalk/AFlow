import numpy as np
from math import gcd
from functools import reduce

def solve():
    # Coefficients of the planes
    A1, B1, C1, D1 = 3, -6, 2, 5
    A2, B2, C2, D2 = 4, -12, 3, -3
    
    # Normal vectors of the planes
    n1 = np.array([A1, B1, C1])
    n2 = np.array([A2, B2, C2])
    
    # Point that lies on the bisecting plane
    point = np.array([-5, -1, -5])
    
    # Calculate the angle bisector normal vector
    n1_magnitude = np.linalg.norm(n1)
    n2_magnitude = np.linalg.norm(n2)
    
    # Normalize the normal vectors
    n1_unit = n1 / n1_magnitude
    n2_unit = n2 / n2_magnitude
    
    # The angle bisector normal vector
    bisector_normal = n1_unit + n2_unit
    bisector_normal /= np.linalg.norm(bisector_normal)  # Normalize the bisector normal
    
    # Coefficients for the bisector plane
    A, B, C = bisector_normal
    
    # Using the point to find D
    D = - (A * point[0] + B * point[1] + C * point[2])
    
    # Convert to integers
    A, B, C, D = map(lambda x: int(round(x)), [A, B, C, D])
    
    # Ensure A > 0 and gcd condition
    if A < 0:
        A, B, C, D = -A, -B, -C, -D
    
    # Calculate gcd of the coefficients
    common_gcd = reduce(gcd, [abs(A), abs(B), abs(C), abs(D)])
    
    # Normalize coefficients
    A //= common_gcd
    B //= common_gcd
    C //= common_gcd
    D //= common_gcd
    
    # Format the result
    result = f"{A}x + {B}y + {C}z + {D} = 0"
    
    return f"\\boxed{{{result}}}"

# Call the solve function and print the result
print(solve())
