    eq1 = sp.cos(alpha) + sp.cos(beta) + sp.cos(gamma) - 1
    eq2 = sp.sin(alpha) + sp.sin(beta) + sp.sin(gamma) - 1
    
    # We want to minimize cos(alpha)
    cos_alpha = sp.cos(alpha)
    
    # Use Lagrange multipliers to find the minimum of cos(alpha)
    # We will minimize cos(alpha) subject to the constraints eq1 and eq2
    lagrange_multiplier = sp.symbols('lambda')
    
    # The Lagrangian function
