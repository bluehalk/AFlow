def solve():
    # We need to find the smallest integer n > 1 such that the product of its positive divisors equals n^6.
    
    # The product of the divisors of n can be expressed as n^(t(n)/2), where t(n) is the number of divisors of n.
    # We need to satisfy the equation: n^(t(n)/2) = n^6
    # This simplifies to: t(n)/2 = 6  => t(n) = 12
    
    # We need to find the smallest n such that the number of divisors t(n) = 12.
    
    # The number of divisors function t(n) can be calculated from the prime factorization of n:
    # If n = p1^e1 * p2^e2 * ... * pk^ek, then t(n) = (e1 + 1)(e2 + 1)...(ek + 1)
    
    # We will check integers starting from 2 and calculate their number of divisors until we find the smallest n with t(n) = 12.
    
    def count_divisors(n):
        count = 0
        for i in range(1, int(n**0.5) + 1):
            if n % i == 0:
                count += 1  # i is a divisor
                if i != n // i:
                    count += 1  # n // i is also a divisor
        return count
    
    n = 2
    while True:
        if count_divisors(n) == 12:
            return f"\\boxed{{{n}}}"
        n += 1

