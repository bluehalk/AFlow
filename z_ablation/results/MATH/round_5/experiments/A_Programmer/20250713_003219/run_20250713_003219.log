    # Probability of drawing a red bead
    prob_red = Fraction(red_beads, total_beads)
    # Probability of drawing a green bead
    prob_green = Fraction(green_beads, total_beads)
    
    # After 3 replacements, we need to calculate the probability of all beads being red
    # We can have the following scenarios:
    # 1. Draw red 3 times: (R, R, R)
    # 2. Draw red 2 times and green 1 time: (R, R, G), (R, G, R), (G, R, R)
    # 3. Draw red 1 time and green 2 times: (R, G, G), (G, R, G), (G, G, R)
    # 4. Draw green 3 times: (G, G, G) - impossible since we start with 2 red beads
    
    # Probability of drawing red 3 times
    prob_all_red = prob_red ** 3
    
    # Probability of drawing red 2 times and green 1 time
    prob_two_red_one_green = 3 * (prob_red ** 2) * prob_green
    
    # Probability of drawing red 1 time and green 2 times
    prob_one_red_two_green = 3 * prob_red * (prob_green ** 2)
    
    # Total probability of all beads being red after 3 draws
    total_probability = prob_all_red + prob_two_red_one_green
    
    # Return the result in the required format
    return f"\\boxed{{{total_probability}}}"

