2025-07-13 00:33:37 - INFO - ```python
import sympy as sp

def solve():
    # Define the variable
    x = sp.symbols('x')
    
    # We know that cos(20 degrees) can be expressed using the triple angle formula
    # cos(3θ) = 4cos^3(θ) - 3cos(θ)
    # Let θ = 20 degrees, then cos(3*20) = cos(60) = 1/2
    # Therefore, we have the equation:
    # 1/2 = 4cos^3(20) - 3cos(20)
    
    # Let y = cos(20 degrees)
    y = sp.cos(sp.rad(20))
    
    # Set up the equation
    equation = sp.Eq(4*y**3 - 3*y, 1/2)
    
    # Rearranging gives us the polynomial
    polynomial = sp.collect(sp.expand(equation.lhs - equation.rhs), y)
    
    # Convert the polynomial to standard form
    coeffs = sp.Poly(polynomial, y).all_coeffs()
    
    # Convert coefficients to integers
    coeffs = [sp.nsimplify(c).as_numer_denom()[0] for c in coeffs]
    
    # Multiply by the least common multiple of the denominators to clear fractions
    lcm = sp.lcm([c.q for c in coeffs if c.q != 1])
    coeffs = [c * lcm for c in coeffs]
    
    # Ensure the leading coefficient is positive
    if coeffs[0] < 0:
        coeffs = [-c for c in coeffs]
    
    # Format the result as a cubic polynomial
    result = f"{coeffs[0]}x^3 + {coeffs[1]}x^2 + {coeffs[2]}x + {coeffs[3]}"
    
    # Return the result in the required format
    return f"\\boxed{{{result}}}"

# Call the solve function and print the result
print(solve())
