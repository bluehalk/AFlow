def solve():
    from math import gcd
    from collections import defaultdict

    # Function to get the prime factorization of a number
    def prime_factors(n):
        factors = defaultdict(int)
        d = 2
        while d * d <= n:
            while (n % d) == 0:
                factors[d] += 1
                n //= d
            d += 1
        if n > 1:
            factors[n] += 1
        return factors

    # Calculate the prime factorization for numbers 1 to 16
    factorization = {i: prime_factors(i) for i in range(1, 17)}

    # To avoid a perfect square product, we need to track the parity of the exponents
    # We will use a bitmask to represent the parity of the prime factors
    prime_to_index = {}
    index = 0
    for i in range(1, 17):
        for prime in factorization[i].keys():
            if prime not in prime_to_index:
                prime_to_index[prime] = index
                index += 1

    # Create a list to hold the parity masks for each number
    parity_masks = []
    for i in range(1, 17):
        mask = 0
        for prime, exponent in factorization[i].items():
            if exponent % 2 == 1:  # Only consider odd exponents
                mask |= (1 << prime_to_index[prime])
        parity_masks.append(mask)

    # We need to find the maximum number of slips that can be drawn without forming a perfect square
    # This is equivalent to finding the largest subset of parity_masks that has no two masks that XOR to 0
    seen_masks = set()
    max_count = 0

    for mask in parity_masks:
        if mask not in seen_masks:
            seen_masks.add(mask)
            max_count += 1

    return f"\\boxed{{{max_count}}}"

