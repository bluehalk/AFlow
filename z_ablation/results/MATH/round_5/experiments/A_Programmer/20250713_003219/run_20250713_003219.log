import sympy as sp

def solve():
    # Define the symbols
    A, B, C, D = sp.symbols('A B C D')
    
    # Calculate tan(A + B) using the tangent addition formula
    tan_A_plus_B = (sp.tan(A) + sp.tan(B)) / (1 - sp.tan(A) * sp.tan(B))
    
    # From the quadratic equation, we know:
    # tan(A) + tan(B) = -C (sum of roots)
    # tan(A) * tan(B) = D (product of roots)
    sum_tan = -C
    product_tan = D
    
    # Substitute into the tangent addition formula
    tan_A_plus_B = sum_tan / (1 - product_tan)
    
    # Now we need to find sin^2(A + B) and cos^2(A + B)
    # sin^2(A + B) = tan^2(A + B) / (1 + tan^2(A + B))
    # cos^2(A + B) = 1 / (1 + tan^2(A + B))
    
    tan_squared = tan_A_plus_B**2
    sin_squared = tan_squared / (1 + tan_squared)
    cos_squared = 1 / (1 + tan_squared)
    
    # Now we can compute the expression
    expression = sin_squared + C * sp.sin(A + B) * cos_squared + D * cos_squared
    
    # Simplify the expression
    simplified_expression = sp.simplify(expression)
    
    # Return the result in the required format
    return f"\\boxed{{{simplified_expression}}}"

# Call the solve function and print the result
