    cos_alpha = sp.cos(alpha)
    
    # Use Lagrange multipliers to find the minimum of cos(alpha)
    # We need to minimize cos_alpha subject to eq1 and eq2 being zero
    lagrange_multiplier = sp.symbols('lambda mu')
    
    # Define the Lagrangian
    L = cos_alpha + lagrange_multiplier * eq1 + mu * eq2
    
    # Compute the gradients
    grad_L = [sp.diff(L, var) for var in (alpha, beta, gamma, lagrange_multiplier, mu)]
    
    # Solve the system of equations given by setting the gradients to zero
