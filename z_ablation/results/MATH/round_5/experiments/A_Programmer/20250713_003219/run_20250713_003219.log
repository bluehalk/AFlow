import math

def solve():
    # Given equation: sin(x) + cos(x) = 1/5
    # We can square both sides to use the identity sin^2(x) + cos^2(x) = 1
    # (sin(x) + cos(x))^2 = (1/5)^2
    # sin^2(x) + 2sin(x)cos(x) + cos^2(x) = 1/25
    # 1 + 2sin(x)cos(x) = 1/25
    # 2sin(x)cos(x) = 1/25 - 1
    # 2sin(x)cos(x) = -24/25
    # sin(2x) = -24/25

    # We can also express sin(x) and cos(x) in terms of tan(x)
    # Let tan(x) = t, then sin(x) = t / sqrt(1 + t^2) and cos(x) = 1 / sqrt(1 + t^2)
    # Substitute into the original equation:
    # (t / sqrt(1 + t^2)) + (1 / sqrt(1 + t^2)) = 1/5
    # (t + 1) / sqrt(1 + t^2) = 1/5
    # Cross-multiply:
    # 5(t + 1) = sqrt(1 + t^2)
    # Square both sides:
    # 25(t + 1)^2 = 1 + t^2
    # 25(t^2 + 2t + 1) = 1 + t^2
    # 25t^2 + 50t + 25 = 1 + t^2
    # 24t^2 + 50t + 24 = 0

    # Now we can solve this quadratic equation using the quadratic formula
    a = 24
    b = 50
    c = 24

    discriminant = b**2 - 4*a*c
    t1 = (-b + math.sqrt(discriminant)) / (2*a)
    t2 = (-b - math.sqrt(discriminant)) / (2*a)

    # We need to check which solution is valid in the range 0 < x < pi
    # Since tan(x) is positive in the first quadrant (0 < x < pi/2) and negative in the second quadrant (pi/2 < x < pi)
    # We will only consider the positive solution
    if t1 > 0:
        result = t1
    else:
        result = t2

    return f"\\boxed{{{result}}}"

