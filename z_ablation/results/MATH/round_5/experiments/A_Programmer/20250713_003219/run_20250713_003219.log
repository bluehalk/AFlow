def solve():
    # Given values
    a_coeff = 27
    b_value = 17
    modulus = 40

    # We need to solve the congruence 27a ≡ 17 (mod 40)
    # This can be rewritten as 27a - 40k = 17 for some integer k
    # We will find the multiplicative inverse of 27 modulo 40

    def extended_gcd(a, b):
        if a == 0:
            return b, 0, 1
        gcd, x1, y1 = extended_gcd(b % a, a)
        x = y1 - (b // a) * x1
        y = x1
        return gcd, x, y

    # Find gcd and the coefficients
    gcd, x, y = extended_gcd(a_coeff, modulus)

    # Check if there is a solution
    if b_value % gcd != 0:
        return "No solution"

    # Scale the solution
    x *= b_value // gcd
    modulus //= gcd

    # Normalize x to be positive
    x = (x % modulus + modulus) % modulus

    # Now we have one solution, we can find the smallest and second smallest positive solutions
    solutions = []
    for k in range(gcd):
        solution = x + k * (modulus * (gcd // gcd))
        if solution > 0:
            solutions.append(solution)

    # Sort and get the smallest and second smallest
    solutions = sorted(set(solutions))
    if len(solutions) < 2:
        return "Not enough solutions"

    smallest = solutions[0]
    second_smallest = solutions[1]

    # Calculate the sum
    result = smallest + second_smallest

    # Return the result in the required format
    return f"\\boxed{{{result}}}"

