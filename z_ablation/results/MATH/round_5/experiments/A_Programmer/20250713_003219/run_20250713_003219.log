            power = prime
            # Count how many times prime is a factor in n!
            while power <= n:
                count += n // power
                power *= prime
            # Calculate the number of complete sets of prime factors
            min_zeros = min(min_zeros, count // exponent)
        
        return min_zeros
    
    # Calculate the number of trailing zeros in 10! in base 11
    result = trailing_zeros_in_factorial_base(10, 11)
    
