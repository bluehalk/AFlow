import numpy as np

def solve():
    # Define the parameters for the plane P
    v0 = np.array([1, 6, 7])  # Point on the plane
    d1 = np.array([2, -1, -1])  # Direction vector 1
    d2 = np.array([2, -3, -5])  # Direction vector 2

    # Define the parameters for the line L
    w0 = np.array([7, 4, 1])  # Point on the line
    d3 = np.array([3, 0, -1])  # Direction vector of the line

    # Set up the equations for the intersection
    # The plane equation can be expressed as:
    # v0 + t * d1 + s * d2 = w0 + u * d3
    # Rearranging gives:
    # t * d1 + s * d2 - u * d3 = w0 - v0

    # Define the coefficients for the system of equations
    A = np.array([d1, d2, -d3]).T  # Coefficient matrix
    b = w0 - v0  # Right-hand side vector

    # Solve the system of equations
    try:
        # Use least squares to find a solution
        solution, residuals, rank, s = np.linalg.lstsq(A, b, rcond=None)
        t, s, u = solution

        # Calculate the intersection point
        intersection_point = v0 + t * d1 + s * d2

        return f"\\boxed{{{intersection_point[0]}, {intersection_point[1]}, {intersection_point[2]}}}"
    except np.linalg.LinAlgError:
        return "\\boxed{No intersection}"

