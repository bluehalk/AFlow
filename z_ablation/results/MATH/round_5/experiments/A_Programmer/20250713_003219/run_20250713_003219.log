import sympy as sp

def solve():
    # Define the variable k
    k = sp.symbols('k')
    
    # Define the coefficients of the system of equations
    A = sp.Matrix([
        [1, k, -1],
        [k, -1, -1],
        [1, 1, -k]
    ])
    
    # Calculate the determinant of the matrix A
    det_A = A.det()
    
    # Solve for k where the determinant is zero (non-trivial solutions)
    k_values = sp.solve(det_A, k)
    
    # Format the result in LaTeX notation
    result = r'\boxed{' + ', '.join(map(str, k_values)) + '}'
    
    return result

