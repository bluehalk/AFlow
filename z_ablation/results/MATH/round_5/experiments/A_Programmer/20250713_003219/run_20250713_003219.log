    A_y = 4 + 3*t
    
    # Parameterization of line m
    B_x = -5 + 4*s
    B_y = 6 + 3*s
    
    # Vector BA
    BA_x = A_x - B_x
    BA_y = A_y - B_y
    
    # Direction vector of line m
    direction_m = sp.Matrix([4, 3])
    
    # Normal vector to line m (perpendicular)
    normal_m = sp.Matrix([-3, 4])
    
    # Find the foot of the perpendicular P from A to line m
    # We need to solve for s such that the vector BA is perpendicular to the direction of line m
    # This means BA . direction_m = 0
    equation = sp.Eq(BA_x * direction_m[0] + BA_y * direction_m[1], 0)
    
    # Solve for s
    s_value = sp.solve(equation, s)[0]
    
    # Substitute s_value back to find B
    B_x_value = B_x.subs(s, s_value)
    B_y_value = B_y.subs(s, s_value)
    
    # Now we have point B, we can find point P
    # P is the projection of A onto line m
    # We can find the projection of vector BA onto the normal vector
