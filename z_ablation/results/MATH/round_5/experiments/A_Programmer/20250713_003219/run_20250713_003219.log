import math

def solve():
    # We need to find the largest possible value of gcd(2m, 3n)
    # where m = 24n + 51
    
    # Express m in terms of n
    # m = 24n + 51
    # Therefore, 2m = 2(24n + 51) = 48n + 102
    # And we have 3n as it is.
    
    # We need to find gcd(48n + 102, 3n)
    
    # Let's denote:
    # A = 48n + 102
    # B = 3n
    
    # We can use the property of gcd:
    # gcd(A, B) = gcd(A - kB, B) for any integer k
    # We can choose k = 16 (since 48/3 = 16)
    
    # A - 16B = (48n + 102) - 16(3n) = 48n + 102 - 48n = 102
    # So, gcd(48n + 102, 3n) = gcd(102, 3n)
    
    # Now we need to find the maximum value of gcd(102, 3n)
    # The gcd will be a divisor of 102.
    
    # Find the divisors of 102
    divisors = []
    for i in range(1, int(math.sqrt(102)) + 1):
        if 102 % i == 0:
            divisors.append(i)
            if i != 102 // i:
                divisors.append(102 // i)
    
    # The divisors of 102 are: 1, 2, 3, 6, 17, 34, 51, 102
    # We want the largest divisor that can be expressed as 3n
    # This means we need to check which of these divisors is a multiple of 3.
    
    max_gcd = 0
    for d in divisors:
        if d % 3 == 0:
            max_gcd = max(max_gcd, d)
    
    # Return the result in the required format
    return f"\\boxed{{{max_gcd}}}"

