def solve():
    # Define the set S of points (a, b) where a and b can be -1, 0, or 1
    S = [(a, b) for a in [-1, 0, 1] for b in [-1, 0, 1]]
    
    # Set to store unique lines represented by their slope and intercept
    lines = set()
    
    # Function to calculate the slope and intercept of the line through two points
    def line_from_points(p1, p2):
        x1, y1 = p1
        x2, y2 = p2
        
        # Handle vertical line case
        if x1 == x2:
            return ('inf', x1)  # 'inf' represents a vertical line with x = x1
        
        # Calculate slope (m) and y-intercept (b)
        slope = (y2 - y1) / (x2 - x1)
        intercept = y1 - slope * x1
        
        return (slope, intercept)
    
    # Iterate through all pairs of points in S
    for i in range(len(S)):
        for j in range(i + 1, len(S)):
            line = line_from_points(S[i], S[j])
            lines.add(line)
    
    # The number of distinct lines is the size of the set
    return f"\\boxed{{{len(lines)}}}"

# Call the solve function and print the result
print(solve())
