def solve():
    # Total outcomes when rolling 5 six-sided dice
    total_outcomes = 6 ** 5
    
    # Calculate the number of outcomes where all dice show different numbers
    # The first die can show any of the 6 numbers
    # The second die can show any of the remaining 5 numbers
    # The third die can show any of the remaining 4 numbers
    # The fourth die can show any of the remaining 3 numbers
    # The fifth die can show any of the remaining 2 numbers
    different_outcomes = 6 * 5 * 4 * 3 * 2
    
    # The probability of all dice showing different numbers
    probability_different = different_outcomes / total_outcomes
    
    # The probability of at least two dice showing the same number
    probability_at_least_two_same = 1 - probability_different
    
    # Format the result in LaTeX notation
    result = f"\\boxed{{{probability_at_least_two_same}}}"
    
    return result

