\[Ax + By + Cz + D = 0,\]where $A,$ $B,$ $C,$ $D$ are integers such that $A > 0$ and $\gcd(|A|,|B|,|C|,|D|) = 1.$

2025-07-13 00:33:36 - INFO - ```python
import numpy as np
from sympy import gcd

def solve():
    # Coefficients of the first plane 3x - 6y + 2z + 5 = 0
    A1, B1, C1, D1 = 3, -6, 2, 5
    # Coefficients of the second plane 4x - 12y + 3z - 3 = 0
    A2, B2, C2, D2 = 4, -12, 3, -3
    
    # Normal vectors of the planes
    n1 = np.array([A1, B1, C1])
    n2 = np.array([A2, B2, C2])
    
    # Calculate the angle bisector normal vector
    n_bisector = n1 / np.linalg.norm(n1) + n2 / np.linalg.norm(n2)
    
    # Point that the bisector plane must contain
    point = np.array([-5, -1, -5])
    
    # The equation of the plane can be written as:
    # n_bisector . (x - point) = 0
    # which expands to:
    # n_bisector[0] * (x + 5) + n_bisector[1] * (y + 1) + n_bisector[2] * (z + 5) = 0
    
    A, B, C = n_bisector
    D = -(A * point[0] + B * point[1] + C * point[2])
    
    # Convert to integers
    A, B, C, D = map(int, np.round([A, B, C, D]))
    
    # Ensure A > 0 and gcd(|A|, |B|, |C|, |D|) = 1
    if A < 0:
        A, B, C, D = -A, -B, -C, -D
    
    common_gcd = gcd(abs(A), abs(B), abs(C), abs(D))
    A //= common_gcd
    B //= common_gcd
    C //= common_gcd
    D //= common_gcd
    
    # Format the result
    result = f"{A}x + {B}y + {C}z + {D} = 0"
    
    return f"\\boxed{{{result}}}"

# Call the solve function and print the result
print(solve())
