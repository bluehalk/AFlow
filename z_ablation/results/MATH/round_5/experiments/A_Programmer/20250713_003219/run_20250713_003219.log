def solve():
    # Number of 12th roots of unity
    n = 12
    
    # Set to store unique values of (a + b)^12
    unique_values = set()
    
    # Generate all 12th roots of unity
    roots_of_unity = [complex(cos(2 * pi * k / n), sin(2 * pi * k / n)) for k in range(n)]
    
    # Iterate over all pairs (a, b) of roots of unity
    for a in roots_of_unity:
        for b in roots_of_unity:
            # Calculate a + b
            sum_ab = a + b
            # Calculate (a + b)^12
            value = sum_ab ** 12
            # Store the real part of the value in the set
            unique_values.add(value)
    
    # The number of unique values of (a + b)^12
    result = len(unique_values)
    
    # Return the result in the required format
    return f"\\boxed{{{result}}}"

# Call the solve function and print the result
print(solve())
