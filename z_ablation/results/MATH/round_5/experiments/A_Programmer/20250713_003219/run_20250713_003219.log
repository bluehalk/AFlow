def solve():
    from math import floor

    # Function to calculate the largest power of p that divides n!
    def largest_power_of_p_in_factorial(n, p):
        count = 0
        power = p
        while power <= n:
            count += n // power
            power *= p
        return count

    # We need to find the largest n such that 15^n divides 942!
    # 15 = 3 * 5, so we need to find the minimum of the powers of 3 and 5 in 942!
    n = 942
    power_of_3 = largest_power_of_p_in_factorial(n, 3)
    power_of_5 = largest_power_of_p_in_factorial(n, 5)

    # The largest n such that 15^n divides 942! is the minimum of these two powers
    result = min(power_of_3, power_of_5)

    return f"\\boxed{{{result}}}"

