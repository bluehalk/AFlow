def is_prime(n):
    """Check if a number is prime."""
    if n <= 1:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

def solve():
    """Calculate the product of all prime numbers between 1 and 100 and return the remainder when divided by 16."""
    product = 1
    for num in range(2, 101):
        if is_prime(num):
            product *= num
    
    remainder = product % 16
    return f"\\boxed{{{remainder}}}"

