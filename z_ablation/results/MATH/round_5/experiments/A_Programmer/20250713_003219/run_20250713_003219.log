import math
from sympy import factorint

def solve():
    # Step 1: Define the number to simplify
    number = 2940
    
    # Step 2: Factor the number into its prime factors
    factors = factorint(number)
    
    # Step 3: Calculate the square root by taking out pairs of prime factors
    radicand = 1
    outside_sqrt = 1
    
    for prime, exponent in factors.items():
        pairs = exponent // 2
        radicand *= prime ** pairs
        outside_sqrt *= prime ** (exponent % 2)
    
    # Step 4: Construct the final result
    if outside_sqrt == 1:
        result = f"\\boxed{{{radicand}}}"
    else:
        result = f"\\boxed{{{outside_sqrt} \\sqrt{{{radicand}}}}}"
    
    return result

# Call the solve function and print the result
print(solve())
