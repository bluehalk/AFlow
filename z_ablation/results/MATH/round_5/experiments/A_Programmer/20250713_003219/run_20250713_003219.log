import numpy as np

def solve():
    # Define points A, B, and C
    A = np.array([1, 8, 4])
    B = np.array([0, -1, 3])
    C = np.array([2, -3, -1])
    
    # Calculate the direction vector of the line BC
    BC = C - B
    
    # Calculate the vector from B to A
    BA = A - B
    
    # Project BA onto BC to find the foot of the perpendicular
    BC_norm = np.dot(BC, BC)
    projection_length = np.dot(BA, BC) / BC_norm
    foot_of_perpendicular = B + projection_length * BC
    
    # Format the result in LaTeX notation
    result = f"\\boxed{{({foot_of_perpendicular[0]}, {foot_of_perpendicular[1]}, {foot_of_perpendicular[2]})}}"
    
    return result

