def solve():
    # Given time
    hour = 2
    minute = 48
    
    # Calculate the position of the hour hand
    # Each hour is 30 degrees (360 degrees / 12 hours)
    # Each minute contributes 0.5 degrees to the hour hand (30 degrees / 60 minutes)
    hour_angle = (hour % 12) * 30 + (minute / 60) * 30
    
    # Calculate the position of the minute hand
    # Each minute is 6 degrees (360 degrees / 60 minutes)
    minute_angle = minute * 6
    
    # Calculate the difference between the two angles
    angle_difference = abs(hour_angle - minute_angle)
    
    # The smaller angle is the minimum of the angle difference and its supplement
    smaller_angle = min(angle_difference, 360 - angle_difference)
    
    # Return the result in LaTeX boxed format
    return f"\\boxed{{{smaller_angle}}}"

# Call the solve function and print the result
print(solve())
