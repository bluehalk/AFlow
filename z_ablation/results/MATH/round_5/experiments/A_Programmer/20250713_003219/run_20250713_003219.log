from math import comb

def solve():
    # Total number of dice
    total_dice = 6
    
    # We want exactly 2 dice to show a 1 and exactly 2 dice to show a 2
    count_1 = 2
    count_2 = 2
    
    # The remaining dice (6 - 2 - 2 = 2) can show any of the numbers 3, 4, 5, or 6
    remaining_dice = total_dice - count_1 - count_2
    
    # Total outcomes when rolling 6 dice
    total_outcomes = 6 ** total_dice
    
    # Calculate the number of favorable outcomes
    favorable_outcomes = (comb(total_dice, count_1) *  # Choose 2 dice to show 1
                         comb(total_dice - count_1, count_2) *  # Choose 2 of the remaining 4 to show 2
                         (4 ** remaining_dice))  # Remaining 2 dice can show 3, 4, 5, or 6
    
    # Probability calculation
    probability = favorable_outcomes / total_outcomes
    
    # Return the result in LaTeX format
    return f"\\boxed{{{favorable_outcomes}/{total_outcomes}}}"

