def solve():
    # We need to find the smallest integer x such that 12 / (x + 1) is an integer.
    # This means that (x + 1) must be a divisor of 12.
    
    # Finding all divisors of 12
    divisors = [1, 2, 3, 4, 6, 12]
    
    # We need to find the smallest x such that x + 1 is a divisor of 12
    # This means x = d - 1 for each divisor d
    smallest_x = float('inf')  # Start with a large number
    
    for d in divisors:
        x = d - 1
        if x < smallest_x:
            smallest_x = x
    
    # Return the result in the required format
    return f"\\boxed{{{smallest_x}}}"

# Call the solve function and print the result
print(solve())
