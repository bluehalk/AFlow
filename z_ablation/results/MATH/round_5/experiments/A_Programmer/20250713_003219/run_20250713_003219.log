def solve():
    # Number of rows and columns on the chessboard
    n = 8
    
    # Calculate the number of ways to place two pieces in the same row
    # For each row, we can choose 2 out of 8 columns
    ways_in_same_row = n * (n * (n - 1) // 2)
    
    # Calculate the number of ways to place two pieces in the same column
    # For each column, we can choose 2 out of 8 rows
    ways_in_same_column = n * (n * (n - 1) // 2)
    
    # Total ways is the sum of both cases
    total_ways = ways_in_same_row + ways_in_same_column
    
    # Return the result in the required format
    return f"\\boxed{{{total_ways}}}"

