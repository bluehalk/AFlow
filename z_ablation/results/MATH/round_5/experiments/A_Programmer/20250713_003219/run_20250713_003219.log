def solve():
    from math import gcd, lcm

    # Given values
    target_gcd = 2
    target_lcm = 108

    # Since gcd(m, n) = 2, we can express m and n as:
    # m = 2a and n = 2b where gcd(a, b) = 1
    # Therefore, lcm(m, n) = (m * n) / gcd(m, n) = (2a * 2b) / 2 = 2ab
    # We need to satisfy: 2ab = 108 => ab = 54

    ab_target = target_lcm // target_gcd  # This gives us 54

    # Now we need to find pairs (a, b) such that a * b = 54 and gcd(a, b) = 1
    count = 0

    # Find all pairs (a, b) such that a * b = 54
    for a in range(1, int(ab_target**0.5) + 1):
        if ab_target % a == 0:
            b = ab_target // a
            # Check if gcd(a, b) = 1
            if gcd(a, b) == 1:
                count += 1  # (a, b) is a valid pair
                if a != b:
                    count += 1  # (b, a) is also a valid pair

    # Each valid (a, b) corresponds to a unique (m, n) = (2a, 2b)
    result = count

    return f"\\boxed{{{result}}}"

