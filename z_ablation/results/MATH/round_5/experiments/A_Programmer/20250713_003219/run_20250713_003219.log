def solve():
    # Given m as a product of prime factors
    m = {
        2: 1980,
        3: 384,
        5: 1694,
        7: 343
    }
    
    # We need to find the smallest n such that mn is a perfect k-th power for some k >= 2
    # This means that for each prime factor, the exponent in the prime factorization of mn
    # must be divisible by k.
    
    # To find the smallest n, we need to determine the maximum exponent in m
    # and find the smallest k such that all exponents in m + n are divisible by k.
    
    # Initialize the maximum exponent
    max_exponent = max(m.values())
    
    # We will find the smallest k such that all exponents are divisible by k
    # This means we need to find the gcd of all the exponents
    from math import gcd
    from functools import reduce
    
    # Calculate the gcd of all the exponents
    exponents = list(m.values())
    overall_gcd = reduce(gcd, exponents)
    
    # Now we need to find the smallest n
    # For each prime factor, we need to make its exponent a multiple of k
    n = 1
    for prime, exponent in m.items():
        # We need to make exponent + additional_exponent a multiple of k
        # additional_exponent = (k - (exponent % k)) % k
        # We can find the smallest additional_exponent needed
        additional_exponent = (overall_gcd - (exponent % overall_gcd)) % overall_gcd
        n *= prime ** additional_exponent
    
    # The smallest k is overall_gcd
    k = overall_gcd
    
    # We need to return n + k
    result = n + k
    
    return f"\\boxed{{{result}}}"

