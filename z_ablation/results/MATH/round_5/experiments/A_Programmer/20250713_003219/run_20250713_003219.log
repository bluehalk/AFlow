    # Total number of cards in the deck
    total_cards = 54
    
    # The two jokers can be placed in any two of the 54 positions
    # The number of ways to choose 2 positions from 54
    from math import comb
    ways_to_choose_jokers = comb(total_cards, 2)
    
    # The expected number of cards between the two jokers
    expected_cards_between = 0
    
    # The number of cards that can be between the two jokers can range from 0 to 52
    for k in range(0, 53):  # k is the number of cards between the jokers
        # The number of ways to choose 2 positions for the jokers with k cards between them
        # The first joker can be placed in position 1 to (52 - k)
        # The second joker will then be in position (1 + k) to (53 - k)
        ways_to_place_jokers = (total_cards - k - 1) * (total_cards - k - 2) // 2
        
        # Each configuration contributes k cards between the jokers
        expected_cards_between += k * ways_to_place_jokers
    
    # Calculate the expected value
    expected_value = expected_cards_between / ways_to_choose_jokers
    
    # Format the result in LaTeX notation
    return f"\\boxed{{{expected_value}}}"

