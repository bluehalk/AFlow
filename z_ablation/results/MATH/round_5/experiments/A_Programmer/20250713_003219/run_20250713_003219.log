def solve():
    # Gear 1 turns 33 1/3 times per minute
    gear1_turns_per_minute = 33 + 1/3  # Convert to improper fraction
    # Gear 2 turns 45 times per minute
    gear2_turns_per_minute = 45

    # Convert turns per minute to turns per second
    gear1_turns_per_second = gear1_turns_per_minute / 60
    gear2_turns_per_second = gear2_turns_per_minute / 60

    # Find the time it takes for both gears to align again
    # We need to find the least common multiple (LCM) of the two turn rates
    from math import gcd

    # Function to calculate LCM
    def lcm(a, b):
        return abs(a * b) // gcd(a, b)

    # Convert turns per second to a common denominator for LCM calculation
    gear1_turns = gear1_turns_per_second * 60  # turns in 1 minute
    gear2_turns = gear2_turns_per_second * 60  # turns in 1 minute

    # Calculate LCM of the two turn counts
    lcm_turns = lcm(int(gear1_turns), int(gear2_turns))

    # Calculate the time in seconds for the next alignment
    time_seconds = lcm_turns / gear1_turns_per_minute  # time in minutes
    time_seconds *= 60  # convert to seconds

    # Return the result in the required format
    return f"\\boxed{{{int(time_seconds)}}}"

