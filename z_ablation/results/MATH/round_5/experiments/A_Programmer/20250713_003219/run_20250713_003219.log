    product_mn = GCD * LCM  # This is m * n

    # We can express m and n as:
    # m = 8a and n = 8b where gcd(a, b) = 1
    # Then LCM(m, n) = (m * n) / GCD(m, n) = (8a * 8b) / 8 = 8ab
    # We need 8ab = 112 => ab = 14

    ab = LCM // GCD  # This gives us the product of a and b
    least_sum = float('inf')

    # We need to find pairs (a, b) such that a * b = 14 and gcd(a, b) = 1
    for a in range(1, int(ab**0.5) + 1):
        if ab % a == 0:
            b = ab // a
            if gcd(a, b) == 1:
                # Calculate m and n
                m = GCD * a
                n = GCD * b
                least_sum = min(least_sum, m + n)

    return f"\\boxed{{{least_sum}}}"

