    prob_A = [comb(flips_A, k) * (0.5 ** flips_A) for k in range(flips_A + 1)]
    
    # Calculate the probability distribution for coin B (4 flips)
    prob_B = [comb(flips_B, k) * (0.5 ** flips_B) for k in range(flips_B + 1)]
    
    # Calculate the probability that the number of heads is the same
    probability_same_heads = sum(prob_A[k] * prob_B[k] for k in range(min(flips_A, flips_B) + 1))
    
