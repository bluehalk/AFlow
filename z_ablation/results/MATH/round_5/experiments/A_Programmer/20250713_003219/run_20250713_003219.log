from math import factorial
from collections import Counter

def prime_factors(n):
    """Return the prime factorization of n as a Counter."""
    i = 2
    factors = Counter()
    while i * i <= n:
        while (n % i) == 0:
            factors[i] += 1
            n //= i
        i += 1
    if n > 1:
        factors[n] += 1
    return factors

def count_cubes(factor_counts):
    """Count how many positive cubes can be formed from the prime factor counts."""
    count = 1
    for exponent in factor_counts.values():
        count *= (exponent // 3) + 1
    return count

def solve():
    # Calculate the factorials
    factorials_product = factorial(3) * factorial(5) * factorial(7)
    
    # Get the prime factorization of the product
    factors = prime_factors(factorials_product)
    
    # Count the number of positive cubes
    result = count_cubes(factors)
    
    # Return the result in LaTeX format
    return f"\\boxed{{{result}}}"

# Call the solve function and print the result
print(solve())
