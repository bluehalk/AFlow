def solve():
    # We need to find a two-digit integer m such that:
    # 1. 6^{-1} mod m exists
    # 2. 6^{-1} ≡ 6^2 mod m
    
    # The modular inverse exists if and only if gcd(6, m) = 1
    # This means m must not have 2 or 3 as factors.
    
    # We will check all two-digit integers from 10 to 99
    for m in range(10, 100):
        if m % 2 != 0 and m % 3 != 0:  # m must be coprime to 6
            # Calculate 6^2 mod m
            six_squared = (6 ** 2) % m
            
            # We need to find the modular inverse of 6 mod m
            # Using Extended Euclidean Algorithm to find the inverse
            def extended_gcd(a, b):
                if a == 0:
                    return b, 0, 1
                gcd, x1, y1 = extended_gcd(b % a, a)
                x = y1 - (b // a) * x1
                y = x1
                return gcd, x, y
            
            gcd, x, _ = extended_gcd(6, m)
            if gcd == 1:  # Inverse exists
                inverse_6 = x % m
                if inverse_6 == six_squared:  # Check the condition
                    return f"\\boxed{{{m}}}"

# Call the solve function and print the result
print(solve())
