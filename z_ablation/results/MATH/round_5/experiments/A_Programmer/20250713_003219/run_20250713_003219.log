from itertools import permutations

def is_adjacent(pos1, pos2):
    """Check if two positions are adjacent (including diagonally)."""
    return abs(pos1[0] - pos2[0]) <= 1 and abs(pos1[1] - pos2[1]) <= 1

def count_valid_arrangements(beads):
    """Count valid arrangements of beads on the grid."""
    grid_positions = [(i, j) for i in range(3) for j in range(3)]
    total_count = 0
    
    for perm in permutations(beads):
        purple_pos = perm.index('purple')
        green_pos = perm.index('green')
        
        if not is_adjacent(grid_positions[purple_pos], grid_positions[green_pos]):
            total_count += 1
            
    return total_count

def solve():
    # Define the beads
    beads = ['purple', 'green'] + [f'bead{i}' for i in range(7)]
    
    # Count valid arrangements
    valid_arrangements = count_valid_arrangements(beads)
    
    # Since the grid can be rotated and reflected, we need to divide by the number of symmetries
    # There are 8 symmetries for a 3x3 grid (4 rotations and 4 reflections)
    symmetries = 8
    final_count = valid_arrangements // symmetries
    
    return f"\\boxed{{{final_count}}}"

# Call the solve function and print the result
print(solve())
