def solve():
    # We need to find the smallest integer greater than 200
    # such that gcd(integer, 36) = 18.
    
    # The GCD of a number with 36 being 18 means that the number
    # must be a multiple of 18 and also must not have any prime factors
    # that would increase the GCD beyond 18 when combined with 36.
    
    # The multiples of 18 are: 18, 36, 54, 72, 90, 108, 126, 144, 162, 180, 198, 216, ...
