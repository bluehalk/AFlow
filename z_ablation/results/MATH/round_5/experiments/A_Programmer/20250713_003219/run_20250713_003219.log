    a = np.array([1, 3, 0])
    b = np.array([-11, 5, 2])
    c = np.array([1 + np.sqrt(5), 4, -5])
    
    # Calculate a + b + c
    sum_vector = a + b + c
    
    # Calculate the cross products
    b_cross_c = np.cross(b, c)
    c_cross_a = np.cross(c, a)
