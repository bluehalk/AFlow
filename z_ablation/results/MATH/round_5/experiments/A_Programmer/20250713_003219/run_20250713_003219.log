def is_prime(n):
    """Check if a number is prime."""
    if n <= 1:
        return False
    if n <= 3:
        return True
    if n % 2 == 0 or n % 3 == 0:
        return False
    i = 5
    while i * i <= n:
        if n % i == 0 or n % (i + 2) == 0:
            return False
        i += 6
    return True

def solve():
    """Calculate the sum of primes between 100 and 200 that are 1 or 2 more than a perfect square."""
    total_sum = 0
    for n in range(100, 201):
        if is_prime(n):
            # Check if n is 1 or 2 more than a perfect square
            sqrt_n = int(n**0.5)
            if (sqrt_n**2 + 1 == n) or (sqrt_n**2 + 2 == n):
                total_sum += n
    return f"\\boxed{{{total_sum}}}"

