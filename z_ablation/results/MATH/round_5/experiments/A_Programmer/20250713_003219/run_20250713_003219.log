import itertools

def solve():
    # Define the ranges for each column
    col1 = list(range(1, 16))    # 1-15
    col2 = list(range(16, 31))    # 16-30
    col3 = list(range(31, 46))    # 31-45 (WILD in the middle)
    col4 = list(range(46, 61))    # 46-60
    col5 = list(range(61, 76))    # 61-75

    # Select 5 numbers from col1, 5 from col2, 4 from col3, 5 from col4, and 5 from col5
    combinations = (
        itertools.combinations(col1, 5),
        itertools.combinations(col2, 5),
        itertools.combinations(col3, 4),
        itertools.combinations(col4, 5),
        itertools.combinations(col5, 5)
    )

    # Calculate the number of ways to choose the numbers for each column
    total_combinations = 1
    for comb in combinations:
        total_combinations *= sum(1 for _ in comb)

    # The diagonal from top left to bottom right consists of:
    # - 1 from col1
    # - 1 from col2
    # - 1 from col3 (WILD)
    # - 1 from col4
    # - 1 from col5
    # The number of distinct possibilities for the diagonal is the product of the choices
    diagonal_possibilities = (
        len(list(itertools.combinations(col1, 1))) *
        len(list(itertools.combinations(col2, 1))) *
        len(list(itertools.combinations(col3, 1))) *
        len(list(itertools.combinations(col4, 1))) *
        len(list(itertools.combinations(col5, 1)))
    )

    # The total number of distinct possibilities for the diagonal
    result = total_combinations * diagonal_possibilities

    return f"\\boxed{{{result}}}"

# Call the solve function and print the result
print(solve())
