    theta_start = 0
    theta_end = 2 * np.pi
    
    # Calculate the area swept by the curve when rotated around the point (2, 0)
    area = area_of_swept_region(r, theta_start, theta_end)
    
    # Return the result in the required format
    return f"\\boxed{{{area}}}"

