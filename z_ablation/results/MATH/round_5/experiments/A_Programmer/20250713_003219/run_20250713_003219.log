def solve():
    # Distances from point P to the vertices of the octahedron
    distances = [3, 7, 8, 9, 11]
    
    # The formula for the distance from point P to the sixth vertex
    # in a regular octahedron is derived from the property of distances
    # to the vertices. The sum of the squares of the distances to all
    # vertices is constant.
    
    # Calculate the sum of the squares of the given distances
    sum_of_squares = sum(d ** 2 for d in distances)
    
    # The distance to the sixth vertex (d6) can be found using the
    # property of the octahedron. The sum of the squares of the distances
    # to the vertices is equal to 5 * d^2, where d is the distance from
    # the center of the octahedron to any vertex.
    
    # The distance from the center to a vertex of a regular octahedron
    # with edge length a is given by the formula: sqrt(3/2) * a.
    # However, we can directly calculate the sixth distance using the
    # derived relationship:
    
    # Let d6 be the distance to the sixth vertex
    # Then we have: sum_of_squares + d6^2 = 5 * d^2
    # We can find d6^2 = 5 * d^2 - sum_of_squares
    
    # Since we don't have the edge length, we can assume the distances
    # are relative and find d6 directly.
    
    # The sixth distance can be calculated as follows:
    d6_squared = 5 * (sum(distances) / 5) ** 2 - sum_of_squares
    d6 = d6_squared ** 0.5
    
