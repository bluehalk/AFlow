import numpy as np

def solve():
    # Define the vector onto which we are projecting
    v = np.array([[1], [7]])
    
    # Calculate the projection matrix P
    # P = (v * v^T) / (v^T * v)
    v_dot_vT = np.dot(v, v.T)  # Outer product
    vT_dot_v = np.dot(v.T, v)  # Inner product (scalar)
    
    P = v_dot_vT / vT_dot_v  # Projection matrix
    
    # Format the result in LaTeX notation
    result = f"\\boxed{{{P[0, 0]:.4f}, {P[0, 1]:.4f}, {P[1, 0]:.4f}, {P[1, 1]:.4f}}}"
    
    return result

