def solve():
    # We need to find k, the number of positive integers less than 2^n that are invertible modulo 2^n.
    # A number is invertible modulo 2^n if it is odd, which means it has to be coprime to 2^n.
    
    # The count of odd numbers less than 2^n is exactly half of 2^n.
    # Therefore, k = 2^n / 2 = 2^(n-1).
    
    # We also need to find n such that 2^n ≡ 3 (mod 13).
    # We will compute powers of 2 modulo 13 until we find the correct n.
    
    n = 0
    power_of_2 = 1  # This is 2^0 % 13
    
    while power_of_2 != 3:
        n += 1
        power_of_2 = (power_of_2 * 2) % 13
    
    # Now we have found n such that 2^n ≡ 3 (mod 13).
    # Calculate k = 2^(n-1)
    k = 2 ** (n - 1)
    
    # We need to find k mod 13
    result = k % 13
    
    # Return the result in the required format
    return f"\\boxed{{{result}}}"

# Call the solve function and print the result
print(solve())
