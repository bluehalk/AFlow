import math

def solve():
    # Define the side lengths of the triangle
    a = 5  # Length of side BC
    b = 6  # Length of side AC
    c = 7  # Length of side AB

    # Calculate the circumradius R of triangle ABC
    # Using the formula R = (abc) / (4 * K), where K is the area of the triangle
    # First, we calculate the semi-perimeter
    s = (a + b + c) / 2
    
    # Calculate the area K using Heron's formula
    K = math.sqrt(s * (s - a) * (s - b) * (s - c))
    
    # Calculate the circumradius R
    R = (a * b * c) / (4 * K)

    # Calculate the common value
    common_value = (a**2 + b**2 + c**2) / 2 + 3 * R**2

    # Return the result in the required format
    return f"\\boxed{{{common_value}}}"

