import numpy as np
from fractions import Fraction
from math import gcd
from functools import reduce

def solve():
    # Define the reflection matrix
    reflection_matrix = np.array([
        [-2/3, -2/3, -1/3],
        [-2/3, 1/3, 2/3],
        [-1/3, 2/3, -2/3]
    ])
    
    # Calculate the eigenvalues and eigenvectors
    eigenvalues, eigenvectors = np.linalg.eig(reflection_matrix)
    
    # The eigenvalue corresponding to the direction vector of line l is 1
    # Find the eigenvector corresponding to the eigenvalue 1
    direction_vector = eigenvectors[:, np.isclose(eigenvalues, 1)].flatten()
    
    # Convert the direction vector to integers
    direction_vector = np.round(direction_vector * 3).astype(int)  # Scale to avoid fractions
    
    # Ensure the first component is positive and reduce by gcd
    a, b, c = direction_vector
    if a < 0:
        direction_vector = -direction_vector
    elif a == 0 and b < 0:
        direction_vector = -direction_vector
    
    # Reduce by gcd
    common_divisor = reduce(gcd, map(abs, direction_vector))
    direction_vector //= common_divisor
    
    # Format the output
    result = f"\\boxed{{\\begin{{pmatrix}} {direction_vector[0]} \\\\ {direction_vector[1]} \\\\ {direction_vector[2]} \\end{{pmatrix}}}}"
    
    return result

