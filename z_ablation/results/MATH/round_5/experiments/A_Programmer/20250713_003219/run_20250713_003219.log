def determinant(n):
    if n == 1:
        return 10
    elif n == 2:
        return 10 * 10 - 3 * 3
    else:
        # Using a recurrence relation to calculate the determinant
        D = [0] * (n + 1)
        D[1] = 10
        D[2] = 10 * 10 - 3 * 3
        for i in range(3, n + 1):
            D[i] = 10 * D[i - 1] - 3 * 3 * D[i - 2]
        return D[n]

def solve():
    total_sum = 0
    n = 1
    while True:
        D_n = determinant(n)
        term = 1 / (8 * D_n + 1)
        total_sum += term
        n += 1
        # Break condition to avoid infinite loop, we can limit n to a reasonable number
        if n > 100:  # Arbitrary limit for convergence
            break
    return f"\\boxed{{{total_sum}}}"

