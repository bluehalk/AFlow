def base3_to_decimal(base3_str):
    """Convert a base 3 string to a decimal integer."""
    return int(base3_str, 3)

def decimal_to_base3(decimal_num):
    """Convert a decimal integer to a base 3 string."""
    if decimal_num == 0:
        return '0'
    base3_str = ''
    while decimal_num > 0:
        base3_str = str(decimal_num % 3) + base3_str
        decimal_num //= 3
    return base3_str

def solve():
    # Given base 3 numbers
    num1 = '121'
    num2 = '2122'
    num3 = '1200'
    num4 = '2111'
    
    # Convert base 3 numbers to decimal
    dec_num1 = base3_to_decimal(num1)
    dec_num2 = base3_to_decimal(num2)
    dec_num3 = base3_to_decimal(num3)
    dec_num4 = base3_to_decimal(num4)
    
    # Perform the calculation
    result_decimal = dec_num1 + dec_num2 - dec_num3 - dec_num4
    
    # Convert the result back to base 3
    result_base3 = decimal_to_base3(result_decimal)
    
    # Return the result in LaTeX boxed format
    return f"\\boxed{{{result_base3}}}"

