    orange = 3
    black = 3
    teal = 1
    
    # Total number of beads
    n = orange + black + teal  # 3 + 3 + 1 = 7
    
    # Function to calculate factorial
    def factorial(x):
        if x == 0 or x == 1:
            return 1
        result = 1
        for i in range(2, x + 1):
            result *= i
        return result
    
    # Calculate the number of distinct arrangements considering rotations and reflections
    # Using Burnside's lemma for counting distinct arrangements under group actions
    def count_bracelets(n, counts):
        # Counts is a list of counts of each type of bead
        total_count = factorial(n)
        for count in counts:
            total_count //= factorial(count)
        
        # Calculate the number of symmetries (rotations and reflections)
        symmetries = 0
        
        # Rotations
        for k in range(n):
            symmetries += total_count // n  # Each rotation gives the same arrangement
        
        # Reflections
        if n % 2 == 0:
            symmetries += total_count // (n // 2) * (n // 2)  # n/2 reflections
        else:
            symmetries += total_count // n * n  # n reflections
        
        # Total distinct arrangements
        return symmetries // (2 * n)  # Divide by 2 for reflections
    
    # Counts of each bead type
    counts = [orange, black, teal]
    
    # Calculate the number of distinct bracelets
    result = count_bracelets(n, counts)
    
    # Return the result in LaTeX format
    return f"\\boxed{{{result}}}"

