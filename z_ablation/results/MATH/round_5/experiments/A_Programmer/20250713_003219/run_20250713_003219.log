import numpy as np
from scipy.optimize import fsolve

def equation(x):
    return np.tan(7 * x) - np.sin(6 * x) - (np.cos(4 * x) - 1/np.tan(7 * x))

def solve():
    # Define the range for x
    x_values = np.linspace(0, 2 * np.pi, 1000)
    
    # Find the roots of the equation
    roots = []
    for x in x_values:
        root = fsolve(equation, x)
        if 0 <= root[0] <= 2 * np.pi and root[0] not in roots:
            roots.append(root[0])
    
    # Format the results in LaTeX notation
    formatted_roots = [f"{root:.6f}" for root in sorted(roots)]
    result = r"\boxed{" + ", ".join(formatted_roots) + "}"
    
    return result

# Call the solve function and print the result
print(solve())
