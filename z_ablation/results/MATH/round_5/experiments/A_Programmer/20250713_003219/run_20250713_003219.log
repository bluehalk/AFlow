def solve():
    from itertools import permutations

    # Define the numbers we are working with
    numbers = [1, 2, 3, 4, 5, 6]

    # Function to check if a permutation is valid
    def is_valid(permutation):
        for i in range(len(permutation)):
            current = permutation[i]
            # Check all divisors of current
            for j in range(1, current):
                if current % j == 0 and j not in permutation[:i]:
                    return False
        return True

    # Count valid permutations
    valid_count = 0
    for perm in permutations(numbers):
        if is_valid(perm):
            valid_count += 1

    # Return the result in the required format
    return f"\\boxed{{{valid_count}}}"

