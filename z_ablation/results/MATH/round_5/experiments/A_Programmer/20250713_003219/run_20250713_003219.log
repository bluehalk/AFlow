def solve():
    # Given values
    a = 14
    b = 46
    m = 100
    
    # We need to solve the congruence 14u ≡ 46 (mod 100)
    # This can be rewritten as 14u - 100k = 46 for some integer k
    # Rearranging gives us 14u = 46 + 100k
    # We can find u by isolating it: u = (46 + 100k) / 14
    
    # First, we need to find the modular inverse of 14 modulo 100
    def extended_gcd(a, b):
        if a == 0:
            return b, 0, 1
        gcd, x1, y1 = extended_gcd(b % a, a)
        x = y1 - (b // a) * x1
        y = x1
        return gcd, x, y
    
    gcd, x, y = extended_gcd(a, m)
    
    # Check if the gcd divides b
    if b % gcd != 0:
        return "No solutions"
    
    # Scale the solution
    a //= gcd
    b //= gcd
    m //= gcd
    
    # Find the modular inverse of a modulo m
    _, inv_a, _ = extended_gcd(a, m)
    inv_a = inv_a % m
    
    # Find the particular solution
    u0 = (inv_a * b) % m
    
    # Generate the two smallest positive solutions
    solutions = []
    for k in range(2):
        u = (u0 + k * m) % (m * gcd)
        if u > 0:
            solutions.append(u)
    
    # Calculate the average of the two smallest positive solutions
    average = sum(solutions) / len(solutions)
    
    # Return the result in the required format
    return f"\\boxed{{{average}}}"

