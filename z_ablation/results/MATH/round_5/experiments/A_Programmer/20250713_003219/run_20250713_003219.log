    z1 = complex(-5, 3)  # -5 + 3i
    z2 = complex(8, -1)  # 8 - i

    # Calculate the midpoint of z1 and z2
    midpoint = (z1 + z2) / 2

    # Calculate the distance between z1 and z2
    distance = abs(z2 - z1)

    # Calculate the height of the equilateral triangle
    height = (distance * cmath.sqrt(3)) / 2

    # Calculate the two possible positions for c (c1 and c2)
    # Rotate z2 around the midpoint by 60 degrees and -60 degrees
    angle_60 = cmath.exp(complex(0, cmath.pi / 3))  # e^(i * 60 degrees)
    angle_neg_60 = cmath.exp(complex(0, -cmath.pi / 3))  # e^(i * -60 degrees)

    c1 = midpoint + (height * angle_60)
    c2 = midpoint + (height * angle_neg_60)

    # Calculate the product c1 * c2
    product = c1 * c2

    # Return the result in the required format
    return f"\\boxed{{{product}}}"

