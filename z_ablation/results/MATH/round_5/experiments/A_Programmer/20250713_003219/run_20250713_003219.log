    point1 = np.array([3, -10, 1])
    direction1 = np.array([2, -9, -2])
    
    point2 = np.array([-5, -3, 6])
    direction2 = np.array([4, -18, -4])
    
    # Calculate the vector between the two points
    vector_between = point2 - point1
    
    # Calculate the cross product of the direction vectors
    cross_product = np.cross(direction1, direction2)
    
    # If the cross product is zero, the lines are parallel
    if np.all(cross_product == 0):
        # Calculate the distance using the formula |(P2 - P1) . (d1 x d2)| / |d1 x d2|
        numerator = np.abs(np.dot(vector_between, cross_product))
        denominator = np.linalg.norm(cross_product)
        
        # Calculate the distance
        distance = numerator / denominator
        return f"\\boxed{{{distance}}}"
    else:
        return "The lines are not parallel."

