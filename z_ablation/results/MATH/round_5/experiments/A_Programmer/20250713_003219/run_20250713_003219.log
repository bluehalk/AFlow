def solve():
    # We need to find the 1000th positive integer with an odd number of digits.
    
    # Odd digit counts are: 1, 3, 5, 7, 9, ...
    # The ranges for these digit counts are:
    # 1 digit: 1 to 9 (9 numbers)
    # 3 digits: 100 to 999 (900 numbers)
    # 5 digits: 10000 to 99999 (90000 numbers)
    # 7 digits: 1000000 to 9999999 (9000000 numbers)
    # 9 digits: 100000000 to 999999999 (900000000 numbers)
    
    # We will accumulate the counts of numbers with odd digits until we reach 1000.
    
    count = 0
    digit_length = 1
    
    while True:
        if digit_length == 1:
            numbers_in_this_range = 9  # 1 to 9
        elif digit_length == 3:
            numbers_in_this_range = 900  # 100 to 999
        elif digit_length == 5:
            numbers_in_this_range = 90000  # 10000 to 99999
        elif digit_length == 7:
            numbers_in_this_range = 9000000  # 1000000 to 9999999
        elif digit_length == 9:
            numbers_in_this_range = 900000000  # 100000000 to 999999999
        
        if count + numbers_in_this_range >= 1000:
            # The 1000th number is in this range
            position_in_range = 1000 - count
            if digit_length == 1:
                result = position_in_range  # 1 to 9
            elif digit_length == 3:
                result = 100 + (position_in_range - 1)  # 100 to 999
            elif digit_length == 5:
                result = 10000 + (position_in_range - 1)  # 10000 to 99999
            elif digit_length == 7:
                result = 1000000 + (position_in_range - 1)  # 1000000 to 9999999
            elif digit_length == 9:
                result = 100000000 + (position_in_range - 1)  # 100000000 to 999999999
            break
        
        count += numbers_in_this_range
        digit_length += 2  # Move to the next odd digit length
    
    return f"\\boxed{{{result}}}"

# Call the solve function and print the result
print(solve())
