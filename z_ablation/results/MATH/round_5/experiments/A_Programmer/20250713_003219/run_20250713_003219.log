def solve():
    # Given data
    DC = 5  # Length of segment DC on hypotenuse BC
    
    # In an isosceles right triangle, let the legs be of length 'x'.
    # The hypotenuse BC can be calculated using the Pythagorean theorem:
    # BC = x * sqrt(2)
    
    # The altitude AD divides the hypotenuse BC into two segments: BD and DC.
    # Let BD = y, then BC = BD + DC = y + 5.
    
    # Using the property of the altitude in a right triangle:
    # AD^2 = BD * DC
    # AD^2 = y * 5
    
    # The length of the altitude AD can also be expressed in terms of the legs:
    # AD = (x * sqrt(2)) / 2  (since AD is the altitude to the hypotenuse)
    
    # Therefore, we have:
    # ((x * sqrt(2)) / 2)^2 = y * 5
    # (x^2 * 2) / 4 = y * 5
    # x^2 / 2 = y * 5
    # y = x^2 / (10)
    
    # Now, we also know that:
    # y + 5 = x * sqrt(2)
    # (x^2 / 10) + 5 = x * sqrt(2)
    
    # Multiplying through by 10 to eliminate the fraction:
    # x^2 + 50 = 10 * x * sqrt(2)
    
    # Rearranging gives us a quadratic equation:
    # x^2 - 10 * x * sqrt(2) + 50 = 0
    
    from math import sqrt
    
    # Coefficients of the quadratic equation
    a = 1
    b = -10 * sqrt(2)
    c = 50
    
    # Using the quadratic formula to find x
    discriminant = b**2 - 4 * a * c
    x1 = (-b + sqrt(discriminant)) / (2 * a)
    x2 = (-b - sqrt(discriminant)) / (2 * a)
    
    # We take the positive root since lengths must be positive
    x = max(x1, x2)
    
    # Area of triangle ABC
    area = (x * x) / 2  # Area = 1/2 * base * height, where base = height = x
    
    # Return the area in the required format
    return f"\\boxed{{{area}}}"

