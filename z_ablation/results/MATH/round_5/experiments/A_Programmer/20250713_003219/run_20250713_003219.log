import math

def solve():
    # Calculate the right-hand side of the equation
    cos_96 = math.cos(math.radians(96))
    sin_96 = math.sin(math.radians(96))
    
    rhs = (cos_96 + sin_96) / (cos_96 - sin_96)
    
    # We need to find the smallest positive integer x such that tan(19x) = rhs
    # tan(theta) = rhs implies theta = arctan(rhs) + k * 180 for any integer k
    # We will solve for x in degrees: 19x = arctan(rhs) + k * 180
    # Thus, x = (arctan(rhs) + k * 180) / 19
    
    # Calculate arctan(rhs) in degrees
    theta = math.degrees(math.atan(rhs))
    
    # We will check for k = 0, 1, 2, ... until we find the smallest positive integer x
    k = 0
    while True:
        x = (theta + k * 180) / 19
        if x > 0 and x.is_integer():
            return f"\\boxed{{{int(x)}}}"
        k += 1

# Call the solve function and print the result
print(solve())
