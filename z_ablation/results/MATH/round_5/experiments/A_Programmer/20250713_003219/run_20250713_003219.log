    k_arm = 3
    
    # Calculate the probability of exactly 2 red spots
    prob_red = comb(n, k_red) * (p_red ** k_red) * (p_other ** (n - k_red))
    
    # Calculate the probability of exactly 3 arms
    prob_arm = comb(n, k_arm) * (p_arm ** k_arm) * (p_leg ** (n - k_arm))
    
    # Since the events are independent, multiply the probabilities
    final_probability = prob_red * prob_arm
    
    # Format the result in LaTeX notation
    return f"\\boxed{{{final_probability:.6f}}}"

