def solve():
    # Number of Democrats and Republicans
    num_democrats = 5
    num_republicans = 5
    
    # Treat the two groups (Democrats and Republicans) as single units
    # There are 2 groups to arrange (Dems and Reps)
    # In a circular arrangement, (n-1)! arrangements are possible
    # Here, n = 2 (the two groups)
    arrangements_of_groups = (2 - 1)!  # which is 1! = 1
    
    # Now, within each group, the members can be arranged
    # Democrats can be arranged in 5! ways
    arrangements_of_democrats = factorial(num_democrats)
    
    # Republicans can also be arranged in 5! ways
    arrangements_of_republicans = factorial(num_republicans)
    
    # Total arrangements = arrangements of groups * arrangements of democrats * arrangements of republicans
    total_arrangements = arrangements_of_groups * arrangements_of_democrats * arrangements_of_republicans
    
    # Format the result in LaTeX notation
    result = f"\\boxed{{{total_arrangements}}}"
    
    return result

# Helper function to calculate factorial
def factorial(n):
    if n == 0 or n == 1:
        return 1
    result = 1
    for i in range(2, n + 1):
        result *= i
    return result

# Call the solve function and print the result
print(solve())
