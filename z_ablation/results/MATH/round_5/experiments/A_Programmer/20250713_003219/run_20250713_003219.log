def solve():
    # Function to find all divisors of a number
    def find_divisors(n):
        divisors = []
        for i in range(1, int(n**0.5) + 1):
            if n % i == 0:
                divisors.append(i)
                if i != n // i:
                    divisors.append(n // i)
        return divisors

    # Function to check if a number is composite
    def is_composite(num):
        if num < 4:  # The smallest composite number is 4
            return False
        for i in range(2, int(num**0.5) + 1):
            if num % i == 0:
                return True
        return False

    # Step 1: Find all divisors of 72
    divisors_of_72 = find_divisors(72)

    # Step 2: Filter out the composite numbers from the divisors
    composite_divisors = [d for d in divisors_of_72 if is_composite(d)]

    # Step 3: Calculate the number of subsets of composite divisors
    # The number of subsets of a set with n elements is 2^n
    number_of_composite_divisors = len(composite_divisors)
    number_of_subsets = 2 ** number_of_composite_divisors

    # Step 4: Return the result in the required format
    return f"\\boxed{{{number_of_subsets}}}"

# Call the solve function and print the result
print(solve())
