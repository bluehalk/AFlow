def solve():
    # A number has exactly three distinct positive integer divisors if and only if
    # it is the square of a prime number. This is because if p is a prime, then
    # the divisors of p^2 are {1, p, p^2}, which are exactly three.
    
    # We need to find all prime numbers p such that p^2 < 1000.
    limit = 1000
    primes = []
    
    # Sieve of Eratosthenes to find all primes less than sqrt(1000)
    max_check = int(limit**0.5) + 1
    is_prime = [True] * (max_check + 1)
    is_prime[0] = is_prime[1] = False  # 0 and 1 are not primes
    
    for num in range(2, max_check + 1):
        if is_prime[num]:
            primes.append(num)
            for multiple in range(num * num, max_check + 1, num):
                is_prime[multiple] = False
    
    # Count how many primes have their square less than 1000
    count = 0
    for prime in primes:
        if prime * prime < limit:
            count += 1
    
    # Return the result in the required format
    return f"\\boxed{{{count}}}"

# Call the solve function and print the result
print(solve())
