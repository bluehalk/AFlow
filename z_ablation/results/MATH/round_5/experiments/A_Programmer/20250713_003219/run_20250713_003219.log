    b_negative_min, b_negative_max = -2, 0
    area_negative_a_b = (a_negative_max - a_negative_min) * (b_negative_max - b_negative_min)
    
    # Total area where a * b is positive
    positive_area = area_positive_a_b + area_negative_a_b
    
    # Calculate the probability
    probability = positive_area / total_area
    
