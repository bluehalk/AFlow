        # Check if the root is within the desired range and not already found
        if 0 <= root <= 2 * np.pi and all(abs(root - r) > 1e-5 for r in roots):
            roots.append(root)
    
    # Format the results in LaTeX notation
    formatted_roots = ', '.join(f'{root:.6f}' for root in sorted(roots))
    return f'\\boxed{{{formatted_roots}}}'

