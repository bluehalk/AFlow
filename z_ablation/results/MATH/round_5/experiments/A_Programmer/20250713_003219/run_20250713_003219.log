import numpy as np

def solve():
    # Define the points
    origin = np.array([0, 0, 0])
    end_point = np.array([1, 0, 0])
    
    # Define the line through points (0,0,1) and (1,1,1)
    point1 = np.array([0, 0, 1])
    point2 = np.array([1, 1, 1])
    
    # Direction vector of the line
    direction = point2 - point1
    
    # Parametric representation of the line
    # A point on the line can be represented as: point_on_line(t) = point1 + t * direction
    # where t is a parameter
    
    # We need to minimize the distance from origin to point_on_line(t) and then to end_point
    # The distance function D can be expressed as:
    # D(t) = ||origin - point_on_line(t)|| + ||point_on_line(t) - end_point||
    
    # We will minimize D(t) by finding the optimal t
    # The point on the line can be expressed as:
    # point_on_line(t) = (t, t, 1) for t in [0, 1]
    
    # Define the distance function
    def distance_squared(t):
        point_on_line = np.array([t, t, 1])
        distance_to_origin = np.linalg.norm(origin - point_on_line)
        distance_to_end = np.linalg.norm(point_on_line - end_point)
        return distance_to_origin**2 + distance_to_end**2
    
    # We will use a simple grid search to find the minimum distance squared
    # over the interval [0, 1]
    t_values = np.linspace(0, 1, 100)
    min_distance_squared = float('inf')
    
    for t in t_values:
        dist_sq = distance_squared(t)
        if dist_sq < min_distance_squared:
            min_distance_squared = dist_sq
    
    # Return the result in the required format
    return f"\\boxed{{{min_distance_squared}}}"

# Call the solve function and print the result
print(solve())
