def area_of_swept_region(r_func, theta_start, theta_end):
    # Calculate the area swept by the polar curve when rotated around a point
    # The area A of a polar curve r(θ) from θ=a to θ=b is given by:
    # A = 1/2 * ∫[a to b] (r(θ))^2 dθ
    area, _ = quad(lambda theta: 0.5 * (r_func(theta) ** 2), theta_start, theta_end)
