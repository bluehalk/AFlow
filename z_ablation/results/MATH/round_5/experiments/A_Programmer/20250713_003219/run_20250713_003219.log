    hugs_per_week = n
    
    # Calculate the minimum weeks required for all pairs to hug at least once
    weeks = total_pairs // hugs_per_week
    
    # If there are any remaining pairs, we need an additional week
    if total_pairs % hugs_per_week != 0:
        weeks += 1
    
    # Return the result in the required format
    return f"\\boxed{{{weeks}}}"

