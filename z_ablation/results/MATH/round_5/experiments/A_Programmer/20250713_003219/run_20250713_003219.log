from math import comb

def solve():
    # Number of trials (rolls)
    n = 5
    # Probability of rolling a 6
    p = 1/6
    # Probability of not rolling a 6
    q = 1 - p
    
    # Calculate the probability of getting at most 2 sixes
    probability = 0
    for k in range(3):  # k = 0, 1, 2
        probability += comb(n, k) * (p ** k) * (q ** (n - k))
    
    # Format the result in LaTeX notation
    return f"\\boxed{{{probability:.6f}}}"

