                    prime_factors[i] += 1
                else:
                    prime_factors[i] = 1
                b //= i
        
        # If b is still greater than 2, then it must be prime
        if b > 2:
            prime_factors[b] = 1
        
        # Calculate the number of trailing zeros for each prime factor
        min_zeros = float('inf')
        for prime, exponent in prime_factors.items():
