    def deg_to_rad(deg):
        return deg * (math.pi / 180)
    
    # Calculate the necessary trigonometric values
    cos_5 = math.cos(deg_to_rad(5))
    cos_20 = math.cos(deg_to_rad(20))
    cos_35 = math.cos(deg_to_rad(35))
    cos_50 = math.cos(deg_to_rad(50))
    
    sin_5 = math.sin(deg_to_rad(5))
    sin_20 = math.sin(deg_to_rad(20))
    sin_35 = math.sin(deg_to_rad(35))
    sin_50 = math.sin(deg_to_rad(50))
    
    # Calculate the numerator and denominator
    numerator = (cos_5 * cos_20 + cos_35 * cos_50 - 
                 sin_5 * sin_20 - sin_35 * sin_50)
    
    denominator = (sin_5 * cos_20 - sin_35 * cos_50 + 
                   cos_5 * sin_20 - cos_35 * sin_50)
    
    # Calculate tan(theta)
    tan_theta = numerator / denominator
    
    # Calculate theta in degrees
    theta = math.degrees(math.atan(tan_theta))
    
    # Ensure we return the least positive angle
    if theta < 0:
        theta += 180  # Adjust to get the least positive angle
    
    return f"\\boxed{{{theta}}}"

