import numpy as np

def determinant_matrix(x):
    # Calculate the elements of the matrix based on the given x
    sec2_x = 1 / np.cos(x)**2
    cos2_x = np.cos(x)**2
    csc2_x = 1 / np.sin(x)**2
    cot2_x = np.cos(x)**2 / np.sin(x)**2
    
    # Construct the matrix
    matrix = np.array([[sec2_x, 1, 1],
                       [cos2_x, cos2_x, csc2_x],
                       [1, cos2_x, cot2_x]])
    
    # Calculate the determinant
    return np.linalg.det(matrix)

def solve():
    # We will evaluate the determinant for a range of x values
    # to find all possible values of the determinant
    x_values = np.linspace(0, 2 * np.pi, 1000)  # Sample points in the range [0, 2π]
    det_values = set()  # Use a set to store unique determinant values
    
    for x in x_values:
        try:
            det = determinant_matrix(x)
            det_values.add(det)
        except Exception as e:
            # Handle any potential errors (like division by zero)
            continue
    
    # Convert the set to a sorted list
    unique_dets = sorted(det_values)
    
    # Format the output in LaTeX notation
    return r"\boxed{" + ", ".join(map(str, unique_dets)) + "}"

# Call the solve function and print the result
result = solve()
print(result)
