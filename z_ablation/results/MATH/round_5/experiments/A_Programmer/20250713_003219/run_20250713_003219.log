import numpy as np
from scipy.integrate import quad

def area_of_swept_region():
    # Define the polar curve r = 1 + cos(theta)
    def r(theta):
        return 1 + np.cos(theta)

    # The area swept by rotating the curve around the point (2, 0)
    # The area of the region swept by the curve can be calculated using the formula:
    # Area = 1/2 * ∫ (r(θ)^2) dθ from θ = 0 to θ = 2π
    def integrand(theta):
        return r(theta)**2

    # Calculate the integral from 0 to 2π
    area, _ = quad(integrand, 0, 2 * np.pi)

    # The area of the region swept is given by the formula
    swept_area = area / 2

    return f"\\boxed{{{swept_area}}}"

def solve():
    return area_of_swept_region()

# Call the solve function and print the result
print(solve())
