    # Step 3: Simplify the equation
    a //= g
    b //= g
    m //= g
    
    # Step 4: Find the modular inverse of a mod m
    def mod_inverse(a, m):
        # Extended Euclidean Algorithm to find the inverse
        m0, x0, x1 = m, 0, 1
        if m == 1:
            return 0
        while a > 1:
            # q is quotient
            q = a // m
            m, a = a % m, m
            x0, x1 = x1 - q * x0, x0
        if x1 < 0:
            x1 += m0
        return x1
    
    inv_a = mod_inverse(a, m)
    
    # Step 5: Find the particular solution
    x0 = (inv_a * b) % m
    
    # Step 6: General solution
    # x = x0 + k * (m / g) for k = 0, 1, 2, ...
    # We need to find k such that 0 < x <= 100
    count = 0
    step = m // g
    
    # Calculate the range of k
    for k in range(0, (100 - x0) // step + 1):
        x = x0 + k * step
        if 0 < x <= 100:
            count += 1
    
    return r"\boxed{" + str(count) + "}"

