    # We need to find the largest number less than upper_limit that satisfies the condition
    # x ≡ target_congruence (mod modulus)
    
    # The largest number less than upper_limit that is congruent to target_congruence
    largest_congruent = upper_limit - 1 - (upper_limit - 1 - target_congruence) % modulus
    
    # Now we need to count how many such numbers exist
    # The numbers that are congruent to target_congruence can be expressed as:
    # target_congruence, target_congruence + modulus, target_congruence + 2*modulus, ...
    # We need to find the largest k such that:
    # target_congruence + k * modulus < upper_limit
    
    # Rearranging gives us:
    # k < (upper_limit - target_congruence) / modulus
    count = (largest_congruent - target_congruence) // modulus + 1
    
    # Return the result in the required format
