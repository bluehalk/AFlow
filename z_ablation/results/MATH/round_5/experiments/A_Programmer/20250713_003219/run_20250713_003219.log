def solve():
    from itertools import combinations
    from math import isqrt

    # The target product
    target_product = 2310

    # Function to get the prime factors of a number
    def prime_factors(n):
        factors = {}
        for i in range(2, isqrt(n) + 1):
            while n % i == 0:
                if i in factors:
                    factors[i] += 1
                else:
                    factors[i] = 1
                n //= i
        if n > 1:
            factors[n] = 1
        return factors

    # Get the prime factors of 2310
    factors = prime_factors(target_product)
    
    # Generate all distinct divisors of the target product
    divisors = set()
    def generate_divisors(current_divisor, prime_list, index):
        if index == len(prime_list):
            divisors.add(current_divisor)
            return
        prime, count = prime_list[index]
        for exponent in range(count + 1):
            generate_divisors(current_divisor * (prime ** exponent), prime_list, index + 1)

    prime_list = list(factors.items())
    generate_divisors(1, prime_list, 0)

    # Convert divisors to a sorted list
    divisors = sorted(divisors)

    # Count valid three-element sets
    count = 0
    n = len(divisors)
    for i in range(n):
        for j in range(i + 1, n):
            for k in range(j + 1, n):
                if divisors[i] * divisors[j] * divisors[k] == target_product:
                    count += 1

    return f"\\boxed{{{count}}}"

