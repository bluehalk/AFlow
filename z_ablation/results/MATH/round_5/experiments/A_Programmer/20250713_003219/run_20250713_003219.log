from sympy import factorint

def solve():
    # Calculate the product of the square roots
    product = math.sqrt(56) * math.sqrt(126)
    
    # Simplify the product
    simplified = math.sqrt(56 * 126)
    
    # Factor the product to find a and b
    factors = factorint(56 * 126)
    
    # Calculate a and b
    a = 1
    b = 1
    
    for prime, exponent in factors.items():
        # If exponent is even, it contributes to a
        if exponent % 2 == 0:
            a *= prime ** (exponent // 2)
        # If exponent is odd, it contributes to b
        else:
            a *= prime ** (exponent // 2)
            b *= prime
    
    # Calculate a + b
    result = a + b
    
