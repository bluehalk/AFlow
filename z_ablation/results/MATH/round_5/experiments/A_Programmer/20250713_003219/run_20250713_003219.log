def solve():
    # We need to find the modular inverse of 17 modulo 83
    a = 17
    m = 83
    
    # Using the Extended Euclidean Algorithm to find the inverse
    def extended_gcd(a, b):
        if a == 0:
            return b, 0, 1
        gcd, x1, y1 = extended_gcd(b % a, a)
        x = y1 - (b // a) * x1
        y = x1
        return gcd, x, y
    
    gcd, x, y = extended_gcd(a, m)
    
    # Since we want the inverse, we need to ensure gcd is 1
    if gcd != 1:
        raise ValueError("Inverse does not exist")
    
    # x is the modular inverse, but it might be negative
    inverse = x % m
    
    # Return the result in the required format
    return f"\\boxed{{{inverse}}}"

