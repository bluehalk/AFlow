import cmath

def solve():
    # Define the complex numbers
    z1 = complex(-5, 3)  # -5 + 3i
    z2 = complex(8, -1)  # 8 - i

    # Calculate the midpoint of z1 and z2
    midpoint = (z1 + z2) / 2

    # Calculate the distance between z1 and z2
    distance = abs(z2 - z1)

    # Calculate the height of the equilateral triangle
    height = (distance * cmath.sqrt(3)) / 2

    # Calculate the angle to rotate (60 degrees in radians)
    angle = cmath.pi / 3

    # Calculate the two possible positions for c1 and c2
    c1 = midpoint + cmath.rect(height, angle)
    c2 = midpoint + cmath.rect(height, -angle)

    # Calculate the product c1 * c2
    product = c1 * c2

    # Return the result formatted in LaTeX notation
    return f"\\boxed{{{product}}}"

