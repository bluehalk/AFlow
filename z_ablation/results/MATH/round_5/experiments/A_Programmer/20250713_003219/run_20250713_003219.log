import random

def is_obtuse(a, b, c):
    # Sort the sides to ensure a <= b <= c
    sides = sorted([a, b, c])
    # Check if the triangle is obtuse
    return sides[0]**2 + sides[1]**2 < sides[2]**2

def solve():
    trials = 1000000  # Number of trials for Monte Carlo simulation
    obtuse_count = 0

    for _ in range(trials):
        x1 = random.uniform(0, 1)
        x2 = random.uniform(0, 1)
        if is_obtuse(x1, x2, 1):
            obtuse_count += 1

    p = obtuse_count / trials
    result = 4 * p
    return f"\\boxed{{{result}}}"

