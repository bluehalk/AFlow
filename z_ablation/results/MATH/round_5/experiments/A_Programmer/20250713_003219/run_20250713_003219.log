def solve():
    # Total outcomes when rolling two four-sided dice
    total_outcomes = 4 * 4  # 4 sides on the first die * 4 sides on the second die
    
    # Winning scenarios
    win_one = 0  # Winning $1 (number appears on one die)
    win_two = 0  # Winning $2 (number appears on both dice)
    lose = 0     # Losing $1 (number does not appear on either die)
    
    # Iterate through all possible outcomes of the two dice
    for die1 in range(1, 5):
        for die2 in range(1, 5):
            if die1 == die2:
                win_two += 1  # Both dice show the same number
            else:
                win_one += 1  # One die shows the chosen number, the other does not
    
    # Each number from 1 to 4 has the same probability
    # Calculate expected return for one roll
    expected_return = (win_one * 1 + win_two * 2 - lose * 1) / total_outcomes
    
    # Format the result as a fraction
    from fractions import Fraction
    result = Fraction(expected_return).limit_denominator()
    
    return f"\\boxed{{{result}}}"

