    # Given relationships:
    # rb = 4 * lb (four times as many right-handed boys as left-handed boys)
    # lg = 2 * lb (twice as many left-handed girls as left-handed boys)
    # lg = 0.5 * (lg + rg) (half of the girls are left-handed)
    
    # Total number of people on the team
    total_people = 36
    
    # From the relationships, we can express everything in terms of lb
    # Let lb = x
    lb = 'x'  # left-handed boys
    rb = f'4 * {lb}'  # right-handed boys
    lg = f'2 * {lb}'  # left-handed girls
    rg = f'2 * {lg}'  # right-handed girls (since lg = 0.5 * (lg + rg))
    
    # Total equation:
    # lb + rb + lg + rg = total_people
    # x + 4x + 2x + 2(2x) = 36
    # x + 4x + 2x + 4x = 36
    # 11x = 36
    # x = 36 / 11
    
