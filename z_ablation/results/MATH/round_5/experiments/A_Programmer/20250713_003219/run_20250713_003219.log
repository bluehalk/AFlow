import math

def solve():
    # Given values
    AB = 20  # length of AB in cm
    angle_A = 30  # angle A in degrees
    angle_C = 45  # angle C in degrees

    # Calculate angle B using the fact that the sum of angles in a triangle is 180 degrees
    angle_B = 180 - angle_A - angle_C  # angle B in degrees

    # Convert angles from degrees to radians for trigonometric calculations
    angle_A_rad = math.radians(angle_A)
    angle_B_rad = math.radians(angle_B)
    angle_C_rad = math.radians(angle_C)

    # Using the Law of Sines to find the length of BC
    # BC / sin(A) = AB / sin(B)
    # Therefore, BC = AB * (sin(A) / sin(B))
    BC = AB * (math.sin(angle_A_rad) / math.sin(angle_B_rad))

    # Return the result in the required format
    return f"\\boxed{{{BC:.2f}}}"

