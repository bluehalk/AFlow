2025-07-13 00:33:01 - INFO - ```python
def count_paths(start, end, steps):
    from collections import defaultdict

    # Initialize a dictionary to count paths to each point
    paths = defaultdict(int)
    paths[start] = 1  # Start at the origin with one path

    # Directions for moving up, down, left, right
    directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]

    for _ in range(steps):
        new_paths = defaultdict(int)
        for (x, y), count in paths.items():
            for dx, dy in directions:
                new_paths[(x + dx, y + dy)] += count
        paths = new_paths

    return paths[end]

def solve():
    # Define the points for M, A, T, H
    M = (0, 0)
    A_points = [(1, 0), (-1, 0), (0, 1), (0, -1)]
    T_points = [(2, 0), (1, 1), (0, 2), (-1, 1), (-2, 0), (-1, -1), (0, -2), (1, -1)]
    H_points = [(3, 0), (2, 1), (1, 2), (0, 3), (-1, 2), (-2, 1), (-3, 0), (-2, -1), (-1, -2), (0, -3), (1, -2), (2, -1)]

    # Calculate paths for M -> A -> T -> H
    total_paths = 1
    total_paths *= count_paths(M, A_points[0], 1)  # M to A (1 step)
    total_paths *= sum(count_paths(A_points[0], point, 2) for point in A_points[1:])  # A to A (2 steps)
    total_paths *= sum(count_paths(A_points[0], point, 2) for point in T_points)  # A to T (2 steps)
    total_paths *= sum(count_paths(T_points[0], point, 3) for point in H_points)  # T to H (3 steps)

