import numpy as np

def solve():
    # Given lengths
    AB = 3
    AC = 5
    
    # Using the Law of Cosines to find the length of BC
    # Let angle A be θ, then:
    # BC^2 = AB^2 + AC^2 - 2 * AB * AC * cos(θ)
    # We need to find OA · BC, where O is the circumcenter.
    
    # For triangle ABC, we can place points A, B, and C in a coordinate system.
    # Let's place A at the origin (0, 0), B at (3, 0), and C at some point (x, y).
    
    A = np.array([0, 0])
    B = np.array([3, 0])
    
    # To find C, we need to satisfy the distance AC = 5
    # Let C = (x, y), then:
    # AC^2 = x^2 + y^2 = 5^2 = 25
    # AB^2 = (x - 3)^2 + y^2 = 3^2 = 9
    
    # From AC^2:
    # x^2 + y^2 = 25  (1)
    
    # From AB^2:
    # (x - 3)^2 + y^2 = 9
    # Expanding this gives:
    # x^2 - 6x + 9 + y^2 = 9
    # x^2 + y^2 - 6x + 9 = 9
    # x^2 + y^2 - 6x = 0
    # Substitute (1) into this:
    # 25 - 6x = 0
    # 6x = 25
    # x = 25 / 6
    
    x = 25 / 6
    # Now substitute x back into (1) to find y:
    # (25/6)^2 + y^2 = 25
    # y^2 = 25 - 625/36
    # y^2 = 900/36 - 625/36
    # y^2 = 275/36
    # y = sqrt(275)/6
    
    y = np.sqrt(275) / 6
    
    C = np.array([x, y])
    
    # Now we need to find the circumcenter O of triangle ABC.
    # The circumcenter O can be found as the intersection of the perpendicular bisectors of the sides.
    
    # Midpoint of AB
    M_AB = (A + B) / 2
    
    # Slope of AB
    slope_AB = (B[1] - A[1]) / (B[0] - A[0]) if (B[0] - A[0]) != 0 else np.inf
    
    # Perpendicular slope
    if slope_AB == 0:
        slope_perpendicular_AB = np.inf
    else:
        slope_perpendicular_AB = -1 / slope_AB
    
    # Midpoint of AC
    M_AC = (A + C) / 2
    
    # Slope of AC
    slope_AC = (C[1] - A[1]) / (C[0] - A[0]) if (C[0] - A[0]) != 0 else np.inf
    
    # Perpendicular slope
    if slope_AC == 0:
        slope_perpendicular_AC = np.inf
    else:
        slope_perpendicular_AC = -1 / slope_AC
    
    # Now we can find the equations of the lines
    # For line through M_AB with slope_perpendicular_AB
    if slope_perpendicular_AB == np.inf:
        O_x = M_AB[0]
        O_y = slope_perpendicular_AC * (O_x - M_AC[0]) + M_AC[1]
    else:
        # y - y1 = m(x - x1)
        # y = slope_perpendicular_AB * (x - M_AB[0]) + M_AB[1]
        # For line through M_AC with slope_perpendicular_AC
        # y = slope_perpendicular_AC * (x - M_AC[0]) + M_AC[1]
        # Set them equal to find O
        # slope_perpendicular_AB * (x - M_AB[0]) + M_AB[1] = slope_perpendicular_AC * (x - M_AC[0]) + M_AC[1]
        # Solve for x and then find y
        
        # This is a bit complex, let's use numpy to solve the system of equations
        A_matrix = np.array([[1, -slope_perpendicular_AB], [1, -slope_perpendicular_AC]])
        B_matrix = np.array([M_AB[1] - slope_perpendicular_AB * M_AB[0], M_AC[1] - slope_perpendicular_AC * M_AC[0]])
        
        O_x, O_y = np.linalg.solve(A_matrix, B_matrix)
    
    O = np.array([O_x, O_y])
    
    # Now we need to find OA · BC
    OA = A - O
    BC = C - B
    
    dot_product = np.dot(OA, BC)
    
    # Return the result in the required format
    return f"\\boxed{{{dot_product}}}"

# Call the solve function and print the result
print(solve())
