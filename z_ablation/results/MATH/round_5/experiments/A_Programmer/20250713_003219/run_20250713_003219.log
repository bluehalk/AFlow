import numpy as np

def solve():
    # Define the equations for points P and Q
    # P is on the line y = -x + 1 in the xy-plane
    # Q is on the line z = -2x + 1 in the xz-plane
    
    # We can express P and Q in terms of a parameter t
    # Let x = t, then:
    # For point P: 
    # P(t) = (t, -t + 1, 0)
    # For point Q:
    # Q(t) = (t, 0, -2t + 1)
    
    # The distance PQ can be calculated using the distance formula
    # Distance PQ = sqrt((x2 - x1)^2 + (y2 - y1)^2 + (z2 - z1)^2)
    
    # Substitute P(t) and Q(t) into the distance formula
    # Distance PQ = sqrt((t - t)^2 + (0 - (-t + 1))^2 + ((-2t + 1) - 0)^2)
    # Simplifying this gives:
    # Distance PQ = sqrt(0 + (t - 1)^2 + (-2t + 1)^2)
    
    # Expanding the distance formula
    # Distance PQ = sqrt((t - 1)^2 + (4t^2 - 4t + 1))
    # = sqrt(5t^2 - 6t + 2)
    
    # To find the minimum distance, we can complete the square or use calculus
    # The function f(t) = 5t^2 - 6t + 2 is a quadratic function
    # The vertex of a quadratic ax^2 + bx + c is at x = -b/(2a)
    
    a = 5
    b = -6
    vertex_t = -b / (2 * a)  # t = 6 / 10 = 0.6
    
    # Calculate the minimum distance at t = 0.6
    min_distance_squared = 5 * (vertex_t ** 2) - 6 * vertex_t + 2
    
    # The minimum distance is the square root of the minimum distance squared
    min_distance = np.sqrt(min_distance_squared)
    
    # Format the result in LaTeX notation
    return f"\\boxed{{{min_distance}}}"

