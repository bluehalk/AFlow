        # Calculate the right-hand side of the equation
        right_side = np.cos(theta_rad) - 0.5
        
        # Check if the left side is approximately equal to the right side
        if np.isclose(left_side, right_side, atol=1e-5):
            solutions.append(round(theta, 6))  # Round to avoid floating point issues

    # Format the solutions in LaTeX boxed format
    formatted_solutions = ', '.join(f"{sol:.6f}" for sol in solutions)
    return f"\\boxed{{{formatted_solutions}}}"

