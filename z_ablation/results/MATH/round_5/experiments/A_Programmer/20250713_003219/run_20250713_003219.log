def solve():
    # Function to find all nice numbers in the range 2010 to 2019
    nice_numbers = set()
    
    # Check each number in the range
    for n in range(2010, 2020):
        # A number m has exactly four positive divisors if it is of the form p^3 or p*q
        # where p and q are distinct primes.
        
        # Check for the form p^3
        for p in range(1, int(n**(1/3)) + 2):
            if p > 1:
                m = p**3
                if m > 0 and m <= n:
                    # The divisors are 1, p, p^2, p^3
                    sum_divisors = 1 + p + p**2 + m
                    if sum_divisors == n:
                        nice_numbers.add(n)
        
        # Check for the form p*q
        for p in range(1, int(n**0.5) + 2):
            if p > 1:
                for q in range(p + 1, n // p + 1):
                    if p * q > n:
                        break
                    # The divisors are 1, p, q, p*q
                    sum_divisors = 1 + p + q + p * q
                    if sum_divisors == n:
                        nice_numbers.add(n)

    # Calculate the sum of all nice numbers found
    result = sum(nice_numbers)
    
    # Return the result in the required format
    return f"\\boxed{{{result}}}"

