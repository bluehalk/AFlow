from itertools import permutations
from fractions import Fraction

def is_divisible_by_11(num):
    # Convert number to string to access digits
    s = str(num)
    # Calculate the alternating sum
    alternating_sum = sum(int(s[i]) if i % 2 == 0 else -int(s[i]) for i in range(len(s)))
    # Check divisibility by 11
    return alternating_sum % 11 == 0

def solve():
    digits = [2, 3, 4, 7, 8]
    total_count = 0
    divisible_count = 0
    
    # Generate all permutations of the digits
    for perm in permutations(digits):
        num = int(''.join(map(str, perm)))
        total_count += 1
        if is_divisible_by_11(num):
            divisible_count += 1
            
    # Calculate the probability
    probability = Fraction(divisible_count, total_count)
    
    # Return the result in LaTeX format
    return f"\\boxed{{{probability}}}"

# Call the solve function and print the result
print(solve())
