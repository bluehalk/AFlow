    # To find the number of ways to return to the starting point,
    # we need to count the number of ways to have an even number of
    # clockwise and counterclockwise moves.
    
    # Let x be the number of heads (counterclockwise moves)
    # Let y be the number of tails (clockwise moves)
    # We need x - y = 0 (to return to the starting point)
    # This means x = y, and since x + y = flips, we have:
    # 2x = flips => x = flips / 2
    # Thus, flips must be even, which it is (6).
    
    # The number of heads (x) must be 3 and the number of tails (y) must also be 3.
    heads = flips // 2
    tails = flips // 2
    
    # The number of ways to choose 3 heads from 6 flips is given by the binomial coefficient
    from math import comb
    ways_to_choose_heads = comb(flips, heads)
    
    # Each sequence of 3 heads and 3 tails results in a net movement of:
    # (number of heads - number of tails) % n
    # which must equal 0 for the man to return to the starting point.
    
    # Since we have 3 heads and 3 tails, the net movement is:
    net_movement = (heads - tails) % n  # This will be 0
    
    # The probability of returning to the starting point
    probability = ways_to_choose_heads / total_outcomes
    
    # Format the result in LaTeX notation
    result = f"\\boxed{{{probability}}}"
    
