def solve():
    # Let x be the repeating decimal
    x = 0.0
    # The repeating part is 57, which has 2 digits
    # We can express x as:
    # x = 0.057575757...
    
    # To eliminate the repeating part, we multiply by 1000 (to shift the decimal point 3 places)
    # This gives us:
    # 1000x = 57.575757...
    
    # Now we also multiply by 10 (to shift the decimal point 1 place)
    # This gives us:
    # 10x = 0.575757...
    
    # Now we can set up the equation:
    # 1000x - 10x = 57.575757... - 0.575757...
    # 990x = 57
    # x = 57 / 990
    
    # Now we need to simplify the fraction 57/990
    from math import gcd
    
    numerator = 57
    denominator = 990
    
    # Find the greatest common divisor
    common_divisor = gcd(numerator, denominator)
    
    # Simplify the fraction
    simplified_numerator = numerator // common_divisor
    simplified_denominator = denominator // common_divisor
    
    # Format the result in LaTeX notation
    result = f"\\boxed{{{simplified_numerator}/{simplified_denominator}}}"
    
    return result

# Call the solve function and print the result
print(solve())
