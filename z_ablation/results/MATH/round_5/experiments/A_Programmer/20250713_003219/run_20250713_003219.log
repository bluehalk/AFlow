    # Calculate the slope of line DF
    slope_DF = (F[1] - D[1]) / (F[0] - D[0])  # (y2 - y1) / (x2 - x1)
    
    # The slope of the perpendicular line EM
    slope_EM = -1 / slope_DF
    
    # Equation of line DF: y - y1 = m(x - x1)
    # Using point D (4, 8)
    # y - 8 = slope_DF * (x - 4)
    # Rearranging to y = mx + b form
    b_DF = D[1] - slope_DF * D[0]  # b = y - mx
    # Line DF: y = slope_DF * x + b_DF
    
    # Equation of line EM: y - y_E = slope_EM * (x - x_E)
    # Using point E (6.8284, 5.1716)
    b_EM = E[1] - slope_EM * E[0]  # b = y - mx
    # Line EM: y = slope_EM * x + b_EM
    
