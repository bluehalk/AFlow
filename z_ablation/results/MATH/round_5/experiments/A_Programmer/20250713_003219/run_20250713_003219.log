import math
from functools import reduce

def solve():
    # Calculate the product of the first 20 positive integers (20!)
    factorial_20 = reduce(lambda x, y: x * y, range(1, 21))
    
    # Start checking from the smallest positive integer greater than 1
    n = 2
    
    # Find the smallest integer greater than 1 that is relatively prime to 20!
    while math.gcd(n, factorial_20) != 1:
        n += 1
    
    # Return the result in the required format
    return f"\\boxed{{{n}}}"

