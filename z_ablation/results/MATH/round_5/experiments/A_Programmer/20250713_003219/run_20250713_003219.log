    # 3M + 2(8n - M) = 96
    # 3M + 16n - 2M = 96
    # M + 16n = 96
    # M = 96 - 16n
    
    # Now we need to ensure that M is positive and that n is a whole number
    # Since M must be greater than 0:
    # 96 - 16n > 0
    # 96 > 16n
