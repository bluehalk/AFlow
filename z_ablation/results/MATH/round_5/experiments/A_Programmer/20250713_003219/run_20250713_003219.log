def solve():
    # Total faces on a die
    faces = [1, 2, 3, 4, 5, 6]
    
    # Calculate total ways to choose 2 faces from 6
    from itertools import combinations
    total_ways = list(combinations(faces, 2))
    
    # Count the number of ways where the product is equal to 6
    product_six_count = 0
    for face1, face2 in total_ways:
        if face1 * face2 == 6:
            product_six_count += 1
    
    # Total ways to paint 2 faces minus the ways where the product is 6
    valid_ways = len(total_ways) - product_six_count
    
    # Return the result in the required format
    return f"\\boxed{{{valid_ways}}}"

