import numpy as np
from scipy.integrate import quad

def polar_curve(r, theta):
    return r * (1 + np.cos(theta))

def area_of_swept_region():
    # Define the polar curve r = 1 + cos(theta)
    r = lambda theta: 1 + np.cos(theta)
    
    # The area swept by rotating the polar curve around the point (2, 0)
    # The area of the region swept by the curve can be calculated using the formula:
    # Area = 1/2 * ∫ (r(θ)^2) dθ from θ = 0 to θ = 2π
    area_integral = lambda theta: 0.5 * (r(theta)**2)
    
    # Calculate the area using numerical integration
    area, _ = quad(area_integral, 0, 2 * np.pi)
    
    return area

def solve():
    return area_of_swept_region()

# Output the result
result = solve()
print(result)
