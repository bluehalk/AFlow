    # Use a queue to perform a breadth-first search (BFS)
    queue = deque(['1'])  # Start with '1' since we need positive numbers
    while queue:
        # Get the current number from the queue
        current = queue.popleft()
        
        # Convert the current string to an integer
        current_num = int(current)
        
        # Check if it is a multiple of 14
