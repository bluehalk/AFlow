    cos_theta = sp.symbols('cos_theta')
    
    # Given volume of the tetrahedron
    volume = 1 / sp.sqrt(360)
    
    # The formula for the volume of the tetrahedron formed by three unit vectors
    # V = (1/6) * |det(a, b, c)| = (1/6) * sqrt(1 + 3 * cos^2(theta) - 3 * cos^4(theta))
