from itertools import permutations

def is_adjacent(pos1, pos2):
    """Check if two positions are adjacent (including diagonals)."""
    return abs(pos1[0] - pos2[0]) <= 1 and abs(pos1[1] - pos2[1]) <= 1

def generate_grid_positions():
    """Generate all positions in a 3x3 grid."""
    return [(i, j) for i in range(3) for j in range(3)]

def count_valid_arrangements(beads, grid_positions):
    """Count valid arrangements of beads on the grid."""
    count = 0
    for perm in permutations(beads):
        purple_pos = perm.index('purple')
        green_pos = perm.index('green')
        
        # Check if purple and green are adjacent
        if is_adjacent(grid_positions[purple_pos], grid_positions[green_pos]):
            continue
        
        count += 1
    return count

def solve():
    # Define the beads and their colors
    beads = ['red', 'blue', 'green', 'purple', 'yellow', 'orange', 'pink', 'black', 'white']
    
    # Generate all positions in a 3x3 grid
    grid_positions = generate_grid_positions()
    
    # Count valid arrangements
    valid_arrangements = count_valid_arrangements(beads, grid_positions)
    
    # Since the grid can be rotated and reflected, we need to divide by the number of symmetries
    # There are 8 symmetries for a square grid (4 rotations and 4 reflections)
    symmetries = 8
    final_count = valid_arrangements // symmetries
    
    return final_count

# Output the result
result = solve()
print(result)
```
