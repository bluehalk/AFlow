   \[
   EV_{\clubsuit} = \frac{1}{13} \left(4 + 2 \cdot 54 + 12 \cdot 20\right) = \frac{1}{13} \left(4 + 108 + 240\right) = \frac{352}{13} \approx 27.0769
   \]
