def extended_gcd(a, b):
    """Return gcd of a and b, and coefficients x, y such that ax + by = gcd(a, b)"""
    if a == 0:
        return b, 0, 1
    gcd, x1, y1 = extended_gcd(b % a, a)
    x = y1 - (b // a) * x1
    y = x1
    return gcd, x, y

def mod_inverse(a, m):
    """Return the modular inverse of a under modulo m, if it exists"""
    gcd, x, _ = extended_gcd(a, m)
    if gcd != 1:
        raise ValueError(f"No modular inverse for {a} under modulo {m}")
    return x % m

def solve():
    a = 160
    m = 1399
    inverse = mod_inverse(a, m)
    return inverse

