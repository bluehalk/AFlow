\[
\overrightarrow{BA} \cdot \begin{pmatrix} v_1 \\ -7 - v_1 \end{pmatrix} = 6v_1 - 2(-7 - v_1) = 6v_1 + 14 + 2v_1 = 8v_1 + 14
\]
