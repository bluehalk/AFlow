import numpy as np

def distance_point_to_line(point, line_point1, line_point2):
    # Convert points to numpy arrays for vector calculations
    point = np.array(point)
    line_point1 = np.array(line_point1)
    line_point2 = np.array(line_point2)
    
    # Vector from line_point1 to line_point2
    line_vector = line_point2 - line_point1
    # Vector from line_point1 to the point
    point_vector = point - line_point1
    
    # Calculate the projection of point_vector onto line_vector
    line_length_squared = np.dot(line_vector, line_vector)
    if line_length_squared == 0:
        return np.linalg.norm(point_vector)  # line_point1 and line_point2 are the same point
    
    projection = np.dot(point_vector, line_vector) / line_length_squared
    projection_vector = projection * line_vector
    
    # The closest point on the line to the given point
    closest_point_on_line = line_point1 + projection_vector
    
    # Calculate the distance from the point to the closest point on the line
    distance = np.linalg.norm(point - closest_point_on_line)
    return distance

def solve():
    # Define the points A, B, and C
    A = (0, 0, 0)  # One corner of the cube
    B = (1, 1, 1)  # Opposite corner of the cube
    C = (1, 0, 0)  # Another vertex of the cube
    
    # Calculate the distance from point C to line AB
    distance = distance_point_to_line(C, A, B)
    
    return distance

