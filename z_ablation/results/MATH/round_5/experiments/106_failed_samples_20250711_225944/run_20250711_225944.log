from scipy.optimize import fsolve

def P(x):
    return 24 * x**24 + sum((24 - j) * (x**(24 - j) + x**(24 + j)) for j in range(1, 24))

def find_zeros():
    # We will find the roots of P(x) using a range of initial guesses
    initial_guesses = np.linspace(-2, 2, 100)
    roots = set()
    
    for guess in initial_guesses:
        root = fsolve(P, guess)[0]
        # Round the root to avoid floating point precision issues
        roots.add(round(root, 8))
    
    return list(roots)

def calculate_b_sum(roots):
