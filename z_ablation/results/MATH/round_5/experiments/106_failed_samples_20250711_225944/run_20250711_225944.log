    # Set up the equation for the volume
    volume_eq = (1/6) * sp.sqrt(1 + 3 * cos_theta**2 - 3 * cos_theta**4) - volume
    
    # Solve for cos(theta)
    cos_theta_solution = sp.solve(volume_eq, cos_theta)
    
    # We are interested in the expression 3*cos^2(theta) - 2*cos^3(theta)
    result = 3 * cos_theta_solution[0]**2 - 2 * cos_theta_solution[0]**3
    
    return result.evalf()

# Call the solve function and print the result
