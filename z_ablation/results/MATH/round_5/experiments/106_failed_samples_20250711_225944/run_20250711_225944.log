import math

def solve():
    # Given conditions
    gcd_ab = 6
    
    # a and b can be expressed as:
    # a = 6 * m
    # b = 6 * n
    # where m and n are coprime integers (gcd(m, n) = 1)
    
    # The units digit of a is 2, so:
    # 6 * m % 10 = 2  => m % 10 = 2/6 = 2 (since 6 is not a factor of 10)
    # The units digit of b is 4, so:
    # 6 * n % 10 = 4  => n % 10 = 4/6 = 4 (since 6 is not a factor of 10)
    
    # Possible values for m and n based on their units digits
    m_candidates = [2, 12, 22, 32, 42, 52, 62, 72, 82, 92]  # m must end with 2
    n_candidates = [4, 14, 24, 34, 44, 54, 64, 74, 84, 94]  # n must end with 4
    
    # We need to find the smallest LCM(a, b)
    # LCM(a, b) = (a * b) / GCD(a, b)
    # LCM(6*m, 6*n) = (6*m * 6*n) / 6 = 6 * m * n
    
    min_lcm = float('inf')
    
    for m in m_candidates:
        for n in n_candidates:
            if math.gcd(m, n) == 1:  # m and n must be coprime
                lcm_ab = 6 * m * n
                if lcm_ab < min_lcm:
                    min_lcm = lcm_ab
    
    return min_lcm

