def solve():
    import math
    from collections import defaultdict

    # Function to determine the prime factorization of a number
    def prime_factors(n):
        factors = defaultdict(int)
        d = 2
        while d * d <= n:
            while (n % d) == 0:
                factors[d] += 1
                n //= d
            d += 1
        if n > 1:
            factors[n] += 1
        return factors

    # Function to determine the parity of the prime factorization
    def factor_parity(n):
        factors = prime_factors(n)
        return tuple((p, exp % 2) for p, exp in sorted(factors.items()))

    # Calculate the parities for numbers 1 to 16
    parities = [factor_parity(i) for i in range(1, 17)]

    # Use a set to track unique parities
    unique_parities = set()

    # Maximum number of slips that can be drawn without forming a perfect square
    max_slips = 0

    for parity in parities:
        if parity not in unique_parities:
            unique_parities.add(parity)
            max_slips += 1

    return max_slips

# Call the solve function and print the result
result = solve()
print(result)
```
