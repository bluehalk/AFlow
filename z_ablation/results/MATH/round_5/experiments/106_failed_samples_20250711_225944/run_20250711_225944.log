def solve():
    # Number of beads of each color
    orange = 3
    black = 3
    teal = 1
    
    # Total number of beads
    total_beads = orange + black + teal
    
    # Using Burnside's lemma to count distinct bracelets
    # We need to consider rotations and reflections
    # The number of symmetries in a bracelet of n beads is n (rotations) + n (reflections)
    n = total_beads
    rotations = n
    reflections = n
    
    # Calculate the number of distinct arrangements for each symmetry
    def count_arrangements(orange, black, teal):
        return factorial(orange + black + teal) // (factorial(orange) * factorial(black) * factorial(teal))
    
    # Count arrangements for rotations
    rotation_count = 0
    for k in range(n):
        # For each rotation, we need to find the number of arrangements that remain unchanged
        # This is equivalent to counting arrangements of beads in groups of gcd(n, k)
        g = gcd(n, k)
        rotation_count += count_arrangements(orange // g, black // g, teal // g)
    
    # Count arrangements for reflections
    reflection_count = 0
    for k in range(n):
        # For each reflection, we need to consider the arrangement of beads
        if n % 2 == 0:  # even length
            # Two halves
            half = n // 2
            reflection_count += count_arrangements(orange // 2, black // 2, teal)
        else:  # odd length
            # One bead in the center and the rest in two halves
            reflection_count += count_arrangements(orange, black, teal // 2)
    
    # Total distinct arrangements using Burnside's lemma
    total_distinct = (rotation_count + reflection_count) // (rotations + reflections)
    
    return total_distinct

