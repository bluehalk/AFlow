import math
from functools import reduce
from math import gcd

def lcm(x, y):
    return x * y // gcd(x, y)

def factorial_sum(n):
    return math.factorial(n) + math.factorial(n + 1)

def solve():
    # Calculate the sums of factorials
    sums = [factorial_sum(i) for i in range(1, 9)]
    
    # Calculate the least common multiple of the sums
    least_common_multiple = reduce(lcm, sums)
    
    # Find the largest b such that least_common_multiple can be expressed as a * b!
    b = 0
    while True:
        factorial_b = math.factorial(b)
        if least_common_multiple % factorial_b == 0:
            b += 1
        else:
            break
    b -= 1  # Decrement b to the last valid value
    
    a = least_common_multiple // math.factorial(b)
    
    return a + b

# Output the result
result = solve()
print(result)
```
