import numpy as np

def solve():
    # Define the target matrix
    target_matrix = np.array([[19, 30], [-45, -71]])
    
    # Calculate the eigenvalues and eigenvectors
    eigenvalues, eigenvectors = np.linalg.eig(target_matrix)
    
    # Calculate the cube root of the eigenvalues
    cube_root_eigenvalues = np.cbrt(eigenvalues)
    
    # Construct the diagonal matrix of cube root eigenvalues
    D = np.diag(cube_root_eigenvalues)
    
    # Calculate the matrix M using the formula M = V * D * V_inv
    M = eigenvectors @ D @ np.linalg.inv(eigenvectors)
    
    return M

result = solve()
