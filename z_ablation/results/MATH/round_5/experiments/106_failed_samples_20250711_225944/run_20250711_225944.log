    # Calculate the constant part of the expression
    constant_part = 3 * np.dot(sum_vector, b_cross_c) - 8 * np.dot(sum_vector, c_cross_a)
    
    # Solve for k
    if coeff_k != 0:
        k = -constant_part / coeff_k
    else:
        k = None  # This case occurs if a and b are parallel, leading to a_cross_b being zero
    
    return k

