import cmath

def solve():
    # Define the complex numbers
    z1 = complex(-5, 3)  # First vertex
    z2 = complex(8, -1)  # Second vertex

    # Calculate the third vertices of the equilateral triangle
    # Rotate z2 around z1 by 60 degrees (pi/3 radians)
    angle = cmath.pi / 3
    c1 = z1 + (z2 - z1) * cmath.exp(complex(0, angle))
    c2 = z1 + (z2 - z1) * cmath.exp(complex(0, -angle))

    # Calculate the product of c1 and c2
    product = c1 * c2

    return product

# Call the solve function and print the result
result = solve()
print(result)
