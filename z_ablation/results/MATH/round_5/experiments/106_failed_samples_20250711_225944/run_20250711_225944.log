            purchase_str = f"{purchase:.2f}".replace('.', '')
            change_str = f"{change:.2f}".replace('.', '')
            # Check if the digits can be rearranged
            if sorted(purchase_str) == sorted(change_str):
                unique_change_amounts.add(change)

    # Return the count of unique change amounts
    return len(unique_change_amounts)

