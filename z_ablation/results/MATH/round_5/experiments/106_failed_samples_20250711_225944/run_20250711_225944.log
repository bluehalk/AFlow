    for z in roots:
        z_squared = z**2
        a_k = z_squared.real
        b_k = z_squared.imag
        b_sum += abs(b_k)
    return b_sum

def solve():
    roots = find_zeros()
    result = calculate_b_sum(roots)
    return result

