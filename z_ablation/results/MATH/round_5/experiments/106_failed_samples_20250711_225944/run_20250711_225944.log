def solve():
    total_items = 100
    true_answers = set()
    false_answers = set()

    # Mark every question that is a multiple of 4 as true
    for i in range(1, total_items + 1):
        if i % 4 == 0:
            true_answers.add(i)
        else:
            false_answers.add(i)

    # Student marks every item that is a multiple of 3 as false
    for i in range(1, total_items + 1):
        if i % 3 == 0:
            false_answers.add(i)

    # Calculate correct answers
    correct_answers = true_answers.intersection(false_answers)
    correct_count = len(true_answers) - len(correct_answers)

    return correct_count

# Output the result
result = solve()
print(result)
