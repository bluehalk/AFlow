def solve():
    from itertools import combinations

    # Define the set S of points (a, b)
    S = [(-1, -1), (-1, 0), (-1, 1), (0, -1), (0, 0), (0, 1), (1, -1), (1, 0), (1, 1)]
    
    # Set to store unique lines
    lines = set()

    # Function to calculate the slope and intercept of the line through two points
    def line_from_points(p1, p2):
        x1, y1 = p1
        x2, y2 = p2
        
        # Handle vertical line case
        if x1 == x2:
            return ('vertical', x1)
        
        # Calculate slope (m) and y-intercept (b)
        slope = (y2 - y1) / (x2 - x1)
        intercept = y1 - slope * x1
        
        return (slope, intercept)

    # Generate all combinations of points in S taken 2 at a time
    for p1, p2 in combinations(S, 2):
        line = line_from_points(p1, p2)
        lines.add(line)

    # The number of distinct lines is the size of the set
    return len(lines)

# Call the solve function and print the result
result = solve()
print(result)
