import numpy as np

def solve():
    # Define the function to find the values of sin(2x)
    def equation(x):
        return np.sin(np.pi * np.cos(x)) - np.cos(np.pi * np.sin(x))

    # Generate values for x in the range [0, 2π]
    x_values = np.linspace(0, 2 * np.pi, 1000)
    
    # Find the roots of the equation
    roots = []
    for i in range(len(x_values) - 1):
        if equation(x_values[i]) * equation(x_values[i + 1]) < 0:
            root = np.interp(0, [equation(x_values[i]), equation(x_values[i + 1])], [x_values[i], x_values[i + 1]])
            roots.append(root)

    # Calculate sin(2x) for the found roots
    sin_2x_values = [np.sin(2 * root) for root in roots]
    
    # Remove duplicates and sort the results
    unique_sin_2x_values = sorted(set(sin_2x_values))
    
    # Convert to string format for output
    result = ', '.join(f"{value:.6f}" for value in unique_sin_2x_values)
    return result

# Call the solve function and print the result
print(solve())
```
