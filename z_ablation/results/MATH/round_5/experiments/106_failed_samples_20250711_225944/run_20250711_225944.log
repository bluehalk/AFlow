import math

def solve():
    # Distances from point P to the five vertices of the octahedron
    distances = [3, 7, 8, 9, 11]
    
    # Calculate the distance to the sixth vertex using the property of the octahedron
    # The sum of the squares of the distances from any point to the vertices of a regular octahedron
    # is constant. Let d be the distance to the sixth vertex.
    
    # The formula derived from the property of the octahedron:
    # d^2 = (sum of squares of known distances) - (sum of known distances)^2 / 5 + 6 * (distance to the center)^2
    # For a regular octahedron, the center is at the origin, and we can assume the distances are from the center.
    
    # Calculate the sum of squares of the known distances
    sum_of_squares = sum(d ** 2 for d in distances)
    
    # Calculate the sum of the known distances
    sum_of_distances = sum(distances)
    
    # The number of vertices in an octahedron
    n = 6
    
    # Using the derived formula to find the distance to the sixth vertex
    # d^2 = (sum of squares) - (sum of distances)^2 / n + 6 * (0)^2
    # Since we are considering distances from the center, we can ignore the last term.
    
    d_squared = (sum_of_squares - (sum_of_distances ** 2) / n)
    
    # The distance to the sixth vertex
    distance_to_sixth_vertex = math.sqrt(d_squared)
    
    return distance_to_sixth_vertex

# Call the solve function and print the result
