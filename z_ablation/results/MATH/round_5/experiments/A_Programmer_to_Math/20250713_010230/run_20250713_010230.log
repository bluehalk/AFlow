import cmath
import math

def solve():
    # Given complex number
    complex_number = 4 - 4j * math.sqrt(3)
    
    # Convert to polar form: r * (cos(theta) + i*sin(theta))
    r = abs(complex_number)
    theta = cmath.phase(complex_number)
    
    # Calculate the fourth roots
    roots = []
    for k in range(4):
        root_angle = (theta + 2 * math.pi * k) / 4
        root_magnitude = r ** (1/4)
        roots.append((root_magnitude, root_angle))
    
    # Convert angles from radians to degrees and normalize to [0, 360)
    angles_degrees = [(math.degrees(root[1]) % 360) for root in roots]
    
    # Calculate the sum of the angles
    sum_of_angles = sum(angles_degrees)
    
    return sum_of_angles

