    factorization = {i: prime_factors(i) for i in range(1, 17)}

    # To avoid a perfect square product, we need to ensure that for each prime factor,
    # the total exponent of that prime factor in the product is odd.
    # We will track the parity (even or odd) of the exponents of the prime factors.

    # This will hold the parity of the prime factors
    parity = defaultdict(int)

