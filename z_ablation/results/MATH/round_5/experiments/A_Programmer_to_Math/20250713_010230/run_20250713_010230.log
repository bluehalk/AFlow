    # The top of her head travels the circumference plus her height
    head_travel_distance = circumference_earth + girl_height
    
    # The distance her feet travel is just the circumference
    feet_travel_distance = circumference_earth
    
    # The difference in distance traveled by the top of her head and her feet
    difference = head_travel_distance - feet_travel_distance
    
    # The difference is equal to her height
