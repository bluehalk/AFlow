def solve():
    # We need to find the value of n such that the total number of squares is 70
    total_squares = 70
    
    # The number of squares of size 1x1, 2x2, and 3x3 in a 3 x n grid
    # For a grid of size 3 x n:
    # 1. Number of 1x1 squares = (3-1) * (n-1) = 2 * (n-1)
    # 2. Number of 2x2 squares = (3-2) * (n-2) = 1 * (n-2) = n-2
    # 3. Number of 3x3 squares = (3-3) * (n-3) = 0 (only exists if n >= 3)
    
    # Total squares = 2 * (n - 1) + (n - 2) + 0
    # Simplifying the equation:
    # Total squares = 2n - 2 + n - 2 = 3n - 4
    
    # We set up the equation:
    # 3n - 4 = 70
    # 3n = 70 + 4
    # 3n = 74
    # n = 74 / 3
    
    n = (total_squares + 4) / 3
    
    # Since n must be an integer, we check if n is an integer
    if n.is_integer():
        return int(n)
    else:
        return None  # In case n is not an integer, which shouldn't happen in this problem

# Call the solve function and print the result
result = solve()
print(result)
```
