import numpy as np
from sympy import symbols, Eq, simplify, gcd

def solve():
    # Define the coefficients of the planes
    A1, B1, C1, D1 = 3, -6, 2, 5
    A2, B2, C2, D2 = 4, -12, 3, -3
    
    # Define the point that the bisecting plane must contain
    point = np.array([-5, -1, -5])
    
    # Calculate the normal vectors of the planes
    n1 = np.array([A1, B1, C1])
    n2 = np.array([A2, B2, C2])
    
    # Calculate the distances from the point to each plane
    def distance_to_plane(n, D, point):
        return (np.dot(n, point) + D) / np.linalg.norm(n)
    
    d1 = distance_to_plane(n1, -D1, point)
    d2 = distance_to_plane(n2, -D2, point)
    
    # Calculate the coefficients of the bisecting plane
    n_bisect = n1 / np.linalg.norm(n1) + n2 / np.linalg.norm(n2)
    
    # Normalize the bisecting normal vector
    n_bisect /= np.linalg.norm(n_bisect)
    
    # The equation of the plane is given by n_bisect . (x, y, z) + D = 0
    A, B, C = n_bisect
    D_bisect = -np.dot(n_bisect, point)
    
    # Convert to integer coefficients
    A, B, C, D_bisect = A * 1000, B * 1000, C * 1000, D_bisect * 1000
    A, B, C, D_bisect = int(round(A)), int(round(B)), int(round(C)), int(round(D_bisect))
    
    # Ensure A > 0
    if A < 0:
        A, B, C, D_bisect = -A, -B, -C, -D_bisect
    
    # Reduce coefficients by their gcd
    common_gcd = gcd(abs(A), abs(B), abs(C), abs(D_bisect))
    A //= common_gcd
    B //= common_gcd
    C //= common_gcd
    D_bisect //= common_gcd
    
    # Return the result in the required format
    return f"{A}x + {B}y + {C}z + {D_bisect} = 0"

# Call the solve function and print the result
result = solve()
print(result)
```
