2025-07-13 01:07:01 - INFO - ```python
import sympy as sp

def solve():
    # Define the variable
    x = sp.symbols('x')
    
    # Define the equation sin(pi * cos(x)) = cos(pi * sin(x))
    equation = sp.sin(sp.pi * sp.cos(x)) - sp.cos(sp.pi * sp.sin(x))
    
    # Solve the equation for x
    solutions = sp.solve(equation, x)
    
    # Calculate sin(2x) for each solution
    sin_2x_values = [sp.sin(2 * sol).evalf() for sol in solutions]
    
    # Convert to a set to get unique values and then sort them
    unique_sin_2x_values = sorted(set(sin_2x_values))
    
    # Convert to string format for output
    result = ', '.join(map(str, unique_sin_2x_values))
    
    return result

# Call the solve function and print the result
print(solve())
```
