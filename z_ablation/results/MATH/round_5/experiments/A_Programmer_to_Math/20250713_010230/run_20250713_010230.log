def factorial_prime_factors(n):
    """Returns a dictionary of prime factors and their counts in n!."""
    from collections import defaultdict
    factors = defaultdict(int)
    
    for i in range(2, n + 1):
        num = i
        for j in range(2, int(num**0.5) + 1):
            while num % j == 0:
                factors[j] += 1
                num //= j
        if num > 1:
            factors[num] += 1
            
    return factors

def solve():
    n = 10
    prime_factors = factorial_prime_factors(n)
    
    # We need to find x such that x^3 divides 10!
    # This means for each prime factor p, the exponent in x^3 must be <= exponent in 10!
    # If p^e is a factor of 10!, then we can have p^(3k) where 3k <= e
    # Thus k can take values from 0 to e // 3
    
    count = 1  # Start with 1 for the product of choices
    for exponent in prime_factors.values():
        count *= (exponent // 3) + 1  # k can be 0 to e // 3
    
    return count

# Call the solve function and print the result
result = solve()
print(result)
