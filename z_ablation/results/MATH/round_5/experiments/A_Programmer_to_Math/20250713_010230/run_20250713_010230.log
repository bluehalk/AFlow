    # To minimize ||c - a||, we can set c1 = 0 (which means c is purely in the direction of p)
    c1 = 0
    
    # Now c = (0, 0, 3/2)
    c = np.array([c1, c2, c3])
    
    # Calculate the distance ||c - a||
    distance = np.linalg.norm(c - a)
    
    return distance

