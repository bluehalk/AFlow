2025-07-13 01:03:43 - INFO - ```python
import numpy as np

def solve():
    # Define the input vectors and their images
    v1 = np.array([[2], [-1]])
    v2 = np.array([[1], [-3]])
    img1 = np.array([[9], [3]])
    img2 = np.array([[7], [-1]])
    
    # Construct the matrix M using the equations M * v1 = img1 and M * v2 = img2
    A = np.hstack((v1, v2))  # Matrix of input vectors
    B = np.hstack((img1, img2))  # Matrix of output vectors
    
    # Calculate the transformation matrix M
    M = B @ np.linalg.inv(A)
    
    # Define the line y = 2x + 1
    # We can express points on the line as (x, 2x + 1)
    # We will transform points on this line
    x_values = np.linspace(-10, 10, 100)  # Generate x values
    transformed_points = []
    
    for x in x_values:
        point = np.array([[x], [2 * x + 1]])  # Point on the line
        transformed_point = M @ point  # Apply the transformation
        transformed_points.append(transformed_point)
    
    # Extract transformed y values
    transformed_y_values = [p[1, 0] for p in transformed_points]
    
    # Fit a line to the transformed points
    # We can use numpy's polyfit to find the slope (m) and intercept (b)
    m, b = np.polyfit(x_values, transformed_y_values, 1)
    
    # Format the result as a string
    result = f"y = {m:.2f}x + {b:.2f}"
    return result

# Call the solve function and print the result
print(solve())
