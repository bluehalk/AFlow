    b_norm = np.linalg.norm(b)
    
    # Calculate the cosine of the angle between a and b
    cos_theta = np.dot(a, b) / (a_norm * b_norm)
    
    # Calculate the angle c using the angle bisector theorem
    # The angle bisector divides the angle into two equal parts
    # We can find c by using the formula: c = k * (a_norm * b_normalized + b_norm * (-b_normalized))
