import math

def solve():
    # Given values
    sin_A = 3 / 5
    sin_B = 24 / 25
    
    # Using the sine rule: sin C = sin(180° - (A + B)) = sin(A + B)
    # We can find C using the identity: sin C = sin A * cos B + cos A * sin B
    
    # Calculate cos A and cos B using the Pythagorean identity
    cos_A = math.sqrt(1 - sin_A**2)  # cos A = sqrt(1 - sin^2 A)
    cos_B = math.sqrt(1 - sin_B**2)  # cos B = sqrt(1 - sin^2 B)
    
    # Calculate sin C using the sine addition formula
    sin_C1 = sin_A * cos_B + cos_A * sin_B  # First possible value of sin C
    sin_C2 = sin_A * cos_B - cos_A * sin_B  # Second possible value of sin C (using negative cos A)
    
    # Prepare the result
    result = [sin_C1, sin_C2]
    
    # Filter valid sine values (must be in the range [-1, 1])
    valid_results = [value for value in result if -1 <= value <= 1]
    
    # Return the results as a comma-separated string
    return ', '.join(map(str, valid_results))

