import numpy as np

def solve():
    # Given lengths
    AB = 3
    AC = 5
    
    # Coordinates of points A, B, and C
    A = np.array([0, 0])  # Point A at origin
    B = np.array([AB, 0])  # Point B at (3, 0)
    
    # To find point C, we can use the distance formula
    # Let C be at (x, y)
    # We know AC = 5 and AB = 3
    # Thus, we have the equations:
    # x^2 + y^2 = 5^2 (distance from A to C)
    # (x - 3)^2 + y^2 = 3^2 (distance from B to C)
    
    # Expanding the second equation:
    # (x - 3)^2 + y^2 = 9
    # x^2 - 6x + 9 + y^2 = 9
    # x^2 + y^2 - 6x + 9 = 9
    # x^2 + y^2 - 6x = 0
    # Substitute x^2 + y^2 = 25 into the equation:
    # 25 - 6x = 0
    # 6x = 25
    # x = 25 / 6
    
    x = 25 / 6
    y_squared = 25 - x**2
    y = np.sqrt(y_squared)  # Taking the positive root for y
    
    C = np.array([x, y])  # Point C
    
    # Vector BC
    BC = C - B
    
    # Circumcenter O of triangle ABC can be found using the perpendicular bisectors
    # For simplicity, we can use the circumradius formula and properties of the triangle
    # The circumcenter O is the average of the vertices for an isosceles triangle
    O = (A + B + C) / 3  # Approximation for circumcenter
    
    # Vector OA
    OA = A - O
    
    # Dot product OA · BC
    dot_product = np.dot(OA, BC)
    
    return dot_product

# Call the solve function and print the result
result = solve()
print(result)
