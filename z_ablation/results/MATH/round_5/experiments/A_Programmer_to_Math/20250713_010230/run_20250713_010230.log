import numpy as np

def solve():
    # Given vector
    v = np.array([0, 13])
    
    # Projection of v onto a is given
    proj_a = np.array([6, 4])
    
    # Calculate vector a from the projection formula
    # proj_a = (v . a / ||a||^2) * a
    # Since we know proj_a, we can find a
    # Let's denote a as [a1, a2]
    # We can find the direction of a from proj_a
    a = proj_a / np.linalg.norm(proj_a)
    
    # Since a and b are orthogonal, we can find b as a perpendicular vector
    # If a = [a1, a2], then b can be [-a2, a1] (90 degrees rotation)
    b = np.array([-a[1], a[0]])
    
    # Now we calculate the projection of v onto b
    # proj_b = (v . b / ||b||^2) * b
    proj_b = (np.dot(v, b) / np.dot(b, b)) * b
    
    return proj_b

# Call the solve function and print the result
result = solve()
print(result)
