def solve():
    # Function to find all nice numbers in the range 2010 to 2019
    nice_numbers = set()
    
    # A number m has exactly four positive divisors if it is of the form p^3 or p*q where p and q are distinct primes
    # We will check for both forms
    
    # Check for p^3 form
    for p in range(2, 100):  # We can limit p to a reasonable range
        m = p ** 3
        if m > 0:
            sum_of_divisors = 1 + p + p**2 + p**3
            if 2010 <= sum_of_divisors <= 2019:
                nice_numbers.add(sum_of_divisors)
    
    # Check for p*q form
    primes = []
    for num in range(2, 100):
        is_prime = True
        for prime in primes:
            if prime * prime > num:
                break
            if num % prime == 0:
                is_prime = False
                break
        if is_prime:
            primes.append(num)
    
    for i in range(len(primes)):
        for j in range(i + 1, len(primes)):
            p = primes[i]
            q = primes[j]
            m = p * q
            if m > 0:
                sum_of_divisors = 1 + p + q + m
                if 2010 <= sum_of_divisors <= 2019:
                    nice_numbers.add(sum_of_divisors)
    
    # Calculate the sum of all nice numbers found
    return sum(nice_numbers)

# Call the solve function and print the result
result = solve()
print(result)
