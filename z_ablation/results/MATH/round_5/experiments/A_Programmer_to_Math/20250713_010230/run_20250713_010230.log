    # Calculate the vector c
    c = a_norm * b_normalized + b_norm * (-b_normalized)
    
    # Normalize c to ensure it is a unit vector
    c_normalized = c / np.linalg.norm(c)
    
    # Scale c to have the same length as a
    c_final = a_norm * c_normalized
    
    return c_final

