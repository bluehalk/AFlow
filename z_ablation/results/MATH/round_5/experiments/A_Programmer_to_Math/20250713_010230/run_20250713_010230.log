import math
from sympy import factorint

def solve():
    # Step 1: Define the number to simplify
    number = 2940
    
    # Step 2: Factor the number into its prime factors
    factors = factorint(number)
    
    # Step 3: Calculate the square root by taking out pairs of prime factors
    radicand = 1
    for prime, exponent in factors.items():
        # Take the integer part of the exponent divided by 2
        pairs = exponent // 2
        # Multiply the prime raised to the number of pairs into the radicand
        radicand *= prime ** pairs
    
    # Step 4: Calculate the remaining part under the square root
    remaining = 1
    for prime, exponent in factors.items():
        # Take the remainder of the exponent divided by 2
        remainder = exponent % 2
        if remainder == 1:
            remaining *= prime
    
    # Step 5: Construct the simplified radical
    if remaining == 1:
        result = radicand
    else:
        result = f"{radicand}√{remaining}"
    
    return result

# Call the solve function and print the result
print(solve())
```
