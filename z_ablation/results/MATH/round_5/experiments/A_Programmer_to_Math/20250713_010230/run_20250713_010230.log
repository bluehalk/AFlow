    # Calculate the orthocenter coordinates in terms of barycentric coordinates
    x = (a**2) / (b**2 + c**2 + a**2)
    y = (b**2) / (a**2 + c**2 + b**2)
    z = (c**2) / (a**2 + b**2 + c**2)

    # Normalize the barycentric coordinates
    total = x + y + z
    x /= total
    y /= total
    z /= total

    return (x, y, z)

# Call the solve function and print the result
result = solve()
print(result)
```
