def modular_inverse(a, m):
    """Compute the modular inverse of a under modulo m using Extended Euclidean Algorithm."""
    m0, x0, x1 = m, 0, 1
    if m == 1:
        return 0
    while a > 1:
        # q is quotient
        q = a // m
        m, a = a % m, m
        x0, x1 = x1 - q * x0, x0
    if x1 < 0:
        x1 += m0
    return x1

def solve():
    # Given values
    mod = 31
    a = 3
    b = 5
    
    # Calculate the modular inverses
    a_inv = modular_inverse(a, mod)
    b_inv = modular_inverse(b, mod)
    
    # Calculate (a_inv + b_inv) % mod
    sum_inv = (a_inv + b_inv) % mod
    
    # Calculate the modular inverse of the sum
    result = modular_inverse(sum_inv, mod)
    
    return result

# Output the result
print(solve())
```
