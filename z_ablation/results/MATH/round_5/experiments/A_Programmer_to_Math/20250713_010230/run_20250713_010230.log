import numpy as np

def determinant(M):
    return int(round(np.linalg.det(M)))

def calculate_D_n(n):
    # Create the n x n matrix M_n
    M_n = np.zeros((n, n))
    
    # Fill the matrix according to the problem statement
    for i in range(n):
        M_n[i, i] = 10  # diagonal elements
        if i < n - 1:
            M_n[i, i + 1] = 3  # upper diagonal
            M_n[i + 1, i] = 3  # lower diagonal
    
    # Calculate the determinant
    return determinant(M_n)

def solve():
