import math

def solve():
    # Calculate the right-hand side of the equation
    cos_50 = math.cos(math.radians(50))
    sin_50 = math.sin(math.radians(50))
    rhs = cos_50 / (1 - sin_50)
    
    # We need to find the smallest positive integer x such that:
    # tan(x - 160) = rhs
    # This implies:
    # x - 160 = arctan(rhs) + k * 180 for some integer k
    # Therefore:
    # x = arctan(rhs) + 160 + k * 180
    
    # Calculate arctan(rhs)
    arctan_rhs = math.degrees(math.atan(rhs))
    
    # Calculate the smallest positive x
    x = arctan_rhs + 160
    
    # We need to ensure x is positive and find the smallest positive integer
    if x <= 0:
        x += 180 * (1 + (-x // 180))
    
    # Round x to the nearest integer
    x = round(x)
    
    return x

# Call the solve function and print the result
result = solve()
print(result)
