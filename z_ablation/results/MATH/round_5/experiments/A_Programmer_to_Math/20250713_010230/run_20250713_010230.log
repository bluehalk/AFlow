from math import comb

def solve():
    # Total number of dice
    total_dice = 5
    
    # Probability of rolling a 1 or 2 on a single die
    p_success = 2 / 6  # There are 2 favorable outcomes (1 or 2) out of 6 possible outcomes
    
    # Probability of not rolling a 1 or 2 on a single die
    p_failure = 1 - p_success  # This is 4/6 or 2/3
    
    # We want exactly 2 successes (rolling a 1 or 2)
    k = 2
    
    # Calculate the probability using the binomial formula
    probability = (comb(total_dice, k) * (p_success ** k) * (p_failure ** (total_dice - k)))
    
    return probability

# Call the solve function and print the result
result = solve()
print(result)
