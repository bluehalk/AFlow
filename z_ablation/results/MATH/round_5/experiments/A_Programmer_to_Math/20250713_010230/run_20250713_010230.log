from math import factorial

def solve():
    # Number of beads of each color
    orange = 3
    black = 3
    teal = 1
    
    # Total number of beads
    total_beads = orange + black + teal
    
    # Using Burnside's lemma to count distinct bracelets
    def gcd(a, b):
        while b:
            a, b = b, a % b
        return a
    
    # Count the number of distinct arrangements considering rotations and reflections
    def count_bracelets(n, counts):
        # Calculate the number of distinct arrangements
        # n is the total number of beads
        # counts is a list of counts of each type of bead
        num_arrangements = factorial(n)
        for count in counts:
            num_arrangements //= factorial(count)
        
        # Count the number of symmetries (rotations and reflections)
        symmetries = 0
        
        # Count rotations
        for k in range(n):
            symmetries += num_arrangements // n
        
        # Count reflections
        if n % 2 == 0:
            symmetries += num_arrangements // (n // 2)
        else:
            symmetries += num_arrangements // n
        
        return symmetries // (2 * n)  # Divide by 2 for reflections and by n for rotations
    
    # Counts of each bead type
    counts = [orange, black, teal]
    
    # Calculate the number of distinct bracelets
    distinct_bracelets = count_bracelets(total_beads, counts)
    
    return distinct_bracelets

