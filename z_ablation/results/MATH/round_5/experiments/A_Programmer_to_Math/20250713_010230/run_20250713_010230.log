import sympy as sp

def solve():
    # Define the variable
    x = sp.symbols('x')
    
    # Calculate cos(20 degrees) using sympy
    cos_20 = sp.cos(sp.rad(20))
    
    # Use the triple angle formula for cosine: cos(3θ) = 4cos^3(θ) - 3cos(θ)
    # We want to find a polynomial with cos(20) as a root, so we set:
    # cos(3 * 20) = 4 * cos(20)^3 - 3 * cos(20)
    # cos(60 degrees) = 1/2
    cos_60 = sp.Rational(1, 2)
    
    # Set up the equation
    polynomial_eq = sp.Eq(4 * cos_20**3 - 3 * cos_20, cos_60)
    
    # Rearranging the equation to form a polynomial
    polynomial = sp.collect(sp.expand(polynomial_eq.lhs - polynomial_eq.rhs), cos_20)
    
    # Convert the polynomial to standard form
    coeffs = sp.Poly(polynomial, cos_20).all_coeffs()
    
    # Convert coefficients to integers
    integer_coeffs = [sp.nsimplify(c).as_numer_denom()[0] for c in coeffs]
    
    # Ensure coefficients are integers
    integer_coeffs = [int(c) for c in integer_coeffs]
    
    # Normalize the polynomial to have a positive leading coefficient
    leading_coeff = integer_coeffs[0]
    if leading_coeff < 0:
        integer_coeffs = [-c for c in integer_coeffs]
    
    # Ensure coefficients have no common factor other than 1
    gcd = sp.gcd(*integer_coeffs)
    if gcd > 1:
        integer_coeffs = [c // gcd for c in integer_coeffs]
    
    # Return the polynomial coefficients
    return integer_coeffs

# Call the solve function and print the result
result = solve()
print(result)
```
