    r1 = 4  # Radius of the smallest circle
    r2 = 6  # Radius of the middle circle
    r3 = 7  # Radius of the largest circle

    # Calculate the areas of the circles
    area1 = math.pi * r1**2  # Area of the smallest circle
    area2 = math.pi * r2**2  # Area of the middle circle
    area3 = math.pi * r3**2  # Area of the largest circle

    # Calculate the areas of the regions X, Y, and Z
    area_X = area3 - area2  # Area of region X (between r2 and r3)
    area_Y = area2 - area1  # Area of region Y (between r1 and r2)
    area_Z = area1          # Area of region Z (inside r1)

    # Find the maximum and minimum areas
    max_area = max(area_X, area_Y, area_Z)
    min_area = min(area_X, area_Y, area_Z)

    # Calculate the difference between the largest and smallest area
    area_difference = max_area - min_area

    # Return the result in exact form
    return area_difference

