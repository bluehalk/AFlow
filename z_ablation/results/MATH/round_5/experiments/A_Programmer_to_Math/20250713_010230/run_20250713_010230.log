    # Let tan(b) = t, then tan(a) = 5t
    
    # Using the identity for sin(a - b):
    # sin(a - b) = sin(a)cos(b) - cos(a)sin(b)
    # We can express sin and cos in terms of tan:
    # sin(x) = tan(x) / sqrt(1 + tan^2(x))
    # cos(x) = 1 / sqrt(1 + tan^2(x))
    
    # Let t = tan(b)
    t = 1  # We can set t to 1 for simplicity, as we will maximize the expression
    
    # Calculate tan(a) and tan(b)
