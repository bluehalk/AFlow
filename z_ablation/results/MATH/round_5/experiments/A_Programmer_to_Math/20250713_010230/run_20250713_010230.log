    # Total arrangements without restrictions
    total_arrangements = factorial(total_creatures) // (factorial(crocodiles) * factorial(catfish) * factorial(giant_squid))

    # Arrangements with no two crocodiles together
    # We can treat the crocodiles as "blocks" to avoid consecutive arrangements
    # First, arrange the non-crocodile creatures
    non_crocodile_creatures = catfish + giant_squid
    non_crocodile_arrangements = factorial(non_crocodile_creatures) // (factorial(catfish) * factorial(giant_squid))

    # We can place crocodiles in the gaps created by non-crocodile arrangements
    # For example, if we have N non-crocodile creatures, we can place crocodiles in N+1 gaps
    gaps = non_crocodile_creatures + 1

    # We need to choose 4 gaps from the available gaps to place the crocodiles
    from math import comb
    valid_arrangements = non_crocodile_arrangements * comb(gaps, crocodiles)

    return valid_arrangements

