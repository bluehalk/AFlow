2025-07-13 01:08:34 - INFO - ```python
import itertools

def solve():
    # Define the bills in the envelope
    bills = [1, 1, 5, 5, 10, 10, 20, 20]
    
    # Calculate all possible combinations of drawing 2 bills
    combinations = list(itertools.combinations(bills, 2))
    
    # Count the number of combinations that sum to 20 or more
    successful_outcomes = sum(1 for combo in combinations if sum(combo) >= 20)
    
    # Total number of combinations
    total_outcomes = len(combinations)
    
    # Calculate the probability
    probability = successful_outcomes / total_outcomes
    
    return probability

# Call the solve function and print the result
result = solve()
print(result)
```
