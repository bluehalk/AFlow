2025-07-13 01:07:55 - INFO - ```python
def get_factors(n):
    """Return a list of positive factors of n, excluding n itself."""
    factors = []
    for i in range(1, n):
        if n % i == 0:
            factors.append(i)
    return factors

def solve():
    """Calculate the maximum number of spins John can make starting with a spin of 20."""
    current_number = 20
    total_spins = 0
    
    while current_number > 0:
        total_spins += 1
        factors = get_factors(current_number)
        if not factors:
            break
        current_number = max(factors)  # John spins the maximum factor next
    
    return total_spins

# Call the solve function and print the result
result = solve()
print(result)
```
