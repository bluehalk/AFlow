from itertools import permutations

def is_adjacent(pos1, pos2):
    """Check if two positions are adjacent (including diagonally)."""
    return abs(pos1[0] - pos2[0]) <= 1 and abs(pos1[1] - pos2[1]) <= 1

def generate_grid_positions():
    """Generate all positions on a 3x3 grid."""
    return [(i, j) for i in range(3) for j in range(3)]

def count_valid_arrangements(beads, grid_positions):
    """Count valid arrangements of beads on the grid."""
    count = 0
    for perm in permutations(beads):
        purple_pos = perm.index('purple')
        green_pos = perm.index('green')
        
        if not is_adjacent(grid_positions[purple_pos], grid_positions[green_pos]):
            count += 1
    return count

def count_unique_arrangements(total_arrangements):
    """Account for rotations and reflections of the grid."""
    # There are 8 symmetries for a 3x3 grid (4 rotations + 4 reflections)
    return total_arrangements // 8

def solve():
    # Define the beads
    beads = ['purple', 'green'] + [f'bead{i}' for i in range(7)]
    
    # Generate grid positions
    grid_positions = generate_grid_positions()
    
    # Count valid arrangements
    total_arrangements = count_valid_arrangements(beads, grid_positions)
    
    # Count unique arrangements considering symmetries
    unique_arrangements = count_unique_arrangements(total_arrangements)
    
    return unique_arrangements

# Output the result
result = solve()
print(result)
