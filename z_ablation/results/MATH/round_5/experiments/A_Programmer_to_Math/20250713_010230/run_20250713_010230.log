    def is_terminating(numerator, denominator):
        # Reduce the fraction by their greatest common divisor
        from math import gcd
        common_divisor = gcd(numerator, denominator)
        denominator //= common_divisor
        
        # Remove factors of 2 and 5 from the denominator
        while denominator % 2 == 0:
            denominator //= 2
        while denominator % 5 == 0:
            denominator //= 5
        
        # If the remaining denominator is 1, it's a terminating decimal
        return denominator == 1

    # We need to find integers k such that both 17k/66 and 13k/105 are terminating decimals
    # This means we need to check the denominators 66 and 105
    
    # Factor 66 and 105
