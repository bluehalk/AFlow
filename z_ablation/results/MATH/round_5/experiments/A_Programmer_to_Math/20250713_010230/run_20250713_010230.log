def decimal_to_base3(decimal_num):
    """Convert a decimal integer to a base 3 string."""
    if decimal_num == 0:
        return '0'
    base3_str = ''
    while decimal_num > 0:
        base3_str = str(decimal_num % 3) + base3_str
        decimal_num //= 3
    return base3_str

def solve():
    # Given base 3 numbers
    num1 = '121'   # base 3
    num2 = '2122'  # base 3
    num3 = '1200'  # base 3
