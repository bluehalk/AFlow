def solve():
    # Given congruence: 14u ≡ 46 (mod 100)
    a = 14
    b = 46
    m = 100

    # We need to solve the equation 14u - 100k = 46 for integers u and k
    # Rearranging gives us: 14u = 46 + 100k
    # This can be rewritten as: 14u - 100k = 46

    # First, we need to find the modular inverse of 14 modulo 100
    def gcd_extended(a, b):
        if a == 0:
            return b, 0, 1
        gcd, x1, y1 = gcd_extended(b % a, a)
        x = y1 - (b // a) * x1
        y = x1
        return gcd, x, y

    gcd, x, y = gcd_extended(a, m)

    # Check if there is a solution
    if b % gcd != 0:
        return "No solution"

    # Scale the solution
    scale = b // gcd
    a //= gcd
    m //= gcd
    x *= scale
    m = m  # m is already scaled

    # Now we have a solution x for the equation a * u ≡ b (mod m)
    # The general solution is u = x + k * (m / gcd)
    # We need the two smallest positive solutions

    # Calculate the step size
    step_size = m // gcd

    # Find the first positive solution
    first_solution = (x % step_size + step_size) % step_size
    if first_solution == 0:
        first_solution += step_size

    # Find the second positive solution
    second_solution = first_solution + step_size

    # Calculate the average of the two smallest positive solutions
    average = (first_solution + second_solution) / 2

    return average

# Call the solve function and print the result
result = solve()
print(result)
```
