def is_prime(n):
    """Check if a number is prime."""
    if n <= 1:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

def solve():
    # List of prime numbers between 40 and 60
    primes = [41, 43, 47, 53, 59]
    
    # Count of primes where p + 12 is also prime
    count_valid = 0
    
    for p in primes:
        if is_prime(p + 12):
            count_valid += 1
            
    # Total number of primes in the range
    total_primes = len(primes)
    
    # Calculate the probability as a fraction
    from fractions import Fraction
    probability = Fraction(count_valid, total_primes)
    
    return str(probability)

