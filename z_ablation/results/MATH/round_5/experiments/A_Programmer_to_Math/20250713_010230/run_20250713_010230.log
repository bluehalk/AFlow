import numpy as np

def solve():
    # Define points A, B, and C
    A = np.array([1, 8, 4])
    B = np.array([0, -1, 3])
    C = np.array([2, -3, -1])
    
    # Calculate the direction vector of the line BC
    BC = C - B
    
    # Calculate the vector from B to A
    BA = A - B
    
    # Calculate the projection of BA onto BC
    BC_norm = np.dot(BC, BC)
    if BC_norm == 0:
        raise ValueError("Points B and C cannot be the same.")
    
    projection_length = np.dot(BA, BC) / BC_norm
    projection_vector = projection_length * BC
    
    # Calculate the foot of the perpendicular from A to the line BC
    foot_of_perpendicular = B + projection_vector
    
    return tuple(foot_of_perpendicular)

# Call the solve function and print the result
result = solve()
print(result)
```
