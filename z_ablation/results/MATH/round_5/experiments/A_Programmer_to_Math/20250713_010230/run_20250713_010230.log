def solve():
    # We need to find the value of n such that the total number of squares is 70
    total_squares = 70
    
    # The number of squares of size 1x1, 2x2, and 3x3 in a 3 x n grid
    def count_squares(n):
        # Count of 1x1 squares
        count_1x1 = (3 - 1) * (n - 1)  # (rows - 1) * (columns - 1)
        
        # Count of 2x2 squares
        count_2x2 = (3 - 2) * (n - 2)  # (rows - 2) * (columns - 2)
        
        # Count of 3x3 squares
        count_3x3 = (3 - 3) * (n - 3)  # (rows - 3) * (columns - 3)
        
        return count_1x1 + count_2x2 + count_3x3
    
    # We will iterate over possible values of n to find the one that gives us 70 squares
    n = 1
    while True:
        if count_squares(n) == total_squares:
            return n
        n += 1

