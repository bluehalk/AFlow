    # We need to express result in the form a + b * sec(20 degrees)
    # result = a + b * sec(20)
    # Rearranging gives us b = (result - a) / sec(20)
    
    # Since we want integers a and b, we can find a and b
    # Let's calculate b first
    b = round(result / sec_20)
    a = round(result - b * sec_20)
    
    return (a, b)

