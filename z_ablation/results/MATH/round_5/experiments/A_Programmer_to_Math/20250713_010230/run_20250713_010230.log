    # Function to get the prime factorization of a number
    def prime_factors(n):
        factors = defaultdict(int)
        d = 2
        while d * d <= n:
            while (n % d) == 0:
                factors[d] += 1
                n //= d
            d += 1
        if n > 1:
            factors[n] += 1
        return factors

