def solve():
    # Define the variable
    x = sp.symbols('x')
    
    # We know that cos(20 degrees) can be expressed using the cosine triple angle formula:
    # cos(3θ) = 4cos^3(θ) - 3cos(θ)
    # Let θ = 20 degrees, then 3θ = 60 degrees, and cos(60 degrees) = 1/2
    # Therefore, we have the equation:
    # 1/2 = 4cos^3(20 degrees) - 3cos(20 degrees)
    
    # Rearranging gives us:
    # 4cos^3(20 degrees) - 3cos(20 degrees) - 1/2 = 0
    # Multiplying through by 2 to eliminate the fraction:
    # 8cos^3(20 degrees) - 6cos(20 degrees) - 1 = 0
    
    # Letting y = cos(20 degrees), we have:
    # 8y^3 - 6y - 1 = 0
    
    # Coefficients are [8, -6, 0, -1]
    coeffs = [8, -6, 0, -1]
    
    # We need to ensure the coefficients have no common factor other than 1
    gcd = sp.gcd(*coeffs)
    if gcd != 1:
        coeffs = [c // gcd for c in coeffs]
    
    # Return the polynomial in the required format
    return f"{coeffs[0]}x^3 + {coeffs[1]}x^2 + {coeffs[2]}x + {coeffs[3]}"

