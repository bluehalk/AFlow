import sympy as sp

def solve():
    # Define the symbols
    A, B = sp.symbols('A B')
    
    # Given equation: sin(2A + B) / sin(B) = 5
    equation = sp.sin(2*A + B) / sp.sin(B) - 5
    
    # Solve for tan(A + B) / tan(A)
    # We can use the identity: tan(A + B) = (tan A + tan B) / (1 - tan A * tan B)
    tan_A = sp.tan(A)
    tan_B = sp.tan(B)
    tan_A_plus_B = (tan_A + tan_B) / (1 - tan_A * tan_B)
    
    # We need to find tan(A + B) / tan(A)
    ratio = tan_A_plus_B / tan_A
    
    # Solve the equation for B in terms of A
    solutions = sp.solve(equation, B)
    
    # Substitute the solutions back into the ratio
    results = []
    for sol in solutions:
        ratio_substituted = ratio.subs(B, sol)
        results.append(ratio_substituted)
    
    # Return the first result as the final answer
    return results[0].simplify()

# Call the solve function and print the result
result = solve()
print(result)
```
