    prob_6_apples = (comb(total_fruit, k_apples) * 
                     (p_apple ** k_apples) * 
                     (p_orange ** (total_fruit - k_apples) + p_banana ** (total_fruit - k_apples)))
    
    # Total probability of either event occurring
    total_probability = prob_3_oranges + prob_6_apples
    
    return total_probability

# Call the solve function and print the result
