    total_letters = 8
    # The word "SIXTEEN" has 2 E's, so we need to account for that in permutations
    repeated_letters = 2
    
    # Calculate total arrangements of the letters in "SIXTEEN"
    total_arrangements = factorial(total_letters) // factorial(repeated_letters)
    
    # Calculate arrangements where the two E's are together
    # Treat the two E's as a single unit
    letters_with_Es_together = total_letters - 1  # 7 units (EE, S, I, X, T, N)
    arrangements_with_Es_together = factorial(letters_with_Es_together)
    
    # Calculate the probability that the two E's are not next to each other
    arrangements_without_Es_together = total_arrangements - arrangements_with_Es_together
    probability_not_together = arrangements_without_Es_together / total_arrangements
    
    return probability_not_together

