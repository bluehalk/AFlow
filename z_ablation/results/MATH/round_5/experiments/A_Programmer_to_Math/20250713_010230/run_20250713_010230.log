    total_cards = 54
    
    # The number of ways to choose 2 positions for the jokers from the total cards
    from math import comb
    
    # The expected number of cards between the two jokers can be calculated as follows:
    # For any two positions chosen for the jokers, the number of cards between them can vary
    # from 0 (if they are adjacent) to 52 (if they are at the ends).
    
    # The expected number of cards between the two jokers can be calculated using the formula:
    # E(X) = (1/(n choose 2)) * sum of (number of cards between jokers for each pair of positions)
    
    # The number of pairs of positions for the jokers
    total_pairs = comb(total_cards, 2)
    
    # The sum of the number of cards between the two jokers for all pairs
    sum_between = 0
    
    # Iterate over all possible positions for the first joker
    for i in range(total_cards):
        # The second joker can be placed in any position after the first joker
        for j in range(i + 1, total_cards):
            # The number of cards between the two jokers is (j - i - 1)
            sum_between += (j - i - 1)
    
    # Calculate the expected value
    expected_value = sum_between / total_pairs
    
    return expected_value

