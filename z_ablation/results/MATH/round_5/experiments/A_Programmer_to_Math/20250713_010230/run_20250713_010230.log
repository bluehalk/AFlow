Express your answer as an integer from $0$ to $11^2-1$, inclusive.

2025-07-13 01:05:13 - INFO - ```python
def extended_gcd(a, b):
    """Return gcd of a and b, and coefficients x, y such that ax + by = gcd(a, b)"""
    if a == 0:
        return b, 0, 1
    gcd, x1, y1 = extended_gcd(b % a, a)
    x = y1 - (b // a) * x1
    y = x1
    return gcd, x, y

def solve():
    # We need to find the modular inverse of 24 modulo 121 (11^2)
    a = 24
    m = 11**2  # 121

    # Use extended Euclidean algorithm to find the inverse
    gcd, x, _ = extended_gcd(a, m)

    # If gcd is not 1, then the inverse does not exist
    if gcd != 1:
        raise ValueError("Inverse does not exist")

    # x is the modular inverse, we need it to be positive
    inverse = x % m
    return inverse

# Call the solve function and print the result
result = solve()
print(result)
```
