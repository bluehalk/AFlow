def sum_of_proper_divisors(n):
    """Calculate the sum of proper divisors of n."""
    divisors_sum = 0
    # Loop through possible divisors from 1 to n//2
    for i in range(1, n // 2 + 1):
        if n % i == 0:  # Check if i is a divisor of n
            divisors_sum += i
    return divisors_sum

def solve():
    """Calculate the sum of the proper divisors of 198."""
    number = 198
    result = sum_of_proper_divisors(number)
    return result

# Call the solve function and print the result
if __name__ == "__main__":
    print(solve())
