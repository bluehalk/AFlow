def solve():
    # Distances from point P to the five vertices of the octahedron
    distances = [3, 7, 8, 9, 11]
    
    # Calculate the square of the distances
    squared_distances = [d ** 2 for d in distances]
    
    # The sum of the squares of the distances to the first five vertices
    sum_of_squares = sum(squared_distances)
    
    # The distance from the center of the octahedron to a vertex
    # For a regular octahedron with vertices at (±1, 0, 0), (0, ±1, 0), (0, 0, ±1)
    # The distance from the center (0, 0, 0) to any vertex is sqrt(1^2 + 1^2 + 1^2) = sqrt(3)
    # The distance from P to the sixth vertex can be calculated using the property of distances
    # The sum of the squares of the distances from any point to the vertices of a regular octahedron
    # is constant and equal to 6 times the square of the distance from the center to a vertex.
    
    # The distance from the center to a vertex
    center_to_vertex_distance = (3 ** 0.5)  # sqrt(3)
    
    # The constant sum of squares for the octahedron
    constant_sum = 6 * (center_to_vertex_distance ** 2)
    
    # The square of the distance to the sixth vertex
    sixth_vertex_distance_squared = constant_sum - sum_of_squares
    
    # The distance to the sixth vertex
    sixth_vertex_distance = sixth_vertex_distance_squared ** 0.5
    
    return sixth_vertex_distance

# Call the solve function and print the result
result = solve()
