import sympy as sp

def solve():
    # Define the variables
    a, b, c, d = sp.symbols('a b c d')
    
    # Define the matrix M
    M = sp.Matrix([[a, b], [c, d]])
    
    # Calculate M^3
    M_cubed = M**3
    
    # Define the identity matrix I
    I = sp.eye(2)
    
    # Set up the equation M^3 = I
    equations = M_cubed - I
    
    # Solve the equations
    solutions = sp.solve(equations, (a, b, c, d))
    
    # Extract the values of a + d from the solutions
    possible_values = set()
    for sol in solutions:
        a_val = sol[a]
        d_val = sol[d]
        possible_values.add(a_val + d_val)
    
    # Convert the set to a sorted list and format the output
    result = sorted(possible_values)
    
    # Return the result as a comma-separated string
    return ', '.join(map(str, result))

# Call the solve function and print the result
print(solve())
