import math

def solve():
    # Radii of the known circles
    r1 = 1
    r2 = 2
    r3 = 3
    
    # Using Descartes' Circle Theorem to find the radius of the fourth circle
    # The formula for the curvature k of a circle is k = 1/r, where r is the radius
    k1 = 1 / r1
    k2 = 1 / r2
    k3 = 1 / r3
    
    # The curvature of the fourth circle (k4) can be calculated using the formula:
    # (k1 + k2 + k3 + k4)^2 = 2 * (k1^2 + k2^2 + k3^2 + k4^2)
    # Rearranging gives us:
    # k4 = k1 + k2 + k3 ± 2 * sqrt(k1 * k2 + k2 * k3 + k3 * k1)
    
    k4_positive = k1 + k2 + k3 + 2 * math.sqrt(k1 * k2 + k2 * k3 + k3 * k1)
    k4_negative = k1 + k2 + k3 - 2 * math.sqrt(k1 * k2 + k2 * k3 + k3 * k1)
    
    # We are interested in the smallest radius, which corresponds to the negative curvature
    k4 = k4_negative
    
    # The radius r is the reciprocal of the curvature
    r = 1 / k4
    
    return r

# Call the solve function and print the result
result = solve()
print(result)
```
