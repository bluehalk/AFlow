    marked_frogs = 45
    
    # Number of frogs observed the next day
    observed_frogs = 40
    
    # Number of marked frogs observed
    marked_observed = 10
    
    # Using the Lincoln-Petersen estimator to estimate the total frog population
    # N = (M * C) / R
    # Where:
    # N = estimated total population
    # M = number of marked frogs (marked_frogs)
    # C = total number of frogs captured in the second sample (observed_frogs)
    # R = number of marked frogs recaptured (marked_observed)
    
    estimated_population = (marked_frogs * observed_frogs) / marked_observed
    
    return estimated_population

