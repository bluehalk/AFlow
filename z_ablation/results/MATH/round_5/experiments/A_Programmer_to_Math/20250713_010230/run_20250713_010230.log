from itertools import combinations
from fractions import Fraction

def solve():
    # Define the set of numbers
    numbers = {2, 4, 12, 14, 21, 28, 98}
    
    # Calculate the total number of ways to choose 2 distinct members
    total_combinations = len(list(combinations(numbers, 2)))
    
    # Define the target multiple
    target_multiple = 196
    
    # Count the number of valid combinations whose product is a multiple of 196
    valid_count = 0
    
    for a, b in combinations(numbers, 2):
        product = a * b
        if product % target_multiple == 0:
            valid_count += 1
    
    # Calculate the probability
    probability = Fraction(valid_count, total_combinations)
    
    return str(probability)

# Call the solve function and print the result
print(solve())
```
