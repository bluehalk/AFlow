    total_outcomes = 1
    for prime in primes:
        total_outcomes *= prime  # Multiply the number of choices for each prime
    
    # Count the number of favorable outcomes where the sum is greater than 0
    favorable_outcomes = 0
    
    # Iterate through all possible combinations of choices
