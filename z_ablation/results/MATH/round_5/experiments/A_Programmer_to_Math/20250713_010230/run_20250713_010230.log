    angle_20_deg = math.radians(20)
    angle_10_deg = math.radians(10)
    
    # Calculate sec^2(20 degrees)
    sec_20 = 1 / math.cos(angle_20_deg)
    sec_20_squared = sec_20 ** 2
    
    # Calculate sin^2(10 degrees)
    sin_10_squared = math.sin(angle_10_deg) ** 2
    
    # Calculate the expression inside the cube root
    expression = 3 * sec_20_squared * sin_10_squared
    
    # Calculate the cube root
    cube_root = expression ** (1/3)
    
    # Calculate the final result
    result = 2 * cube_root
    
    # Express result in the form a + b * sec(20 degrees)
