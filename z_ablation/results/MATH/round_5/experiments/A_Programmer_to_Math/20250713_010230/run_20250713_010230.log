def solve():
    # Define the repeating decimals
    decimal_a = 0.0 + 0.3 / 9  # 0.0(3) = 1/3
    decimal_b = 0.03 / 99      # 0.0(03) = 1/33

    # Perform the division
    result = decimal_a / decimal_b

    # Convert the result to a mixed number
    whole_number = int(result)
    fractional_part = result - whole_number

    # Convert the fractional part to a fraction
    from fractions import Fraction
    fraction = Fraction(fractional_part).limit_denominator()

    # Prepare the mixed number format
    if whole_number == 0:
        mixed_number = f"{fraction.numerator}/{fraction.denominator}"
    else:
        mixed_number = f"{whole_number} {fraction.numerator}/{fraction.denominator}"

    return mixed_number

# Call the solve function and print the result
print(solve())
