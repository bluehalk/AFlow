    # Iterate through all possible combinations of the last four digits (0000 to 9999)
    for last_four in range(10000):
        # Extract each digit from the last four digits
        d1 = last_four // 1000          # Thousands place
        d2 = (last_four // 100) % 10     # Hundreds place
        d3 = (last_four // 10) % 10      # Tens place
