def solve():
    # Define the day of the week for January 1, 2000
    day_of_week_2000 = 6  # Saturday (0=Monday, 1=Tuesday, ..., 6=Sunday)
    
    # Calculate the number of years between 1960 and 2000
    start_year = 1960
    end_year = 2000
    years_difference = end_year - start_year
    
    # Initialize total days to count backwards
    total_days = 0
    
    # Count the total number of days from 1960 to 2000
    for year in range(start_year, end_year):
        # Check if the year is a leap year
        if (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0):
            total_days += 366  # Leap year
        else:
            total_days += 365  # Non-leap year
    
    # Calculate the day of the week for January 1, 1960
    # We subtract the total days from the known day of week
    day_of_week_1960 = (day_of_week_2000 - (total_days % 7)) % 7
    
    # Map the day of the week to a string
    days = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
    
    return days[day_of_week_1960]

