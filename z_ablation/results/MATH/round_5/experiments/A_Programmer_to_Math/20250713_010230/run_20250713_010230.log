def is_prime(n):
    """Check if a number is prime."""
    if n <= 1:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

def least_perfect_square_with_three_prime_factors():
    """Find the least perfect square with 3 different prime factors."""
    prime_factors = []
    num = 1
    
    # Continue until we find a perfect square with 3 different prime factors
    while True:
        num += 1
        if is_prime(num):
            prime_factors.append(num)
        
        # Check if we have 3 different prime factors
        if len(prime_factors) == 3:
            # Calculate the least perfect square
            perfect_square = (prime_factors[0] * prime_factors[1] * prime_factors[2]) ** 2
            return perfect_square

def solve():
    """Solve the problem and return the result."""
    return least_perfect_square_with_three_prime_factors()

# Output the result
result = solve()
print(result)
