2025-07-13 01:08:04 - INFO - ```python
def solve():
    # Probability of a picture turning out
    p_success = 1 / 5
    # Probability of a picture not turning out
    p_failure = 1 - p_success
    
    # Desired probability of at least one picture turning out
    desired_probability = 3 / 4
    
    # Initialize the number of pictures taken
    n = 0
    # Calculate the probability of at least one picture turning out
    while True:
        n += 1
        # Probability of all n pictures failing
        probability_all_fail = p_failure ** n
        # Probability of at least one picture turning out
        probability_at_least_one_success = 1 - probability_all_fail
        
        # Check if the probability meets or exceeds the desired probability
        if probability_at_least_one_success >= desired_probability:
            break
    
    return n

# Call the solve function and print the result
result = solve()
print(result)
```
