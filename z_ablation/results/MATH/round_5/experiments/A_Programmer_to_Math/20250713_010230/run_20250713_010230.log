def solve():
    from itertools import permutations

    # Define the numbers we are working with
    numbers = [1, 2, 3, 4, 5, 6]

    # Function to check if a given arrangement is valid
    def is_valid(arrangement):
        for number in arrangement:
            # Check all divisors of the number
            for divisor in range(1, number):
                if number % divisor == 0:
                    # If the divisor is not to the left of the number, return False
                    if arrangement.index(divisor) > arrangement.index(number):
                        return False
        return True

    # Count valid arrangements
    valid_count = 0
    for perm in permutations(numbers):
        if is_valid(perm):
            valid_count += 1

    return valid_count

# Call the solve function and print the result
result = solve()
print(result)
