def solve():
    from math import gcd

    # Number of colors
    colors = 5
    # Number of squares
    squares = 4

    # Using Burnside's lemma to count distinct colorings considering rotations
    # The group of rotations for a 2x2 board has 4 elements: 0°, 90°, 180°, 270°
    # We will calculate the number of colorings fixed by each rotation.

    # 0° rotation (identity): All colorings are fixed
    fixed_identity = colors ** squares

    # 90° rotation: No coloring can be fixed because all squares must be the same color
    fixed_90 = colors

    # 180° rotation: Opposite squares must be the same color
    # (1, 4) and (2, 3) must match, so we have colors^2 choices
    fixed_180 = colors ** 2

    # 270° rotation: Similar to 90° rotation, no coloring can be fixed
    fixed_270 = colors

    # Total fixed colorings
    total_fixed = (fixed_identity + fixed_90 + fixed_180 + fixed_270)

    # Number of distinct colorings is the average number of fixed colorings
    distinct_colorings = total_fixed // 4

    return distinct_colorings

# Call the solve function and print the result
result = solve()
print(result)
