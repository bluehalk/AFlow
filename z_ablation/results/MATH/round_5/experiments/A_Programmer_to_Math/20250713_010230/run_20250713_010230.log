2025-07-13 01:04:48 - INFO - ```python
from itertools import permutations
from fractions import Fraction

def is_divisible_by_11(n):
    # Convert the number to string to access its digits
    s = str(n)
    # Calculate the alternating sum of the digits
    alternating_sum = sum(int(s[i]) if i % 2 == 0 else -int(s[i]) for i in range(len(s)))
    # Check if the alternating sum is divisible by 11
    return alternating_sum % 11 == 0

def solve():
    digits = [2, 3, 4, 7, 8]
    total_count = 0
    divisible_count = 0
    
    # Generate all permutations of the digits
    for perm in permutations(digits):
        number = int(''.join(map(str, perm)))
        total_count += 1
        if is_divisible_by_11(number):
            divisible_count += 1
            
    # Calculate the probability as a fraction
    probability = Fraction(divisible_count, total_count)
    return str(probability)

# Call the solve function and print the result
print(solve())
```
