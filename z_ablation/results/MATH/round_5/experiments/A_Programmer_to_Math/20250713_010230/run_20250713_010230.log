def is_terminating_decimal(n):
    # A fraction 1/k is a terminating decimal if and only if k has no prime factors other than 2 and 5.
    while n % 2 == 0:
        n //= 2
    while n % 5 == 0:
        n //= 5
    return n == 1

def solve():
    n = 1
    terminating_count = 0
    
    while True:
        if is_terminating_decimal(n):
            terminating_count += 1
        
        # Check if exactly half of the fractions are terminating
        if terminating_count * 2 == n:
            return n
        
        n += 1

