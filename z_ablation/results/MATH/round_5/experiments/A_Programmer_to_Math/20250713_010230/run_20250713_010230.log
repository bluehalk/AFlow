def solve():
    import sympy as sp

    # Define the ratio k
    k = sp.symbols('k', positive=True)

    # Define the dimensions of the rectangle
    width = 2 * k  # AB = 2k
    height = 2     # AD = 2 (fixed height)

    # Area of the rectangle ABCD
    area_rectangle = width * height

    # The center O of the rectangle is at (0, 0)
    # The vertices A, B, C, D are at (-k, 1), (k, 1), (k, -1), (-k, -1)

    # The distance from O to any vertex (e.g., A) is:
    distance_O_A = sp.sqrt(k**2 + 1**2)

    # The region where points are closer to O than to any vertex is defined by:
    # The perpendicular bisector of the line segment from O to each vertex.
    # For vertex A (-k, 1), the line is y = (1/k)(x + k) + 1
    # For vertex B (k, 1), the line is y = -(1/k)(x - k) + 1
    # For vertex C (k, -1), the line is y = (1/k)(x - k) - 1
    # For vertex D (-k, -1), the line is y = -(1/k)(x + k) - 1

    # The area closer to O than to any vertex is a smaller rectangle
    # whose vertices can be calculated as follows:
    # The intersection points of the lines give the vertices of the inner rectangle.

    # The vertices of the inner rectangle can be calculated as:
    inner_width = k / (1 + k**2)
    inner_height = 1 / (1 + k**2)

    # Area of the inner rectangle
    area_inner_rectangle = inner_width * inner_height

    # Probability that a point chosen randomly from the rectangle is closer to O
    probability = area_inner_rectangle / area_rectangle

    # Simplifying the probability expression
    probability_simplified = sp.simplify(probability)

    return probability_simplified

