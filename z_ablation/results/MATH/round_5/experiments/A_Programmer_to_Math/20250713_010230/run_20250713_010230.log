def solve():
    # Number of flips for each coin
    flips_A = 3  # Coin A is flipped 3 times
    flips_B = 4  # Coin B is flipped 4 times

    # Total outcomes for each coin
    total_outcomes_A = 2 ** flips_A  # 2^3 outcomes for coin A
    total_outcomes_B = 2 ** flips_B  # 2^4 outcomes for coin B

    # Calculate the probability of getting the same number of heads
    probability_same_heads = 0

    # Iterate over the possible number of heads for coin A
    for heads_A in range(flips_A + 1):
        # Calculate the number of ways to get heads_A from coin A
        ways_A = comb(flips_A, heads_A)

        # Calculate the number of ways to get heads_A from coin B
        if heads_A <= flips_B:
            ways_B = comb(flips_B, heads_A)
        else:
            ways_B = 0

        # Update the probability of getting the same number of heads
        probability_same_heads += ways_A * ways_B

    # Total ways to get outcomes from both coins
    total_ways = total_outcomes_A * total_outcomes_B

    # Calculate the final probability
    final_probability = probability_same_heads / total_ways

    return final_probability

# Call the solve function and print the result
result = solve()
print(result)
