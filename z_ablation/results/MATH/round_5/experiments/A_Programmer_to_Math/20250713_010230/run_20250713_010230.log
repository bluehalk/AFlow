    # Parametric equations of the line: P(t) = (0,0,1) + t * (1,1,0)
    # where t is a parameter
    # We can express a point on the line as:
    # P(t) = (t, t, 1) for t in [0, 1]
    
    # Function to calculate the distance squared from the origin to a point on the line and then to (1,0,0)
    def distance_squared(t):
