2025-07-13 01:08:13 - INFO - ```python
def solve():
    # Define the target sum
    target_sum = 9
    # Define the possible addends
    addends = [1, 2, 4]
    
    # Create a list to store the number of ways to form each sum
    ways = [0] * (target_sum + 1)
    # There is one way to make the sum of 0: using no addends
    ways[0] = 1
    
    # Iterate over each addend
    for addend in addends:
        # Update the ways to form sums from the current addend to the target sum
        for current_sum in range(addend, target_sum + 1):
            ways[current_sum] += ways[current_sum - addend]
    
    # The result is the number of ways to form the target sum
    return ways[target_sum]

# Call the solve function and print the result
result = solve()
print(result)
```
