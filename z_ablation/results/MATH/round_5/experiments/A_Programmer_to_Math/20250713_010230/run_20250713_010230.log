def solve():
    # Given constants
    A = 12_500_000
    R = 111
    M = 999_999_999
    
    # We need to find the smallest positive integer n such that:
    # (A * n) % M == R
    # Rearranging gives us:
    # A * n ≡ R (mod M)
    
    # We can find n by solving the equation:
    # n ≡ (R * A_inv) (mod M)
    # where A_inv is the modular inverse of A modulo M.
    
    # Function to compute the modular inverse using Extended Euclidean Algorithm
    def extended_gcd(a, b):
        if a == 0:
            return b, 0, 1
        gcd, x1, y1 = extended_gcd(b % a, a)
        x = y1 - (b // a) * x1
        return gcd, x, y1
    
    def mod_inverse(a, m):
        gcd, x, _ = extended_gcd(a, m)
        if gcd != 1:
            raise ValueError("Inverse doesn't exist")
        else:
            return x % m
    
    # Calculate the modular inverse of A modulo M
    A_inv = mod_inverse(A, M)
    
    # Calculate n
    n = (R * A_inv) % M
    
    # Since we need the smallest positive integer n, we check if n is zero
    if n == 0:
        n += M
    
    return n

# Call the solve function and print the result
result = solve()
