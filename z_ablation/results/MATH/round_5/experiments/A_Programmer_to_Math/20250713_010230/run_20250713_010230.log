def solve():
    # Total possible outcomes when rolling a die twice
    total_outcomes = 6 * 6  # 6 options for the tens digit and 6 for the ones digit
    
    # Count the number of favorable outcomes that are divisible by 8
    favorable_outcomes = 0
    
    # Loop through all possible outcomes
    for tens in range(1, 7):  # Tens digit can be 1 to 6
        for ones in range(1, 7):  # Ones digit can be 1 to 6
            number = tens * 10 + ones  # Form the two-digit number
            if number % 8 == 0:  # Check if the number is divisible by 8
                favorable_outcomes += 1
    
    # Calculate the probability as a fraction
    from fractions import Fraction
    probability = Fraction(favorable_outcomes, total_outcomes)
    
    return str(probability)

