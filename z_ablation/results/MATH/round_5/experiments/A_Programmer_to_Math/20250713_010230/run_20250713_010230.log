    # Given values
    GCD = 8
    LCM = 112
    
    # The relationship between GCD and LCM
    # m * n = GCD(m, n) * LCM(m, n)
    # m * n = GCD * LCM
    product = GCD * LCM  # This is m * n
    
    # We need to find m and n such that:
    # 1. gcd(m, n) = 8
    # 2. lcm(m, n) = 112
    # 3. m + n is minimized
    
    # Let m = 8a and n = 8b where gcd(a, b) = 1
    # Then lcm(m, n) = (m * n) / gcd(m, n) = (8a * 8b) / 8 = 8ab
    # We need 8ab = 112 => ab = 14
    
    # Now we need to find pairs (a, b) such that a * b = 14 and gcd(a, b) = 1
    pairs = []
    for a in range(1, 15):
        if 14 % a == 0:
            b = 14 // a
            if gcd(a, b) == 1:
                pairs.append((a, b))
    
    # Calculate m + n for each valid pair
    min_sum = float('inf')
    for a, b in pairs:
        m = GCD * a
        n = GCD * b
        min_sum = min(min_sum, m + n)
    
    return min_sum

