import numpy as np
from fractions import Fraction
from math import gcd
from functools import reduce

def solve():
    # Define the reflection matrix
    reflection_matrix = np.array([
        [-2/3, -2/3, -1/3],
        [-2/3, 1/3, 2/3],
        [-1/3, 2/3, -2/3]
    ])
    
    # Calculate the eigenvalues and eigenvectors
    eigenvalues, eigenvectors = np.linalg.eig(reflection_matrix)
    
    # The eigenvalue corresponding to the direction vector of line l is 1
    # Find the eigenvector corresponding to the eigenvalue 1
    direction_vector = eigenvectors[:, np.isclose(eigenvalues, 1)].flatten()
    
    # Convert the direction vector to integers
    direction_vector = direction_vector / np.gcd.reduce(np.round(direction_vector * 1000).astype(int))
    
    # Ensure the first element is positive
    if direction_vector[0] < 0:
        direction_vector = -direction_vector
    
    # Convert to integers
    direction_vector = np.round(direction_vector).astype(int)
    
    return f"\\begin{{pmatrix}} {direction_vector[0]} \\\\ {direction_vector[1]} \\\\ {direction_vector[2]} \\end{{pmatrix}}"

# Call the solve function and print the result
result = solve()
print(result)
