    # Probability of choosing each type of fruit
    p_orange = 1/3
    p_apple = 1/3
    p_banana = 1/3
    
    # Calculate the probability of exactly 3 oranges
    k_oranges = 3
    prob_3_oranges = (comb(total_fruit, k_oranges) * 
                      (p_orange ** k_oranges) * 
                      (p_apple ** (total_fruit - k_oranges) + p_banana ** (total_fruit - k_oranges)))
    
    # Calculate the probability of exactly 6 apples
