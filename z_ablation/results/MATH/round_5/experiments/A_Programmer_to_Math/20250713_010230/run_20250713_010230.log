    diff2 = a2 - b2  # 468 - 13 = 455
    
    # Find the greatest common divisor (gcd) of the differences
    from math import gcd
    g = gcd(diff1, diff2)  # gcd(91, 455)
    
    # Find all divisors of g
    def find_divisors(n):
        divisors = set()
        for i in range(1, int(n**0.5) + 1):
            if n % i == 0:
                divisors.add(i)
                divisors.add(n // i)
        return divisors
    
