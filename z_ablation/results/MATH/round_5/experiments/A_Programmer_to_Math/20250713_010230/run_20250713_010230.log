                                    no_rap_country_ways - no_rap_metal_ways - no_country_metal_ways)
    
    # Ways to choose with at least one from each category
    ways_with_all_categories = total_ways - ways_without_all_categories
    
    # Probability
    probability = ways_with_all_categories / total_ways
    
    # Return the probability as a common fraction
