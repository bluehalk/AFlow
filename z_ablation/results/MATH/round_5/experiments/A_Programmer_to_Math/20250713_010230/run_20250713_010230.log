def solve():
    # Define the number for which we want to find multiples
    number = 12
    
    # Initialize counters for positive and negative multiples
    positive_count = 0
    negative_count = 0
    
    # Calculate positive multiples
    for i in range(1, number + 1):
        if number % i == 0:
            positive_count += 1
    
    # Calculate negative multiples
    for i in range(-1, -number - 1, -1):
        if number % i == 0:
            negative_count += 1
    
    # Return the result as a tuple (positive_count, negative_count)
    return positive_count, negative_count

