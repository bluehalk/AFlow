def solve():
    # Number of rows of pegs
    n = 8
    
    # The total number of slots at the bottom is n + 1
    total_slots = n + 1
    
    # The middle slot index
    middle_slot_index = n // 2
    
    # Using dynamic programming to calculate the number of ways to reach each slot
    # dp[i] will hold the number of ways to reach slot i
    dp = [0] * total_slots
    dp[0] = 1  # There's one way to be at the starting position (top)

    # Iterate through each row of pegs
    for _ in range(n):
        new_dp = [0] * total_slots
        for j in range(total_slots):
            if j > 0:
                new_dp[j - 1] += dp[j]  # Move to the left slot
            if j < total_slots - 1:
                new_dp[j + 1] += dp[j]  # Move to the right slot
        dp = new_dp

    # The total number of ways to reach any slot
    total_ways = sum(dp)
    
    # The number of ways to reach the middle slot
    ways_to_middle_slot = dp[middle_slot_index]
    
    # The probability of landing in the middle slot
    probability = ways_to_middle_slot / total_ways
    
    return probability

# Call the solve function and print the result
result = solve()
print(result)
