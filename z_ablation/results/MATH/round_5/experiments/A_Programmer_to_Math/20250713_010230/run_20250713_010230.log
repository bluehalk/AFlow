    correct_answers = [False] * (total_questions + 1)  # Index 0 is unused
    for i in range(1, total_questions + 1):
        if i % 4 == 0:
            correct_answers[i] = True  # Every question that is a multiple of 4 is true
    
    # Student's answers
    student_answers = [False] * (total_questions + 1)  # Index 0 is unused
    for i in range(1, total_questions + 1):
        if i % 3 == 0:
            student_answers[i] = False  # Marks multiples of 3 as false
        else:
            student_answers[i] = True  # Marks all others as true
    
    # Count the number of correct answers
    correct_count = 0
    for i in range(1, total_questions + 1):
        if correct_answers[i] == student_answers[i]:
            correct_count += 1
    
    return correct_count

