def gcd(m, n):
    while n:
        m, n = n, m % n
    return m

def lcm(m, n):
    return m * n // gcd(m, n)

def solve():
    target_lcm = 108
    target_gcd = 2
    
    # Since gcd(m, n) = 2, we can express m and n as:
    # m = 2a and n = 2b where gcd(a, b) = 1
    # Therefore, lcm(m, n) = (m * n) / gcd(m, n) = (2a * 2b) / 2 = 2ab
    # We need to find pairs (a, b) such that 2ab = 108
    # This simplifies to ab = 54
    
    ab_target = target_lcm // target_gcd
    count = 0
    
    # We need to find pairs (a, b) such that a * b = 54 and gcd(a, b) = 1
    for a in range(1, int(ab_target**0.5) + 1):
        if ab_target % a == 0:
            b = ab_target // a
            if gcd(a, b) == 1:
                count += 1  # (a, b) is a valid pair
                if a != b:
                    count += 1  # (b, a) is also a valid pair if a != b
    
    return count

# Call the solve function and print the result
result = solve()
print(result)
