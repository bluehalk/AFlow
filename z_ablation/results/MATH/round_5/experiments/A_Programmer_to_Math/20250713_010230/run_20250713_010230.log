def solve():
    # Define the modulus and the target number
    modulus = 37
    target_number = 18632
    target_congruence = 23
    
    # Find the first number less than target_number that is congruent to target_congruence mod modulus
    # We need to find the largest number less than target_number that satisfies the condition
    # This can be done by calculating the remainder of target_number when divided by modulus
    remainder = target_number % modulus
    
    # Calculate the largest number less than target_number that is congruent to target_congruence
    if remainder >= target_congruence:
        largest_congruent = target_number - (remainder - target_congruence)
    else:
        largest_congruent = target_number - (remainder + modulus - target_congruence)
    
