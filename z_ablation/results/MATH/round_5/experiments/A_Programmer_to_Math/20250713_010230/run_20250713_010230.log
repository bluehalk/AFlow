import cmath

def solve():
    # Define the root of unity
    n = 1729
    omega = cmath.exp(2 * cmath.pi * 1j / n)
    
    # Initialize the sum
    total_sum = 0
    
    # Calculate the sum
    for k in range(1, n):
        denominator = 1 + omega**k + omega**(2*k) + omega**(3*k)
        total_sum += 1 / denominator
    
    return total_sum.real  # Return the real part of the sum

# Call the solve function and print the result
result = solve()
print(result)
