                   [d for d in range(1, abs(a) + 1) if a % d == 0]
        
        # Calculate the product of the divisors
        product = 1
        for divisor in divisors:
            product *= divisor
        
        # Check if the product is negative
        if product < 0:
            count += 1
    
    return count

