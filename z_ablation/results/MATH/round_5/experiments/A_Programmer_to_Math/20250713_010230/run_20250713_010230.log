from fractions import Fraction

def solve():
    # Initial state: 2 red beads and 2 green beads
    red = 2
    green = 2
    
    # Total number of beads
    total_beads = red + green
    
    # Probability of drawing a red bead
    prob_red = Fraction(red, total_beads)
    # Probability of drawing a green bead
    prob_green = Fraction(green, total_beads)
    
    # After three draws and replacements, we need to calculate the probabilities
    # We can have the following scenarios:
    # 1. Draw red three times: RRR
    # 2. Draw red twice and green once: RRG, RGR, GRR
    # 3. Draw red once and green twice: RGG, GRG, GGR
    
    # Probability of drawing red three times (RRR)
    prob_RRR = prob_red * prob_red * prob_red
    
    # Probability of drawing red twice and green once (RRG, RGR, GRR)
    prob_RRG = 3 * (prob_red * prob_red * prob_green)
    
    # Probability of drawing red once and green twice (RGG, GRG, GGR)
    prob_RGG = 3 * (prob_red * prob_green * prob_green)
    
    # Total probability of having all beads red after three draws
    total_probability = prob_RRR + prob_RRG
    
    # Return the result as a common fraction
    return total_probability

# Call the solve function and print the result
result = solve()
print(result)
