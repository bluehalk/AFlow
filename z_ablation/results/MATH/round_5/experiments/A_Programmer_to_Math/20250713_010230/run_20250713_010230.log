    a = 5  # Length of side BC
    b = 6  # Length of side AC
    c = 7  # Length of side AB
    
    # Calculate the circumradius R using the formula R = (abc) / (4 * K)
    # where K is the area of the triangle
    # Using Heron's formula to calculate the area K
    s = (a + b + c) / 2  # semi-perimeter
    K = math.sqrt(s * (s - a) * (s - b) * (s - c))  # area of triangle
    
    R = (a * b * c) / (4 * K)  # circumradius

    # Calculate AF^2 + BF^2 + CF^2
    # The formula derived is AF^2 + BF^2 + CF^2 = (a^2 + b^2 + c^2) / 3 + (R^2)
    AF_BF_CF_squared = (a**2 + b**2 + c**2) / 3 + R**2
    
    return AF_BF_CF_squared

