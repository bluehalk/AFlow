import numpy as np
from sympy import gcd

def solve():
    # Coefficients of the first plane 3x - 6y + 2z + 5 = 0
    A1, B1, C1, D1 = 3, -6, 2, 5
    
    # Coefficients of the second plane 4x - 12y + 3z - 3 = 0
    A2, B2, C2, D2 = 4, -12, 3, -3
    
    # Point that lies on the bisecting plane
    point = np.array([-5, -1, -5])
    
    # Normal vectors of the planes
    n1 = np.array([A1, B1, C1])
    n2 = np.array([A2, B2, C2])
    
    # Calculate the angle bisector normal vector
    n_bisector = n1 / np.linalg.norm(n1) + n2 / np.linalg.norm(n2)
    
    # The equation of the plane can be expressed as:
    # n_bisector[0] * x + n_bisector[1] * y + n_bisector[2] * z + D = 0
    # We need to find D such that the plane passes through the given point
    D = - (n_bisector[0] * point[0] + n_bisector[1] * point[1] + n_bisector[2] * point[2])
    
    # Coefficients of the bisecting plane
    A = n_bisector[0]
    B = n_bisector[1]
    C = n_bisector[2]
    
    # Convert to integers
    A, B, C, D = map(lambda x: int(round(x)), [A, B, C, D])
    
    # Ensure A > 0 and gcd(|A|, |B|, |C|, |D|) = 1
    if A < 0:
        A, B, C, D = -A, -B, -C, -D
    
    common_gcd = gcd(abs(A), abs(B), abs(C), abs(D))
    
    A //= common_gcd
    B //= common_gcd
    C //= common_gcd
    D //= common_gcd
    
    return f"{A}x + {B}y + {C}z + {D} = 0"

# Call the solve function and print the result
result = solve()
print(result)
```
