def solve():
    # Total number of coin flips
    flips = 6
    
    # Possible outcomes: heads (H) means counterclockwise, tails (T) means clockwise
    # Each flip can be represented as +1 (H) or -1 (T)
    
    # The man starts at vertex 0
    # We need to find the number of ways to end up at vertex 0 after 6 flips
    
    # The position after n flips can be represented as:
    # position = (number of heads - number of tails) % 6
    # Since there are 6 flips, number of heads + number of tails = 6
    # Let h be the number of heads, then t = 6 - h
    # position = (h - (6 - h)) % 6 = (2h - 6) % 6
    # We need (2h - 6) % 6 == 0, which simplifies to 2h % 6 == 0
    
    # This means h must be a multiple of 3 (0, 3, 6)
    
    from math import comb
    
    # Total ways to flip the coin 6 times
    total_ways = 2 ** flips
    
    # Calculate the number of successful outcomes
    successful_outcomes = 0
    
    # h can be 0, 3, or 6
    for h in [0, 3, 6]:
        successful_outcomes += comb(flips, h)
    
    # Probability of being back at the starting vertex
    probability = successful_outcomes / total_ways
    
    return probability

# Call the solve function and print the result
