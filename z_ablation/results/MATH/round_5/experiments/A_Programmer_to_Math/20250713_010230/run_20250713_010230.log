def prime_factors(n):
    """Return the prime factorization of n as a dictionary."""
    factors = {}
    # Check for number of 2s that divide n
    while n % 2 == 0:
        if 2 in factors:
            factors[2] += 1
        else:
            factors[2] = 1
        n //= 2
    # n must be odd at this point, so we can skip even numbers
    for i in range(3, int(n**0.5) + 1, 2):
        while n % i == 0:
            if i in factors:
                factors[i] += 1
            else:
                factors[i] = 1
            n //= i
    # This condition is to check if n is a prime number greater than 2
    if n > 2:
        factors[n] = 1
    return factors

def count_perfect_square_factors(n):
    """Count the number of perfect square factors of n."""
    factors = prime_factors(n)
    count = 1
    for exponent in factors.values():
        # For each prime factor, the number of choices for perfect squares is (exponent // 2) + 1
        count *= (exponent // 2) + 1
    return count

def solve():
    # Calculate the product of the numbers
    product = 2 * 4 * 6 * 8 * 10 * 12
    # Count the perfect square factors of the product
    result = count_perfect_square_factors(product)
    return result

# Output the result
print(solve())
```
