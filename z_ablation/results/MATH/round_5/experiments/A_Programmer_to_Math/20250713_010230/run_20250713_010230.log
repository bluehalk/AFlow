2025-07-13 01:05:41 - INFO - ```python
from math import comb

def solve():
    # Total outcomes for each spin
    total_outcomes = 2 * 4  # 2 body parts (arm, leg) * 4 colors
    
    # Probability of moving to a red spot
    p_red = 1 / 4  # 1 red out of 4 colors
    p_not_red = 3 / 4  # 3 non-red colors
    
    # Probability of moving an arm
    p_arm = 1 / 2  # 1 arm out of 2 body parts
    p_leg = 1 / 2  # 1 leg out of 2 body parts
    
    # We need exactly 2 moves to a red spot and 3 arms
    n = 4  # total spins
    k_red = 2  # exactly 2 red moves
    k_arm = 3  # exactly 3 arm moves
    
    # Calculate the probability of exactly 2 red moves
    prob_red = comb(n, k_red) * (p_red ** k_red) * (p_not_red ** (n - k_red))
    
    # Calculate the probability of exactly 3 arm moves
    prob_arm = comb(n, k_arm) * (p_arm ** k_arm) * (p_leg ** (n - k_arm))
    
    # Since the events are independent, multiply the probabilities
    final_probability = prob_red * prob_arm
    
    return final_probability

# Call the solve function and print the result
result = solve()
print(result)
```
