    # Rearranging the equation to the form ax^4 - bx^2 + cy^2 = 0
    # We will express everything in terms of x and y
    left_side = y_squared - (4 * x**2 * (1 - x**2))
    
    # Collect terms
    left_side = sp.collect(left_side, x)
    
    # Coefficients of the polynomial
    coeffs = sp.Poly(left_side, x).all_coeffs()
    
    # Extract coefficients a, b, c
