    # Define cos(theta) = x
    cos_theta = sp.cos(sp.acos(x))
    
    # Create the polynomial equation
    polynomial = sp.expand(sp.cos(sp.acos(x) + sp.acos(2*x) + sp.acos(3*x)))
    
    # Convert the polynomial to standard form
    polynomial = sp.collect(polynomial, x)
    
    # Get the coefficients of the polynomial
    coeffs = sp.Poly(polynomial, x).all_coeffs()
    
    # Convert coefficients to integers
