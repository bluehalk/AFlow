import math

def solve():
    # Given length of AB
    AB = 2 * math.sqrt(5)  # cm
    
    # Since the squares are identical and aligned, we can find the coordinates of points A, B, and C
    # A is at (0, 2s), B is at (2s, 0), and C is at (3s, 0) where s is the side length of the squares.
    
    # The distance AB can be expressed using the coordinates:
    # A(0, 2s) and B(2s, 0)
    # Distance formula: d = sqrt((x2 - x1)^2 + (y2 - y1)^2)
    # AB = sqrt((2s - 0)^2 + (0 - 2s)^2)
    # AB = sqrt((2s)^2 + (-2s)^2) = sqrt(4s^2 + 4s^2) = sqrt(8s^2) = 2s * sqrt(2)
    
    # Setting the distance AB equal to the given length
    # 2s * sqrt(2) = 2 * sqrt(5)
    # s * sqrt(2) = sqrt(5)
    # s = sqrt(5) / sqrt(2) = sqrt(5/2)
    
    s = math.sqrt(5 / 2)
    
    # Now we need to find the length of AC
