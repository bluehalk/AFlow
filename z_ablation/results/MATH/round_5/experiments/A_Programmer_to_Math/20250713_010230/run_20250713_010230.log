2025-07-13 01:08:41 - INFO - ```python
def solve():
    from math import factorial

    # Number of distinguishable balls
    n = 4
    # Number of indistinguishable boxes
    k = 3

    # Using the "stars and bars" theorem to find the number of ways to distribute n distinguishable balls into k indistinguishable boxes
    # We need to find the partitions of n into at most k parts
    # This can be calculated using the formula: P(n, k) = number of ways to partition n into at most k parts

    # We will use a dynamic programming approach to calculate the number of partitions
    # dp[i][j] will be the number of ways to partition i using at most j parts
    dp = [[0] * (k + 1) for _ in range(n + 1)]
    
    # There is one way to partition 0 (using no parts)
    for j in range(k + 1):
        dp[0][j] = 1

    # Fill the dp table
    for i in range(1, n + 1):
        for j in range(1, k + 1):
            dp[i][j] = dp[i][j - 1]  # not using the j-th part
            if i >= j:
                dp[i][j] += dp[i - j][j]  # using the j-th part

    # The result is the number of ways to partition n using at most k parts
    result = dp[n][k]
    return result

# Call the solve function and print the result
print(solve())
```
