import math

def solve():
    # Given volume of the tetrahedron
    volume = 1 / math.sqrt(360)
    
    # The formula for the volume of a tetrahedron formed by three unit vectors
    # V = (1/6) * |det(a, b, c)|
    # For unit vectors with acute angles, we can express the determinant in terms of cos(theta)
    # The volume can also be expressed as:
    # V = (1/6) * sqrt(1 - 3 * cos^2(theta) + 2 * cos^3(theta))
    
    # Rearranging the volume formula to find cos(theta)
    # 6 * volume = sqrt(1 - 3 * cos^2(theta) + 2 * cos^3(theta))
    # Squaring both sides:
    # (6 * volume)^2 = 1 - 3 * cos^2(theta) + 2 * cos^3(theta)
    
    # Let x = cos(theta)
    # (6 * volume)^2 = 1 - 3x^2 + 2x^3
    # Rearranging gives us:
    # 2x^3 - 3x^2 + (1 - (6 * volume)^2) = 0
    
    # Calculate (6 * volume)^2
    left_side = (6 * volume) ** 2
    
    # Coefficients for the cubic equation
    a = 2
    b = -3
    c = 1 - left_side
    
    # We can use numerical methods to find the root of the cubic equation
    # Using numpy's roots function to find the roots of the polynomial
    import numpy as np
    
    # Coefficients of the polynomial 2x^3 - 3x^2 + 0x + (1 - (6 * volume)^2)
    coefficients = [a, b, 0, c]
    
    # Finding the roots
    roots = np.roots(coefficients)
    
    # We need to find the real root that is in the range [0, 1] (since cos(theta) must be a unit vector)
    cos_theta = None
    for root in roots:
        if np.isreal(root) and 0 <= root <= 1:
            cos_theta = root.real
            break
    
    # Now we can calculate the final expression: 3 * cos^2(theta) - 2 * cos^3(theta)
    result = 3 * cos_theta**2 - 2 * cos_theta**3
    
    return result

