import numpy as np
from fractions import Fraction
from math import gcd
from functools import reduce

def solve():
    # Define the projection matrix
    projection_matrix = np.array([
        [Fraction(13, 14), Fraction(-1, 7), Fraction(3, 14)],
        [Fraction(-1, 7), Fraction(5, 7), Fraction(3, 7)],
        [Fraction(3, 14), Fraction(3, 7), Fraction(5, 14)]
    ])
    
    # The normal vector can be found by calculating the null space of the projection matrix
    # We can find the normal vector by solving the equation: Ax = 0
    # where A is the projection matrix.
    
    # Calculate the eigenvalues and eigenvectors
    eigenvalues, eigenvectors = np.linalg.eig(projection_matrix)
    
    # The normal vector corresponds to the eigenvalue 0
    normal_vector = eigenvectors[:, np.isclose(eigenvalues, 1)].flatten()
    
    # Convert the normal vector to integers
    normal_vector = normal_vector / normal_vector[-1]  # Normalize to make the last component 1
    normal_vector = np.round(normal_vector).astype(int)
    
    # Ensure the first component is positive and gcd is 1
    a, b, c = normal_vector
    if a < 0:
        a, b, c = -a, -b, -c
    
    # Reduce to coprime integers
    common_gcd = reduce(gcd, [abs(a), abs(b), abs(c)])
    a //= common_gcd
    b //= common_gcd
    c //= common_gcd
    
    return f"\\begin{{pmatrix}} {a} \\\\ {b} \\\\ {c} \\end{{pmatrix}}"

# Call the solve function and print the result
result = solve()
print(result)
```
