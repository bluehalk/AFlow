2025-07-13 01:04:24 - INFO - ```python
def solve():
    # Number of groups
    num_democrats = 5
    num_republicans = 5
    num_independents = 1
    
    # Total groups: 3 (Democrats, Republicans, Independents)
    num_groups = 3
    
    # Arrangements of groups around a circular table
    # (n-1)! for circular permutations
    arrangements_of_groups = factorial(num_groups - 1)
    
    # Arrangements within each group
    arrangements_within_democrats = factorial(num_democrats)
    arrangements_within_republicans = factorial(num_republicans)
    arrangements_within_independents = factorial(num_independents)
    
    # Total arrangements
    total_arrangements = (arrangements_of_groups *
                          arrangements_within_democrats *
                          arrangements_within_republicans *
                          arrangements_within_independents)
    
    return total_arrangements

def factorial(n):
    if n == 0 or n == 1:
        return 1
    result = 1
    for i in range(2, n + 1):
        result *= i
    return result

# Call the solve function and print the result
