    # Parametric equations
    x = sp.sin(t)
    y = sp.sin(2*t)
    
    # Express y in terms of x
    # We know that y = sin(2t) = 2sin(t)cos(t) = 2x * sqrt(1 - x^2)
    # We can square both sides to eliminate the square root
    y_squared = y**2
    y_squared_expanded = (2 * x * sp.sqrt(1 - x**2))**2
    
    # Set up the equation
