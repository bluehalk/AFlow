import numpy as np

def solve():
    # Define the matrix A
    A = np.array([[2, -2, 1],
                  [2, -3, 2],
                  [-1, 2, 0]])
    
    # Calculate the eigenvalues of the matrix A
    eigenvalues = np.linalg.eigvals(A)
    
    # Convert eigenvalues to a set to get unique values
    unique_eigenvalues = set(eigenvalues)
    
    # Return the unique eigenvalues as a sorted list
    return sorted(unique_eigenvalues)

