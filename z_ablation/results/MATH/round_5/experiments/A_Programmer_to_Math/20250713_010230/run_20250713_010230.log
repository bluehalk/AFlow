    cos_20 = math.cos(math.radians(20))
    cos_35 = math.cos(math.radians(35))
    cos_50 = math.cos(math.radians(50))
    sin_5 = math.sin(math.radians(5))
    sin_20 = math.sin(math.radians(20))
    sin_35 = math.sin(math.radians(35))
