    # Candy per student in group B
    candy_per_student_b = (percentage_candy_b * total_candy) / students_group_b
    
    # Calculate the ratio of candy per student in group A to group B
    ratio = candy_per_student_a / candy_per_student_b
    
    # Return the ratio as a common fraction
