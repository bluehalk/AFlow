import numpy as np
from scipy.optimize import fsolve

def equation(x):
    return np.tan(7 * x) - np.sin(6 * x) - (np.cos(4 * x) - 1/np.tan(7 * x))

def solve():
    # Define the range for x
    x_values = np.linspace(0, 2 * np.pi, 1000)
    
    # Find the roots of the equation
    roots = []
    for x in x_values:
        # Use fsolve to find roots near each x value
        root = fsolve(equation, x)
        # Check if the root is within the desired range and not already in the list
        if 0 <= root[0] <= 2 * np.pi and not any(np.isclose(root[0], r) for r in roots):
            roots.append(root[0])
    
    # Sort the roots for output
    roots = sorted(roots)
    
    # Convert roots to a string format with 6 decimal places
    result = ', '.join(f"{r:.6f}" for r in roots)
    return result

# Call the solve function and print the result
