    return 1 / math.sin(radians)

def sec(degrees):
    radians = math.radians(degrees)
    return 1 / math.cos(radians)

def solve():
    # Calculate the sum of csc(2^k) for k from 3 to 2019
    total_csc_sum = sum(csc(2**k) for k in range(3, 2020))
    
    # We need to find n such that sec(n) = total_csc_sum
    # sec(n) = 1 / cos(n) => cos(n) = 1 / total_csc_sum
    cos_n = 1 / total_csc_sum
    
    # Find n in degrees such that 0 < n < 180
    for n in range(1, 180):
        if math.isclose(cos(n), cos_n, rel_tol=1e-9):
            return n

