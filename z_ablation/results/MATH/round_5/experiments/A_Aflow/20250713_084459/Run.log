2025-07-13 08:54:55 - INFO - ```python
def solve():
    # Step 1: Factor 1200 into its prime factors
    number = 1200
    factors = {}
    
    # Finding prime factors of 1200
    for i in range(2, int(number**0.5) + 1):
        while number % i == 0:
            if i in factors:
                factors[i] += 1
            else:
                factors[i] = 1
            number //= i
    if number > 1:
        factors[number] = 1
    
    # Step 2: Calculate the sum of all positive integer values of n such that n^2 is a factor of 1200
    sum_n = 0
    
    # For n^2 to be a factor, each prime factor's exponent in n^2 must be less than or equal to the exponent in 1200
    # This means for each prime factor p with exponent e in 1200, we can have n with exponent at most e//2
    for p, e in factors.items():
        max_n_exponent = e // 2
        # We can have n = p^0, p^1, ..., p^max_n_exponent
        for k in range(max_n_exponent + 1):
            sum_n += p ** k
    
    return sum_n

# Call the solve function and print the result
result = solve()
print(result)
```
