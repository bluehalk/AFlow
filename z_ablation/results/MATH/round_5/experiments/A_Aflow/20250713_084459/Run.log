def solve():
    # Let n be of the form p1^a * p2^b where p1 and p2 are distinct primes
    # The number of divisors of n is given by (a + 1) * (b + 1)
    # The number of divisors of n^2 is given by (2a + 1) * (2b + 1)
    
    # We know that n^2 has 27 divisors
    # Therefore, (2a + 1) * (2b + 1) = 27
    
    # The divisors of 27 are: 1, 3, 9, 27
    # We can express 27 as a product of two factors (2a + 1) and (2b + 1)
    
    # Possible pairs (2a + 1, 2b + 1) that multiply to 27:
    pairs = [(1, 27), (3, 9), (9, 3), (27, 1)]
    
    for x, y in pairs:
        # We need to solve for a and b
        # 2a + 1 = x  => a = (x - 1) / 2
        # 2b + 1 = y  => b = (y - 1) / 2
        
        a = (x - 1) // 2
        b = (y - 1) // 2
        
        # Check if a and b are non-negative integers
        if a >= 0 and b >= 0:
            # Calculate the number of divisors of n
            num_divisors_n = (a + 1) * (b + 1)
            return num_divisors_n
    
    return None  # In case no valid pairs are found

# Call the solve function and print the result
result = solve()
print(result)
