def solve():
    # Given values
    norm_u = 2
    norm_v = 2
    dot_product_uv = -1
    
    # Calculate the vectors' norms
    norm_u_plus_v = np.linalg.norm(np.array([norm_u, norm_v]) + np.array([dot_product_uv, 0]))
    norm_2u_minus_v = np.linalg.norm(2 * np.array([norm_u, 0]) - np.array([norm_v, dot_product_uv]))
    
    # Calculate the dot product of (u + v) and (2u - v)
    dot_product = (norm_u**2 + norm_v**2 + 2 * dot_product_uv)  # u + v
    dot_product_2u_minus_v = (2 * norm_u**2 - dot_product_uv)  # 2u - v
    
    # Calculate cos(theta)
    cos_theta = dot_product / (norm_u_plus_v * norm_2u_minus_v)
    
    return cos_theta

