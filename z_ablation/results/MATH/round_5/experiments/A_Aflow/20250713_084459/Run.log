def solve():
    # Distances from point P to the first five vertices of the octahedron
    distances = [3, 7, 8, 9, 11]
    
    # Calculate the distance to the sixth vertex using the formula
    # The sum of the squares of the distances from point P to the vertices
    # of a regular octahedron is constant.
    
    # The formula derived from the properties of the octahedron:
    # d1^2 + d2^2 + d3^2 + d4^2 + d5^2 + d6^2 = constant
    # where d1, d2, d3, d4, d5 are the known distances and d6 is the unknown distance.
    
    # Calculate the sum of the squares of the known distances
    sum_of_squares = sum(d ** 2 for d in distances)
    
    # The constant for a regular octahedron with vertices at distance 1 from the center
    # is 5 (since there are 6 vertices and each contributes 1^2).
    # Therefore, we can set up the equation:
    # sum_of_squares + d6^2 = 5
    # d6^2 = 5 - sum_of_squares
    # d6 = sqrt(5 - sum_of_squares)
    
    constant = 5
    d6_squared = constant - sum_of_squares
    
    # Calculate the distance to the sixth vertex
    if d6_squared < 0:
        return None  # This would indicate an invalid scenario
    
    d6 = d6_squared ** 0.5
    
    return d6

