import numpy as np

def solve():
    # Define the normal vectors of the planes
    normal1 = np.array([1, 1, 1])  # From the plane x + y + z - 6 = 0
    normal2 = np.array([2, 3, 4])  # From the plane 2x + 3y + 4z + 5 = 0
    
    # Find the direction vector of the line L (cross product of the normals)
    direction = np.cross(normal1, normal2)
    
    # Find a point on the line L by solving the system of equations
    # We can set z = 0 and solve for x and y
    z = 0
    # From the first plane: x + y - 6 = 0  =>  y = 6 - x
    # From the second plane: 2x + 3y + 5 = 0
    # Substitute y in the second equation:
    # 2x + 3(6 - x) + 5 = 0
    # 2x + 18 - 3x + 5 = 0
    # -x + 23 = 0 => x = 23
    x = 23
    y = 6 - x  # y = 6 - 23 = -17
    point_on_line = np.array([x, y, z])  # Point on line L is (23, -17, 0)
    
    # Now we need to find the equation of the plane containing line L and point (1, 1, 1)
    point = np.array([1, 1, 1])
    
    # The normal vector of the new plane can be found using the direction vector and the vector from point_on_line to point
    vector_to_point = point - point_on_line
    normal_plane = np.cross(direction, vector_to_point)
    
    # The equation of the plane can be written as:
    # A(x - x0) + B(y - y0) + C(z - z0) = 0
    # where (x0, y0, z0) is a point on the plane (point_on_line)
    # A, B, C are the components of the normal vector
    A, B, C = normal_plane
    D = - (A * point_on_line[0] + B * point_on_line[1] + C * point_on_line[2])
    
    # Ensure A > 0 and gcd(|A|, |B|, |C|, |D|) = 1
    if A < 0:
        A, B, C, D = -A, -B, -C, -D
    
    # Function to compute gcd
    def gcd(a, b):
        while b:
            a, b = b, a % b
        return abs(a)
    
    def gcd_multiple(*args):
        result = args[0]
        for num in args[1:]:
            result = gcd(result, num)
        return result
    
    # Calculate gcd of A, B, C, D
    common_gcd = gcd_multiple(A, B, C, D)
    
    # Normalize the coefficients
    A //= common_gcd
    B //= common_gcd
    C //= common_gcd
    D //= common_gcd
    
    # Return the result in the required format
    return f"{A}x + {B}y + {C}z + {D} = 0"

# Call the solve function and print the result
result = solve()
print(result)
```
