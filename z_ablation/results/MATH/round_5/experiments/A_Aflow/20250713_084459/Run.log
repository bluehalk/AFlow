def solve():
    count = 0
    
    # Iterate through all possible three-digit numbers with non-zero digits
    for hundreds in range(1, 10):  # Hundreds digit (1-9)
        for tens in range(1, 10):  # Tens digit (1-9)
            if tens % hundreds == 0:  # Tens digit is a multiple of hundreds digit
                for units in range(1, 10):  # Units digit (1-9)
