def solve():
    # Initialize the count of valid outcomes and total outcomes
    valid_count = 0
    total_count = 0
    
    # Loop through all possible outcomes of two rolls of a six-sided die
    for tens in range(1, 7):  # Tens digit can be 1 to 6
        for ones in range(1, 7):  # Ones digit can be 1 to 6
            # Form the two-digit number
            number = tens * 10 + ones
            total_count += 1
            
            # Check if the number is divisible by 8
            if number % 8 == 0:
                valid_count += 1
    
    # Calculate the probability as a fraction
    from fractions import Fraction
    probability = Fraction(valid_count, total_count)
    
    return str(probability)

