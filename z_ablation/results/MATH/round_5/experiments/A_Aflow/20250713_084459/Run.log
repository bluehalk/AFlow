def solve():
    # Define the set S of points (a, b) where a and b can be -1, 0, or 1
    S = [(-1, -1), (-1, 0), (-1, 1), (0, -1), (0, 0), (0, 1), (1, -1), (1, 0), (1, 1)]
    
    # Set to store unique lines represented by their slope and intercept
    lines = set()
    
    # Iterate through all pairs of points in S
    for i in range(len(S)):
        for j in range(i + 1, len(S)):
            x1, y1 = S[i]
            x2, y2 = S[j]
            
            # Check if the points are the same
            if (x1, y1) == (x2, y2):
                continue
            
            # Calculate the slope (dy/dx) and intercept
            if x1 == x2:  # Vertical line
                slope = 'inf'  # Use 'inf' to represent vertical lines
                intercept = x1  # x-intercept for vertical lines
            else:
                slope = (y2 - y1) / (x2 - x1)
                intercept = y1 - slope * x1
            
            # Store the line in a normalized form (slope, intercept)
            lines.add((slope, intercept))
    
    # The number of distinct lines is the size of the set
    return len(lines)

# Call the solve function and print the result
result = solve()
print(result)
