def solve():
    from math import gcd
    from collections import defaultdict

    # Function to determine the prime factorization of a number
    def prime_factors(n):
        factors = defaultdict(int)
        d = 2
        while d * d <= n:
            while (n % d) == 0:
                factors[d] += 1
                n //= d
            d += 1
        if n > 1:
            factors[n] += 1
        return factors

    # Calculate the prime factorization for numbers 1 to 16
    factorization = {i: prime_factors(i) for i in range(1, 17)}

    # To avoid a perfect square product, we need to track the parity of the exponents
    # We will use a tuple of (prime, exponent % 2) to represent the state
    parity_count = defaultdict(int)

    # Maximum number of slips that can be drawn without forming a perfect square
    max_slips = 0

    for i in range(1, 17):
        current_factors = factorization[i]
        current_parity = tuple((p, exp % 2) for p, exp in current_factors.items() if exp % 2 != 0)

        # Check if the current parity already exists
        if current_parity in parity_count:
            break  # We found a duplicate parity, which means a perfect square product is possible
        else:
            parity_count[current_parity] += 1
            max_slips += 1

    return max_slips

# Call the solve function and print the result
result = solve()
print(result)
```
