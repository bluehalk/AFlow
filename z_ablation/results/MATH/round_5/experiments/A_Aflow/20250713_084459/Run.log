    sum_of_units_digits = 0
    
    # Iterate through multiples of 3 from 0 to 50
    for i in range(0, 51, 3):
        # Get the units digit by taking modulo 10
        units_digit = i % 10
        # Add the units digit to the sum
        sum_of_units_digits += units_digit
    
    # Return the final result
    return sum_of_units_digits

