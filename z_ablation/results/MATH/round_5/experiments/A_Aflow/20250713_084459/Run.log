import math

def solve():
    # Calculate the right-hand side of the equation
    cos_96 = math.cos(math.radians(96))
    sin_96 = math.sin(math.radians(96))
    
    rhs = (cos_96 + sin_96) / (cos_96 - sin_96)
    
    # We need to find the smallest positive integer solution for tan(19x) = rhs
    # tan(19x) = rhs implies 19x = arctan(rhs) + k * 180 for any integer k
    # Therefore, x = (arctan(rhs) + k * 180) / 19
    
    # Calculate arctan(rhs)
    arctan_rhs = math.degrees(math.atan(rhs))
    
    # We will find the smallest positive integer x
    smallest_x = None
    
    # Check for k = 0, 1, 2, ... until we find a positive integer solution
    k = 0
    while True:
        x = (arctan_rhs + k * 180) / 19
        if x > 0 and x.is_integer():
            smallest_x = int(x)
            break
        k += 1
    
    return smallest_x

