        return np.array([1 + 4 * t, 4 + 3 * t])
    
    # Parameterization of line m
    def point_on_line_m(s):
        return np.array([-5 + 4 * s, 6 + 3 * s])
    
    # Finding the foot of the perpendicular from A to line m
    # We will use the fact that the direction vector of line m is (4, 3)
    direction_m = np.array([4, 3])
    
    # We need to find the point A on line l and point B on line m
    # Let's choose t = 0 for line l and s = 0 for line m for simplicity
    A = point_on_line_l(0)  # A = (1, 4)
    B = point_on_line_m(0)  # B = (-5, 6)
    
    # Vector BA
    BA = A - B  # BA = A - B
    
    # The projection of BA onto the direction vector of line m
    # Projection formula: proj_v(u) = (u . v / v . v) * v
    dot_product = np.dot(BA, direction_m)
    direction_m_length_squared = np.dot(direction_m, direction_m)
    projection_length = dot_product / direction_m_length_squared
    
    # The projection vector BP
