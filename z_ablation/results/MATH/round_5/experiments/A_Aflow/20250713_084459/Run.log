def is_prime(n):
    """Check if a number is prime."""
    if n <= 1:
        return False
    if n <= 3:
        return True
    if n % 2 == 0 or n % 3 == 0:
        return False
    i = 5
    while i * i <= n:
        if n % i == 0 or n % (i + 2) == 0:
            return False
        i += 6
    return True

def perfect_squares_up_to(n):
    """Generate perfect squares up to n."""
    squares = []
    i = 0
    while i * i <= n:
        squares.append(i * i)
        i += 1
    return squares

def solve():
    """Calculate the sum of primes between 100 and 200 that are 1 or 2 more than a perfect square."""
    lower_bound = 100
    upper_bound = 200
    sum_of_primes = 0
    
    # Get perfect squares up to the upper bound
    squares = perfect_squares_up_to(upper_bound)
    
    # Check for primes that are 1 or 2 more than each perfect square
    for square in squares:
        for offset in [1, 2]:
            candidate = square + offset
            if lower_bound <= candidate <= upper_bound and is_prime(candidate):
                sum_of_primes += candidate
    
    return sum_of_primes

# Output the result
result = solve()
print(result)
```
