def count_trailing_zeros(n):
    """Count the number of trailing zeros in n! by counting factors of 5."""
    count = 0
    while n > 0:
        n //= 5
        count += n
    return count

def solve():
    # Calculate the number of trailing zeros in 100!, 200!, and 300!
    zeros_100 = count_trailing_zeros(100)
    zeros_200 = count_trailing_zeros(200)
    zeros_300 = count_trailing_zeros(300)
    
    # Total trailing zeros in the product (100!)(200!)(300!)
    total_zeros = zeros_100 + zeros_200 + zeros_300
    
    return total_zeros

# Call the solve function and print the result
result = solve()
print(result)
```
