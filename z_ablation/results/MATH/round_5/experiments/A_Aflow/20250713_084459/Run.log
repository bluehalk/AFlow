    marked_observed_frogs = 10
    
    # Using the Lincoln-Petersen estimator to estimate the total frog population
    # N = (M * C) / R
    # Where:
    # N = estimated total population
    # M = number of marked individuals (marked_frogs)
    # C = total number of individuals captured in the second sample (observed_frogs)
    # R = number of marked individuals recaptured (marked_observed_frogs)
    
