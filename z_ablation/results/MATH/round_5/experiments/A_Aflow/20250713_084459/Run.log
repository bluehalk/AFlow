2025-07-13 08:47:24 - INFO - ```python
def get_factors(n):
    """Return a list of positive factors of n, excluding n itself."""
    factors = []
    for i in range(1, n):
        if n % i == 0:
            factors.append(i)
    return factors

def solve():
    """Calculate the maximum number of spins John can make starting with a spin of 20."""
    current_number = 20
    total_spins = 1  # Start with the first spin
    
    while current_number > 0:
        factors = get_factors(current_number)
        if not factors:  # If there are no factors left, the game ends
            break
        current_number = max(factors)  # Spin the maximum factor
        total_spins += 1  # Increment the spin count
    
    return total_spins

# Call the solve function and print the result
result = solve()
print(result)
```
