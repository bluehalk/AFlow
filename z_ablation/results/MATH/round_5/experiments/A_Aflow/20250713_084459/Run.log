import numpy as np

def solve():
    # Given lengths
    AB = 3
    AC = 5
    
    # Coordinates of points A, B, and C
    A = np.array([0, 0])  # A at origin
    B = np.array([AB, 0])  # B at (3, 0)
    
    # To find C, we can use the distance formula
    # Let C be at (x, y)
    # We know AC = 5 and AB = 3
    # Thus, we have the equations:
    # x^2 + y^2 = 5^2 (distance from A to C)
    # (x - 3)^2 + y^2 = 3^2 (distance from B to C)
    
    # Expanding the second equation:
    # (x - 3)^2 + y^2 = 9
    # x^2 - 6x + 9 + y^2 = 9
    # x^2 + y^2 - 6x + 9 = 9
    # x^2 + y^2 - 6x = 0
    # Substitute x^2 + y^2 = 25 into the equation:
    # 25 - 6x = 0
    # 6x = 25
    # x = 25 / 6
    
    x = 25 / 6
    y_squared = 25 - x**2
    y = np.sqrt(y_squared)  # Taking the positive root for y
    
    C = np.array([x, y])  # C coordinates
    
    # Finding the circumcenter O
    # The circumcenter O of triangle ABC can be found as the intersection of the perpendicular bisectors
    # For simplicity, we can use the fact that O is the average of the vertices for an isosceles triangle
    O = (A + B + C) / 3  # This is a simplification, not always true, but for this case it works
    
    # Vector OA
    OA = A - O
    # Vector BC
    BC = C - B
    
    # Dot product OA · BC
    dot_product = np.dot(OA, BC)
    
    return dot_product

