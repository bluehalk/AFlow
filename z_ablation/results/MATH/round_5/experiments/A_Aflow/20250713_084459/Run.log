    teams = ['A', 'B', 'C']
    
    # Total combinations of selecting 2 teams from 3
    total_combinations = 3  # (A, B), (A, C), (B, C)
    
    # Count the favorable outcomes where Team A is selected at least 2 out of 3 days
    favorable_outcomes = 0
    
    # Possible selections for 3 days
    selections = [
