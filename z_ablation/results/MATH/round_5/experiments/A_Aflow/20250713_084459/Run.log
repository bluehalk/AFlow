        u = (b + m * k) / a
        if u.is_integer() and u > 0:
            solutions.append(int(u))
    
    # We need the two smallest positive integer solutions
    solutions = sorted(set(solutions))  # Remove duplicates and sort
    if len(solutions) < 2:
        return None  # Not enough solutions found
    
    # Calculate the average of the two smallest solutions
    average = (solutions[0] + solutions[1]) / 2
    return average

# Call the solve function and print the result
