def solve():
    import math

    # Function to calculate the highest power of p that divides n!
    def highest_power_of_p_in_factorial(n, p):
        count = 0
        power = p
        while power <= n:
            count += n // power
            power *= p
        return count

    # We need to find the largest n such that 942! is divisible by 15^n
    # 15 = 3 * 5, so we need to find the minimum of the powers of 3 and 5 in 942!
    n = 942
    power_of_3 = highest_power_of_p_in_factorial(n, 3)
    power_of_5 = highest_power_of_p_in_factorial(n, 5)

    # The largest n such that 942! is divisible by 15^n is the minimum of these two powers
    result = min(power_of_3, power_of_5)
    
    return result

