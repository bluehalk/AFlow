    values = [5, 10, 15, 20]
    
    # Possible moves: Up, Down, Left, Right
    moves = [(0, 1), (0, -1), (-1, 0), (1, 0)]
    
    # To store the number of ways to reach each sum
    sum_count = {}
    
    # Iterate through all possible combinations of moves (3 moves)
    for move_sequence in product(moves, repeat=3):
        # Starting position (0, 0)
        position = (0, 0)
        total_sum = 0
        
        # Move according to the sequence
        for move in move_sequence:
            position = (position[0] + move[0], position[1] + move[1])
            # Determine the value based on the position
            if position == (0, 0):
                total_sum += 0  # Start square has no value
            elif position in [(0, 1), (0, -1), (-1, 0), (1, 0)]:
                total_sum += 10  # Up or Down or Left or Right
            elif position in [(0, 2), (0, -2), (-2, 0), (2, 0)]:
                total_sum += 20  # Two steps in one direction
            elif position in [(0, 3), (0, -3), (-3, 0), (3, 0)]:
