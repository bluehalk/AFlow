def count_paths(start, end, visited):
    if start == end:
        return 1
    if start in visited:
        return 0
    
    visited.add(start)
    total_paths = 0
    
    # Possible moves: up, down, left, right
    moves = [(0, 1), (0, -1), (-1, 0), (1, 0)]
    
    for move in moves:
        next_position = (start[0] + move[0], start[1] + move[1])
        total_paths += count_paths(next_position, end, visited)
    
    visited.remove(start)
    return total_paths

