2025-07-13 08:48:07 - INFO - ```python
def solve():
    # The size of the grid
    grid_size = 5
    
    # The center square is located at (2, 2) in 0-indexed coordinates
    center_x, center_y = 2, 2
    
    # Count the number of squares that contain the center square
    count = 0
    
    # Iterate over all possible square sizes
    for size in range(1, grid_size + 1):
        # The top-left corner of the square can be positioned in a way that
        # the center square (2, 2) is included in the square of the given size.
        
        # The square can start from (x, y) where:
        # x can range from (center_x - (size - 1)) to (center_x)
        # y can range from (center_y - (size - 1)) to (center_y)
        
        # Calculate the valid range for the top-left corner of the square
        start_x = max(0, center_x - (size - 1))
        end_x = min(grid_size - size, center_x)
        start_y = max(0, center_y - (size - 1))
        end_y = min(grid_size - size, center_y)
        
        # Count the number of valid positions for the top-left corner
        count += (end_x - start_x + 1) * (end_y - start_y + 1)
    
    return count

# Call the solve function and print the result
result = solve()
print(result)
```
