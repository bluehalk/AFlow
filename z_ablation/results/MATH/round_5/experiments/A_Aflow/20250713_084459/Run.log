def solve():
    # We need to find the value of n such that the total number of squares is 70
    total_squares = 70
    
    # The number of squares of size 1x1, 2x2, and 3x3 in a 3 x n grid
    def count_squares(n):
        # Count of 1x1 squares
        count_1x1 = (n - 1) * 2  # Each 1x1 square can be formed in (n-1) columns and 2 rows
        # Count of 2x2 squares
        count_2x2 = (n - 2) * 1  # Each 2x2 square can be formed in (n-2) columns and 1 row
        # Count of 3x3 squares
        count_3x3 = 0  # A 3x3 square cannot be formed in a 3 x n grid if n < 3
        
        if n >= 3:
            count_3x3 = 1  # Only one 3x3 square can be formed if n >= 3
        
        return count_1x1 + count_2x2 + count_3x3
    
    # We will iterate over possible values of n to find the one that gives us 70 squares
    n = 3  # Start from the minimum value of n that allows for squares
    while True:
        if count_squares(n) == total_squares:
            return n
        n += 1

# Call the solve function and print the result
result = solve()
print(result)
