    def is_fifth_power(n):
        return int(n**(1/5)) ** 5 == n

    # We will collect numbers that are not squares, cubes, or fifth powers
    result = []
    num = 1

    while len(result) < 1000:
        if not (is_square(num) or is_cube(num) or is_fifth_power(num)):
            result.append(num)
        num += 1

    return result[999]  # 1000th term is at index 999

