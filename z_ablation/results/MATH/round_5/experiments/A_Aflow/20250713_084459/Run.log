import math
from functools import reduce
from math import gcd

def lcm(x, y):
    return x * y // gcd(x, y)

def factorial(n):
    return math.factorial(n)

def solve():
    # Calculate the values of 1! + 2!, 2! + 3!, ..., 8! + 9!
    values = [factorial(i) + factorial(i + 1) for i in range(1, 9)]
    
    # Calculate the least common multiple of the values
    lcm_value = reduce(lcm, values)
    
    # Find the largest b such that lcm_value can be expressed as a * b!
    b = 0
    while True:
        b_factorial = factorial(b)
        if lcm_value % b_factorial == 0:
            a = lcm_value // b_factorial
            b += 1
        else:
            break
    
    # Since we incremented b one extra time, we need to decrement it
    b -= 1
    a = lcm_value // factorial(b)
    
    return a + b

