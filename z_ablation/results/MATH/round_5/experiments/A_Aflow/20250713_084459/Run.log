    # Rectangle dimensions based on the ratio k
    # Let AD = h and AB = k * h
    h = 1  # We can assume AD = 1 for simplicity
    w = k * h  # AB = k * AD

    # Area of rectangle ABCD
    area_rectangle = w * h

    # The region closer to the center O than to any vertex
    # The vertices of the rectangle are:
    A = (-w / 2, h / 2)
    B = (w / 2, h / 2)
    C = (w / 2, -h / 2)
