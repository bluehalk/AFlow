                selected_teams = [day1, day2, day3]
                count_A = sum(1 for teams in selected_teams if 'A' in teams)
                if count_A >= 2:
                    favorable_outcomes += 1
    
    # Total possible outcomes for 3 days
    total_outcomes = total_combinations ** 3
    
    # Calculate the probability
    probability = Fraction(favorable_outcomes, total_outcomes)
    
    return probability

# Call the solve function and print the result
result = solve()
print(result)
```
