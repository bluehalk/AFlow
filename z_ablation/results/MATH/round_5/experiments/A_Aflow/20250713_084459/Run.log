import numpy as np

def solve():
    # Define the input vectors and their images
    v1 = np.array([[2], [-1]])
    v2 = np.array([[1], [-3]])
    img1 = np.array([[9], [3]])
    img2 = np.array([[7], [-1]])
    
    # Construct the matrix M using the equations M * v1 = img1 and M * v2 = img2
    A = np.hstack((v1, v2))  # Matrix of input vectors
    B = np.hstack((img1, img2))  # Matrix of output vectors
    
    # Calculate the transformation matrix M
    M = B @ np.linalg.inv(A)
    
    # Define the line y = 2x + 1
    # We can express points on the line as (x, 2x + 1)
    x_values = np.linspace(-10, 10, 100)  # Generate x values
    line_points = np.array([[x], [2*x + 1]] for x in x_values)  # Points on the line
    
    # Apply the transformation M to each point on the line
    transformed_points = np.array([M @ point for point in line_points])
    
    # Extract the transformed y values
    transformed_y = transformed_points[1, :]
    
    # Fit a line to the transformed points
    # We can use the first two points to find the slope and intercept
    slope = (transformed_y[-1] - transformed_y[0]) / (x_values[-1] - x_values[0])
    intercept = transformed_y[0] - slope * x_values[0]
    
    # Format the result as a string
    result = f"y = {slope:.2f}x + {intercept:.2f}"
    return result

# Call the solve function and print the result
print(solve())
```
