import numpy as np

def determinant(M):
    return int(round(np.linalg.det(M)))

def calculate_D_n(n):
    if n == 1:
        return 10
    elif n == 2:
        return 10 * 10 - 3 * 3
    else:
        M = np.zeros((n, n))
        np.fill_diagonal(M, 10)
        M[0, 1] = M[1, 0] = 3
        for i in range(1, n - 1):
            M[i, i + 1] = M[i + 1, i] = 3
        return determinant(M)

def solve():
    total_sum = 0
    for n in range(1, 100):  # Calculate for a reasonable number of terms
        D_n = calculate_D_n(n)
        total_sum += 1 / (8 * D_n + 1)
    return total_sum

result = solve()
print(result)
```
