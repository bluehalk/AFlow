2025-07-13 08:45:59 - INFO - ```python
from itertools import permutations

def solve():
    # Define the available digits
    digits = ['2', '3', '5', '7']
    
    # Set to hold distinct numbers
    distinct_numbers = set()
    
    # Generate all possible combinations of the digits
    for r in range(1, len(digits) + 1):
        for perm in permutations(digits, r):
            # Join the tuple of characters to form a number
            number = ''.join(perm)
            # Add the number to the set
            distinct_numbers.add(number)
    
    # The result is the count of distinct numbers
    result = len(distinct_numbers)
    return result

# Call the solve function and print the result
print(solve())
```
