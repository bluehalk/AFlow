def solve():
    # We need to find how many positive integers less than 103 have an odd number of positive divisors.
    # A number has an odd number of positive divisors if and only if it is a perfect square.
    
    limit = 103
    count = 0
    
    # We will count perfect squares less than 103
    # The largest integer whose square is less than 103 is the integer part of the square root of 102
    max_square_root = int((limit - 1) ** 0.5)
    
    # The perfect squares are 1^2, 2^2, ..., max_square_root^2
    count = max_square_root
    
    return count

