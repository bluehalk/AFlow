    ways_with_less_than_3_false = 0
    
    # 0 False answers
    ways_with_0_false = 1  # Only one way: all True
    
    # 1 False answer
    ways_with_1_false = total_questions  # Choose 1 question to be False
    
    # 2 False answers
    ways_with_2_false = (total_questions * (total_questions - 1)) // 2  # Choose 2 questions to be False
    
    # Sum the ways with less than 3 False answers
    ways_with_less_than_3_false = ways_with_0_false + ways_with_1_false + ways_with_2_false
    
    # Calculate the ways with at least 3 False answers
    ways_with_at_least_3_false = total_ways - ways_with_less_than_3_false
    
    return ways_with_at_least_3_false

