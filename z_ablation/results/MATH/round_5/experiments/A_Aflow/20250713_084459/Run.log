def solve():
    # Initialize the sum of all possible values of k
    total_sum = 0
    
    # Iterate over possible integer values of x greater than 1
    for x in range(2, 100):  # Arbitrarily chosen upper limit for x
        # Calculate k
        k = 1 / (1 + 2 * x)
        
        # Check if k can be represented as a terminating decimal
        # A fraction a/b is a terminating decimal if the denominator b (in lowest terms)
        # has no prime factors other than 2 and 5.
        
        # The denominator of k is (1 + 2x)
        denominator = 1 + 2 * x
        
        # Reduce the denominator by removing factors of 2
        while denominator % 2 == 0:
            denominator //= 2
        
        # Reduce the denominator by removing factors of 5
        while denominator % 5 == 0:
            denominator //= 5
        
        # If the reduced denominator is 1, then k is a terminating decimal
        if denominator == 1:
            total_sum += k
    
    return total_sum

