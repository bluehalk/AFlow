import math

def solve():
    # Define the equations for points P and Q
    # P is on the line y = -x + 1 in the xy-plane
    # Q is on the line z = -2x + 1 in the xz-plane
    
    # We can express P and Q in terms of x
    # Let P = (x, -x + 1, 0)
    # Let Q = (x, 0, -2x + 1)
    
    # Calculate the distance PQ
    # Distance formula in 3D: PQ = sqrt((x2 - x1)^2 + (y2 - y1)^2 + (z2 - z1)^2)
    # For points P(x, -x + 1, 0) and Q(x, 0, -2x + 1):
    # PQ = sqrt((x - x)^2 + (0 - (-x + 1))^2 + ((-2x + 1) - 0)^2)
    # Simplifying this gives:
    # PQ = sqrt(0 + (x - 1)^2 + (-2x + 1)^2)
    
    def distance(x):
        return math.sqrt((x - 1) ** 2 + (-2 * x + 1) ** 2)
    
    # To find the minimum distance, we can take the derivative and set it to zero
    # Distance function: d(x) = sqrt((x - 1)^2 + (-2x + 1)^2)
    # We can minimize the square of the distance to avoid dealing with the square root
    # Let f(x) = (x - 1)^2 + (-2x + 1)^2
    
    def f(x):
        return (x - 1) ** 2 + (-2 * x + 1) ** 2
    
    # Derivative of f(x)
    def df(x):
        return 2 * (x - 1) + 2 * (-2 * x + 1) * (-2)
    
    # We can use a numerical method to find the minimum
    # Using a simple gradient descent approach
    x = 0  # Starting point
    learning_rate = 0.01
    for _ in range(10000):  # Iterate to find the minimum
        x -= learning_rate * df(x)
    
    # Calculate the minimum distance
    min_distance = distance(x)
    
    return min_distance

# Call the solve function and print the result
result = solve()
print(result)
