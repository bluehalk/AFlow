def solve():
    # Given equation: sin(x) + cos(x) = 1/5
    # We can square both sides to find a relationship between sin(x) and cos(x)
    
    # Let sin(x) = a and cos(x) = b
    # Then a + b = 1/5
    # Squaring both sides: (a + b)^2 = (1/5)^2
    # This gives us: a^2 + 2ab + b^2 = 1/25
    # We know that a^2 + b^2 = 1 (since sin^2(x) + cos^2(x) = 1)
    # Therefore: 1 + 2ab = 1/25
    # Rearranging gives us: 2ab = 1/25 - 1
    # 2ab = -24/25
    # ab = -12/25

    # Now we have two equations:
    # 1. a + b = 1/5
    # 2. ab = -12/25

    # We can treat a and b as the roots of the quadratic equation:
    # t^2 - (a+b)t + ab = 0
    # t^2 - (1/5)t - (12/25) = 0

    # Coefficients for the quadratic equation
    A = 1
    B = -1/5
    C = -12/25

    # Using the quadratic formula: t = [-B ± sqrt(B^2 - 4AC)] / 2A
    discriminant = B**2 - 4*A*C
    sqrt_discriminant = math.sqrt(discriminant)

    # Roots of the equation
    a1 = (-B + sqrt_discriminant) / (2 * A)
    a2 = (-B - sqrt_discriminant) / (2 * A)

    # Since a = sin(x) and b = cos(x), we need to find tan(x) = sin(x) / cos(x)
    # We can find cos(x) using b = 1/5 - a
    b1 = 1/5 - a1
    b2 = 1/5 - a2

    # Calculate tan(x) for both cases
    tan1 = a1 / b1
    tan2 = a2 / b2

    # Since we are looking for 0 < x < pi, we need to check which tan is valid
    # In the range (0, pi), both sin and cos can be positive or negative
    # We will return the positive value of tan(x) since both a1 and b1 should be valid in this range
    return tan1 if tan1 > 0 else tan2

