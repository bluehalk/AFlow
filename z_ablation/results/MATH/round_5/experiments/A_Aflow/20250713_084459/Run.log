def solve():
    # The internal angle of a regular heptagon
    heptagon_internal_angle = (7 - 2) * 180 / 7  # (n-2)*180/n for n=7
    # The angle at vertex A in the heptagon
    angle_BAF = heptagon_internal_angle / 2  # Angle BAF is half of the internal angle
    
    # The angle BAC is the right angle (90 degrees) minus angle BAF
    angle_BAC = 90 - angle_BAF
    
    # Convert angle_BAC to a common fraction
    from fractions import Fraction
    angle_BAC_fraction = Fraction(angle_BAC).limit_denominator()
    
    return angle_BAC_fraction

# Call the solve function and print the result
result = solve()
print(result)
