                # Get the last two digits in base 3
                last_two_digits = base_3_digits[-2:][::-1] if len(base_3_digits) >= 2 else base_3_digits[::-1]
                
                # Store the result as a tuple
                results.append(tuple(last_two_digits))
    
    # Return the last two digits of the first valid a - b found
    return results[0] if results else None

