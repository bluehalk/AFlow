            if -1 in coeff:
                a_plus_sqrt_b = coeff[-1]
                if isinstance(a_plus_sqrt_b, sp.Add):
                    a, b = 0, 0
                    for term in a_plus_sqrt_b.args:
                        if isinstance(term, sp.sqrt):
