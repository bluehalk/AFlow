import itertools

def solve():
    # Define the bills in the envelope
    bills = [1, 1, 5, 5, 10, 10, 20, 20]
    
    # Calculate all possible combinations of drawing 2 bills
    combinations = list(itertools.combinations(bills, 2))
    
    # Count the total number of combinations
    total_combinations = len(combinations)
    
    # Count the number of combinations that sum to 20 or more
    successful_combinations = sum(1 for combo in combinations if sum(combo) >= 20)
    
    # Calculate the probability
    probability = successful_combinations / total_combinations
    
    return probability

# Call the solve function and print the result
result = solve()
print(result)
```
