    total_cupcakes = 2 * 12  # 2 dozen
    
    # Calculate the number of cupcakes with each ingredient
    chocolate = total_cupcakes // 2  # half contain chocolate
    raisins = (2 * total_cupcakes) // 3  # two-thirds contain raisins
    chocolate_chips = total_cupcakes // 4  # one-fourth contain chocolate chips
    nuts = total_cupcakes // 6  # one-sixth contain nuts
    
    # Using a set to track unique cupcakes with ingredients
    ingredient_cupcakes = set()
    
    # Add cupcakes with chocolate
    ingredient_cupcakes.update(range(chocolate))
    
    # Add cupcakes with raisins
    ingredient_cupcakes.update(range(chocolate, chocolate + raisins))
    
    # Add cupcakes with chocolate chips
    ingredient_cupcakes.update(range(chocolate + raisins, chocolate + raisins + chocolate_chips))
    
    # Add cupcakes with nuts
    ingredient_cupcakes.update(range(chocolate + raisins + chocolate_chips, chocolate + raisins + chocolate_chips + nuts))
    
    # Calculate the number of cupcakes with none of the ingredients
    cupcakes_with_ingredients = len(ingredient_cupcakes)
    cupcakes_with_none = total_cupcakes - cupcakes_with_ingredients
    
    return cupcakes_with_none

# Call the solve function and print the result
result = solve()
print(result)
