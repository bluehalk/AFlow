def solve():
    # Coefficients of the first plane 3x - 6y + 2z + 5 = 0
    A1, B1, C1, D1 = 3, -6, 2, 5
    # Coefficients of the second plane 4x - 12y + 3z - 3 = 0
    A2, B2, C2, D2 = 4, -12, 3, -3
    
    # Point that lies on the bisecting plane
    point = np.array([-5, -1, -5])
    
    # Normal vectors of the planes
    n1 = np.array([A1, B1, C1])
    n2 = np.array([A2, B2, C2])
    
    # Calculate the angle bisector normal vector
    n_bisector = n1 / np.linalg.norm(n1) + n2 / np.linalg.norm(n2)
    
    # Coefficients of the bisecting plane
    A, B, C = n_bisector
    
    # Using the point-normal form of the plane equation: A(x - x0) + B(y - y0) + C(z - z0) = 0
    # where (x0, y0, z0) is the point (-5, -1, -5)
    D = -(A * point[0] + B * point[1] + C * point[2])
    
    # Convert to integer coefficients
    A, B, C, D = map(int, [A, B, C, D])
    
    # Ensure A > 0
    if A < 0:
        A, B, C, D = -A, -B, -C, -D
    
    # Reduce coefficients by their gcd
    common_gcd = gcd(abs(A), abs(B), abs(C), abs(D))
    A //= common_gcd
    B //= common_gcd
    C //= common_gcd
    D //= common_gcd
    
    return f"{A}x + {B}y + {C}z + {D} = 0"

