        paths_to_next = sum(count_paths(current_position, pos, set()) for pos in next_positions)
        total_paths *= paths_to_next
        current_position = next_positions[0]  # Move to the first position of the next letter for the next calculation
    
    return total_paths

# Output the result
result = solve()
print(result)
