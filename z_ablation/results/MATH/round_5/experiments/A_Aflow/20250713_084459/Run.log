import math

def solve():
    # Given hypotenuse of the larger triangle
    hypotenuse_large = 16  # cm
    
    # In a 30-60-90 triangle, the relationships between the sides are:
    # Hypotenuse = 2 * shorter leg
    # Longer leg = shorter leg * sqrt(3)
    
    # Calculate the shorter leg of the larger triangle
    shorter_leg_large = hypotenuse_large / 2
    
    # Calculate the longer leg of the larger triangle
    longer_leg_large = shorter_leg_large * math.sqrt(3)
    
    # The longer leg of the smaller triangle is the hypotenuse of the larger triangle
    hypotenuse_small = longer_leg_large
    
    # Calculate the shorter leg of the smaller triangle
    shorter_leg_small = hypotenuse_small / 2
    
    # Calculate the longer leg of the smaller triangle
    longer_leg_small = shorter_leg_small * math.sqrt(3)
    
    # Return the length of the longer leg of the smaller triangle
    return longer_leg_small

