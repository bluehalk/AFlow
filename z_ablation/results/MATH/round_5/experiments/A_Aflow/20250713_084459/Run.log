2025-07-13 09:04:51 - INFO - ```python
def solve():
    # Total number of coin flips
    flips = 6
    
    # Possible outcomes of the coin flips
    # Each flip can be either heads (H) or tails (T)
    # Heads means moving counterclockwise (CCW) and tails means moving clockwise (CW)
    
    # The man starts at vertex 0
    # Each move changes his position by +2 for heads and -1 for tails
    # We can represent the position as an integer modulo 6 (since there are 6 vertices)
    
    # We will count the number of ways to end up at the starting position (vertex 0)
    from itertools import product
    
    # Count the number of valid sequences that return to the starting position
    count_return_to_start = 0
    
    # Generate all possible sequences of flips (H and T)
    for sequence in product(['H', 'T'], repeat=flips):
        position = 0  # Starting at vertex 0
        
        for flip in sequence:
            if flip == 'H':
                position = (position + 2) % 6  # Move counterclockwise
            else:
                position = (position - 1) % 6  # Move clockwise
        
        # Check if the final position is the starting position
        if position == 0:
            count_return_to_start += 1
    
    # Total possible outcomes of 6 flips
    total_outcomes = 2 ** flips
    
    # Probability of returning to the starting position
    probability = count_return_to_start / total_outcomes
    
    return probability

# Call the solve function and print the result
result = solve()
print(result)
```
