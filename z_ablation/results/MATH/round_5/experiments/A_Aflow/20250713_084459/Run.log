2025-07-13 08:48:04 - INFO - ```python
def solve():
    # Given data for the flights
    first_flight_time = 12  # seconds
    first_flight_distance = 37  # meters
    longest_flight_time = 59  # seconds
    longest_flight_distance = 260  # meters
    
    # Calculate average speed for the first flight (x)
    x = first_flight_distance / first_flight_time  # meters per second
    
    # Calculate average speed for the longest flight (y)
    y = longest_flight_distance / longest_flight_time  # meters per second
    
    # Calculate the average of x and y
    average_speed = (x + y) / 2
    
    # Return the result rounded to the nearest tenth
    return round(average_speed, 1)

# Call the solve function and print the result
result = solve()
print(result)
```
