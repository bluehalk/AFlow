    a = 14
    b = 46
    m = 100

    # We need to solve the equation 14u - 46 = 100k for integers u and k
    # Rearranging gives us: 14u = 46 + 100k
    # This can be rewritten as: u = (46 + 100k) / 14

    # We need to find the smallest positive integer solutions for u
