def extended_gcd(a, b):
    """Return gcd of a and b, and coefficients x, y such that ax + by = gcd(a, b)"""
    if a == 0:
        return b, 0, 1
    gcd, x1, y1 = extended_gcd(b % a, a)
    x = y1 - (b // a) * x1
    y = x1
    return gcd, x, y

def solve():
    # Given values
    a = 160
    m = 1399
    
    # Calculate gcd and the multiplicative inverse using Extended Euclidean Algorithm
    gcd, x, _ = extended_gcd(a, m)
    
    # Check if the gcd is 1, which means a and m are coprime
    if gcd != 1:
        return None  # No multiplicative inverse exists
    
    # The multiplicative inverse is x mod m
    inverse = x % m
    
    return inverse

