import numpy as np
from scipy.integrate import quad

def polar_area(r_func, theta_start, theta_end):
    """Calculate the area enclosed by a polar curve r = f(θ) from θ_start to θ_end."""
    integrand = lambda theta: 0.5 * (r_func(theta) ** 2)
    area, _ = quad(integrand, theta_start, theta_end)
    return area

def r(theta):
    """Polar function r = 1 + cos(θ)."""
    return 1 + np.cos(theta)

def solve():
    # The polar curve r = 1 + cos(θ) completes one full rotation from θ = 0 to θ = 2π
    theta_start = 0
    theta_end = 2 * np.pi
    
    # Calculate the area swept by the curve when rotated around the point (2, 0)
    area = polar_area(r, theta_start, theta_end)
    
    # The area swept when rotating around the point (2, 0) is the area calculated
    return area

# Call the solve function and print the result
result = solve()
print(result)
```
