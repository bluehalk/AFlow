def solve():
    # Total amount Lupe paid
    total_amount = 10.0
    
    # Initialize a set to store unique amounts of change
    change_amounts = set()
    
    # Loop through possible purchase amounts from $1 to $9.99
    for purchase in range(100, 1000):  # purchase amounts in cents (100 to 999)
        purchase_amount = purchase / 100.0
        if purchase_amount < 1 or purchase_amount >= total_amount:
            continue
        
        # Calculate change amount
        change = total_amount - purchase_amount
        
        # Check if change is valid
        if change < 1 or change >= total_amount:
            continue
        
        # Convert amounts to strings and check if they can be rearranged
        purchase_str = str(int(purchase_amount * 100)).zfill(3)
        change_str = str(int(change * 100)).zfill(3)
        
        if sorted(purchase_str) == sorted(change_str):
            change_amounts.add(change)
    
    # Return the number of unique change amounts
    return len(change_amounts)

# Call the solve function and print the result
