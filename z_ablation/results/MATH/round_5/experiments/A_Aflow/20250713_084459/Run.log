from collections import Counter
from itertools import product

def solve():
    # Number of distinguishable balls and indistinguishable boxes
    num_balls = 4
    num_boxes = 3
    
    # Generate all possible distributions of balls into boxes
    distributions = product(range(num_boxes), repeat=num_balls)
    
    # Use a set to store unique distributions
    unique_distributions = set()
    
    for distribution in distributions:
        # Count how many balls are in each box
        count = Counter(distribution)
        # Create a tuple of counts sorted to ensure uniqueness
        unique_distributions.add(tuple(sorted(count.values())))
    
    # The number of unique distributions is the answer
    return len(unique_distributions)

# Call the solve function and print the result
result = solve()
print(result)
```
