    multiple_of_3_pairs = 0
    
    # Iterate through all pairs of different positive integers less than 100
    for i in range(1, 100):
        for j in range(1, 100):
            if i != j:
                total_pairs += 1
                # Check if the product is a multiple of 3
                if (i * j) % 3 == 0:
