def solve():
    def has_exactly_four_factors(n):
        count = 0
        for i in range(1, int(n**0.5) + 1):
            if n % i == 0:
                count += 1  # i is a factor
                if i != n // i:
                    count += 1  # n // i is also a factor
            if count > 4:  # No need to count further if we already have more than 4
                return False
        return count == 4

    result = []
    num = 1
    while len(result) < 5:
        if has_exactly_four_factors(num):
            result.append(num)
        num += 1

    return sum(result)

