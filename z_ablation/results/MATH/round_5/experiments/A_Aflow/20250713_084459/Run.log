2025-07-13 09:07:16 - INFO - ```python
from fractions import Fraction

def solve():
    total_outcomes = 0
    expected_value = 0
    
    # Iterate through all possible outcomes of rolling two dice
    for die1 in range(1, 7):
        for die2 in range(1, 7):
            larger = max(die1, die2)
            expected_value += larger
            total_outcomes += 1
    
    # Calculate the expected value as a fraction
    expected_value_fraction = Fraction(expected_value, total_outcomes)
    
    return expected_value_fraction

# Call the solve function and print the result
result = solve()
print(result)
```
