import math

def solve():
    # Bill's movements
    south_1 = 0.5  # miles south
    east = 0.75    # miles east
    south_2 = 0.5  # miles south

    # Total south movement
    total_south = south_1 + south_2  # Total distance moved south

    # Total distance from starting point in a right triangle
    # Using Pythagorean theorem: distance = sqrt((east)^2 + (total_south)^2)
    distance = math.sqrt(east**2 + total_south**2)

    # Return the distance rounded to the nearest hundredth
    return round(distance, 2)

