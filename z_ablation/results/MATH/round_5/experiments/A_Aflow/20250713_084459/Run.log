def extended_gcd(a, b):
    """Return gcd of a and b, and coefficients x, y such that ax + by = gcd(a, b)"""
    if a == 0:
        return b, 0, 1
    gcd, x1, y1 = extended_gcd(b % a, a)
    x = y1 - (b // a) * x1
    y = x1
    return gcd, x, y

def solve():
    # Given values
    a = 24
    m = 11**2  # 121

    # Calculate gcd and coefficients using Extended Euclidean Algorithm
    gcd, x, _ = extended_gcd(a, m)

    # Check if gcd is 1, which means a has an inverse modulo m
    if gcd != 1:
        raise ValueError("Inverse does not exist since gcd(a, m) != 1")

    # The modular inverse is x mod m
    inverse = x % m
    return inverse

# Call the solve function and print the result
result = solve()
print(result)
```
