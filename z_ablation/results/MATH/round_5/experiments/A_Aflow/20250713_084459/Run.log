        # For each x, there are (52 - x) ways to choose the remaining cards
        # The number of ways to arrange the jokers with x cards in between
        ways_with_x_between = comb(52, x) * 2  # 2 for the arrangement of jokers
        
        # Contribution to the expected value
        expected_value += x * ways_with_x_between
    
    # Divide by the total number of ways to choose 2 positions for the jokers
