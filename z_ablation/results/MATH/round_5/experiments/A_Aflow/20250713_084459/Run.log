import numpy as np

def solve():
    # Define the vectors a and b
    a = np.array([-2, 5])
    b = np.array([1, 3])
    
    # Calculate the angle bisector direction
    # Normalize vector b
    b_normalized = b / np.linalg.norm(b)
    
    # Calculate the projection of a onto b
    projection_a_on_b = np.dot(a, b_normalized) * b_normalized
    
    # Calculate the component of a that is perpendicular to b
    a_perpendicular = a - projection_a_on_b
    
    # The vector c will be in the direction of the angle bisector
    # which is the sum of the normalized b and the normalized a_perpendicular
    c_direction = b_normalized + a_perpendicular / np.linalg.norm(a_perpendicular)
    
    # Normalize c_direction to get the unit vector
    c_direction_normalized = c_direction / np.linalg.norm(c_direction)
    
    # Scale c_direction to have the same length as b
    c_length = np.linalg.norm(b)
    c = c_length * c_direction_normalized
    
    return c

# Call the solve function and print the result
result = solve()
print(result)
