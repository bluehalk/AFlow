    O = (0, 0)

    # The distance from O to any vertex
    distance_O_A = ((O[0] - A[0]) ** 2 + (O[1] - A[1]) ** 2) ** 0.5
    distance_O_B = ((O[0] - B[0]) ** 2 + (O[1] - B[1]) ** 2) ** 0.5
    distance_O_C = ((O[0] - C[0]) ** 2 + (O[1] - C[1]) ** 2) ** 0.5
    distance_O_D = ((O[0] - D[0]) ** 2 + (O[1] - D[1]) ** 2) ** 0.5

    # The distance from any point (x, y) to the vertices
