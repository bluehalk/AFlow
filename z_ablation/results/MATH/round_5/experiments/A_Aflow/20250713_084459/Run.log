from math import comb

def solve():
    # Number of trials (rolls)
    n = 5
    # Number of successful outcomes (rolling a 1 or 2)
    k = 3
    # Probability of success on a single trial (rolling a 1 or 2)
    p = 2 / 6  # There are 2 successful outcomes (1 and 2) out of 6 possible outcomes
    # Probability of failure on a single trial (not rolling a 1 or 2)
    q = 1 - p  # This is 4/6 or 2/3

    # Calculate the probability using the binomial formula
    probability = comb(n, k) * (p ** k) * (q ** (n - k))
    
    return probability

# Call the solve function and print the result
result = solve()
print(result)
```
