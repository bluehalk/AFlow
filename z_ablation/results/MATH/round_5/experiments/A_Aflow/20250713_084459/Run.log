\[3 \cos^2 \theta - 2 \cos^3 \theta.\]

2025-07-13 09:01:59 - INFO - ```python
import math

def solve():
    # Given volume of the tetrahedron
    volume = 1 / math.sqrt(360)
    
    # The formula for the volume of a tetrahedron formed by three unit vectors
    # V = (1/6) * |det(a, b, c)| = (1/6) * sqrt(1 + 3 * cos^2(theta) - 3 * cos^4(theta))
    # We need to find cos(theta) such that:
    # (1/6) * sqrt(1 + 3 * x^2 - 3 * x^4) = volume
    # where x = cos(theta)
    
    # Rearranging gives:
    # sqrt(1 + 3 * x^2 - 3 * x^4) = 6 * volume
    # 1 + 3 * x^2 - 3 * x^4 = (6 * volume)^2
    # 3 * x^4 - 3 * x^2 + (6 * volume)^2 - 1 = 0
    
    # Calculate the right-hand side
    rhs = (6 * volume) ** 2
    
    # Coefficients for the quadratic in terms of y = x^2
    a = 3
    b = -3
    c = rhs - 1
    
    # Using the quadratic formula to find x^2
    discriminant = b**2 - 4 * a * c
    if discriminant < 0:
        return None  # No real solution
    
    y1 = (-b + math.sqrt(discriminant)) / (2 * a)
    y2 = (-b - math.sqrt(discriminant)) / (2 * a)
    
    # We need to find 3 * cos^2(theta) - 2 * cos^3(theta)
    # cos^2(theta) = y, cos^3(theta) = y * sqrt(y)
    
    results = []
    for y in [y1, y2]:
        if 0 <= y <= 1:  # Valid cos^2(theta)
            cos_cubed = y * math.sqrt(y)
            result = 3 * y - 2 * cos_cubed
            results.append(result)
    
    # Return the first valid result
    return results[0] if results else None

# Call the solve function and print the result
result = solve()
print(result)
```
