    expected_return = 0
    
    # Calculate the expected return for each possible choice (1 to 4)
    for choice in range(1, 5):
        win_one = 0  # Wins $1
        win_two = 0  # Wins $2
        lose_one = 0  # Loses $1
        
        for die1, die2 in outcomes:
            if die1 == choice and die2 == choice:
                win_two += 1
            elif die1 == choice or die2 == choice:
                win_one += 1
            else:
                lose_one += 1
        
        # Calculate the contribution to expected return for this choice
        total_outcomes = len(outcomes)
        expected_return += (win_one * 1 + win_two * 2 - lose_one * 1) / total_outcomes
    
    # Since all choices are symmetric, we can divide by 4 to get the average
    expected_return /= 4
    
    # Return the expected return as a fraction
    from fractions import Fraction
    return Fraction(expected_return).limit_denominator()

