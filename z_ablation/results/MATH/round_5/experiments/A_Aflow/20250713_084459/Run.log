    # The number of ways to choose 2 positions from 54 is given by combinations
    from math import comb
    
    # The expected number of cards between the two jokers can be calculated
    # Let X be the number of cards between the two jokers
    # The possible values for X are 0 to 52 (since there are 52 other cards)
    
    # The expected value E[X] can be calculated as follows:
    expected_value = 0
    
    # The number of ways to choose 2 positions for the jokers
    total_ways = comb(total_cards, 2)
    
    # Calculate the expected number of cards between the two jokers
