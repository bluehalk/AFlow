def solve():
    # Size of the chessboard
    n = 8
    
    # Calculate the number of ways to place two pieces in the same row
    same_row_ways = n * (n - 1)  # Choose 1 row (n ways) and place 2 pieces in that row (n-1 ways)
    
    # Calculate the number of ways to place two pieces in the same column
    same_column_ways = n * (n - 1)  # Choose 1 column (n ways) and place 2 pieces in that column (n-1 ways)
    
    # Total ways is the sum of both cases
    total_ways = same_row_ways + same_column_ways
    
    return total_ways

