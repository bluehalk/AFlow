def solve():
    def is_terminating_fraction(k):
        # A fraction 1/k is terminating if k has no prime factors other than 2 and 5
        while k % 2 == 0:
            k //= 2
        while k % 5 == 0:
            k //= 5
        return k == 1

    n = 1
    terminating_count = 0

    while True:
        if is_terminating_fraction(n):
            terminating_count += 1
        
        # Check if exactly half of the fractions are terminating
        if terminating_count * 2 == n:
            return n
        
        n += 1

result = solve()
print(result)
