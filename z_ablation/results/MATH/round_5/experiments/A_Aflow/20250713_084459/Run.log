import numpy as np
from scipy.integrate import quad

def polar_area(r_func, theta_start, theta_end):
    """Calculate the area under a polar curve from theta_start to theta_end."""
    integrand = lambda theta: 0.5 * (r_func(theta) ** 2)
    area, _ = quad(integrand, theta_start, theta_end)
    return area

def r(theta):
    """Polar function r = 1 + cos(theta)."""
    return 1 + np.cos(theta)

def solve():
    # The polar curve r = 1 + cos(theta) completes one full rotation from 0 to 2*pi
    theta_start = 0
    theta_end = 2 * np.pi
    
    # Calculate the area swept by the curve when rotated around (2, 0)
    area = polar_area(r, theta_start, theta_end)
    
    # The area of the region swept over when rotated around (2, 0) is:
    # Area = Area of the polar curve + Area of the circle of radius 2
    radius_of_rotation = 2
    area_of_circle = np.pi * (radius_of_rotation ** 2)
    
    total_area = area + area_of_circle
    return total_area

# Call the solve function and print the result
result = solve()
print(result)
```
