import numpy as np
from scipy.integrate import quad

def polar_area(r_func, theta_start, theta_end):
    """Calculate the area under a polar curve from theta_start to theta_end."""
    integrand = lambda theta: 0.5 * (r_func(theta) ** 2)
    area, _ = quad(integrand, theta_start, theta_end)
    return area

def r(theta):
    """Polar function r = 1 + cos(theta)."""
    return 1 + np.cos(theta)

def solve():
    # The area swept by the curve r = 1 + cos(theta) when rotated around (2, 0)
    # is calculated by finding the area of the original polar curve and then
    # using the formula for the area of a shape rotated around a point.
    
    # The area of the original polar curve from 0 to 2*pi
    area_original = polar_area(r, 0, 2 * np.pi)
    
    # The area swept when rotated around the point (2, 0)
    # The distance from the point (2, 0) to the origin is 2.
    # The area swept is the area of the original curve plus the area of the circle
    # with radius 2 (the distance from (2, 0) to the origin).
    radius = 2
    area_circle = np.pi * radius ** 2
    
    # Total area swept
    total_area = area_original + area_circle
    return total_area

# Call the solve function and print the result
result = solve()
print(result)
```
