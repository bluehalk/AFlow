import math

def solve():
    # We need to find the smallest integer greater than 200
    # such that gcd(integer, 36) = 18.
    
    # The GCD of two numbers is the largest number that divides both.
    # Since we want gcd(x, 36) = 18, x must be a multiple of 18.
    
    # The multiples of 18 are: 18, 36, 54, 72, 90, 108, 126, 144, 162, 180, 198, 216, ...
    # We start checking from the first multiple of 18 that is greater than 200.
    
    # The first multiple of 18 greater than 200 can be found by:
    # 1. Dividing 200 by 18 and taking the ceiling of the result.
    # 2. Multiplying the ceiling result by 18.
    
    start = (200 // 18) + 1  # This gives us the next multiple
    candidate = start * 18   # This is the first candidate greater than 200
    
    # We need to check if gcd(candidate, 36) == 18
    while True:
        if math.gcd(candidate, 36) == 18:
            return candidate
        candidate += 18  # Check the next multiple of 18

# Call the solve function and print the result
