def solve():
    # Total number of people
    total_people = 6
    
    # Total arrangements of 6 people
    total_arrangements = factorial(total_people)
    
    # Each couple can be treated as a single unit (block)
    # There are 3 couples, so we can treat them as 3 blocks
    # Each block can be arranged in 2 ways (couple A can sit as (A1, A2) or (A2, A1))
    couple_blocks = 3
    arrangements_of_blocks = factorial(couple_blocks)
    arrangements_within_blocks = 2 ** couple_blocks
    
    # Total favorable arrangements where couples sit together
    favorable_arrangements = arrangements_of_blocks * arrangements_within_blocks
    
    # Probability calculation
    probability = favorable_arrangements / total_arrangements
    
    return probability

def factorial(n):
    if n == 0 or n == 1:
        return 1
    result = 1
    for i in range(2, n + 1):
        result *= i
    return result

# Call the solve function and print the result
result = solve()
print(result)
```
