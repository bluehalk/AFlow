        '5': 5,
        '6': 6,
        '7': 7,
        '8': 8,
        '9': 9,
        '10': 10,
        'Jack': 20,
        'Queen': 20,
        'King': 20
    }
    
    # Define the suits
    suits = ['♠', '♥', '♦', '♣']
    
    # Initialize total winnings
    total_winnings = 0
    total_cards = 52
    
