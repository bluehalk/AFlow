def solve():
    from math import factorial

    # Total number of cars
    n = 6
    # Total number of lanes
    lanes = 3

    # Calculate the total arrangements of cars
    total_arrangements = factorial(n)

    # Calculate the arrangements where at least one lane is empty
    # We will use the principle of inclusion-exclusion

    # Total arrangements with at least one lane empty
    arrangements_with_empty_lanes = 0

    # Calculate arrangements for 1 lane empty
    for i in range(1, lanes + 1):
        # Choose i lanes to be empty
        empty_lanes = factorial(lanes) // factorial(lanes - i)
        # Remaining lanes will have all cars
        arrangements_for_remaining_lanes = factorial(n) * (lanes - i) ** n
        arrangements_with_empty_lanes += empty_lanes * arrangements_for_remaining_lanes

    # Total arrangements with all lanes occupied
    arrangements_with_all_lanes_occupied = total_arrangements - arrangements_with_empty_lanes

    return arrangements_with_all_lanes_occupied

# Call the solve function and print the result
result = solve()
print(result)
```
