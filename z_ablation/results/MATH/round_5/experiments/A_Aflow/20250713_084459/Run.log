def count_trailing_zeroes_in_factorial_base(n, base):
    # Function to count the number of trailing zeroes in n! in a given base
    def prime_factors(b):
        factors = {}
        d = 2
        while d * d <= b:
            while (b % d) == 0:
                if d in factors:
                    factors[d] += 1
                else:
                    factors[d] = 1
                b //= d
            d += 1
        if b > 1:
            factors[b] = 1
        return factors

    def count_p_in_factorial(n, p):
        # Count how many times p is a factor in n!
        count = 0
        power = p
        while power <= n:
            count += n // power
            power *= p
        return count

    # Get the prime factors of the base
    factors = prime_factors(base)
    
    # Calculate the minimum number of times n! can be divided by base
    min_zeroes = float('inf')
    for p, exponent in factors.items():
        count = count_p_in_factorial(n, p)
        min_zeroes = min(min_zeroes, count // exponent)
    
    return min_zeroes

def solve():
    n = 10  # We want to calculate for 10!
    base = 11  # We want to find trailing zeroes in base 11
    result = count_trailing_zeroes_in_factorial_base(n, base)
    return result

