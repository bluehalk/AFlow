import numpy as np
from scipy.optimize import fsolve

def equation(x):
    return np.tan(7 * x) - np.sin(6 * x) - (np.cos(4 * x) - 1/np.tan(7 * x))

def solve():
    # Define the range for x
    x_values = np.linspace(0, 2 * np.pi, 1000)
    solutions = []

    # Use fsolve to find roots of the equation
    for x0 in x_values:
        root = fsolve(equation, x0)[0]
        # Check if the root is within the desired range and not already found
        if 0 <= root <= 2 * np.pi and all(abs(root - sol) > 1e-5 for sol in solutions):
            solutions.append(root)

    # Convert solutions to a more readable format (in radians)
    solutions = sorted(solutions)
    return ', '.join(f"{sol:.6f}" for sol in solutions)

# Call the solve function and print the result
result = solve()
print(result)
