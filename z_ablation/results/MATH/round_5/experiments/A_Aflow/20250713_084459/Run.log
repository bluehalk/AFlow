def fibonacci_mod(n, mod):
    if n == 0:
        return 0
    elif n == 1:
        return 1
    
    a, b = 0, 1
    for _ in range(2, n + 1):
        a, b = b, (a + b) % mod
    return b

def solve():
    # Given conditions for a, b, c
    a = 5  # a ≡ 5 (mod 16)
    b = 10 # b ≡ 10 (mod 16)
    c = 15 # c ≡ 15 (mod 16)
    
    # Calculate Fibonacci numbers t_a, t_b, t_c modulo 7
    t_a = fibonacci_mod(a, 7)
    t_b = fibonacci_mod(b, 7)
    t_c = fibonacci_mod(c, 7)
    
    # Calculate the sum and then take modulo 7
    result = (t_a + t_b + t_c) % 7
    return result

# Call the solve function and print the result
print(solve())
