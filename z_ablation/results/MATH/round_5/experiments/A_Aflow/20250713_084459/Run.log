        5: 7,
        6: 8
    }
    
    # Calculate the total sum of outcomes
    total_sum = sum(outcome * count for outcome, count in outcomes.items())
    
    # Calculate the total number of rolls
    total_rolls = sum(outcomes.values())
    
    # Calculate the average
    average = total_sum / total_rolls
    
    # Return the average rounded to two decimal places
