2025-07-13 08:56:57 - INFO - ```python
import math

def solve():
    # We need to find the smallest positive t such that cos(t) = cos(t degrees)
    # Convert degrees to radians for the comparison
    def cos_degrees(deg):
        return math.cos(math.radians(deg))
    
    # Start searching for t from a small positive value
    t = 0.0
    step = 0.0001  # A small step to increment t
    while True:
        if math.isclose(math.cos(t), cos_degrees(t), rel_tol=1e-9):
            break
        t += step
    
    # Return the floor of t
    return math.floor(t)

# Call the solve function and print the result
result = solve()
print(result)
```
