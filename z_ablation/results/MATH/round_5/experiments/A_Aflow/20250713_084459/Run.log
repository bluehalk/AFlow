    a_values = [i for i in range(5, 1000, 9)]  # Arbitrarily chosen upper limit of 1000
    
    # Find all possible values of b such that b % 36 == 53
    b_values = [i for i in range(53, 1000, 36)]  # Arbitrarily chosen upper limit of 1000
    
    # Calculate a - b for all combinations of a and b
    results = []
    for a in a_values:
        for b in b_values:
            if a > b:  # Ensure a - b is positive
                difference = a - b
                
                # Convert the difference to base 3 and get the last two digits
                base_3_digits = []
                while difference > 0:
