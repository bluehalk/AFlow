2025-07-13 08:54:21 - INFO - ```python
def solve():
    # Function to find all nice numbers in the range 2010 to 2019
    nice_numbers = set()
    
    # A number m has exactly four positive divisors if it is of the form p^3 or p*q
    # where p and q are distinct primes.
    
    # Check for numbers in the range 2010 to 2019
    for n in range(2010, 2020):
        # Check for the form p^3
        for p in range(2, int(n**(1/3)) + 2):
            if is_prime(p):
                m = p**3
                if m > 1 and sum_of_divisors(m) == n:
                    nice_numbers.add(n)
        
        # Check for the form p*q
        for p in range(2, int(n**0.5) + 2):
            if is_prime(p):
                for q in range(p + 1, n // p + 1):
                    if is_prime(q):
                        m = p * q
                        if m > 1 and sum_of_divisors(m) == n:
                            nice_numbers.add(n)

    # Return the sum of all nice numbers found
    return sum(nice_numbers)

def is_prime(num):
    if num < 2:
        return False
    for i in range(2, int(num**0.5) + 1):
        if num % i == 0:
            return False
    return True

def sum_of_divisors(m):
    divisors = [1, m]
    for i in range(2, int(m**0.5) + 1):
        if m % i == 0:
            divisors.append(i)
            if i != m // i:
                divisors.append(m // i)
    return sum(divisors)

# Call the solve function and print the result
result = solve()
print(result)
```
