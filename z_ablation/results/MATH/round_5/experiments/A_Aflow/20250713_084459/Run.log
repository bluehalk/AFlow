    chocolate_chip_cookies = 3
    sugar_cookies = 4
    
    # Total cookies
    total_cookies = chocolate_chip_cookies + sugar_cookies
    
    # Function to calculate permutations of cookies
    def permutations(chocolate_chip, sugar):
        return factorial(chocolate_chip + sugar) // (factorial(chocolate_chip) * factorial(sugar))
    
    # Calculate total arrangements
    total_arrangements = permutations(chocolate_chip_cookies, sugar_cookies)
    
    # Calculate arrangements where chocolate chip cookie is first
    arrangements_first = permutations(chocolate_chip_cookies - 1, sugar_cookies)
    
    # Calculate arrangements where chocolate chip cookie is last
    arrangements_last = permutations(chocolate_chip_cookies - 1, sugar_cookies)
    
    # Calculate arrangements where chocolate chip cookie is both first and last
    arrangements_both = permutations(chocolate_chip_cookies - 2, sugar_cookies)
    
    # Using the principle of inclusion-exclusion
    valid_arrangements = (arrangements_first + arrangements_last - arrangements_both)
    
    return valid_arrangements

