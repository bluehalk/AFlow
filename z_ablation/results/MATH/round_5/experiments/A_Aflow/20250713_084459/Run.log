    d1 = np.array([-3, -2, -6])  # Direction vector of the first line
    d2 = np.array([1, 2, 2])      # Direction vector of the second line

    # Calculate the cosine of the angle between the two direction vectors
    dot_product = np.dot(d1, d2)
    norm_d1 = np.linalg.norm(d1)
    norm_d2 = np.linalg.norm(d2)

    # Using the formula cos(theta) = (d1 . d2) / (||d1|| * ||d2||)
    cos_theta = dot_product / (norm_d1 * norm_d2)

    return cos_theta

