def solve():
    # Probability of winning in a single turn
    # Winning conditions: die shows 1 or 6 (2 outcomes) and coin shows heads (1 outcome)
    winning_die_outcomes = 2  # (1, 6)
    total_die_outcomes = 6
    winning_coin_outcomes = 1  # (heads)
    total_coin_outcomes = 2
    
    # Probability of winning in one turn
    probability_win = (winning_die_outcomes / total_die_outcomes) * (winning_coin_outcomes / total_coin_outcomes)
    
    # Probability of losing in one turn
    probability_lose = 1 - probability_win
    
    # Probability of winning before the fourth turn
    # This can be calculated as 1 - (probability of losing all three turns)
    probability_lose_all_three_turns = probability_lose ** 3
    probability_win_before_fourth_turn = 1 - probability_lose_all_three_turns
    
    # Return the result as a common fraction
    return Fraction(probability_win_before_fourth_turn).limit_denominator()

