def is_prime(n):
    """Check if a number is prime."""
    if n <= 1:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

def prime_factors(n):
    """Return the prime factors of a number as a set."""
    factors = set()
    for i in range(2, n + 1):
        while n % i == 0 and is_prime(i):
            factors.add(i)
            n //= i
    return factors

def least_perfect_square_with_three_prime_factors():
    """Find the least perfect square with 3 different prime factors."""
    n = 1
    while True:
        factors = prime_factors(n)
        if len(factors) == 3:
            # To be a perfect square, all prime factors must have even exponents
            return n
        n += 1

def solve():
    """Solve the problem and return the result."""
    result = least_perfect_square_with_three_prime_factors()
    return result

# Output the result
print(solve())
```
