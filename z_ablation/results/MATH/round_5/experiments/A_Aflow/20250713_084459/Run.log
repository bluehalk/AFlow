    # Simplifying this leads to:
    # a * altitude = a^2 / √2
    # Therefore, a = altitude * √2
    
    # Calculate the length of the legs
    leg_length = altitude * (2 ** 0.5)
    
    # Calculate the area of the triangle
    area = (1/2) * leg_length * leg_length
    
