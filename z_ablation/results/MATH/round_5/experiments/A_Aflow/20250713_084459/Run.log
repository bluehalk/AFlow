2025-07-13 08:45:45 - INFO - ```python
def solve():
    # Given data from the stem-and-leaf plot
    data = [
        41, 52, 67, 68, 71, 71, 72, 73, 73, 73, 75, 76, 78,
        80, 84, 84, 86, 86, 86, 86, 88, 91, 93, 95, 95, 97
    ]
    
    # Calculate the median
    n = len(data)
    sorted_data = sorted(data)
    
    if n % 2 == 0:
        median = (sorted_data[n // 2 - 1] + sorted_data[n // 2]) / 2
    else:
        median = sorted_data[n // 2]
    
    # Calculate the mode
    from collections import Counter
    frequency = Counter(data)
    mode_data = frequency.most_common()
    max_frequency = mode_data[0][1]
    mode = [num for num, freq in mode_data if freq == max_frequency]
    
    # If there are multiple modes, we take the smallest one
    mode = min(mode)
    
    # Calculate the arithmetic mean of the median and the mode
    arithmetic_mean = (median + mode) / 2
    
    return arithmetic_mean

# Call the solve function and print the result
result = solve()
print(result)
```
