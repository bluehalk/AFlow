    # Total arrangements
    total_arrangements = arrangements_of_units * arrangements_of_math_books
    
    return total_arrangements

def factorial(n):
    if n == 0 or n == 1:
        return 1
    result = 1
    for i in range(2, n + 1):
        result *= i
    return result

