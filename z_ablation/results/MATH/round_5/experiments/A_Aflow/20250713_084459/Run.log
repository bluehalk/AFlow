import math

def solve():
    # Calculate the right-hand side of the equation
    cos_50 = math.cos(math.radians(50))
    sin_50 = math.sin(math.radians(50))
    rhs = cos_50 / (1 - sin_50)
    
    # We need to find the smallest positive integer x such that
    # tan(x - 160) = rhs
    # This means we need to solve for x
    # tan(theta) = rhs implies theta = arctan(rhs)
    
    # Calculate the angle theta
    theta = math.degrees(math.atan(rhs))
    
    # Since tan is periodic with a period of 180 degrees,
    # we can express x as:
    # x - 160 = theta + k * 180 for some integer k
    # Therefore, x = theta + 160 + k * 180
    
    # We need to find the smallest positive x
    k = 0
    while True:
        x = theta + 160 + k * 180
        if x > 0:
            return round(x)  # Return the smallest positive integer x
        k += 1

# Call the solve function and print the result
result = solve()
print(result)
```
