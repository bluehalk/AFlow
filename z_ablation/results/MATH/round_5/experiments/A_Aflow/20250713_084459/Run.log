    v = np.array([0, 13])
    
    # Projection of v onto a is given
    proj_a = np.array([6, 4])
    
    # Calculate the vector a from the projection
    # proj_a = (v . a / ||a||^2) * a
    # Since we know proj_a, we can find a
    # Let's denote a = k * proj_a for some scalar k
    # We can find k by using the fact that proj_a is a scaled version of a
    # We can find the length of proj_a
    length_proj_a = np.linalg.norm(proj_a)
    
    # The projection formula gives us the direction of a
    # We can find a by normalizing proj_a
    a = proj_a / length_proj_a
    
    # Since a and b are orthogonal, we can find b as a vector orthogonal to a
    # If a = [a1, a2], then b can be [-a2, a1] (90 degrees rotation)
    b = np.array([-a[1], a[0]])
    
    # Now we can calculate the projection of v onto b
    # proj_b = (v . b / ||b||^2) * b
    dot_product_v_b = np.dot(v, b)
    length_b_squared = np.dot(b, b)
    
    proj_b = (dot_product_v_b / length_b_squared) * b
    
    return proj_b

