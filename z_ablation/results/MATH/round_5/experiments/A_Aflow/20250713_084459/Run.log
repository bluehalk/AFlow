    inner_height = mid_A_O[1] - mid_D_O[1]
    area_inner_rectangle = inner_width * inner_height

    # The probability is the area of the inner rectangle divided by the area of the outer rectangle
    probability = area_inner_rectangle / area_rectangle

    return probability

