2025-07-13 09:09:14 - INFO - ```python
from math import comb

def solve():
    # Total number of dice
    total_dice = 6
    
    # We want exactly 2 dice to show a 1 and exactly 2 dice to show a 2
    count_ones = 2
    count_twos = 2
    
    # The remaining dice will show neither 1 nor 2
    remaining_dice = total_dice - (count_ones + count_twos)  # 6 - (2 + 2) = 2
    
    # The number of ways to choose which dice show 1s
    ways_to_choose_ones = comb(total_dice, count_ones)
    
    # The number of ways to choose which of the remaining dice show 2s
    ways_to_choose_twos = comb(total_dice - count_ones, count_twos)
    
    # The remaining dice can show any of the numbers 3, 4, 5, or 6
    # There are 4 options for each of the remaining dice
    ways_for_remaining_dice = 4 ** remaining_dice
    
    # Total favorable outcomes
    favorable_outcomes = (ways_to_choose_ones * 
                          ways_to_choose_twos * 
                          ways_for_remaining_dice)
    
    # Total possible outcomes when rolling 6 dice
    total_outcomes = 6 ** total_dice
    
    # Probability as a fraction
    probability = favorable_outcomes / total_outcomes
    
    # Return the result as a common fraction
    return f"{favorable_outcomes}/{total_outcomes}"

# Call the solve function and print the result
print(solve())
```
