import math
from functools import reduce

def product_of_four_consecutive_integers(n):
    """Calculate the product of four consecutive integers starting from n."""
    return n * (n + 1) * (n + 2) * (n + 3)

def gcd(a, b):
    """Calculate the greatest common divisor of a and b."""
    while b:
        a, b = b, a % b
    return a

def solve():
    """Calculate the greatest common divisor of all products of four consecutive integers."""
    # We will calculate the GCD of the first few products of four consecutive integers
    # to find a pattern.
    products = [product_of_four_consecutive_integers(n) for n in range(1, 11)]
    
    # Calculate the GCD of the list of products
    result = reduce(gcd, products)
    
    return result

# Call the solve function and print the result
if __name__ == "__main__":
    print(solve())
```
