from math import comb

def solve():
    # Total number of dice
    total_dice = 5
    
    # Probability of rolling a 1 or 2
    p_success = 2 / 6  # There are 2 favorable outcomes (1 and 2) out of 6 possible outcomes
    p_failure = 1 - p_success  # Probability of not rolling a 1 or 2
    
    # We want exactly 2 successes (rolling a 1 or 2)
    k = 2
    
    # Calculate the probability using the binomial formula
    probability = (comb(total_dice, k) * (p_success ** k) * (p_failure ** (total_dice - k)))
    
    return probability

