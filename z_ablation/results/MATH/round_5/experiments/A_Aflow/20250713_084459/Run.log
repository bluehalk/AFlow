def solve():
    from itertools import combinations
    from math import isqrt

    # The target product
    target_product = 2310

    # Function to get the prime factors of a number
    def prime_factors(n):
        factors = {}
        for i in range(2, isqrt(n) + 1):
            while n % i == 0:
                if i in factors:
                    factors[i] += 1
                else:
                    factors[i] = 1
                n //= i
        if n > 1:
            factors[n] = 1
        return factors

    # Get the prime factors of 2310
    factors = prime_factors(target_product)
    
    # Generate all distinct factors of the number
    distinct_factors = set()
    def generate_factors(current_product, prime_list, index):
        if index == len(prime_list):
            if current_product > 1:
                distinct_factors.add(current_product)
            return
        prime, count = prime_list[index]
        for exp in range(count + 1):
            generate_factors(current_product * (prime ** exp), prime_list, index + 1)
    
    prime_list = list(factors.items())
    generate_factors(1, prime_list, 0)

    # Convert the set to a sorted list
    distinct_factors = sorted(distinct_factors)

    # Count valid combinations of three distinct factors
    count = 0
    for a, b, c in combinations(distinct_factors, 3):
        if a * b * c == target_product:
            count += 1

    return count

