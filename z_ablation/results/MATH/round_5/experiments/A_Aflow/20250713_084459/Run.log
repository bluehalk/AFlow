    # Two vectors are parallel if one is a scalar multiple of the other
    cross_product = np.cross(direction1, direction2)
    
    if not np.all(cross_product == 0):
        return "The lines are not parallel."
    
    # Calculate the distance between the two parallel lines
    # Using the formula: distance = |(P2 - P1) . n| / |n|
    # where P1 is a point on line 1, P2 is a point on line 2, and n is the direction vector of the lines
    
    # Vector between points on the two lines
    P2_minus_P1 = point2 - point1
    
    # Normal vector (direction vector of the lines)
    n = direction1  # or direction2, since they are parallel
    
    # Calculate the distance
    distance = np.abs(np.dot(P2_minus_P1, n) / np.linalg.norm(n))
    
    return distance

