import numpy as np

def solve():
    # Number of random samples to generate
    num_samples = 1000000
    
    # Generate random numbers a and b uniformly between 0 and 1
    a = np.random.rand(num_samples)
    b = np.random.rand(num_samples)
    
    # Calculate c as the sum of a and b
    c = a + b
    
    # Round a, b, and c to the nearest integer
    A = np.round(a).astype(int)
    B = np.round(b).astype(int)
    C = np.round(c).astype(int)
    
    # Calculate the probability that A + B = C
    count = np.sum(A + B == C)
    probability = count / num_samples
    
    return probability

