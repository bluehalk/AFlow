def extended_gcd(a, b):
    if a == 0:
        return b, 0, 1
    gcd, x1, y1 = extended_gcd(b % a, a)
    x = y1 - (b // a) * x1
    y = x1
    return gcd, x, y

def mod_inverse(a, n):
    gcd, x, _ = extended_gcd(a, n)
    if gcd != 1:
        raise ValueError("Inverse does not exist")
    return x % n

def solve():
    # Given values
    n = 7  # Example value for n (must be >= 3)
    a = 3  # Example value for a
    b = 5  # Example value for b

    # Check if ab is invertible modulo n
    ab = a * b
    if extended_gcd(ab, n)[0] != 1:
        raise ValueError("ab is not invertible modulo n")

    # Check if a + b is invertible
    a_plus_b = a + b
    if extended_gcd(a_plus_b, n)[0] != 1:
        raise ValueError("a + b is not invertible modulo n")

    # Given that (ab)^-1 ≡ 2 (mod n)
    ab_inverse = 2

    # Calculate (a + b)^-1
    a_plus_b_inverse = mod_inverse(a_plus_b, n)

    # Calculate (a^-1 + b^-1)
    a_inverse = mod_inverse(a, n)
    b_inverse = mod_inverse(b, n)
    sum_inverses = (a_inverse + b_inverse) % n

    # Calculate the final result
    result = (a_plus_b_inverse * sum_inverses) % n

    return result

# Call the solve function and print the result
