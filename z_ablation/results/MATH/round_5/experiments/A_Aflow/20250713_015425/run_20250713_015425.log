2025-07-13 01:57:09 - INFO - ```python
def solve():
    # The number we are interested in
    number = 144
    
    # Find all factors of the number
    factors = set()
    for i in range(1, int(number**0.5) + 1):
        if number % i == 0:
            factors.add(i)
            factors.add(number // i)
    
    # Filter for two-digit factors
    two_digit_factors = [f for f in factors if 10 <= f < 100]
    
    # Calculate the sum of distinct two-digit factors
    result = sum(two_digit_factors)
    
    return result

# Call the solve function and print the result
print(solve())
```
