from math import factorial

def solve():
    # Number of distinguishable balls
    n = 4
    # Number of indistinguishable boxes
    k = 3
    
    # To find the number of ways to distribute n distinguishable balls into k indistinguishable boxes,
    # we can use the formula for the number of partitions of n into at most k parts.
    
    # We will use the "stars and bars" theorem and the concept of partitions.
    # We can calculate the number of ways to partition n into at most k parts using the formula:
    # P(n, k) = sum((-1)^j * C(k, j) * C(n - j * (k + 1) - 1, k - 1)) for j in range(0, k + 1)
    
    def combinations(n, r):
        if r > n or r < 0:
            return 0
        return factorial(n) // (factorial(r) * factorial(n - r))
    
    def partitions(n, k):
        total = 0
        for j in range(k + 1):
            total += (-1) ** j * combinations(k, j) * combinations(n - j * (k + 1) - 1, k - 1)
        return total
    
    result = partitions(n, k)
    return result

# Call the solve function and print the result
print(solve())
```
