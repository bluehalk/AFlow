import numpy as np

def area_of_swept_region(r_func, theta_start, theta_end, num_points=1000):
    # Generate theta values
    theta = np.linspace(theta_start, theta_end, num_points)
    
    # Calculate r values
    r = r_func(theta)
    
    # Calculate the area using the polar area formula
    area = 0.5 * np.trapz(r**2, theta)
    return area

def solve():
    # Define the polar function r = 1 + cos(theta)
    r_func = lambda theta: 1 + np.cos(theta)
    
    # The area swept when rotating around the point (2, 0)
    # The limits for theta are from 0 to 2*pi
    theta_start = 0
    theta_end = 2 * np.pi
    
    # Calculate the area
    swept_area = area_of_swept_region(r_func, theta_start, theta_end)
    
    # The area of the region swept over when rotating around (2, 0)
    # The area of the circle with radius 2 is pi * (2^2) = 4 * pi
    # The area of the original polar curve is swept_area
    total_area = swept_area + (4 * np.pi)
    
    return total_area

# Call the solve function and print the result
result = solve()
print(result)
```
