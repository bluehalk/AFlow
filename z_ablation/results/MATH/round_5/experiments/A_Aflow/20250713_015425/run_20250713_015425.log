    # We need to find BC (a)

    # Using the Law of Sines:
    # BC / sin(A) = AB / sin(B)
    # BC = AB * (sin(A) / sin(B))

    # Calculate lengths using the Law of Sines
    BC = AB * (math.sin(angle_A_rad) / math.sin(angle_B_rad))

    # Return the result in simplest radical form
    return BC

