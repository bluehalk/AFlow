def proper_divisors(n):
    """Return a list of proper divisors of n."""
    divisors = []
    for i in range(1, n):
        if n % i == 0:
            divisors.append(i)
    return divisors

def sum_of_proper_divisors(n):
    """Return the sum of proper divisors of n."""
    return sum(proper_divisors(n))

def solve():
    # Step 1: Calculate the sum of the proper divisors of 284
    sum_divisors_284 = sum_of_proper_divisors(284)
    
    # Step 2: Calculate the sum of the proper divisors of the result from step 1
    result = sum_of_proper_divisors(sum_divisors_284)
    
    return result

# Output the result
print(solve())
```
