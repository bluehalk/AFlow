    green_balls = 2
    red_balls = 2
    boxes = 3
    
    # Generate all possible distributions of green and red balls in the boxes
    green_distributions = product(range(boxes), repeat=green_balls)
    red_distributions = product(range(boxes), repeat=red_balls)
    
    # Use a set to store unique distributions
    unique_distributions = set()
    
    # Combine distributions of green and red balls
    for green in green_distributions:
        for red in red_distributions:
            # Create a tuple that represents the distribution of balls in boxes
            distribution = [0] * boxes
            for box in green:
                distribution[box] += 1  # Add green balls
            for box in red:
                distribution[box] += 1    # Add red balls
            unique_distributions.add(tuple(distribution))
    
    # The number of unique distributions is the answer
    return len(unique_distributions)

# Call the solve function and print the result
result = solve()
print(result)
```
