2025-07-13 02:02:40 - INFO - ```python
from math import factorial

def solve():
    # Number of beads (different colors)
    n = 8
    
    # Number of rotations of a cube (considering only rotations, not reflections)
    # A cube has 24 rotational symmetries
    rotations = 24
    
    # Using Burnside's lemma to count distinct arrangements
    # The number of distinct arrangements is given by:
    # (1 / |G|) * sum(|Fix(g)| for g in G)
    # where |G| is the number of group actions (rotations) and |Fix(g)| is the number of arrangements fixed by g.
    
    # Since all beads are different, the number of arrangements fixed by any rotation is:
    # - For the identity rotation (1 way to arrange all beads)
    # - For other rotations, we need to consider how many beads remain in the same position.
    
    # Identity rotation fixes all arrangements
    fixed_by_identity = factorial(n)
    
    # Other rotations:
    # 6 rotations of 90 degrees and 6 rotations of 270 degrees around axes through the centers of faces
    # Each of these fixes 0 arrangements since all beads are different.
    fixed_by_90_and_270 = 0
    
    # 8 rotations of 180 degrees around axes through the centers of faces
    # Each of these fixes 0 arrangements since all beads are different.
    fixed_by_180 = 0
    
    # 6 rotations of 120 degrees and 6 rotations of 240 degrees around axes through vertices
    # Each of these fixes 0 arrangements since all beads are different.
    fixed_by_120_and_240 = 0
    
    # Total fixed arrangements
    total_fixed = (fixed_by_identity + 
                   fixed_by_90_and_270 * 12 + 
                   fixed_by_180 * 6 + 
                   fixed_by_120_and_240 * 12)
    
    # Applying Burnside's lemma
    distinct_arrangements = total_fixed // rotations
    
    return distinct_arrangements

# Call the solve function and print the result
result = solve()
print(result)
```
