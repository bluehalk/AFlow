def solve():
    # Number of people
    n = 8
    
    # To track the pairs of hugs
    hugs = set()
    
    # Initialize the number of weeks
    weeks = 0
    
    # Continue until all pairs have hugged
    while len(hugs) < n * (n - 1) // 2:  # Total pairs = n choose 2
        weeks += 1
        
        # Generate the current arrangement of people
        arrangement = list(range(n))
        
        # Simulate hugging for the current arrangement
        for i in range(n):
            left = arrangement[i]
            right = arrangement[(i + 1) % n]
            # Add the pair to the hugs set (sorted to avoid duplicates)
            hugs.add(tuple(sorted((left, right))))
        
        # Rotate the arrangement for the next week
        arrangement = arrangement[1:] + arrangement[:1]
    
    return weeks

# Call the solve function and print the result
result = solve()
print(result)
```
