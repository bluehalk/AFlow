    # This means we need to find b such that 2013 % b == 3
    # Rearranging gives us b = (2013 - 3) / k for some integer k >= 1
    # Thus, b = 2010 / k must be an integer and k must be a divisor of 2010
    
    target_value = number - digit
    
    # Finding divisors of 2010
