2025-07-13 02:03:35 - INFO - ```python
def solve():
    from itertools import combinations
    from math import isqrt

    # The target product
    target_product = 2310

    # Function to get the prime factors of a number
    def prime_factors(n):
        factors = {}
        for i in range(2, isqrt(n) + 1):
            while n % i == 0:
                if i in factors:
                    factors[i] += 1
                else:
                    factors[i] = 1
                n //= i
        if n > 1:
            factors[n] = 1
        return factors

    # Get the prime factors of 2310
    factors = prime_factors(target_product)
    
    # Generate all distinct positive integer factors of 2310
    def generate_factors(factors):
        from functools import reduce
        from itertools import product
        
        prime_list = list(factors.keys())
        exponents = [range(factors[p] + 1) for p in prime_list]
        
        all_factors = set()
        for exp in product(*exponents):
            factor = reduce(lambda x, y: x * (prime_list[y] ** exp[y]), range(len(exp)), 1)
            all_factors.add(factor)
        
        return sorted(all_factors)

    distinct_factors = generate_factors(factors)

    # Count valid three-element sets
    count = 0
    n = len(distinct_factors)

    for i in range(n):
        for j in range(i + 1, n):
            for k in range(j + 1, n):
                if distinct_factors[i] * distinct_factors[j] * distinct_factors[k] == target_product:
                    count += 1

    return count

# Call the solve function and print the result
result = solve()
print(result)
```
