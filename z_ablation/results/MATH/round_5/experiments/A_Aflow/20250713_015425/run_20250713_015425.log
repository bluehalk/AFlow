import cmath

def solve():
    # Define the complex numbers
    A = complex(-5, 3)  # First vertex
    B = complex(8, -1)  # Second vertex

    # Calculate the third vertices of the equilateral triangle
    # Rotate B around A by 60 degrees (pi/3 radians)
    angle = cmath.pi / 3
    c1 = A + (B - A) * cmath.exp(complex(0, angle))
    c2 = A + (B - A) * cmath.exp(complex(0, -angle))

    # Calculate the product of c1 and c2
    product = c1 * c2

    # Return the real and imaginary parts of the product
    return product.real, product.imag

# Call the solve function and print the result
result = solve()
print(f"Product c1 * c2: {result[0]} + {result[1]}i")
