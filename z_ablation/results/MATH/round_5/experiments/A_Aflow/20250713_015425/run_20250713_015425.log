from itertools import permutations

def solve():
    # Total number of lamps
    red_lamps = 3
    blue_lamps = 3
    total_lamps = red_lamps + blue_lamps
    
    # Generate all unique arrangements of the lamps
    arrangements = set(permutations(['R'] * red_lamps + ['B'] * blue_lamps))
    
    # Count the favorable outcomes
    favorable_count = 0
    
    for arrangement in arrangements:
        # Check if the leftmost lamp is red
        if arrangement[0] == 'R':
            # Count the number of red lamps in the arrangement
            red_count = arrangement.count('R')
            # We can turn on 3 lamps, we need to check if the leftmost turned on lamp is red
            # Total ways to choose 3 lamps to turn on
            total_ways_to_turn_on = comb(red_count, 1) * comb(total_lamps - red_count, 2) + comb(red_count, 2) * comb(total_lamps - red_count, 1) + comb(red_count, 3)
            # Count the ways where the leftmost turned on lamp is red
            favorable_ways = comb(red_count, 1) * comb(total_lamps - red_count, 2) + comb(red_count, 2) * comb(total_lamps - red_count, 1) + comb(red_count, 3)
            favorable_count += favorable_ways
    
    # Total arrangements
    total_arrangements = len(arrangements)
    
    # Probability calculation
    probability = favorable_count / total_arrangements
    
    return probability

def comb(n, k):
    if k > n or k < 0:
        return 0
    if k == 0 or k == n:
        return 1
    k = min(k, n - k)  # Take advantage of symmetry
    c = 1
    for i in range(k):
        c = c * (n - i) // (i + 1)
    return c

# Call the solve function and print the result
result = solve()
print(result)
```
