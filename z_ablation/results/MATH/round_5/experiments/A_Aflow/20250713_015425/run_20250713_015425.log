def solve():
    # Number of chocolate chip cookies and sugar cookies
    chocolate_chip_cookies = 3
    sugar_cookies = 4
    
    # Total number of cookies
    total_cookies = chocolate_chip_cookies + sugar_cookies
    
    # Function to calculate permutations of cookies
    def permutations(n, k):
        return factorial(n) // factorial(n - k)
    
    # Total arrangements of cookies
    total_arrangements = factorial(total_cookies) // (factorial(chocolate_chip_cookies) * factorial(sugar_cookies))
    
    # Arrangements where a chocolate chip cookie is first
    arrangements_first = permutations(total_cookies - 1, total_cookies - 1) // (factorial(chocolate_chip_cookies - 1) * factorial(sugar_cookies))
    
    # Arrangements where a chocolate chip cookie is last
    arrangements_last = permutations(total_cookies - 1, total_cookies - 1) // (factorial(chocolate_chip_cookies - 1) * factorial(sugar_cookies))
    
    # Arrangements where a chocolate chip cookie is both first and last
    arrangements_both = permutations(total_cookies - 2, total_cookies - 2) // (factorial(chocolate_chip_cookies - 2) * factorial(sugar_cookies))
    
    # Using the principle of inclusion-exclusion
    result = (arrangements_first + arrangements_last - arrangements_both)
    
    return result

