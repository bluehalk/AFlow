def solve():
    # Define the vector v
    v = np.array([1, 1])  # Example vector, can be any non-zero vector
    
    # Normalize the vector v
    v_normalized = v / np.linalg.norm(v)
    
    # Create the projection matrix P
    P = np.outer(v_normalized, v_normalized)
    
    # Create the identity matrix I
    I = np.eye(2)
    
    # The reflection matrix R can be expressed as R = 2P - I
    R = 2 * P - I
    
