def solve():
    # Total number of ways to choose 3 cards from a 52-card deck
    total_ways = comb(52, 3)
    
    # Number of ways to form a pair
    # Step 1: Choose the rank for the pair (13 ranks)
    ranks_for_pair = 13
    
    # Step 2: Choose 2 cards from the 4 available in that rank
    ways_to_choose_pair = comb(4, 2)
    
    # Step 3: Choose a different rank for the third card (12 remaining ranks)
    ranks_for_third_card = 12
    
    # Step 4: Choose 1 card from the 4 available in that rank
    ways_to_choose_third_card = comb(4, 1)
    
    # Total ways to form a pair
    ways_to_form_pair = (ranks_for_pair * ways_to_choose_pair * 
                         ranks_for_third_card * ways_to_choose_third_card)
    
    # Calculate the probability
    probability_of_pair = ways_to_form_pair / total_ways
    
    return probability_of_pair

# Call the solve function and print the result
result = solve()
print(result)
```
