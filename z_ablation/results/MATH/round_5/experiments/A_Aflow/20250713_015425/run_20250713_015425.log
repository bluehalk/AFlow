    start_time_camera_a = 6 * 60  # 6 AM in minutes
    start_time_camera_b = 7 * 60  # 7 AM in minutes
    
    # Define the intervals in minutes
    interval_camera_a = 11  # Camera A takes a picture every 11 minutes
    interval_camera_b = 7   # Camera B takes a picture every 7 minutes
    
    # Calculate the times when each camera takes pictures
    times_camera_a = set(range(start_time_camera_a, 12 * 60, interval_camera_a))
    times_camera_b = set(range(start_time_camera_b, 12 * 60, interval_camera_b))
    
    # Find the common times when both cameras take pictures
    common_times = times_camera_a.intersection(times_camera_b)
    
    # Find the last common time before noon
    last_common_time = max(common_times)
    
    # Calculate how many minutes before noon this time is
    noon_time = 12 * 60  # Noon in minutes
    minutes_before_noon = noon_time - last_common_time
    
    return minutes_before_noon

