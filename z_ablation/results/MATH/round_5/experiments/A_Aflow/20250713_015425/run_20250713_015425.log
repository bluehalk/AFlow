def solve():
    # Let n be expressed as n = p1^a * p2^b where p1 and p2 are the two distinct prime factors
    # The number of divisors of n is given by (a + 1) * (b + 1)
    # The number of divisors of n^2 is given by (2a + 1) * (2b + 1)
    
    # We know that n^2 has 27 divisors
    # Therefore, (2a + 1) * (2b + 1) = 27
    
    # The divisors of 27 can be factored as follows:
    # 27 = 27 * 1
    # 27 = 9 * 3
    # 27 = 3 * 9
    # 27 = 1 * 27
    
    # We will consider the pairs (2a + 1, 2b + 1) that multiply to 27
    divisor_pairs = [(27, 1), (9, 3), (3, 9), (1, 27)]
    
    # We will find valid (a, b) pairs from these divisor pairs
    for d1, d2 in divisor_pairs:
        # d1 = 2a + 1 and d2 = 2b + 1
        # We can solve for a and b
        a = (d1 - 1) // 2
        b = (d2 - 1) // 2
        
        # Since n has exactly 2 positive prime divisors, a and b must be non-negative integers
        if a >= 0 and b >= 0:
            # Calculate the number of divisors of n
            num_divisors_n = (a + 1) * (b + 1)
            return num_divisors_n
    
    return None  # In case no valid (a, b) pair is found

# Call the solve function and print the result
result = solve()
