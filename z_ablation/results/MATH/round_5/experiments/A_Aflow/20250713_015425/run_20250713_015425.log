def solve():
    # The size of the grid
    grid_size = 5
    
    # The center square is located at (2, 2) in 0-indexed coordinates
    center_x, center_y = 2, 2
    
    # Count the number of squares that contain the center square
    count = 0
    
    # Iterate over all possible square sizes
    for size in range(1, grid_size + 1):
        # The top-left corner of the square can be at (x, y)
        # where x and y are in the range that allows the square to fit in the grid
        for x in range(grid_size - size + 1):
            for y in range(grid_size - size + 1):
                # Check if the center square (2, 2) is within the current square
                if x <= center_x < x + size and y <= center_y < y + size:
                    count += 1
    
    return count

