def solve():
    total_questions = 10
    total_ways = 2 ** total_questions  # Total ways to answer 10 questions (True/False)
    
    # Calculate the number of ways to answer with less than 3 False answers
    ways_with_less_than_3_falses = 0
    
    # 0 False answers
    ways_with_0_falses = 1  # Only one way: all True
    
    # 1 False answer
    ways_with_1_false = total_questions  # Choose 1 question to be False
    
    # 2 False answers
    ways_with_2_falses = (total_questions * (total_questions - 1)) // 2  # Choose 2 questions to be False
    
    # Sum the ways with less than 3 False answers
    ways_with_less_than_3_falses = ways_with_0_falses + ways_with_1_false + ways_with_2_falses
    
    # Calculate the ways with at least 3 False answers
    ways_with_at_least_3_falses = total_ways - ways_with_less_than_3_falses
    
    return ways_with_at_least_3_falses

# Call the solve function and print the result
result = solve()
print(result)
```
