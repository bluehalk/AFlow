2025-07-13 02:04:57 - INFO - ```python
def solve():
    # Given congruence: 27a ≡ 17 (mod 40)
    # We need to find the smallest and second-smallest positive integers a that satisfy this.

    # We can rewrite the congruence as:
    # 27a - 40k = 17 for some integer k
    # This is a linear Diophantine equation.

    # We will find the multiplicative inverse of 27 modulo 40.
    def extended_gcd(a, b):
        if a == 0:
            return b, 0, 1
        gcd, x1, y1 = extended_gcd(b % a, a)
        x = y1 - (b // a) * x1
        y = x1
        return gcd, x, y

    # Finding the inverse of 27 mod 40
    gcd, x, _ = extended_gcd(27, 40)
    
    # Check if the gcd is 1, which means 27 has an inverse mod 40
    if gcd != 1:
        return "No solution exists"

    # The multiplicative inverse of 27 mod 40
    inverse = x % 40

    # Now we can solve for a
    # a ≡ 17 * inverse (mod 40)
    a = (17 * inverse) % 40

    # We need to find the smallest and second-smallest positive integers a
    # The general solution is a + 40k for k = 0, 1, 2, ...
    solutions = []
    for k in range(2):  # We only need the first two solutions
        current_solution = (a + 40 * k) % 40
        if current_solution > 0:
            solutions.append(current_solution)

    # Sort the solutions to find the smallest and second-smallest
    solutions = sorted(solutions)

    # Calculate the sum of the smallest and second-smallest
    result = sum(solutions)

    return result

# Call the solve function and print the result
print(solve())
```
