2025-07-13 02:04:33 - INFO - ```python
def sum_of_proper_divisors(n):
    """Calculate the sum of proper divisors of a given number n."""
    if n < 2:
        return 0
    divisors_sum = 1  # Start with 1, as it's a proper divisor for any n > 1
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            divisors_sum += i
            if i != n // i:  # Add the complementary divisor if it's different
                divisors_sum += n // i
    return divisors_sum

def solve():
    """Calculate the sum of the proper divisors of 198."""
    number = 198
    result = sum_of_proper_divisors(number)
    return result

# Output the result
print(solve())
```
