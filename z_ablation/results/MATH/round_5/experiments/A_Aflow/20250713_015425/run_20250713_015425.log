from math import factorial
from collections import Counter

def prime_factors(n):
    """Return the prime factorization of n as a Counter."""
    i = 2
    factors = Counter()
    while i * i <= n:
        while (n % i) == 0:
            factors[i] += 1
            n //= i
        i += 1
    if n > 1:
        factors[n] += 1
    return factors

def factorial_prime_factors(n):
    """Return the prime factorization of n! as a Counter."""
    factors = Counter()
    for i in range(2, n + 1):
        factors += prime_factors(i)
    return factors

def solve():
    # Calculate the prime factorization of 3!, 5!, and 7!
    factors_3 = factorial_prime_factors(3)
    factors_5 = factorial_prime_factors(5)
    factors_7 = factorial_prime_factors(7)
    
    # Combine the factors
    total_factors = factors_3 + factors_5 + factors_7
    
    # Count the number of positive cubes that divide the product
    count_cubes = 1
    for exponent in total_factors.values():
        count_cubes *= (exponent // 3) + 1
    
    return count_cubes

# Output the result
result = solve()
print(result)
