def solve():
    # Step 1: Find the inverse of 2 modulo 17
    # We need to find n such that 2n ≡ 1 (mod 17)
    for n in range(17):
        if (2 * n) % 17 == 1:
            break
    
    # Step 2: Calculate (2^n)^2 - 2 mod 17
    power_result = (2 ** n) % 17
    result = (power_result ** 2 - 2) % 17
    
    return result

