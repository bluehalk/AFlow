    # Finding all divisors of 67
    divisors = []
    for i in range(1, int(67**0.5) + 1):
        if 67 % i == 0:
            divisors.append(i)
            if i != 67 // i:
                divisors.append(67 // i)
    
    # Now we have the divisors of 67, we need to consider both positive and negative divisors
    divisors.extend([-d for d in divisors])
    
    # We will store the valid integer values of x
    valid_x_values = []
    
    # For each divisor, we can find the corresponding x
    for d in divisors:
        # 2x - 23 = d  =>  2x = d + 23  =>  x = (d + 23) / 2
        x = (d + 23) / 2
        if x.is_integer():  # Check if x is an integer
            valid_x_values.append(int(x))
    
    # Calculate the sum of all valid integer x values
    result = sum(valid_x_values)
    
    return result

# Call the solve function and print the result
