import math
from sympy import factorint

def simplify_sqrt_product(a, b):
    # Calculate the product of the square roots
    product = math.sqrt(a) * math.sqrt(b)
    
    # Simplify the product
    simplified = math.sqrt(a * b)
    
    # Factor the product to find a and b
    factors = factorint(a * b)
    
    # Calculate a and b
    a_result = 1
    b_result = 1
    
    for prime, exponent in factors.items():
        # If exponent is even, it contributes to a
        if exponent % 2 == 0:
            a_result *= prime ** (exponent // 2)
        else:
            a_result *= prime ** (exponent // 2)
            b_result *= prime
    
    return a_result, b_result

def solve():
    a, b = 56, 126
    a_result, b_result = simplify_sqrt_product(a, b)
    
    # Calculate a + b
    result = a_result + b_result
    return result

# Output the result
print(solve())
```
