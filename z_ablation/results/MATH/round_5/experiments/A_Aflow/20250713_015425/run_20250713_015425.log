def solve():
    # Calculate n = 3^17 + 3^10
    n = 3**17 + 3**10
    
    # Check if 11 divides into n + 1
    if (n + 1) % 11 != 0:
        return None  # This should not happen according to the problem statement
    
    # Convert n to string to check the format ABCACCBAB
    n_str = str(n)
    
    # Check if the length of n_str is 9
    if len(n_str) != 9:
        return None  # This should not happen according to the problem statement
    
    # Extract digits A, B, C from the string
    A = int(n_str[0])
    B = int(n_str[1])
    C = int(n_str[2])
    
    # Check the conditions for A, B, C
    if (A % 2 == 1 and C % 2 == 1 and B % 3 != 0 and 
        A != B and A != C and B != C):
        # Calculate the result
        result = 100 * A + 10 * B + C
        return result
    
    return None  # If conditions are not met

# Call the solve function and print the result
result = solve()
print(result)
