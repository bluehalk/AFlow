    total_tests = num_tests + final_exam_weight
    
    # Target average score
    target_average = 90
    # Score on the final exam
    final_exam_score = 99
    
    # Calculate the total score needed to achieve the target average
    total_score_needed = target_average * total_tests
    
    # Calculate the total score from the first 6 tests
    total_score_from_tests = total_score_needed - final_exam_score
    
    # Calculate the average score on the first 6 tests
    average_score_per_test = total_score_from_tests / num_tests
    
    return average_score_per_test

