    power_of_3 = highest_power_of_p_in_factorial(n, 3)
    power_of_5 = highest_power_of_p_in_factorial(n, 5)

    # The largest n such that 15^n divides 942! is the minimum of the two powers
    result = min(power_of_3, power_of_5)
    
    return result

# Call the solve function and print the result
print(solve())
```
