import cmath
import math

def solve():
    # Define the complex numbers z and c
    z = complex(2 + math.sqrt(2), -(3 + 3 * math.sqrt(2)))
    c = complex(2, -3)
    
    # Calculate the angle of rotation
    angle = math.pi / 4  # 45 degrees in radians
    
    # Translate z to the origin by subtracting c
    z_translated = z - c
    
    # Rotate z_translated by angle
    z_rotated = z_translated * complex(math.cos(angle), math.sin(angle))
    
    # Translate back by adding c
    w = z_rotated + c
    
    return w

# Call the solve function and print the result
