2025-07-13 02:04:26 - INFO - ```python
import math

def f(x):
    return 12 * x + 7

def g(x):
    return 5 * x + 2

def h(x):
    return math.gcd(f(x), g(x))

def solve():
    possible_values = set()
    
    # We will check for positive integers x from 1 to a reasonable limit
    for x in range(1, 100):  # Checking up to 99
        possible_values.add(h(x))
    
    # Return the sum of all unique values of h(x)
    return sum(possible_values)

# Call the solve function and print the result
result = solve()
print(result)
```
