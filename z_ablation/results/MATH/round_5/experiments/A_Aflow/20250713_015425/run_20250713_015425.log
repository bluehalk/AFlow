\[Ax + By + Cz + D = 0,\]where $A,$ $B,$ $C,$ $D$ are integers such that $A > 0$ and $\gcd(|A|,|B|,|C|,|D|) = 1.$

2025-07-13 01:58:31 - INFO - ```python
import numpy as np
from sympy import gcd

def solve():
    # Coefficients of the first plane 3x - 6y + 2z + 5 = 0
    A1, B1, C1, D1 = 3, -6, 2, 5
    
    # Coefficients of the second plane 4x - 12y + 3z - 3 = 0
    A2, B2, C2, D2 = 4, -12, 3, -3
    
    # Point that lies on the bisecting plane
    point = np.array([-5, -1, -5])
    
    # Normal vectors of the planes
    n1 = np.array([A1, B1, C1])
    n2 = np.array([A2, B2, C2])
    
    # Calculate the angle bisector normal vector
    n_bisector = n1 / np.linalg.norm(n1) + n2 / np.linalg.norm(n2)
    
    # Coefficients of the bisector plane
    A_bisector, B_bisector, C_bisector = n_bisector
    
    # Using the point-normal form of the plane equation: A(x - x0) + B(y - y0) + C(z - z0) = 0
    # We can rearrange it to the form Ax + By + Cz + D = 0
    D_bisector = -(A_bisector * point[0] + B_bisector * point[1] + C_bisector * point[2])
    
    # Convert to integers
    A_bisector, B_bisector, C_bisector, D_bisector = map(int, [A_bisector, B_bisector, C_bisector, D_bisector])
    
    # Ensure A > 0 and gcd(|A|, |B|, |C|, |D|) = 1
    if A_bisector < 0:
        A_bisector, B_bisector, C_bisector, D_bisector = -A_bisector, -B_bisector, -C_bisector, -D_bisector
    
    common_gcd = gcd(abs(A_bisector), abs(B_bisector), abs(C_bisector), abs(D_bisector))
    
    A_bisector //= common_gcd
    B_bisector //= common_gcd
    C_bisector //= common_gcd
    D_bisector //= common_gcd
    
    # Format the result
    result = f"{A_bisector}x + {B_bisector}y + {C_bisector}z + {D_bisector} = 0"
    
    return result

# Call the solve function and print the result
print(solve())
```
