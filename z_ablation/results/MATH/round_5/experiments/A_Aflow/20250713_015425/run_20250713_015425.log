import math

def solve():
    # Given equation: sin(x) + cos(x) = 1/5
    # We can square both sides to find a relationship between sin(x) and cos(x)
    
    # Let s = sin(x) and c = cos(x)
    # Then s + c = 1/5
    # Squaring both sides gives us: (s + c)^2 = (1/5)^2
    # This expands to: s^2 + 2sc + c^2 = 1/25
    # We know that s^2 + c^2 = 1 (Pythagorean identity)
    
    # Therefore, we can substitute: 1 + 2sc = 1/25
    # Rearranging gives us: 2sc = 1/25 - 1
    # 2sc = -24/25
    # sc = -12/25
    
    # Now we have two equations:
    # 1. s + c = 1/5
    # 2. sc = -12/25
    
    # We can treat s and c as the roots of the quadratic equation:
    # t^2 - (s+c)t + sc = 0
    # t^2 - (1/5)t - 12/25 = 0
    
    a = 1
    b = -1/5
    c = -12/25
    
    # Using the quadratic formula: t = [-b ± sqrt(b^2 - 4ac)] / 2a
    discriminant = b**2 - 4*a*c
    root1 = (-b + math.sqrt(discriminant)) / (2*a)
    root2 = (-b - math.sqrt(discriminant)) / (2*a)
    
    # The roots are the values of sin(x) and cos(x)
    # We need to find tan(x) = sin(x) / cos(x)
    
    # We can use the roots to find tan(x)
    sin_x = root1
    cos_x = (1/5) - sin_x  # since sin(x) + cos(x) = 1/5
    
    # Calculate tan(x)
    tan_x = sin_x / cos_x
    
    return tan_x

# Call the solve function and print the result
