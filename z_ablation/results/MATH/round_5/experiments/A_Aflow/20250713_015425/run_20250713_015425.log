def solve():
    from itertools import combinations_with_replacement

    # Number of oranges
    oranges = 4
    # Maximum number of groups
    max_groups = 3

    # To store the number of ways to divide the oranges
    ways = 0

    # Iterate over the number of groups from 1 to max_groups
