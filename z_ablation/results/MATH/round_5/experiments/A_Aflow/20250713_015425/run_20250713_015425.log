    width = 2 * k  # AB = 2k
    height = 2     # AD = 2 (fixed height)

    # Area of the rectangle ABCD
    area_rectangle = width * height

    # The center O of the rectangle
    O = (0, 0)

    # Vertices of the rectangle
    A = (-k, 1)
    B = (k, 1)
    C = (k, -1)
    D = (-k, -1)

    # Distance from O to each vertex
    distance_O_A = sp.sqrt((O[0] - A[0])**2 + (O[1] - A[1])**2)
    distance_O_B = sp.sqrt((O[0] - B[0])**2 + (O[1] - B[1])**2)
    distance_O_C = sp.sqrt((O[0] - C[0])**2 + (O[1] - C[1])**2)
    distance_O_D = sp.sqrt((O[0] - D[0])**2 + (O[1] - D[1])**2)

    # The distance from O to any vertex is the same due to symmetry
    distance_O_vertex = distance_O_A

    # The region where points are closer to O than to any vertex
    # This region is defined by the lines that are the perpendicular bisectors
    # of the segments connecting O to each vertex.

    # The equations of the lines (perpendicular bisectors) can be derived
    # and will form a smaller rectangle inside ABCD.

    # The vertices of the inner rectangle can be calculated
    inner_width = distance_O_vertex / sp.sqrt(2)
    inner_height = distance_O_vertex / sp.sqrt(2)

    # Area of the inner rectangle
    area_inner_rectangle = inner_width * inner_height

    # Probability that a point is closer to O than to any vertex
    probability = area_inner_rectangle / area_rectangle

    # Simplifying the probability expression
    probability_simplified = sp.simplify(probability)

    return probability_simplified

# Call the solve function and print the result
result = solve()
print(result)
