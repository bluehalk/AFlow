import random

def segments_intersect(A, B, C, D):
    # Check if segments AB and CD intersect
    return (A < C < B) != (A < D < B)

def estimate_probability(num_trials=100000):
    count_intersections = 0
    
    for _ in range(num_trials):
        # Randomly choose four points on the circle
        points = sorted([random.uniform(0, 1) for _ in range(4)])
        A, B, C, D = points
        
        # Check if segments AB and CD intersect
        if segments_intersect(A, B, C, D):
            count_intersections += 1
            
    # Calculate the probability
    probability = count_intersections / num_trials
    return probability

def solve():
    # Estimate the probability of intersection
    probability = estimate_probability()
    return probability

# Call the solve function and print the result
result = solve()
print(f"The estimated probability that segments AB and CD intersect is: {result:.4f}")
```
