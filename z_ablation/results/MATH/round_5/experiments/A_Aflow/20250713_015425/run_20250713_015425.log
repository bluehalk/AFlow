def solve():
    # Given congruence: 14u ≡ 46 (mod 100)
    a = 14
    b = 46
    m = 100

    # We need to solve the equation 14u - 46 = 100k for integers u and k
    # Rearranging gives us: 14u = 46 + 100k
    # This can be rewritten as: 14u - 100k = 46

    # We will use the Extended Euclidean Algorithm to find solutions
    def extended_gcd(a, b):
        if b == 0:
            return a, 1, 0
        gcd, x1, y1 = extended_gcd(b, a % b)
        x = y1
        y = x1 - (a // b) * y1
        return gcd, x, y

    # Calculate gcd and coefficients
    gcd, x0, y0 = extended_gcd(a, m)

    # Check if there is a solution
    if b % gcd != 0:
        return None  # No solution exists

    # Scale the solution
    x0 *= b // gcd
    m //= gcd
    a //= gcd
    b //= gcd

    # Now x0 is a particular solution to a * u ≡ b (mod m)
    # General solution is u = x0 + k * (m / gcd)
    # We need to find the two smallest positive solutions

    # Normalize x0 to be positive
    x0 = (x0 % m + m) % m

    # Find the two smallest positive solutions
    solutions = []
    for k in range(2):
        solution = x0 + k * (m // gcd)
        if solution > 0:
            solutions.append(solution)

    # Calculate the average of the two smallest positive solutions
    average = sum(solutions) / len(solutions)
    
    return average

# Call the solve function and print the result
result = solve()
print(result)
```
