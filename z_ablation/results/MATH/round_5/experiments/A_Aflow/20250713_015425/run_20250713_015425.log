2025-07-13 01:57:16 - INFO - ```python
from math import comb

def solve():
    # Total outcomes for each spin
    total_outcomes = 2 * 4  # 2 body parts (arm, leg) and 4 colors
    
    # Probability of moving to a red spot
    p_red = 1 / 4  # 1 out of 4 colors is red
    p_not_red = 3 / 4  # 3 out of 4 colors are not red
    
    # Probability of moving an arm
    p_arm = 1 / 2  # 1 out of 2 body parts is an arm
    p_leg = 1 / 2  # 1 out of 2 body parts is a leg
    
    # We need exactly 2 moves to a red spot and 3 arms
    n = 4  # total spins
    k_red = 2  # exactly 2 red moves
    k_arm = 3  # exactly 3 arm moves
    
    # Calculate the probability of exactly 2 red moves
    prob_red_moves = comb(n, k_red) * (p_red ** k_red) * (p_not_red ** (n - k_red))
    
    # Calculate the probability of exactly 3 arm moves
    prob_arm_moves = comb(n, k_arm) * (p_arm ** k_arm) * (p_leg ** (n - k_arm))
    
    # Since the events are independent, multiply the probabilities
    final_probability = prob_red_moves * prob_arm_moves
    
    return final_probability

# Call the solve function and print the result
result = solve()
print(result)
```
