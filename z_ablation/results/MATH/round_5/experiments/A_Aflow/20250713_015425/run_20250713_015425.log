def solve():
    # Given values for the prime factorization of a
    exponent_2 = 306
    exponent_3 = 340
    
    # To find the largest n such that a is a perfect nth power,
    # we need to find the greatest common divisor (GCD) of the exponents.
    from math import gcd
    from functools import reduce
    
    # Calculate the GCD of the exponents
    largest_n = reduce(gcd, [exponent_2, exponent_3])
    
    return largest_n

# Call the solve function and print the result
result = solve()
print(result)
```
