2025-07-13 02:02:49 - INFO - ```python
def solve():
    # Total number of coin flips
    flips = 6
    
    # Possible outcomes: heads (H) means counterclockwise, tails (T) means clockwise
    # Each flip can be represented as +1 (H) or -1 (T)
    
    # The man starts at vertex 0
    # We need to find the number of ways to end up at vertex 0 after 6 flips
    
    # The position after n flips can be represented as:
    # position = (number of heads - number of tails) % 6
    # where number of heads + number of tails = flips
    
    # Let h be the number of heads and t be the number of tails
    # h + t = flips
    # t = flips - h
    # position = (h - (flips - h)) % 6
    # position = (2h - flips) % 6
    
    # We need to find the number of heads (h) such that:
    # (2h - flips) % 6 == 0
    # This simplifies to:
    # 2h - flips = 6k for some integer k
    # 2h = flips + 6k
    # h = (flips + 6k) / 2
    
    # h must be a non-negative integer and also must be <= flips
    # Therefore, we can iterate over possible values of k to find valid h
    
    valid_count = 0
    
    for k in range(-3, 4):  # k can range from -3 to 3 to cover all possible h values
        h = (flips + 6 * k) / 2
        if h.is_integer() and 0 <= h <= flips:
            valid_count += 1
    
    # Total possible outcomes of 6 flips
    total_outcomes = 2 ** flips
    
    # Probability that the man is back at the starting vertex
    probability = valid_count / total_outcomes
    
    return probability

# Call the solve function and print the result
result = solve()
print(result)
```
