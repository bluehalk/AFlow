def solve():
    from itertools import permutations

    # The sum of the four two-digit numbers
    target_sum = 221
    # Digits to consider (1 through 9)
    digits = '123456789'
    
    # Generate all permutations of 8 digits taken 4 at a time
    for perm in permutations(digits, 8):
        # Create four two-digit numbers from the permutation
        num1 = int(perm[0] + perm[1])
        num2 = int(perm[2] + perm[3])
        num3 = int(perm[4] + perm[5])
        num4 = int(perm[6] + perm[7])
        
        # Check if the sum of the numbers equals the target sum
        if num1 + num2 + num3 + num4 == target_sum:
            # Find the digits used
            used_digits = set(perm)
            # Find the missing digit
            missing_digit = set(digits) - used_digits
            return missing_digit.pop()  # Return the missing digit

# Call the solve function and print the result
result = solve()
print(result)
```
