def solve():
    # Number of rows of pegs
    n = 8
    
    # The total number of slots at the bottom
    total_slots = n + 1
    
    # The middle slot index
    middle_slot_index = n // 2
    
    # Using dynamic programming to calculate the probability of landing in each slot
    # dp[i][j] will represent the number of ways to reach slot j after i rows
    dp = [[0] * total_slots for _ in range(n + 1)]
    
    # The ball starts at the top middle position
    dp[0][0] = 1  # Starting at the top
    
    # Fill the dp table
    for i in range(1, n + 1):
        for j in range(total_slots):
            if j > 0:
                dp[i][j] += dp[i - 1][j - 1]  # Coming from the left peg
            if j < total_slots - 1:
                dp[i][j] += dp[i - 1][j + 1]  # Coming from the right peg
    
    # The total number of ways to reach the bottom
    total_ways = 2 ** n
    
    # The number of ways to reach the middle slot
    ways_to_middle_slot = dp[n][middle_slot_index]
    
    # Calculate the probability of landing in the middle slot
    probability = ways_to_middle_slot / total_ways
    
    return probability

# Call the solve function and print the result
result = solve()
print(result)
```
