def solve():
    # Probability of winning in a single turn
    # Winning conditions: die shows 1 or 6 (2 outcomes) and coin shows heads (1 outcome)
    die_winning_outcomes = 2  # (1, 6)
    total_die_outcomes = 6    # (1, 2, 3, 4, 5, 6)
    coin_winning_outcomes = 1  # (heads)
    total_coin_outcomes = 2    # (heads, tails)

    # Probability of winning in one turn
    p_win = Fraction(die_winning_outcomes, total_die_outcomes) * Fraction(coin_winning_outcomes, total_coin_outcomes)
    
    # Probability of losing in one turn
    p_lose = 1 - p_win
    
    # Probability of winning before the fourth turn
    # This can be calculated as 1 - (probability of losing all three turns)
    p_lose_all_three_turns = p_lose ** 3
    p_win_before_fourth_turn = 1 - p_lose_all_three_turns
    
    return p_win_before_fourth_turn

# Output the result
result = solve()
print(result)
