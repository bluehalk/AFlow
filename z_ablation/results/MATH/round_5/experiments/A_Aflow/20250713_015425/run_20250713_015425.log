    # Rearranging the equation gives us:
    # 4c^3 - 3c - 1/2 = 0
    # To eliminate the fraction, we multiply the entire equation by 2:
    # 8c^3 - 6c - 1 = 0
    
    # Define the polynomial
    polynomial = 8 * x**3 - 6 * x - 1
    
    # Get the coefficients
    coefficients = polynomial.as_coefficients_dict()
    
    # Extract coefficients in order
    a = coefficients[x**3] if x**3 in coefficients else 0
    b = coefficients[x**2] if x**2 in coefficients else 0
    c = coefficients[x] if x in coefficients else 0
    d = coefficients[1] if 1 in coefficients else 0
    
    # Coefficients should be integers
    coeffs = [a, b, c, d]
    
    # Ensure coefficients have no common factor other than 1
    gcd = sp.gcd(*coeffs)
    if gcd != 1:
        coeffs = [coeff // gcd for coeff in coeffs]
    
