def sum_of_odd_divisors(n):
    # Function to calculate the sum of odd divisors of a given number n
    total_sum = 0
    # Iterate through all possible divisors
    for i in range(1, n + 1, 2):  # Only check odd numbers
        if n % i == 0:  # Check if i is a divisor of n
            total_sum += i  # Add the odd divisor to the total sum
    return total_sum

def solve():
    n = 6300  # The number for which we want to find the sum of odd divisors
    result = sum_of_odd_divisors(n)  # Calculate the sum of odd divisors
    return result

# Call the solve function and print the result
if __name__ == "__main__":
    print(solve())
