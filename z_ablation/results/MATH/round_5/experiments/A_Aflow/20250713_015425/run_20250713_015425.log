2025-07-13 01:58:26 - INFO - ```python
import numpy as np

def solve():
    # Define points A, B, and C
    A = np.array([1, 8, 4])
    B = np.array([0, -1, 3])
    C = np.array([2, -3, -1])
    
    # Calculate the direction vector of the line BC
    BC = C - B
    
    # Calculate the vector from B to A
    BA = A - B
    
    # Project BA onto BC to find the foot of the perpendicular
    BC_norm = np.dot(BC, BC)
    if BC_norm == 0:
        raise ValueError("Points B and C cannot be the same.")
    
    # Calculate the projection scalar
    projection_scalar = np.dot(BA, BC) / BC_norm
    
    # Calculate the foot of the perpendicular
    foot_of_perpendicular = B + projection_scalar * BC
    
    return tuple(foot_of_perpendicular)

# Call the solve function and print the result
result = solve()
print(result)
```
