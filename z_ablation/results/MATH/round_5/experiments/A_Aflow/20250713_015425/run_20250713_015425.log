    b = 2  # We will calculate for base 2 and then generalize
    
    # Convert the base-b numbers to decimal
    num1 = int('11011', b)  # 11011_b in decimal
    num2 = int('1001', b)   # 1001_b in decimal
    
    # Perform the calculation: (num1 * (b - 1)) + num2
    result_decimal = (num1 * (b - 1)) + num2
    
    # Convert the result back to base b
    result_base_b = ''
    while result_decimal > 0:
        result_base_b = str(result_decimal % b) + result_base_b
        result_decimal //= b
    
    return result_base_b

# Call the solve function and print the result
