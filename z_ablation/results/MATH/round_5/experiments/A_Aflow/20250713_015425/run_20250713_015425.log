    term2 = pow(4, 5, mod)   # 4^5 % 13
    term3 = pow(6, 7, mod)   # 6^7 % 13
    term4 = pow(8, 9, mod)   # 8^9 % 13
    
    # Combine the terms and take modulo 13
    result = (term1 * term2 % mod * term3 % mod * term4 % mod) % mod
    
    return result

