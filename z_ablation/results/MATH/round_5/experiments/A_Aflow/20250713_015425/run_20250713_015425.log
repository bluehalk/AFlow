    # AB = 2s * sqrt(2)
    
    # Setting this equal to the given length of AB
    # 2s * sqrt(2) = 2 * sqrt(5)
    # s * sqrt(2) = sqrt(5)
    # s = sqrt(5) / sqrt(2)
