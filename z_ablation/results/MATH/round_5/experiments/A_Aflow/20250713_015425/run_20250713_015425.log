def solve():
    # Dimensions of the page
    page_width = 10  # inches
    page_height = 12  # inches
    
    # Margins
    margin = 1.5  # inches
    
    # Calculate the area of the entire page
    total_area = page_width * page_height
    
    # Calculate the dimensions of the inner area (area without margins)
    inner_width = page_width - 2 * margin
    inner_height = page_height - 2 * margin
    
    # Calculate the area of the inner part of the page
    inner_area = inner_width * inner_height
    
    # Calculate the area taken up by the margins
    margins_area = total_area - inner_area
    
    # Calculate the fraction of the area taken up by the margins
    fraction_margins = margins_area / total_area
    
    # Convert to a common fraction
    from fractions import Fraction
    fraction_margins_common = Fraction(margins_area, total_area).limit_denominator()
    
    return fraction_margins_common

# Call the solve function and print the result
result = solve()
