    a = 8  # side opposite to vertex A
    b = 7  # side opposite to vertex B
    c = 5  # side opposite to vertex C

    # Calculate the area of triangle ABC using Heron's formula
    s = (a + b + c) / 2  # semi-perimeter
    area = math.sqrt(s * (s - a) * (s - b) * (s - c))

    # Calculate the circumradius R
