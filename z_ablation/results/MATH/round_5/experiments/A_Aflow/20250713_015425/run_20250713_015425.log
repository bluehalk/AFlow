2025-07-13 02:01:22 - INFO - ```python
import math

def solve():
    # Number of sides of the heptagon
    n = 7
    
    # Calculate the angle in radians for each vertex
    angle = 2 * math.pi / n
    
    # Coordinates of the vertices of the heptagon
    A = (math.cos(0 * angle), math.sin(0 * angle))
    B = (math.cos(1 * angle), math.sin(1 * angle))
    D = (math.cos(3 * angle), math.sin(3 * angle))
    G = (math.cos(6 * angle), math.sin(6 * angle))
    
    # Calculate the centroid M of triangle ABD
    M_x = (A[0] + B[0] + D[0]) / 3
    M_y = (A[1] + B[1] + D[1]) / 3
    M = (M_x, M_y)
    
    # Center O of the heptagon is at the origin (0, 0)
    O = (0, 0)
    
    # Calculate the vectors OM and OG
    OM = (M[0] - O[0], M[1] - O[1])
    OG = (G[0] - O[0], G[1] - O[1])
    
    # Calculate the dot product of OM and OG
    dot_product = OM[0] * OG[0] + OM[1] * OG[1]
    
    # Calculate the magnitudes of OM and OG
    magnitude_OM = math.sqrt(OM[0]**2 + OM[1]**2)
    magnitude_OG = math.sqrt(OG[0]**2 + OG[1]**2)
    
    # Calculate cos(angle GOM)
    cos_angle_GOM = dot_product / (magnitude_OM * magnitude_OG)
    
    # Calculate cos^2(angle GOM)
    cos_squared_angle_GOM = cos_angle_GOM ** 2
    
    return cos_squared_angle_GOM

# Call the solve function and print the result
result = solve()
print(result)
```
