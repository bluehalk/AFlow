     \[
     \text{midpoint}_{BC} = \left(\frac{B_x + C_x}{2}, \frac{B_y + C_y}{2}\right) = \left(\frac{8 + 8}{2}, \frac{0 + 9}{2}\right) = (8, 4.5)
     \]
