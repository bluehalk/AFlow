    # Check if hypotenuse_c is an integer
    if hypotenuse_c.is_integer():
        hypotenuse_c = int(hypotenuse_c)
        perimeter = leg_a + leg_b + hypotenuse_c
        return f"\\boxed{{{perimeter}}}"
    
    # Case 2: leg_b = leg_a - 1
    leg_b = leg_a - 1
    hypotenuse_c = (leg_a**2 + leg_b**2)**0.5  # Pythagorean theorem
    
    # Check if hypotenuse_c is an integer
    if hypotenuse_c.is_integer():
        hypotenuse_c = int(hypotenuse_c)
