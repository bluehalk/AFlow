    # Calculate commissions
    commission_on_original = original_price * commission_rate
    commission_on_discounted = discounted_price * commission_rate

    # Calculate the difference in commissions in cents
    difference_in_commission = (commission_on_original - commission_on_discounted) * 100  # Convert to cents

