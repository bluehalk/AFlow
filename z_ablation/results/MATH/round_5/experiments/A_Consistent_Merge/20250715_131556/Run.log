    if final_result_decimal == 0:
        result_base_b = "0"
    else:
        while final_result_decimal > 0:
            result_base_b = str(final_result_decimal % b) + result_base_b
            final_result_decimal //= b
    
    # Return the final result in LaTeX format
    return f"\\boxed{{{result_base_b}}}"

# Example usage
# The function can be called with any base b
