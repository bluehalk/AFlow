def solve():
    # The prefix of the phone number
    prefix = 336
    
    # Initialize a counter for valid phone numbers
    count = 0
    
    # Iterate through all possible combinations of the last four digits (0000 to 9999)
    for last_four in range(10000):
        # Extract the individual digits of the last four digits
        d1 = last_four // 1000          # Thousands place
        d2 = (last_four // 100) % 10     # Hundreds place
        d3 = (last_four // 10) % 10      # Tens place
        d4 = last_four % 10               # Units place
        
        # Calculate the product of the last four digits
        product = d1 * d2 * d3 * d4
        
        # Check if the product equals the prefix
        if product == prefix:
            count += 1
    
    # Return the count of valid phone numbers in LaTeX format
    return f"\\boxed{{{count}}}"

