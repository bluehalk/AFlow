    # Convert 1001_b to decimal
    num2 = (1 * b**3) + (0 * b**2) + (0 * b**1) + (1 * b**0)  # 1001_b
    
    # Add the two results
    final_result_decimal = result_after_multiplication + num2
    
    # Convert the final result back to base b
