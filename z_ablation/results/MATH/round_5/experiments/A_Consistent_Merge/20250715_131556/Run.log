def solve():
    # A natural number has exactly three distinct positive integer divisors
    # if and only if it is the square of a prime number.
    
    # We will find all prime numbers less than sqrt(1000)
    import math
    
    limit = int(math.sqrt(1000))  # We need primes less than sqrt(1000)
    
    # Sieve of Eratosthenes to find all primes up to 'limit'
    is_prime = [True] * (limit + 1)
    is_prime[0] = is_prime[1] = False  # 0 and 1 are not prime numbers
    
    for start in range(2, int(math.sqrt(limit)) + 1):
        if is_prime[start]:
            for multiple in range(start*start, limit + 1, start):
                is_prime[multiple] = False
    
    # Collecting all prime numbers
    primes = [num for num, prime in enumerate(is_prime) if prime]
    
    # Now we will count the squares of these primes that are less than 1000
    count = 0
    for prime in primes:
        if prime * prime < 1000:
            count += 1
    
    # The result is the count of such numbers
    return f"\\boxed{{{count}}}"

# Call the solve function to get the result
result = solve()
print(result)
</python_code>

