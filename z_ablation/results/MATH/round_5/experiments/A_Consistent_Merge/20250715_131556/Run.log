    # Each hour represents 30 degrees (360 degrees / 12 hours)
    # Each minute, the hour hand moves 0.5 degrees (30 degrees / 60 minutes)
    hour_angle = (hour % 12) * 30 + (minute / 60) * 30
    
    # Calculate the position of the minute hand
    # Each minute represents 6 degrees (360 degrees / 60 minutes)
    minute_angle = minute * 6
    
    # Calculate the difference between the two angles
    angle_difference = abs(hour_angle - minute_angle)
    
    # The smaller angle is the minimum of the angle difference and 360 - angle difference
    smaller_angle = min(angle_difference, 360 - angle_difference)
    
