    # Radius is given as x + 6
    # Diameter is given as 3x + 5
    
    # Setting up the equation based on the relationship between diameter and radius
    # diameter = 2 * radius
    # Therefore, we can set up the equation:
    # 3x + 5 = 2 * (x + 6)
    
    # Expanding the right side
    # 3x + 5 = 2x + 12
    
    # Rearranging the equation to solve for x
    # 3x - 2x = 12 - 5
    # x = 7
    
    # Now substituting x back into the radius
    x = 7
    radius_value = x + 6  # radius = 7 + 6 = 13
    
    # Circumference of the circle is given by the formula C = 2 * π * r
    circumference_in_terms_of_pi = 2 * radius_value  # This gives us 26
    
    # Formatting the answer in LaTeX notation
    return f"\\boxed{{{circumference_in_terms_of_pi}π}}"

# Call the solve function to get the result
