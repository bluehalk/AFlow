def solve():
    # We need to find primes p for which the congruence 8x ≡ 1 (mod p) has no solutions.
    # This congruence has no solutions if and only if 8 is not coprime to p.
    # This means that p must divide 8.
    
    # The prime factorization of 8 is 2^3, so the only prime that divides 8 is 2.
    # Therefore, the only prime p for which the congruence has no solutions is p = 2.
    
    # We need to find the sum of all such primes.
    primes_with_no_solution = [2]
