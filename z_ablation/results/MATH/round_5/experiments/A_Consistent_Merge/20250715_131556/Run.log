\[
\tan(\theta) = \frac{\sin(\theta)}{\cos(\theta)} = \frac{\frac{1}{\sqrt{3}}}{\sqrt{1 - \frac{1}{3}}} = \frac{\frac{1}{\sqrt{3}}}{\sqrt{\frac{2}{3}}} = \frac{1}{\sqrt{2}}.
