def solve():
    # We have 4 distinguishable balls and 3 indistinguishable boxes.
    # We can use the "stars and bars" theorem to find the number of ways to distribute the balls.
    
    from math import factorial
    
    # The number of ways to distribute n distinguishable objects into k indistinguishable boxes
    # can be calculated using the formula: 
    # P(n, k) = (n + k - 1)! / (k - 1)! * n!
    
    n = 4  # number of distinguishable balls
    k = 3  # number of indistinguishable boxes
    
    # We need to find the number of partitions of n into at most k parts
    # This can be calculated using the formula for the number of partitions
    # of n into at most k parts, which is equivalent to the number of ways
    # to distribute n indistinguishable objects into k distinguishable boxes.
    
    # We will use a dynamic programming approach to count the partitions.
    
    # Create a table to store the number of ways to partition
    # i balls into j boxes
    dp = [[0] * (k + 1) for _ in range(n + 1)]
    
    # There is one way to put 0 balls into any number of boxes
    for j in range(k + 1):
        dp[0][j] = 1
    
    # Fill the table
    for i in range(1, n + 1):
        for j in range(1, k + 1):
            dp[i][j] = dp[i][j - 1]  # ways without using the j-th box
            if i >= j:
                dp[i][j] += dp[i - j][j]  # ways using the j-th box
    
    # The answer is the number of ways to partition n balls into k boxes
    result = dp[n][k]
    
    # Return the result in LaTeX format
    return f"\\boxed{{{result}}}"

# Call the solve function to get the result
print(solve())
