    losses_to_wins_ratio = (3, 2)  # 3 losses for every 2 wins
    
    # Let the number of wins be 2x and losses be 3x for some integer x
    x = 1  # We can assume x = 1 for simplicity
    wins = losses_to_wins_ratio[1] * x  # 2 wins
    losses = losses_to_wins_ratio[0] * x  # 3 losses
    
    # If the team had won twice as many games
    new_wins = 2 * wins  # New wins would be 2 * 2 = 4
    new_losses = losses  # Losses remain the same
    
    # Calculate the new ratio of losses to wins
    new_ratio = new_losses / new_wins  # Ratio of losses to wins
    
    # Return the result in LaTeX format
    return f"\\boxed{{\\frac{{{new_losses}}}{{{new_wins}}}}}"

