    def prime_factors(n):
        factors = {}
        d = 2
        while d * d <= n:
            while (n % d) == 0:
                if d in factors:
                    factors[d] += 1
                else:
                    factors[d] = 1
                n //= d
            d += 1
        if n > 1:
            factors[n] = 1
        return factors
    
    numbers = list(range(1, 17))
    parity_groups = defaultdict(list)
    
    for num in numbers:
        factors = prime_factors(num)
        parity = tuple((p, exp % 2) for p, exp in factors.items())
        parity_groups[parity].append(num)
    
    return len(parity_groups)

# Call the function to get the number of unique parity groups
max_slips = unique_parity_groups()
print(f"Maximum slips without a perfect square product: {max_slips}")
