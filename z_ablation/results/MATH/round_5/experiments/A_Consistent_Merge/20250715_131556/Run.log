    # Function to calculate the number of trailing zeros in n!
    def count_trailing_zeros(n):
        count = 0
        # Count factors of 5 in n!
        while n >= 5:
            n //= 5
            count += n
        return count

    # Given value for the problem
    n = 42
    # Calculate the number of trailing zeros in 42!
