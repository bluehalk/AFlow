    numerator = 1/30  # 0.0(3) is 1/30
    denominator = 1/33  # 0.(03) is 1/33
    
    # Perform the division
    result = numerator / denominator
    
    # Convert the result to a mixed number
    whole_number = int(result)  # Get the whole number part
    fractional_part = result - whole_number  # Get the fractional part
    
