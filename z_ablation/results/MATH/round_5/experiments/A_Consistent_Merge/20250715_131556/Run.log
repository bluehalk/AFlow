def solve():
    # Define the blinking intervals for each light in seconds
    red_blink = 2
    yellow_blink = 3
    blue_blink = 5
    
    # Calculate the least common multiple (LCM) of the blinking intervals
    import math
    lcm_red_yellow = (red_blink * yellow_blink) // math.gcd(red_blink, yellow_blink)
    lcm_all = (lcm_red_yellow * blue_blink) // math.gcd(lcm_red_yellow, blue_blink)
    
    # The total duration of the dance in seconds
    dance_duration = 7 * 60  # 7 minutes
    
    # Count how many times all lights blink together
    # They blink together at time 0 and every lcm_all seconds thereafter
    count = dance_duration // lcm_all + 1  # +1 to include the start time
    
    # Return the result in LaTeX format
    return f"\\boxed{{{count}}}"

# Call the solve function to get the result
