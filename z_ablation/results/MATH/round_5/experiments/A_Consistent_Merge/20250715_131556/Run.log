    # Since 0 < x < pi, we need to find the positive solution for tan(x)
    # tan(x) = 2t / (1 - t^2) for t = tan(x/2)
    # We will use the positive root
    t = t1 if t1 > 0 else t2

    tan_x = 2 * t / (1 - t**2)

    return f"\\boxed{{{tan_x}}}"

result = solve()
print(result)
