def solve():
    # Camera A starts at 6 AM and takes a picture every 11 minutes
    # Camera B starts at 7 AM and takes a picture every 7 minutes
    
    # Convert times to minutes from midnight
    start_A = 6 * 60  # 6 AM in minutes
    start_B = 7 * 60  # 7 AM in minutes
    
    # Time intervals
    interval_A = 11  # minutes
    interval_B = 7   # minutes
    
    # Calculate the times when both cameras take pictures
    times_A = [start_A + i * interval_A for i in range(0, (12 * 60 - start_A) // interval_A + 1)]
    times_B = [start_B + i * interval_B for i in range(0, (12 * 60 - start_B) // interval_B + 1)]
    
    # Find common times
    common_times = set(times_A) & set(times_B)
    
    # The last common time before noon
    last_common_time = max(common_times)
    
    # Calculate minutes before noon
    noon_time = 12 * 60  # noon in minutes
    minutes_before_noon = noon_time - last_common_time
    
    # Return the result in LaTeX format
    return f"\\boxed{{{minutes_before_noon}}}"

# Call the solve function to get the result
