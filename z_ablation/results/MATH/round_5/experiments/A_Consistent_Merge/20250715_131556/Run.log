def solve():
    # The set of numbers to choose from
    numbers = {1, 2, 3, 4, 5}
    
    # Count of even and odd numbers in the set
    even_count = len([x for x in numbers if x % 2 == 0])  # 2, 4
    odd_count = len([x for x in numbers if x % 2 != 0])   # 1, 3, 5
    
