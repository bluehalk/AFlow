import numpy as np

def solve():
    # Define the range of theta from 0 to 24 degrees
    theta_values = np.linspace(0, 24, 1000)  # 1000 points for better resolution
    results = []

    for theta in theta_values:
        # Convert theta to radians for the sine and cosine functions
        theta_rad = np.radians(theta)
        
        # Calculate the left-hand side of the equation
        left_side = 2 * np.sin(theta_rad) * sum(np.sin(2 * k * theta_rad) for k in range(1, 8))
        
        # Calculate the right-hand side of the equation
        right_side = np.cos(theta_rad) - 0.5
        
        # Check if the left side is approximately equal to the right side
        if np.isclose(left_side, right_side, atol=1e-5):
            results.append(theta)
    
    # Format the results in LaTeX boxed notation
    formatted_results = ', '.join(f'{theta:.2f}' for theta in results)
    return f'\\boxed{{{formatted_results}}}'

# Call the solve function to get the result
