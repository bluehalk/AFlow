def solve():
    import math

    # Given that a, b, c are unit vectors
    # a is orthogonal to both b and c
    # The angle between b and c is 60 degrees

    # The magnitude of the cross product |b x c| is given by:
    # |b x c| = |b| * |c| * sin(theta)
    # Since b and c are unit vectors, |b| = |c| = 1
    # The angle theta = 60 degrees, so sin(60 degrees) = sqrt(3)/2

    angle_b_c = math.radians(60)  # Convert degrees to radians
    sin_theta = math.sin(angle_b_c)  # sin(60 degrees)

    # Calculate the magnitude of the cross product
    magnitude_cross_product = 1 * 1 * sin_theta  # |b| * |c| * sin(theta)
    
    # Since a is orthogonal to both b and c, |a . (b x c)| = |a| * |b x c|
    # |a| = 1 (since a is a unit vector)
    result = magnitude_cross_product  # |a . (b x c)| = |b x c|

    # Return the result in LaTeX format
    return f"\\boxed{{{result}}}"

# Call the solve function to get the result
print(solve())
