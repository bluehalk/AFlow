def solve():
    from math import comb

    # Total number of students
    total_students = 30

    # Number of girls and boys
    total_girls = 15
    total_boys = 15

    # Freshmen girls and boys
    freshmen_girls = 12
    freshmen_boys = 11

    # Non-freshmen girls and boys
    non_freshmen_girls = total_girls - freshmen_girls  # 3
    non_freshmen_boys = total_boys - freshmen_boys      # 4

    # We want to select 2 freshmen girls and 3 freshmen boys
    desired_freshmen_girls = 2
    desired_freshmen_boys = 3

    # Total ways to choose 5 students from 30
    total_ways = comb(total_students, 5)

    # Ways to choose 2 freshmen girls from 12
    ways_to_choose_girls = comb(freshmen_girls, desired_freshmen_girls)

    # Ways to choose 3 freshmen boys from 11
    ways_to_choose_boys = comb(freshmen_boys, desired_freshmen_boys)

    # Total ways to choose the desired group
    desired_ways = ways_to_choose_girls * ways_to_choose_boys

    # Probability calculation
    probability = desired_ways / total_ways

