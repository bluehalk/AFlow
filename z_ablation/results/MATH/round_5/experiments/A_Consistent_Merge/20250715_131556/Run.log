    def product_of_four_consecutive_integers(n):
        return n * (n + 1) * (n + 2) * (n + 3)

    # Generate the first few products of four consecutive integers
    products = [product_of_four_consecutive_integers(n) for n in range(1, 11)]

    # Function to calculate the GCD of a list of numbers
    def gcd(a, b):
