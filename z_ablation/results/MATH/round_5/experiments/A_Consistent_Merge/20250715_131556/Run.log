def solve():
    # Number of players in the soccer team
    num_players = 11
    
    # Each player passes the ball to each of the other players exactly 3 times
    passes_per_player = 3
    
    # Each player passes to (num_players - 1) other players
    total_passes = num_players * (num_players - 1) * passes_per_player
    
    # Return the result formatted in LaTeX notation
    return f"\\boxed{{{total_passes}}}"

# Call the solve function to get the result
