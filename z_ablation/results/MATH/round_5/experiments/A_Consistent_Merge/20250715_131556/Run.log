def is_terminating_decimal(k):
    """Check if the fraction 1/k is a terminating decimal."""
    while k % 2 == 0:
        k //= 2
    while k % 5 == 0:
        k //= 5
    return k == 1

def count_terminating_decimals(n):
    """Count how many unit fractions 1/k are terminating decimals for k in range 1 to n."""
    count = 0
    for k in range(1, n + 1):
        if is_terminating_decimal(k):
            count += 1
    return count

def solve():
    """Find the smallest positive integer n such that exactly half of the unit fractions 1/k are terminating decimals."""
    n = 1
    while True:
        terminating_count = count_terminating_decimals(n)
        if terminating_count == n / 2:
            return f"\\boxed{{{n}}}"
        n += 1

# Execute the solve function to get the result
