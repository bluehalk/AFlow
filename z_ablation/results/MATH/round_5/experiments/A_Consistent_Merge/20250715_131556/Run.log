def solve():
    # Total number of questions
    total_questions = 10
    
    # Total ways to answer the test (2 options: True or False)
    total_ways = 2 ** total_questions
    
    # Calculate the number of ways to answer with at least 3 False answers
    # We will use the complement principle: total ways - ways with less than 3 False answers
    
    # Ways with 0 False answers (all True)
    ways_0_false = 1  # Only one way: TTTTTTTTTT
    
    # Ways with 1 False answer
    ways_1_false = total_questions  # Choose 1 out of 10 to be False
    
    # Ways with 2 False answers
    ways_2_false = (total_questions * (total_questions - 1)) // 2  # Choose 2 out of 10
    
    # Total ways with less than 3 False answers
    ways_less_than_3_false = ways_0_false + ways_1_false + ways_2_false
    
    # Total ways with at least 3 False answers
    ways_at_least_3_false = total_ways - ways_less_than_3_false
    
    # Return the result in LaTeX format
    return f"\\boxed{{{ways_at_least_3_false}}}"

# Call the solve function to get the result
result = solve()
print(result)
