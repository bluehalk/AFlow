    prob_A_exactly_2 = (prob_A_selected ** 2) * ((1 - prob_A_selected) ** 1) * Fraction(3, 1)
    
    # Probability that Team A is selected on all 3 days
    prob_A_all_3 = prob_A_selected ** 3

    # Total probability that Team A is selected at least 2 days
