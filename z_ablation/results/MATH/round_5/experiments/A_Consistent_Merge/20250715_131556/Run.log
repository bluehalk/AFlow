    # Half of the female adults have exactly one biological child
    mothers = female_adults / 2
    
    # Each mother has exactly one child
    children = mothers  # Total number of children is equal to the number of mothers
    
    # Total population of Mathopolis
    total_population = A + children
    
    # Calculate the percentage of children in the total population
    percent_children = (children / total_population) * 100
    
    # Return the result formatted in LaTeX notation
    return f"\\boxed{{{percent_children}}}"

# Call the solve function to get the result
