\[
\begin{pmatrix} 6 \\ 4 \end{pmatrix} = \frac{\begin{pmatrix} 0 \\ 13 \end{pmatrix} \cdot \begin{pmatrix} a_1 \\ a_2 \end{pmatrix}}{\begin{pmatrix} a_1 \\ a_2 \end{pmatrix} \cdot \begin{pmatrix} a_1 \\ a_2 \end{pmatrix}} \begin{pmatrix} a_1 \\ a_2 \end{pmatrix}
