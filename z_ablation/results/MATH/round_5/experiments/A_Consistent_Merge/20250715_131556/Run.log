    AB = 20  # length of segment AB in cm
    angle_A = 30  # angle A in degrees
    angle_C = 45  # angle C in degrees

    # Calculate angle B using the fact that the sum of angles in a triangle is 180 degrees
    angle_B = 180 - angle_A - angle_C  # angle B in degrees

    # Using the Law of Sines to find the length of BC
    # BC / sin(A) = AB / sin(B)
    # Therefore, BC = AB * (sin(A) / sin(B))
    
    # Calculate sine values
    sin_A = math.sin(math.radians(angle_A))  # sin(30 degrees)
    sin_B = math.sin(math.radians(angle_B))  # sin(105 degrees)

    # Using the Law of Sines
    BC = AB * (sin_A / sin_B)

    # Return the result in LaTeX format
    return f"\\boxed{{{BC:.2f}}}"

# Call the solve function to get the result
