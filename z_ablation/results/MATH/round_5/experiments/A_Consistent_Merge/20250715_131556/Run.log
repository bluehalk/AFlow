import math

def solve():
    # Number of sides in the heptagon
    n = 7
    angle = 2 * math.pi / n
    
    # Coordinates of vertices A, B, D, and G
    A = (1, 0)  # Vertex A at (1, 0)
    B = (math.cos(angle), math.sin(angle))  # Vertex B
    D = (math.cos(3 * angle), math.sin(3 * angle))  # Vertex D
    G = (math.cos(6 * angle), math.sin(6 * angle))  # Vertex G
    
    # Centroid M of triangle ABD
    M_x = (A[0] + B[0] + D[0]) / 3
    M_y = (A[1] + B[1] + D[1]) / 3
    M = (M_x, M_y)
    
    # Vector OG
    OG = G
    
    # Vector OM
    OM = M
    
    # Calculate the dot product of vectors OG and OM
    dot_product = OG[0] * OM[0] + OG[1] * OM[1]
    
    # Calculate the magnitudes of OG and OM
    magnitude_OG = math.sqrt(OG[0]**2 + OG[1]**2)
    magnitude_OM = math.sqrt(OM[0]**2 + OM[1]**2)
    
