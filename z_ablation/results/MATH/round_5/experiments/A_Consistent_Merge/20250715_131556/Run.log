def solve():
    # Initialize a counter for pages with digit sum equal to 4
    count = 0
    
    # Iterate through all page numbers from 1 to 1000
    for page in range(1, 1001):
        # Convert the page number to a string to iterate over digits
        digit_sum = sum(int(digit) for digit in str(page))
        
        # Check if the sum of the digits equals 4
        if digit_sum == 4:
            count += 1
            
    # Return the result in LaTeX format
