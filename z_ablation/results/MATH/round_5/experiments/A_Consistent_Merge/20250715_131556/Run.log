    # We can express y in terms of x from the first equation:
    # y = 15 - x

    # Substitute y in the second equation:
    # 4x = 2(15 - x) - 60
    # 4x = 30 - 2x - 60
    # 4x + 2x = 30 - 60
    # 6x = -30
    # x = -5

    # Now substitute x back to find y:
    # y = 15 - (-5)
    # y = 15 + 5
    # y = 20

    # The larger number is y
