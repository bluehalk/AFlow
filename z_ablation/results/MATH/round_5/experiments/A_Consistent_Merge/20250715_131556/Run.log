    circumference_of_earth_km = 40000  # Circumference of Earth in kilometers
    distance_travelled_m = 1_000_000_000  # Distance travelled in meters

    # Convert circumference from kilometers to meters for consistency
    circumference_of_earth_m = circumference_of_earth_km * 1000  # Convert km to m

    # Calculate the number of trips around Earth
    number_of_trips = distance_travelled_m / circumference_of_earth_m

