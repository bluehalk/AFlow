def solve():
    # Function to find all nice numbers in the range 2010 to 2019
    nice_numbers = []
    
    # Check each number in the range
    for n in range(2010, 2020):
        # We need to find if there exists a positive integer m with exactly 4 divisors
        # The two forms of m with exactly 4 divisors are:
        # 1. m = p^3 where p is a prime (divisors: 1, p, p^2, p^3)
        # 2. m = p * q where p and q are distinct primes (divisors: 1, p, q, p*q)
        
        # Check for the first form: m = p^3
        for p in range(2, int(n**(1/3)) + 1):
            if is_prime(p):
                m = p**3
                if m > 0 and sum_of_divisors(m) == n:
                    nice_numbers.append(n)
                    break
        
        # Check for the second form: m = p * q
        for p in range(2, n):
            if is_prime(p):
                for q in range(p + 1, n // p + 1):
                    if is_prime(q):
                        m = p * q
                        if m > 0 and sum_of_divisors(m) == n:
                            nice_numbers.append(n)
                            break
    
    # Calculate the sum of all nice numbers found
    result = sum(nice_numbers)
    return f"\\boxed{{{result}}}"

def is_prime(num):
    """Check if a number is prime."""
    if num < 2:
        return False
    for i in range(2, int(num**0.5) + 1):
        if num % i == 0:
            return False
    return True

def sum_of_divisors(m):
    """Calculate the sum of all positive divisors of m."""
    total = 0
    for i in range(1, int(m**0.5) + 1):
        if m % i == 0:
            total += i
            if i != m // i:  # Add the complementary divisor
                total += m // i
    return total

# Call the solve function to get the result
print(solve())
