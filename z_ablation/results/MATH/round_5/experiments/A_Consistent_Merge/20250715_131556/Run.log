def solve():
    # The base-8 number is represented as 1d41_8
    # where d is a digit in base 8 (0 to 7).
    
    # Initialize a variable to hold the sum of all possible values of n in base 10
    total_sum = 0
    
    # Iterate over all possible values of d (0 to 7)
    for d in range(8):
        # Convert the base-8 number 1d41_8 to base-10
        # The formula for conversion is:
        # n = 1 * 8^3 + d * 8^2 + 4 * 8^1 + 1 * 8^0
        n = 1 * (8 ** 3) + d * (8 ** 2) + 4 * (8 ** 1) + 1 * (8 ** 0)
        # Add the calculated value of n to the total sum
        total_sum += n
    
    # Return the total sum formatted in LaTeX notation
    return f"\\boxed{{{total_sum}}}"

