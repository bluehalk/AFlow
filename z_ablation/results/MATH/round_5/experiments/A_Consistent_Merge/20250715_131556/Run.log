def solve():
    # Initialize total winnings
    total_winnings = 0

    # Aces: 4 Aces, each worth $1
    total_winnings += 4 * 1  # 4 Aces

    # Cards 2 to 10: 4 of each card, each worth its value
    for value in range(2, 11):
        total_winnings += 4 * value  # 4 of each card from 2 to 10

    # Face cards (Jack, Queen, King): 4 face cards, each worth $20
    total_winnings += 4 * 20  # 4 face cards

    # Calculate winnings for clubs (doubled)
    # Ace of clubs
    total_winnings += 2 * 1  # 2 * $1 for Ace of clubs
    # Cards 2 to 10 of clubs
    for value in range(2, 11):
        total_winnings += 2 * value  # 2 * value for each card 2-10 of clubs
    # Face cards of clubs
    total_winnings += 2 * 20  # 2 * $20 for face cards of clubs

    # Calculate winnings for spades (tripled)
    # Ace of spades
    total_winnings += 3 * 1  # 3 * $1 for Ace of spades
