def double_factorial(n):
    """Calculate the double factorial of n (n!!)."""
    if n <= 0:
        return 1  # By convention, 0!! = 1
    product = 1
    for i in range(n, 0, -2):
        product *= i
    return product

def solve():
    """Calculate the units digit of the sum of double factorials from 1!! to 49!!."""
    total_sum = 0
    for i in range(1, 50, 2):  # Iterate over odd numbers from 1 to 49
        total_sum += double_factorial(i)  # Add the double factorial to the total sum
    
    # Get the units digit of the total sum
    units_digit = total_sum % 10
    return f"\\boxed{{{units_digit}}}"

# Call the solve function to get the result
result = solve()
print(result)
</python_code>

