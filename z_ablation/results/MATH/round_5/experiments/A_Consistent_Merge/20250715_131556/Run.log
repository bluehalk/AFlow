    from itertools import permutations

    # Digits to use
    digits = ['1', '2', '3', '4']
    
    # Set to hold unique numbers that are divisible by 4
    divisible_by_4 = set()

    # Generate all permutations of the digits
    for r in range(1, len(digits) + 1):
        for perm in permutations(digits, r):
            # Join the tuple to form a number
            number = int(''.join(perm))
            # Check if the number is divisible by 4
            if number % 4 == 0:
                divisible_by_4.add(number)

    # Count of unique numbers divisible by 4
    result = len(divisible_by_4)
    
    # Return the result in LaTeX format
