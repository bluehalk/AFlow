def solve():
    from math import isqrt
    from itertools import combinations

    # The target product
    target_product = 2310

    # Function to get the prime factorization of a number
    def prime_factors(n):
        factors = {}
        for i in range(2, isqrt(n) + 1):
            while n % i == 0:
                if i in factors:
                    factors[i] += 1
                else:
                    factors[i] = 1
                n //= i
        if n > 1:
            factors[n] = 1
        return factors

    # Get the prime factorization of 2310
    factors = prime_factors(target_product)
    
    # Generate the list of distinct prime factors
    distinct_primes = list(factors.keys())
    
    # To store the valid sets
    valid_sets = set()

    # Generate all combinations of three distinct primes
    for combo in combinations(distinct_primes, 3):
        a, b, c = combo
        # Check if the product of the combination equals the target product
        if a * b * c == target_product:
            valid_sets.add(tuple(sorted(combo)))

    # The number of valid sets
    result = len(valid_sets)
    
    return f"\\boxed{{{result}}}"

