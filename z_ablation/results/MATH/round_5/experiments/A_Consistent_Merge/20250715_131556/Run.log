def solve():
    from math import gcd

    # Number of colors
    colors = 5
    # Number of squares
    squares = 4

    # Using Burnside's lemma to count distinct colorings considering rotations
    # The group of rotations for a 2x2 board has 4 elements: 0°, 90°, 180°, 270°
    # We will calculate the number of colorings fixed by each rotation.

    # 1. Identity rotation (0°)
    # All colorings are fixed: 5^4
    fixed_identity = colors ** squares

    # 2. 90° rotation
    # No coloring can remain unchanged under a 90° rotation since all squares would need to be the same color.
    fixed_90 = colors ** 1  # Only one color can be used for all squares

    # 3. 180° rotation
    # The top left must match the bottom right, and the top right must match the bottom left.
    # So we have 2 pairs of squares, each can be any of the 5 colors.
    fixed_180 = colors ** 2

    # 4. 270° rotation
    # Similar to the 90° rotation, no coloring can remain unchanged.
    fixed_270 = colors ** 1  # Only one color can be used for all squares

    # Applying Burnside's lemma
    # Average the number of fixed colorings over the group size (4)
    total_fixed = (fixed_identity + fixed_90 + fixed_180 + fixed_270) / 4

