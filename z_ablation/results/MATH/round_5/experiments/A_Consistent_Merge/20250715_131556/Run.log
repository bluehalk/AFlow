def solve():
    # Number of people at the party
    n = 22
    
    # Each person can shake hands with at most 20 other people
    # The maximum number of unique handshakes can be calculated using the formula for combinations
    # C(n, 2) = n * (n - 1) / 2, where n is the number of people
    # However, since each person can only shake hands with 20 others, we need to adjust our calculation.
    
    # Maximum handshakes possible
    max_handshakes = (n * (n - 1)) // 2  # This is the total if everyone could shake hands with everyone else
    
    # Since each person can only shake hands with 20 others, we need to ensure we don't exceed this limit.
    # However, since there are 22 people, each can shake hands with 20 others, which is valid.
    
    return f"\\boxed{{{max_handshakes}}}"

# Call the solve function to get the result
