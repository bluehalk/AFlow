    B = int(lcm_str[8])  # B is the 9th character (index 8)
    C = int(lcm_str[12]) # C is the 13th character (index 12)
    
    # Calculate the final result
    result = 100 * A + 10 * B + C
    
    # Return the result in the required format
    return f"\\boxed{{{result}}}"

# Call the solve function to get the result
solve()
