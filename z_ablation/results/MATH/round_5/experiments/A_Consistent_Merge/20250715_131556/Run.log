def solve():
    # Data from the histogram representing the number of hurricanes per year
    # The index represents the number of hurricanes, and the value represents the number of years
    hurricane_data = {
        1: 5,   # 5 years had 1 hurricane
        2: 14,  # 14 years had 2 hurricanes
        3: 17,  # 17 years had 3 hurricanes
        4: 12,  # 12 years had 4 hurricanes
        5: 2,   # 2 years had 5 hurricanes
        6: 4,   # 4 years had 6 hurricanes
        7: 2,   # 2 years had 7 hurricanes
        8: 1    # 1 year had 8 hurricanes
    }
    
    # Create a list to hold the number of hurricanes for each year
    hurricane_counts = []
    
    # Populate the list based on the histogram data
    for hurricanes, years in hurricane_data.items():
        hurricane_counts.extend([hurricanes] * years)
    
    # Sort the list to find the median
    hurricane_counts.sort()
    
    # Calculate the median
    n = len(hurricane_counts)
    if n % 2 == 1:
        # If odd, return the middle element
        median = hurricane_counts[n // 2]
    else:
        # If even, return the average of the two middle elements
        median = (hurricane_counts[n // 2 - 1] + hurricane_counts[n // 2]) / 2
    
    # Return the result in LaTeX format
    return f"\\boxed{{{median}}}"

# Call the solve function to get the result
result = solve()
print(result)
</python_code>

