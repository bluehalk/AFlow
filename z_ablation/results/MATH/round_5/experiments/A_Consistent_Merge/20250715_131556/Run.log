def count_factors_of_p(n, p):
    """Count the number of factors of prime p in n!."""
    count = 0
    power = p
    while power <= n:
        count += n // power
        power *= p
    return count

def solve():
    n = 942
    count_3 = count_factors_of_p(n, 3)
    count_5 = count_factors_of_p(n, 5)
    # The largest n such that 942! is divisible by 15^n is the minimum of the counts of 3 and 5
    result = min(count_3, count_5)
    return f"\\boxed{{{result}}}"

# Execute the solve function to get the result
