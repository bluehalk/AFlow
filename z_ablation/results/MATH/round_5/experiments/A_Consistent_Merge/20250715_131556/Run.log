    A, B, C, D = int(A), int(B), int(C), int(D)

    # Adjust signs if necessary
    if A < 0:
        A, B, C, D = -A, -B, -C, -D

    # Calculate gcd
    def gcd_multiple(*args):
        return reduce(gcd, args)

    g = gcd_multiple(abs(A), abs(B), abs(C), abs(D))

    # Scale down by gcd
    A //= g
