def solve():
    # Total chips: 3 red (R) and 2 white (W)
    # We need to find the probability that the last chip drawn is white.
    
    # Total possible arrangements of chips
    total_arrangements = 0
    # Arrangements where the last chip is white
    white_last_arrangements = 0
    
    # We can represent the chips as a string of 'R' and 'W'
    from itertools import permutations
    
    # Generate all unique permutations of the chips
    chips = 'RRRWW'
    unique_permutations = set(permutations(chips))
    
    # Count total arrangements and those ending with 'W'
    for arrangement in unique_permutations:
        total_arrangements += 1
        if arrangement[-1] == 'W':
            white_last_arrangements += 1
    
    # Probability that the last chip drawn is white
    probability_white_last = white_last_arrangements / total_arrangements
    
    # Format the result in LaTeX notation
    result = f"\\boxed{{{probability_white_last:.2f}}}"
    return result

# Call the solve function to get the result
solve()
