    # We need to find n such that 2n ≡ 1 (mod 17)
    for n in range(17):
        if (2 * n) % 17 == 1:
            break
    
    # Step 2: Calculate (2^n)^2 - 2 mod 17
    power_result = (2 ** n) % 17
    final_result = (power_result ** 2 - 2) % 17
    
