def solve():
    from math import factorial

    # Number of beads (different colors)
    n = 8

    # The number of distinct arrangements of n beads on the vertices of a cube
    # is given by the formula: n! / |G|, where |G| is the number of rotations of the cube.
    
    # The cube has 24 rotational symmetries (rotations only, no reflections).
    # This can be derived from the fact that:
    # - There are 6 faces, and for each face, there are 4 ways to rotate it.
    # Thus, |G| = 6 * 4 = 24.
    
    # Calculate the number of distinct arrangements
    num_rotations = 24
    distinct_arrangements = factorial(n) // num_rotations

    # Return the result in LaTeX format
    return f"\\boxed{{{distinct_arrangements}}}"

# Call the solve function to get the result
