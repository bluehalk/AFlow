    current_mean = 91  # Current arithmetic mean of test scores
    last_test_score = 98  # Score on the last test
    new_mean = 92  # Desired new arithmetic mean after the last test

    # Let n be the number of tests before the last test
    # The total score of the first n tests can be calculated as:
    # total_score = current_mean * n
    # After adding the last test score, the total number of tests becomes n + 1
    # The new total score will be total_score + last_test_score
    # The new mean can be expressed as:
    # new_mean = (total_score + last_test_score) / (n + 1)

    # Rearranging the equation to find n:
    # new_mean * (n + 1) = total_score + last_test_score
    # new_mean * (n + 1) = current_mean * n + last_test_score
    # new_mean * n + new_mean = current_mean * n + last_test_score
    # (new_mean - current_mean) * n = last_test_score - new_mean
    # n = (last_test_score - new_mean) / (new_mean - current_mean)

    last_test_score = 98
    n = (last_test_score - new_mean) / (new_mean - current_mean)

    # The total number of tests including the last test is n + 1
    total_tests = n + 1

    # Return the result in LaTeX format
