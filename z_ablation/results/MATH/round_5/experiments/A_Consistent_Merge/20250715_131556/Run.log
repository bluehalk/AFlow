    # Let n be the number of people in Angela's family
    # Each person drinks 8 ounces of the mixture
    # Total amount of mixture consumed by the family
    total_mixture = 8  # ounces per person
    
    # Total amount consumed by n people
    total_consumed = n * total_mixture  # ounces
    
    # Let M be the total amount of milk and C be the total amount of coffee
    # Angela drank a quarter of the total milk and a sixth of the total coffee
    # Therefore, we can express the total milk and coffee in terms of n
    # Let M = total milk, C = total coffee
    # Angela's milk = M/4 and Angela's coffee = C/6
    
    # The total mixture is the sum of total milk and total coffee
    # total_consumed = M + C
    # We also know that:
    # M/4 + C/6 = total_consumed / n  (since Angela drank from the total mixture)
    
    # We can set up the equations:
    # M + C = 8n
    # M/4 + C/6 = 8/n
    
    # To solve for n, we can manipulate these equations.
    
    # Let's express M in terms of C:
    # M = 8n - C
    
    # Substitute M in the second equation:
    # (8n - C)/4 + C/6 = 8/n
    # Multiply through by 12 to eliminate the denominators:
    # 3(8n - C) + 2C = 96/n
    # 24n - 3C + 2C = 96/n
    # 24n - C = 96/n
