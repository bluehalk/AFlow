def solve():
    from itertools import permutations

    # Define the letters available from the word "TARGET"
    letters = "TARGET"
    
    # Create a set to hold distinct sequences
    distinct_sequences = set()
    
    # Generate all permutations of length 3 from the letters
    for perm in permutations(letters, 3):
        sequence = ''.join(perm)
        # Check if the sequence contains at least one 'T'
        if 'T' in sequence:
            distinct_sequences.add(sequence)
    
    # Count the number of distinct sequences
    result = len(distinct_sequences)
    
    # Return the result in LaTeX format
    return f"\\boxed{{{result}}}"

# Call the solve function to get the result
print(solve())
</python_code>

