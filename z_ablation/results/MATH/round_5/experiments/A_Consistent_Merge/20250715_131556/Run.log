    # Define the counts of each type of creature
    crocodiles = 4
    catfish = 1
    giant_squid = 2

    # Total number of creatures
    total_creatures = crocodiles + catfish + giant_squid

    # Total arrangements without restrictions
    total_arrangements = factorial(total_creatures) // (factorial(crocodiles) * factorial(catfish) * factorial(giant_squid))

    # To avoid consecutive crocodiles, we can use the "gap" method
    # First, arrange the non-crocodile creatures
    non_crocodile_creatures = catfish + giant_squid  # 1 catfish + 2 giant squid = 3 non-crocodiles
    non_crocodile_arrangements = factorial(non_crocodile_creatures) // (factorial(catfish) * factorial(giant_squid))

    # We can place crocodiles in the gaps created by the non-crocodile arrangements
    # There are (non_crocodile_creatures + 1) gaps to place crocodiles
    gaps = non_crocodile_creatures + 1  # 3 non-crocodiles create 4 gaps

    # We need to choose 4 gaps from the available gaps to place the crocodiles
    from math import comb
    valid_arrangements = non_crocodile_arrangements * comb(gaps, crocodiles)

    # Return the result in LaTeX format
