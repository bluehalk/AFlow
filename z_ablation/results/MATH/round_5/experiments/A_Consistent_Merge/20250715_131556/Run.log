def solve():
    import numpy as np
    
    # Number of simulations
    num_samples = 1000000
    
    # Count of successful outcomes
    successful_outcomes = 0
    
    for _ in range(num_samples):
        # Select a and b uniformly from [0, 1)
        a = np.random.uniform(0, 1)
        b = np.random.uniform(0, 1)
        
        # Calculate c
        c = a + b
        
        # Round a, b, and c to the nearest integer
        A = round(a)
        B = round(b)
        C = round(c)
        
        # Check if A + B equals C
        if A + B == C:
            successful_outcomes += 1
            
    # Calculate the probability
    probability = successful_outcomes / num_samples
    
    # Return the result in LaTeX format
    return f"\\boxed{{{probability:.6f}}}"

