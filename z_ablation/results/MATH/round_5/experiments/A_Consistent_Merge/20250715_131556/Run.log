def solve():
    k = 2  # Example ratio, can be any positive value
    width = 2 * k  # Width of rectangle AB
    height = 2  # Height of rectangle AD
    
    # Area of the rectangle ABCD
    area_rectangle = width * height
    
    # The distance from O to any vertex (e.g., A) is:
    distance_O_A = ((k ** 2 + 1) ** 0.5)  # Correct distance calculation
    
    # The inner rectangle's corners are at (±(width/2 - distance_O_A), ±(height/2 - distance_O_A))
    inner_width = width - 2 * (distance_O_A / 2)
    inner_height = height - 2 * (distance_O_A / 2)
    
    # Ensure inner dimensions are non-negative
    if inner_width < 0 or inner_height < 0:
        return "Invalid dimensions for inner rectangle."
    
    # Area of the inner rectangle
    area_inner_rectangle = inner_width * inner_height
    
    # Probability that a point chosen randomly from ABCD is closer to O than to any vertex
    probability = area_inner_rectangle / area_rectangle
    
    # Return the result in LaTeX format
    return f"\\boxed{{{probability:.4f}}}"

# Call the solve function to get the result
result = solve()
print(result)
```
This code ensures that the dimensions of the inner rectangle are calculated correctly and checks for valid dimensions before proceeding with the area calculation. Adjust the value of \(k\) as needed to test different rectangle configurations.
