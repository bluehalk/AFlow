    a_norm = np.linalg.norm(a)
    b_norm = np.linalg.norm(b)
    
    # Calculate k using the angle bisector theorem
    k = a_norm / (a_norm + b_norm)
    
    # Calculate the direction of c
    c = k * (a / a_norm) + (1 - k) * (b / b_norm)
    
    # Format the output in LaTeX notation
