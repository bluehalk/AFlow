import sympy as sp

def solve():
    # Define the variable
    z = sp.symbols('z')

    # Define the polynomial
    polynomial = z**8 - z**7 + z**6 - z**5 + z**4 - z**3 + z**2 - z + 1

    # Find the roots of the polynomial
    roots = sp.solve(polynomial, z)

    # Extract the angles (theta) from the roots
    angles = []
    for root in roots:
        if root.is_real:
            continue  # Skip real roots
        # Convert to polar form and get the angle
