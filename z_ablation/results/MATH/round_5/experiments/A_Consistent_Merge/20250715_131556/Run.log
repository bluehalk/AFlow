    # The system can be represented in matrix form as A * [x, y, z]^T = 0
    # where A is the coefficient matrix.
    
    # Coefficient matrix A
    k = np.symbols('k')  # We will use sympy to handle symbolic computation
    A = np.array([[1, k, -1],
                  [k, -1, -1],
                  [1, 1, -k]])
    
    # To find the values of k for which the system has a non-trivial solution,
    # we need to find the determinant of the matrix A and set it to zero.
    
    # Calculate the determinant of A
