def solve():
    from math import comb

    # Total number of students
    total_students = 12
    # Number of girls and boys
    girls = 6
    boys = 6
    # Number of teams and jerseys per team
    teams = 3
    jerseys_per_team = 4

    # Total ways to distribute jerseys without restrictions
    total_ways = comb(total_students, jerseys_per_team) ** teams

    # Subtract cases where at least one team has no girls or no boys
    # Case 1: At least one team has no girls
    no_girls_ways = comb(boys, jerseys_per_team) ** teams
    # Case 2: At least one team has no boys
    no_boys_ways = comb(girls, jerseys_per_team) ** teams

    # Case 3: At least one team has no girls and at least one team has no boys
    # This is the case where we have teams with only boys and teams with only girls
    # We can have 1 team with only boys and 2 teams with any combination of boys and girls
    # or 1 team with only girls and 2 teams with any combination of boys and girls
    both_no_girls_boys_ways = 0
    for i in range(1, teams + 1):
        both_no_girls_boys_ways += comb(teams, i) * (comb(boys, jerseys_per_team) ** i) * (comb(total_students - boys, jerseys_per_team) ** (teams - i))

    # Applying Inclusion-Exclusion Principle
    valid_ways = total_ways - (no_girls_ways + no_boys_ways - both_no_girls_boys_ways)

    # Return the result in LaTeX format
    return f"\\boxed{{{valid_ways}}}"

# Call the solve function to get the result
