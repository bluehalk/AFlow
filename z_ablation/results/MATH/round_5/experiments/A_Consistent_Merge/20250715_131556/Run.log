def solve():
    import sympy as sp

    # Define the variable
    theta = sp.symbols('theta')

    # Given volume of the tetrahedron
    volume = 1 / sp.sqrt(360)

    # The volume of the tetrahedron formed by three vectors a, b, c is given by:
    # V = (1/6) * |det(a, b, c)|
    # For unit vectors with acute angles, the determinant can be expressed in terms of cosines:
    # det(a, b, c) = 1 + 2 * cos(theta) * cos(theta) * cos(theta)
    # Therefore, we have:
    # V = (1/6) * (1 + 2 * cos^2(theta) * cos(theta))

    # Set up the equation for volume
    det_expr = 1 + 2 * sp.cos(theta)**2 * sp.cos(theta)
    volume_expr = (1/6) * det_expr

    # Solve for cos(theta)
    equation = sp.Eq(volume_expr, volume)
    cos_theta = sp.solve(equation, sp.cos(theta))[0]

    # Now we need to find 3 * cos^2(theta) - 2 * cos^3(theta)
    result = 3 * cos_theta**2 - 2 * cos_theta**3

    # Return the result in LaTeX format
    return f"\\boxed{{{result}}}"

# Call the solve function to get the result
solve()
