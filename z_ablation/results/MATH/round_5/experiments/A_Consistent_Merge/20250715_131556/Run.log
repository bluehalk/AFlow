def solve():
    # The least common multiple (LCM) of the first 25 positive integers
    # is given as 26A7114B4C0. We need to find the digits A, B, and C.
    
    # The LCM of the first n positive integers can be calculated using prime factorization.
    # We will calculate the LCM of the first 25 integers and then extract A, B, and C.
    
    from math import gcd
    from functools import reduce
    from collections import defaultdict
    
    def lcm(x, y):
        return x * y // gcd(x, y)
    
    # Calculate the LCM of the first 25 positive integers
    lcm_value = reduce(lcm, range(1, 26))
    
    # Convert the LCM value to a string to extract A, B, and C
    lcm_str = str(lcm_value)
    
    # The LCM is given as 26A7114B4C0, we need to find A, B, and C
    # The positions of A, B, and C are known:
    # A is at index 2, B is at index 7, C is at index 9
    A = int(lcm_str[2])
    B = int(lcm_str[7])
    C = int(lcm_str[9])
    
    # Calculate the final result
    result = 100 * A + 10 * B + C
    
    # Return the result in the required format
