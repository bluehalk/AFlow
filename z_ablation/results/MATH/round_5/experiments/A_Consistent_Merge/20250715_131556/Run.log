def solve():
    import numpy as np

    # Define the line equations
    # P is on the line y = -x + 1 in the xy-plane
    # Q is on the line z = -2x + 1 in the xz-plane

    # We can express P and Q in terms of a parameter x
    # For point P, we can take P(x, -x + 1, 0)
    # For point Q, we can take Q(x, 0, -2x + 1)

    # The distance PQ can be calculated using the distance formula in 3D:
    # Distance PQ = sqrt((x2 - x1)^2 + (y2 - y1)^2 + (z2 - z1)^2)
    # where P = (x1, y1, z1) and Q = (x2, y2, z2)

    # Coordinates of P
    def P(x):
        return (x, -x + 1, 0)

    # Coordinates of Q
    def Q(x):
        return (x, 0, -2*x + 1)

    # Distance function
    def distance(x):
        p = P(x)
        q = Q(x)
        return np.sqrt((q[0] - p[0])**2 + (q[1] - p[1])**2 + (q[2] - p[2])**2)

    # We need to minimize the distance function
    # We can use numpy's optimization to find the minimum distance
    from scipy.optimize import minimize_scalar

    result = minimize_scalar(distance)
    min_distance = distance(result.x)

    # Return the result in the required format
    return f"\\boxed{{{min_distance}}}"

# Call the solve function to get the result
print(solve())
