import numpy as np

def solve():
    # We will find the values of x that satisfy the equation sin(pi * cos(x)) = cos(pi * sin(x))
    # and then calculate sin(2x) for those values.

    # Define the function to check the equality
    def equation(x):
        return np.sin(np.pi * np.cos(x)) - np.cos(np.pi * np.sin(x))

    # We will use a numerical approach to find the roots of the equation
    # We will check values of x in the range [0, 2*pi]
    x_values = np.linspace(0, 2 * np.pi, 1000)
    roots = []

    # Check for roots using a small tolerance
    tolerance = 1e-5
    for i in range(len(x_values) - 1):
        if (equation(x_values[i]) * equation(x_values[i + 1]) < 0):  # A root is between these two points
            # Use the bisection method to find the root
            low, high = x_values[i], x_values[i + 1]
            while high - low > tolerance:
                mid = (low + high) / 2
                if equation(mid) == 0:
                    break
                elif equation(mid) * equation(low) < 0:
                    high = mid
                else:
                    low = mid
            roots.append((low + high) / 2)

    # Now calculate sin(2x) for the found roots
    sin_2x_values = [np.sin(2 * root) for root in roots]

    # Remove duplicates and sort the results
    unique_sin_2x_values = sorted(set(sin_2x_values))

    # Format the output in LaTeX notation
    result = ', '.join(f'{value:.6f}' for value in unique_sin_2x_values)
    return f'\\boxed{{{result}}}'

# Call the solve function to get the result
print(solve())
