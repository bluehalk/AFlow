def solve():
    # Initial conditions
    initial_red = 2
    initial_green = 2
    total_beads = initial_red + initial_green
    
    # Probability of all beads being red after 3 replacements
    # We will track the probabilities of the different states after each draw and replacement
    
    # State probabilities after each draw
    # P(RR) = Probability of having 2 red and 2 green
    # P(RG) = Probability of having 3 red and 1 green
    # P(GG) = Probability of having 4 red
    probabilities = {
        (2, 2): 1.0,  # Start with 2 red and 2 green
        (3, 1): 0.0,  # Start with 3 red and 1 green
        (4, 0): 0.0   # Start with 4 red
    }
    
    for _ in range(3):  # We will perform 3 draws
        new_probabilities = {
            (2, 2): 0.0,
            (3, 1): 0.0,
            (4, 0): 0.0
        }
        
        # Calculate probabilities for the next state
        # From (2, 2) -> (3, 1) or (4, 0)
        p_2_red_2_green = probabilities[(2, 2)]
        new_probabilities[(3, 1)] += p_2_red_2_green * (2 / total_beads)  # Draw red
        new_probabilities[(4, 0)] += p_2_red_2_green * (2 / total_beads)  # Draw green
        
        # From (3, 1) -> (4, 0)
        p_3_red_1_green = probabilities[(3, 1)]
        new_probabilities[(4, 0)] += p_3_red_1_green * (3 / total_beads)  # Draw red
        new_probabilities[(3, 1)] += p_3_red_1_green * (1 / total_beads)  # Draw green
        
        # From (4, 0) -> (4, 0)
        p_4_red_0_green = probabilities[(4, 0)]
        new_probabilities[(4, 0)] += p_4_red_0_green  # Always draw red
        
        # Update probabilities for the next iteration
        probabilities = new_probabilities
    
    # The probability that all beads are red after 3 replacements
    final_probability = probabilities[(4, 0)]
    
    # The final answer should be expressed as a common fraction
    from fractions import Fraction
    result = Fraction(final_probability).limit_denominator()
    
    return f"\\boxed{{{result}}}"

# Call the solve function to get the result
