def solve():
    # We need to find a number that has three digits in base 3 and base 4,
    # and the digits in base 3 are the reverse of the digits in base 4.
    
    # The range of three-digit numbers in base 3 is from 3^2 to 3^3 - 1
    # which is from 9 to 26 in base 10.
    base_3_range = range(9, 27)
    
    for num in base_3_range:
        # Convert the number to base 3
        base_3_digits = []
        n = num
        while n > 0:
            base_3_digits.append(n % 3)
            n //= 3
        base_3_digits.reverse()  # Reverse to get the correct order
        
        # Convert the number to base 4
        base_4_digits = []
        n = num
        while n > 0:
            base_4_digits.append(n % 4)
            n //= 4
        base_4_digits.reverse()  # Reverse to get the correct order
        
        # Check if the digits are reverses of each other
        if base_3_digits == base_4_digits[::-1]:
            # If they are, return the number in LaTeX format
            return f"\\boxed{{{num}}}"
    
    return "No solution found"

# Call the solve function to get the result
result = solve()
print(result)
