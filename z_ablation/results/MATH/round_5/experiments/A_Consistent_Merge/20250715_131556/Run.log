    # Therefore, BC = AB * (sin(A) / sin(B))
    
    # Calculate sine values using exact values
    sin_A = 1/2  # sin(30 degrees)
    sin_B = (math.sqrt(6) + math.sqrt(2)) / 4  # sin(105 degrees)

    # Using the Law of Sines
    BC = AB * (sin_A / sin_B)

    # Return the result in LaTeX format
    return f"\\boxed{{{BC}}}"

# Call the solve function to get the result
