def solve():
    # Function to check if a number is prime
    def is_prime(n):
        if n <= 1:
            return False
        for i in range(2, int(n**0.5) + 1):
            if n % i == 0:
                return False
        return True

    # Initialize the sum of primes
    prime_sum = 0

    # Iterate through the range from 100 to 200
    for n in range(100, 201):
        # Check if n is 1 or 2 more than a perfect square
        sqrt_n = int(n**0.5)
        if n == (sqrt_n**2 + 1) or n == (sqrt_n**2 + 2):
            # If n is prime, add it to the sum
            if is_prime(n):
                prime_sum += n

    # Return the final result in LaTeX format
    return f"\\boxed{{{prime_sum}}}"

# Call the solve function to get the result
result = solve()
print(result)
</python_code>

