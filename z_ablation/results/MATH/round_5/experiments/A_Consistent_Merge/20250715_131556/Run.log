    start_year = 2008
    end_year = 2016
    
    # Amaretta's birthday is July 27
    # Enzo's birthday is September 3
    start_date = (7, 27)  # (month, day)
    end_date = (9, 3)     # (month, day)
    
    # Function to calculate the number of days from start_date to end_date in a given year
    def days_in_year(year):
        # Check if the year is a leap year
        is_leap = (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)
        
        # Days in each month
        month_days = [31, 28 + is_leap, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
        
        # Calculate the number of days from start_date to end_date
        days = 0
        
        # Add days from the start month to the end month
        # Add days remaining in the start month
        days += month_days[start_date[0] - 1] - start_date[1] + 1  # Days from start_date to end of July
        
        # Add full months between start and end month
        for month in range(start_date[0], end_date[0] - 1):
            days += month_days[month]  # Full months in between
        
        # Add days in the end month
        days += end_date[1]  # Days from start of September to Enzo's birthday
        
        return days
    
    # Calculate total cake-eating days from 2008 to 2016
    total_days = 0
    for year in range(start_year, end_year + 1):
        total_days += days_in_year(year)
    
    # Return the result in LaTeX format
    return f"\\boxed{{{total_days}}}"

