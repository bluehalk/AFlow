def solve():
    # Define the total number of meerkats
    total_meerkats = 10
    
    # Calculate the total number of unique pairs of meerkats
    total_nights = (total_meerkats * (total_meerkats - 1)) // 2  # C(10, 2) = 45
    
    # Each meerkat guards with every other meerkat exactly once
    nights_guarding = total_meerkats - 1  # Each meerkat guards 9 times
    
    # Calculate the nights of sleep for each meerkat
    nights_of_sleep = total_nights - nights_guarding  # 45 - 9 = 36
    
    # Return the result in LaTeX format
    return f"\\boxed{{{nights_of_sleep}}}"

# Call the solve function to get the result
