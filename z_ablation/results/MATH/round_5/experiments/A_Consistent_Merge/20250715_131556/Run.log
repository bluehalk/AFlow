def solve():
    # Define the variable
    t = sp.symbols('t')
    
    # Distance from the origin to a point on the line
    d1 = sp.sqrt(2*t**2 + 1)
    
    # Distance from the point on the line to the endpoint (1, 0, 0)
    d2 = sp.sqrt((1 - t)**2 + (0 - t)**2 + (0 - 1)**2)
    
    # Total distance
    total_distance = d1 + d2
    
    # We want to minimize the square of the total distance
    total_distance_squared = total_distance**2
    
    # Differentiate with respect to t and find critical points
    derivative = sp.diff(total_distance_squared, t)
    critical_points = sp.solve(derivative, t)
    
    # Evaluate the total distance squared at the critical points
    min_distance_squared = float('inf')
    for point in critical_points:
        if point.is_real and 0 <= point <= 1:  # Check if the point is within the valid range
            distance_squared_value = total_distance_squared.subs(t, point)
            min_distance_squared = min(min_distance_squared, distance_squared_value)
    
    # Return the minimum distance squared in LaTeX format
    return f"\\boxed{{{min_distance_squared}}}"

# Execute the function to get the result
result = solve()
print(result)
</python_code>

