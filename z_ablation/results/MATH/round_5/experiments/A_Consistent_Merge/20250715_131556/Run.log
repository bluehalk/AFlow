     \]
     \[
     a = \frac{10 \pm \sqrt{100 + 4800}}{100}
     \]
     \[
     a = \frac{10 \pm \sqrt{4900}}{100}
     \]
     \[
     a = \frac{10 \pm 70}{100}
     \]
