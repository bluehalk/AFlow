    # Calculate sin(BAC) using the relationship sin(BAC) = 2 * sin(BAM) * cos(BAM)
    sin_BAC = 2 * sin_BAM * cos_BAM
    
    # Calculate the exact value for comparison
    exact_value = (4 * math.sqrt(2)) / 9
    
