import numpy as np
import sympy as sp

def solve():
    # Define the variable
    x = sp.symbols('x')
    
    # Define the matrix
    matrix = sp.Matrix([
        [sp.sec(x)**2, 1, 1],
        [sp.cos(x)**2, sp.cos(x)**2, sp.csc(x)**2],
        [1, sp.cos(x)**2, sp.cot(x)**2]
    ])
    
    # Calculate the determinant
    determinant = sp.simplify(matrix.det())
    
    # Evaluate the determinant over a range of x values
    x_values = np.linspace(0, 2 * np.pi, 100)
    det_values = [determinant.subs(x, val).evalf() for val in x_values]
    
    # Find the minimum and maximum values of the determinant
    min_det = min(det_values)
    max_det = max(det_values)
    
    # Return the result in LaTeX boxed format
    return f"\\boxed{{[{min_det}, {max_det}]}}"

# Call the solve function to get the result
result = solve()
print(result)
