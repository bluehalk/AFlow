    def sum_of_odd_divisors(n):
        total_sum = 0
        # Iterate through all possible odd divisors
        for i in range(1, n + 1, 2):  # Step by 2 to only consider odd numbers
            if n % i == 0:  # Check if i is a divisor of n
                total_sum += i  # Add the odd divisor to the total sum
