def solve():
    from itertools import permutations
    from math import gcd

    # Define the digits to be used
    digits = '123456'
    count = 0

    # Generate all permutations of the digits
    for perm in permutations(digits):
        # Convert the tuple of characters to a list of integers
        digits_list = [int(d) for d in perm]
        
        # Check if all pairs of consecutive digits are relatively prime
        if all(gcd(digits_list[i], digits_list[i + 1]) == 1 for i in range(len(digits_list) - 1)):
            count += 1

    # Return the final count formatted in LaTeX notation
    return f"\\boxed{{{count}}}"

# Call the solve function to get the result
result = solve()
print(result)
