def solve():
    # Function to find the least perfect square with 3 different prime factors
    from sympy import primerange
    
    # Get the first three prime numbers
    primes = list(primerange(1, 20))[:3]  # We only need the first three primes
    # Calculate the least perfect square
    # A perfect square with 3 different prime factors can be expressed as (p1 * p2 * p3)^2
    least_perfect_square = (primes[0] * primes[1] * primes[2]) ** 2
    
    # Return the result in LaTeX format
    return f"\\boxed{{{least_perfect_square}}}"

# Call the solve function to get the result
result = solve()
print(result)
