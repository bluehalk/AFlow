def solve():
    import numpy as np
    from fractions import Fraction

    # Define the vector onto which we are projecting
    v = np.array([1, 7])
    
    # Calculate the projection matrix
    v_transpose = v.reshape(-1, 1)  # Reshape to a column vector
    dot_product = np.dot(v, v)  # This is a scalar
    outer_product = np.dot(v_transpose, v_transpose.T)  # This is a 2x2 matrix
    
    # Calculate the projection matrix
    projection_matrix = outer_product / dot_product
    
    # Format the output in LaTeX notation with fractions
    result = f"\\begin{{pmatrix}} {Fraction(projection_matrix[0, 0]).limit_denominator()} & {Fraction(projection_matrix[0, 1]).limit_denominator()} \\\\ {Fraction(projection_matrix[1, 0]).limit_denominator()} & {Fraction(projection_matrix[1, 1]).limit_denominator()} \\end{{pmatrix}}"
    
    return f"\\boxed{{{result}}}"

# Call the solve function to get the result
print(solve())
```
