def solve():
    # Given values
    a = 12500000
    m = 999999999
    remainder = 111

    # Calculate the modular inverse of a modulo m
    def extended_gcd(aa, bb):
        if aa == 0:
            return bb, 0, 1
        gcd, x1, y1 = extended_gcd(bb % aa, aa)
        x = y1 - (bb // aa) * x1
        y = x1
        return gcd, x, y

    def mod_inverse(a, m):
        gcd, x, _ = extended_gcd(a, m)
        if gcd != 1:
            return None  # Inverse doesn't exist
        else:
            return x % m

    # Calculate gcd and modular inverse
    a_inv = mod_inverse(a, m)

    # Calculate n using the modular inverse
    n = (a_inv * (remainder % m)) % m

    return f"\\boxed{{{n}}}"

print(solve())
