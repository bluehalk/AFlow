    # Calculate the area of overlap
    # The overlap width is the minimum of the widths of both papers
    overlap_width = min(width1, width2)
    # The overlap height is the minimum of the heights of both papers
    overlap_height = min(height1, height2)

    # Area of the overlapping region
    overlap_area = overlap_width * overlap_height

