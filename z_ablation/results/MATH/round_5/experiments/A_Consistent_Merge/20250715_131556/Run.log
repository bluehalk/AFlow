def solve():
    # We need to find the smallest integer greater than 200
    # such that gcd(integer, 36) = 18.
    
    # The prime factorization of 36 is:
    # 36 = 2^2 * 3^2
    
    # The gcd of an integer n and 36 being 18 means:
    # 18 = 2^1 * 3^2
    # This implies that n must be a multiple of 18.
    
    # We start checking from 201 upwards.
    n = 201
    while True:
        if n % 18 == 0:  # Check if n is a multiple of 18
            # Now we check if gcd(n, 36) is indeed 18
            from math import gcd
            if gcd(n, 36) == 18:
                return f"\\boxed{{{n}}}"
        n += 1

# Call the solve function to get the result
