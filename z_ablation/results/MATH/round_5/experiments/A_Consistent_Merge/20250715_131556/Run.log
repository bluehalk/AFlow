def solve():
    # Function to calculate the largest integer n such that 942! is divisible by 15^n
    # 15 can be factored into its prime factors: 15 = 3 * 5
    # Therefore, we need to find the minimum of the number of factors of 3 and 5 in 942!

    def count_factors_of_p(n, p):
        """Count the number of times p is a factor in n!"""
        count = 0
        power = p
        while power <= n:
            count += n // power
            power *= p
        return count

    # Count the factors of 3 and 5 in 942!
    count_3 = count_factors_of_p(942, 3)
    count_5 = count_factors_of_p(942, 5)

    # The largest n such that 942! is divisible by 15^n is the minimum of these two counts
    n = min(count_3, count_5)

    # Return the result in LaTeX format
    return f"\\boxed{{{n}}}"

# Call the solve function to get the result
