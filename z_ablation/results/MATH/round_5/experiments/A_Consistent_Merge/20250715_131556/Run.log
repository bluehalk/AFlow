def solve():
    from itertools import permutations

    # Define the numbers we are working with
    numbers = [1, 2, 3, 4, 5, 6]

    # Function to check if a given arrangement is valid
    def is_valid(arrangement):
        for number in arrangement:
            # Get the divisors of the number (excluding itself)
            divisors = [i for i in range(1, number) if number % i == 0]
            # Check if all divisors appear to the left of the number
            for divisor in divisors:
                if divisor not in arrangement[:arrangement.index(number)]:
                    return False
        return True

    # Count valid arrangements
    valid_count = 0
    for perm in permutations(numbers):
        if is_valid(perm):
            valid_count += 1

    # Return the result in LaTeX format
    return f"\\boxed{{{valid_count}}}"

result = solve()
print(result)
</python_code>

