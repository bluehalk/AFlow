def solve():
    # Step 1: Define the initial number spun by John
    initial_spin = 20
    
    # Step 2: Function to find the positive factors of a number
    def positive_factors(n):
        factors = []
        for i in range(1, n):
            if n % i == 0:
                factors.append(i)
        return factors
    
    # Step 3: Initialize the total spins counter
    total_spins = 0
    current_number = initial_spin
    
    # Step 4: Continue the game until there are no numbers left
    while current_number > 0:
        # Count this spin
        total_spins += 1
        
        # Get the positive factors of the current number
        factors = positive_factors(current_number)
        
        # If there are no factors left, break the loop
        if not factors:
            break
        
        # For the next spin, choose the largest factor (to maximize spins)
        current_number = max(factors)
    
    # Step 5: Return the total number of spins in the required format
    return f"\\boxed{{{total_spins}}}"

