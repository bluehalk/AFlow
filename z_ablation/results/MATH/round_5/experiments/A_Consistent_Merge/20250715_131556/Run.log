    # Function to compute the modular inverse using Extended Euclidean Algorithm
    def extended_gcd(aa, bb):
        if aa == 0:
            return bb, 0, 1
        gcd, x1, y1 = extended_gcd(bb % aa, aa)
        x = y1 - (bb // aa) * x1
