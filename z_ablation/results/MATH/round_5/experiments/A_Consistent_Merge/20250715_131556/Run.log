def solve():
    # Function to calculate the sum of proper divisors of a number
    def sum_of_proper_divisors(n):
        # Proper divisors are all divisors excluding the number itself
        divisors_sum = 0
        for i in range(1, n // 2 + 1):
            if n % i == 0:
                divisors_sum += i
        return divisors_sum

    # Given number
    number = 198
    # Calculate the sum of proper divisors
    result = sum_of_proper_divisors(number)
    
    # Return the result in LaTeX format
    return f"\\boxed{{{result}}}"

# Call the solve function to get the result
print(solve())
</python_code>

