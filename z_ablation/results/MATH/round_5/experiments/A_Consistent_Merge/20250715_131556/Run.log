def solve():
    import math

    # Step 1: Factor the number 2940 into its prime factors
    n = 2940
    factors = []
    
    # Finding prime factors
    for i in range(2, int(math.sqrt(n)) + 1):
        while n % i == 0:
            factors.append(i)
            n //= i
    if n > 1:
        factors.append(n)

    # Step 2: Count the occurrences of each prime factor
    from collections import Counter
    factor_count = Counter(factors)

    # Step 3: Simplify the square root
    sqrt_value = 1
    for factor, count in factor_count.items():
        # For each prime factor, if it appears an even number of times, we can take it out of the square root
        sqrt_value *= factor ** (count // 2)
    
    # Step 4: Calculate the remaining part under the square root
    remaining_product = 1
    for factor, count in factor_count.items():
        if count % 2 != 0:  # If it appears an odd number of times
            remaining_product *= factor

    # Final result
    if remaining_product == 1:
        result = f"\\boxed{{{sqrt_value}}}"
    else:
        result = f"\\boxed{{{sqrt_value} \\sqrt{{{remaining_product}}}}}"

    return result

# Call the solve function and print the result
