def solve():
    # Function to calculate the number of trailing zeros in n! in base b
    def trailing_zeros_in_factorial(n, b):
        # Function to factorize b into its prime factors
        def prime_factors(n):
            factors = {}
            d = 2
            while d * d <= n:
                while (n % d) == 0:
                    if d in factors:
                        factors[d] += 1
                    else:
                        factors[d] = 1
                    n //= d
                d += 1
            if n > 1:
                factors[n] = 1
            return factors
        
        # Get the prime factorization of b
        factors = prime_factors(b)
        
        # Calculate the minimum number of times n! can be divided by each prime factor
        min_zeros = float('inf')
        for p, k in factors.items():
            count = 0
            power = p
            # Count the number of multiples of p, p^2, p^3, ... in n!
            while power <= n:
                count += n // power
                power *= p
            # Calculate the number of trailing zeros contributed by this prime factor
            min_zeros = min(min_zeros, count // k)
        
        return min_zeros
    
    # We need to find the number of trailing zeros in 10! in base 11
    n = 10
    b = 11
    result = trailing_zeros_in_factorial(n, b)
    
    # Return the result in LaTeX format
