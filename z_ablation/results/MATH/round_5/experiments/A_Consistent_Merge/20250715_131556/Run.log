    boxes = 3
    green_ways = comb(green_balls + boxes - 1, boxes - 1)

    # For 2 indistinguishable red balls into 3 boxes
    red_balls = 2
    red_ways = comb(red_balls + boxes - 1, boxes - 1)

    # The total number of ways to distribute both green and red balls
