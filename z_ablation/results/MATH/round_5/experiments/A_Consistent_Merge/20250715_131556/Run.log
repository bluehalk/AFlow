def solve():
    from math import comb

    # Number of lamps and tables
    lamps = 10
    tables = 3

    # Using the stars and bars theorem to find the number of ways to distribute lamps
    # The formula is C(n + k - 1, k - 1) where n is the number of lamps and k is the number of tables
    ways = comb(lamps + tables - 1, tables - 1)

    # Return the result in LaTeX format
    return f"\\boxed{{{ways}}}"

# Call the solve function to get the result
