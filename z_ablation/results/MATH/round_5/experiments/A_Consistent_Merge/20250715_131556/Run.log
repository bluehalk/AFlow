def solve():
    # The center square of the 5x5 grid is located at (2, 2) in 0-indexed coordinates.
    center_x, center_y = 2, 2
    
    # We will count the number of squares of different sizes that contain the center square.
    count = 0
    
    # A square of size n x n can be placed in the grid in various positions.
    # The top-left corner of the square can be at (i, j) where:
    # 0 <= i <= 5 - n and 0 <= j <= 5 - n
    
    # We will check for each square size from 1 to 5
    for n in range(1, 6):  # n is the size of the square
        # The square must contain the center square (2, 2)
        # This means the top-left corner (i, j) must satisfy:
        # i <= center_x <= i + n - 1
        # j <= center_y <= j + n - 1
        
        # Rearranging gives us:
        # i must be in the range [center_x - (n - 1), center_x]
        # j must be in the range [center_y - (n - 1), center_y]
        
        # Calculate the valid range for i
        min_i = max(0, center_x - (n - 1))
        max_i = min(5 - n, center_x)
        
        # Calculate the valid range for j
        min_j = max(0, center_y - (n - 1))
        max_j = min(5 - n, center_y)
        
        # The number of valid positions for the top-left corner (i, j)
        valid_i_count = max_i - min_i + 1
        valid_j_count = max_j - min_j + 1
        
        # Total squares of size n x n that contain the center square
        count += valid_i_count * valid_j_count
    
    # Return the final count formatted in LaTeX notation
    return f"\\boxed{{{count}}}"

# Call the solve function to get the result
result = solve()
print(result)
</python_code>

