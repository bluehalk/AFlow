def solve():
    from itertools import permutations

    # Define the grid size and the number of beads
    grid_size = 3
    total_beads = 9
    purple_bead = 'P'
    green_bead = 'G'
    other_beads = ['B1', 'B2', 'B3', 'B4', 'B5', 'B6', 'B7']  # Other 7 beads

    # Create a list of all beads
    beads = [purple_bead, green_bead] + other_beads

    # Function to check if two positions are adjacent
    def are_adjacent(pos1, pos2):
        x1, y1 = pos1
        x2, y2 = pos2
        return max(abs(x1 - x2), abs(y1 - y2)) == 1

    # Function to generate all unique grid configurations
    def generate_unique_configurations():
        unique_configurations = set()
        for perm in permutations(beads):
            grid = [perm[i * grid_size:(i + 1) * grid_size] for i in range(grid_size)]
            # Normalize the grid to account for rotations and reflections
            for _ in range(4):  # Rotate 4 times
                grid = [list(row) for row in zip(*grid[::-1])]  # Rotate 90 degrees
                unique_configurations.add(tuple(tuple(row) for row in grid))
                # Add reflections
                unique_configurations.add(tuple(tuple(row[::-1]) for row in grid))
        return unique_configurations

    # Count valid configurations
    valid_count = 0
    for config in generate_unique_configurations():
        # Find positions of purple and green beads
