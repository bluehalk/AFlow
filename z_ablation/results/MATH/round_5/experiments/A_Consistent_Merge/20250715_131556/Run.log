        (1/16) * sp.cos(4 * theta) - (1/32) * sp.sin(5 * theta) - (1/64) * sp.cos(6 * theta) + \
        (1/128) * sp.sin(7 * theta)

    # Set up the equation P/Q = 2*sqrt(2)/7
    equation = sp.Eq(P / Q, (2 * sp.sqrt(2)) / 7)

    # Solve for sin(theta)
    sin_theta = sp.solve(equation, sp.sin(theta))

    # Evaluate for specific theta values in the range [pi, 2*pi)
    results = []
    for angle in [sp.pi, 3*sp.pi/4, sp.pi/2 + sp.pi, 2*sp.pi - sp.pi/4]:
        evaluated = sin_theta[0].subs(theta, angle).evalf()
        results.append((angle, evaluated))

    return results

