    # The integers from 1 to 16
    numbers = list(range(1, 17))
    
    # Function to determine if a number is a perfect square
    def is_perfect_square(n):
        return int(n**0.5) ** 2 == n
    
    # Function to find the prime factorization of a number
    def prime_factors(n):
        factors = {}
        d = 2
        while d * d <= n:
            while (n % d) == 0:
                if d in factors:
                    factors[d] += 1
                else:
                    factors[d] = 1
                n //= d
            d += 1
        if n > 1:
            factors[n] = 1
        return factors
    
    # Collect the prime factorization of each number
