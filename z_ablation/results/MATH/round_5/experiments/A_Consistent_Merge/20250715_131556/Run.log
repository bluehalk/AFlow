import numpy as np
from math import gcd
from functools import reduce

def solve():
    # Define the projection matrix
    P = np.array([[13/14, -1/7, 3/14],
                  [-1/7, 5/7, 3/7],
                  [3/14, 3/7, 5/14]])

    # Perform Singular Value Decomposition (SVD)
    U, S, Vt = np.linalg.svd(P)

    # The last column of Vt gives the normal vector
    normal_vector = Vt[-1]

    # Scale to get integer values
    normal_vector_int = np.round(normal_vector * 14).astype(int)  # Scale by 14 to avoid fractions

    # Ensure the first component is positive and gcd is 1
    a, b, c = normal_vector_int
    if a < 0:
        normal_vector_int = -normal_vector_int

    # Calculate gcd
    def gcd_multiple(*args):
        return reduce(gcd, args)

    g = gcd_multiple(abs(a), abs(b), abs(c))
    normal_vector_int //= g  # Normalize by gcd

    # Format the result in LaTeX notation
    return f"\\boxed{{\\begin{{pmatrix}} {normal_vector_int[0]} \\\\ {normal_vector_int[1]} \\\\ {normal_vector_int[2]} \\end{{pmatrix}}}}"

# Call the solve function to get the result
result = solve()
print(result)
