def solve():
    import numpy as np
    from math import gcd
    from functools import reduce

    # Define the normal vectors of the given planes
    normal1 = np.array([1, 1, 1])  # From the plane x + y + z - 6 = 0
    normal2 = np.array([2, 3, 4])  # From the plane 2x + 3y + 4z + 5 = 0

    # Find the direction vector of the line L (cross product of the normals)
    direction_vector = np.cross(normal1, normal2)

    # The point (1, 1, 1) is given
    point = np.array([1, 1, 1])

    # The plane containing line L and point (1, 1, 1) will have a normal vector
    # that is the same as the direction vector of line L
    A, B, C = direction_vector

    # Using the point-normal form of the plane equation: A(x - x0) + B(y - y0) + C(z - z0) = 0
    # where (x0, y0, z0) is the point (1, 1, 1)
    D = -(A * point[0] + B * point[1] + C * point[2])

    # Ensure A > 0 and gcd(|A|, |B|, |C|, |D|) = 1
    if A < 0:
        A, B, C, D = -A, -B, -C, -D

    # Calculate gcd
    gcd_value = reduce(gcd, [abs(A), abs(B), abs(C), abs(D)])

    # Normalize the coefficients
    A //= gcd_value
    B //= gcd_value
    C //= gcd_value
    D //= gcd_value

    # Return the result in the required format
    return f"\\boxed{{{A}x + {B}y + {C}z + {D} = 0}}"

# Call the solve function to get the result
result = solve()
print(result)
