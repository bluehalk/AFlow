def solve():
    from itertools import permutations

    # Digits to be used
    digits = [2, 3, 4, 7, 8]
    
    # Function to check divisibility by 11
    def is_divisible_by_11(num):
        # Convert number to string to access digits
        num_str = str(num)
        # Calculate the alternating sum
        alternating_sum = sum(int(num_str[i]) if i % 2 == 0 else -int(num_str[i]) for i in range(len(num_str)))
        return alternating_sum % 11 == 0

    # Generate all unique permutations of the digits
    all_permutations = set(permutations(digits))
    
    # Count how many of these permutations are divisible by 11
    count_divisible_by_11 = sum(1 for perm in all_permutations if is_divisible_by_11(int(''.join(map(str, perm)))))
    
    # Total number of permutations
    total_permutations = len(all_permutations)
    
    # Calculate the probability
    probability = count_divisible_by_11 / total_permutations
    
    # Return the result in LaTeX format
    return f"\\boxed{{{count_divisible_by_11}/{total_permutations}}}"

