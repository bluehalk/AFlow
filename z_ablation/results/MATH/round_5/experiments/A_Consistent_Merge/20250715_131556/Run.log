def solve():
    from math import comb

    # Total number of ways to choose 3 cards from a 52-card deck
    total_ways = comb(52, 3)

    # Number of ways to choose 3 consecutive cards of the same suit
    # There are 4 suits and for each suit, we can have the following consecutive triplets:
    # A, 2, 3; 2, 3, 4; 3, 4, 5; 4, 5, 6; 5, 6, 7; 6, 7, 8; 7, 8, 9; 8, 9, 10; 9, 10, J; 10, J, Q; J, Q, K; Q, K, A
    consecutive_triplets = 12  # There are 12 valid triplets for each suit

    # Total successful outcomes
    successful_outcomes = 4 * consecutive_triplets  # 4 suits

    # Probability calculation
    probability = successful_outcomes / total_ways

    # Format the result in LaTeX notation
    return f"\\boxed{{{probability:.6f}}}"

# Call the solve function to get the result
result = solve()
print(result)
