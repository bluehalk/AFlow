    # (n - 2) * 180 - 1070 > 0
    # (n - 2) * 180 > 1070
    # n - 2 > 1070 / 180
    # n > (1070 / 180) + 2
    
    # Calculate the minimum n
    min_n = (1070 / 180) + 2
    
