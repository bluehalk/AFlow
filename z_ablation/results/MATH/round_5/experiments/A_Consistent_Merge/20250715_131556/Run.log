import numpy as np
from math import gcd
from functools import reduce

def solve():
    # Coefficients of the first plane
    A1, B1, C1, D1 = 3, -6, 2, 5
    # Coefficients of the second plane
    A2, B2, C2, D2 = 4, -12, 3, -3

    # Normal vectors of the planes
    n1 = np.array([A1, B1, C1])
    n2 = np.array([A2, B2, C2])

    # Calculate magnitudes
    k1 = np.linalg.norm(n1)
    k2 = np.linalg.norm(n2)

    # Calculate the angle bisector normal vector
    bisector_normal = (n1 / k1) + (n2 / k2)

    # The point (-5, -1, -5)
    point = np.array([-5, -1, -5])

    # The equation of the plane
    A, B, C = bisector_normal
    D = - (A * point[0] + B * point[1] + C * point[2])

    # Ensure A > 0 and gcd(|A|, |B|, |C|, |D|) = 1
    A, B, C, D = int(A), int(B), int(C), int(D)

    # Adjust signs if necessary
    if A < 0:
        A, B, C, D = -A, -B, -C, -D

    # Calculate gcd
    def gcd_multiple(*args):
        return reduce(gcd, args)

    g = gcd_multiple(abs(A), abs(B), abs(C), abs(D))

    # Scale down by gcd
    A //= g
    B //= g
    C //= g
    D //= g

    # Final output in the required format
    return f"\\boxed{{{A}x + {B}y + {C}z + {D} = 0}}"

# Call the solve function to get the result
result = solve()
print(result)
</python_code>

