    odd_ab_count = odd_count * odd_count  # a odd, b odd
    odd_ab_count *= odd_count  # c can be any
    
    # Total favorable outcomes
    favorable_outcomes = even_ab_count + odd_ab_count
    
    # Probability
    probability = favorable_outcomes / total_combinations
    
    # Return the result in LaTeX format
    return f"\\boxed{{{probability}}}"

# Call the solve function to get the result
