def solve():
    # Define the modulus
    n = 2**4  # 16
    
    # Function to check if a number is invertible modulo n
    def is_invertible(x, n):
        return gcd(x, n) == 1
    
    # Function to calculate gcd
    def gcd(a, b):
        while b:
            a, b = b, a % b
        return a
    
    # Initialize sums for invertible and non-invertible integers
    A = 0  # Sum of invertible integers
    B = 0  # Sum of non-invertible integers
    
    # Iterate through the residue system modulo n
    for i in range(n):
        if is_invertible(i, n):
            A += i  # Add to invertible sum
        else:
            B += i  # Add to non-invertible sum
    
    # Calculate A - B
    result = A - B
    
    # Return the result in LaTeX format
    return f"\\boxed{{{result}}}"

# Call the solve function to get the result
