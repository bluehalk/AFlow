def solve():
    # Define the starting date and the target date
    start_year = 2000
    target_year = 1960
    start_day = 6  # Saturday (0=Monday, 1=Tuesday, ..., 6=Sunday)
    
    # Calculate the number of leap years and regular years between 1960 and 2000
    leap_years = 0
    regular_years = 0
    
    for year in range(target_year, start_year):
        if (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0):
            leap_years += 1
        else:
            regular_years += 1
    
    # Total days from 1960 to 2000
    total_days = (regular_years * 365) + (leap_years * 366)
    
    # Calculate the day of the week for January 1, 1960
    # Days of the week cycle every 7 days
    day_of_week = (start_day - (total_days % 7)) % 7
    
    # Map the day of the week to its name
    days = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
    
    # Return the result in LaTeX format
    return f"\\boxed{{{days[day_of_week]}}}"

# Call the solve function to get the result
result = solve()
print(result)
