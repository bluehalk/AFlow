def solve():
    # Initialize a counter for the number of integers a with negative product of divisors
    count_negative_product = 0
    
    # Iterate through all integers a from -200 to -1
    for a in range(-200, 0):
        # Find the divisors of -a (which is positive)
        divisors = [d for d in range(1, abs(a) + 1) if abs(a) % d == 0]
        
        # Calculate the product of the divisors
        product_of_divisors = 1
        for d in divisors:
            product_of_divisors *= d
        
        # Check if the product of divisors is negative
        if product_of_divisors < 0:
            count_negative_product += 1
    
    # Return the final count in LaTeX format
    return r"\boxed{" + str(count_negative_product) + "}"

# Call the solve function to get the result
result = solve()
