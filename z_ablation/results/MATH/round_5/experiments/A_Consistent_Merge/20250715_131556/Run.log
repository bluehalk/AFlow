    # The radius of the sphere is the distance from the center to the planes
    # The center of the sphere (h, k, l) must satisfy:
    # h = radius, k = radius, l = radius
    # The distances from the center to the planes are:
    # d_xy = l = radius
    # d_xz = k = radius
    # d_yz = h = radius

    # Therefore, we can find the radius as follows:
    radius_xy = d_xy
    radius_xz = d_xz
    radius_yz = d_yz

    # The radius must be equal to the distances from the center to the respective planes
    # We can find the possible values for the radius
    possible_radii = {radius_xy, radius_xz, radius_yz}

    # Format the output in LaTeX notation
    result = ', '.join(f'{r}' for r in sorted(possible_radii))
