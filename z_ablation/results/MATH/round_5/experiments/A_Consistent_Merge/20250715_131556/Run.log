def solve():
    import math

    def excluded_count(N):
        squares = int(math.sqrt(N))
        cubes = int(N ** (1/3))
        fifths = int(N ** (1/5))
        sixths = int(N ** (1/6))
        tenths = int(N ** (1/10))
        fifteenths = int(N ** (1/15))
        thirtieths = int(N ** (1/30))
        
        return (squares + cubes + fifths 
                - sixths - tenths - fifteenths 
                + thirtieths)

    # Find the smallest N such that N - excluded_count(N) = 1000
    N = 1200  # Start with an estimate
    while True:
        if N - excluded_count(N) >= 1000:
            break
        N += 1

    # The 1000th term is:
    result = N - excluded_count(N)
    return f"\\boxed{{{result}}}"

# Call the solve function to get the result
print(solve())
