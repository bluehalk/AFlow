    modulus = 37
    target_congruence = 23
    upper_limit = 18632
    
    # Calculate the maximum k such that 23 + k * 37 < upper_limit
    k_max = (upper_limit - target_congruence - 1) // modulus  # Subtract 1 to ensure n < upper_limit
    
