def solve():
    # Define the projection matrix
    P = np.array([[13/14, -1/7, 3/14],
                  [-1/7, 5/7, 3/7],
                  [3/14, 3/7, 5/14]])
    
    # The normal vector can be found by calculating the null space of the projection matrix
    # The normal vector is orthogonal to the plane, which is the null space of the projection matrix
    # We can find the normal vector by solving the equation P * n = 0
    
    # We can use numpy's linear algebra to find the null space
    # We will use SVD to find the null space
    U, S, Vt = np.linalg.svd(P)
    
    # The last column of Vt (which corresponds to the smallest singular value) gives us the normal vector
    normal_vector = Vt[-1]
    
    # Normalize the vector to get integer components
    normal_vector = normal_vector / np.linalg.norm(normal_vector)
    
    # Scale to get integer values
    normal_vector_int = np.round(normal_vector * 14).astype(int)  # Scale by 14 to avoid fractions
    
    # Ensure the first component is positive and gcd is 1
    a, b, c = normal_vector_int
