def solve():
    import math

    # Function to calculate the exponent of a prime p in n!
    def exponent_of_prime_in_factorial(n, p):
        exponent = 0
        power = p
        while power <= n:
            exponent += n // power
            power *= p
        return exponent

    # Given values
    n = 109
    p = 3

    # Calculate the exponent of 3 in 109!
    result = exponent_of_prime_in_factorial(n, p)

    # Return the result in LaTeX format
    return f"\\boxed{{{result}}}"

# Call the solve function to get the result
