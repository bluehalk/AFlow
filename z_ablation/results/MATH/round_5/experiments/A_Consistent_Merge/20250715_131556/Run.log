import math

def solve():
    # We need to find the smallest positive real number t such that
    # cos(t) = cos(t degrees)
    
    # Convert degrees to radians for comparison
    # cos(t) = cos(t * (pi / 180))
    
    # We will use a numerical approach to find the smallest t
    # Start with a small value and increment until we find the solution
    t = 0.0
    step = 0.0001  # Small step to increment t
    while True:
        # Calculate cos(t) in radians and cos(t) in degrees
        cos_t_radians = math.cos(t)
        cos_t_degrees = math.cos(math.radians(t))
        
        # Check if they are approximately equal
        if math.isclose(cos_t_radians, cos_t_degrees, rel_tol=1e-9):
            break
        t += step
    
    # Return the floor of t in LaTeX format
    return f"\\boxed{{{math.floor(t)}}}"

# Call the solve function to get the result
result = solve()
print(result)
