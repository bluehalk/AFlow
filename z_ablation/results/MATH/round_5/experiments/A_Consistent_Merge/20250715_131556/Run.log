import math

def solve():
    # Calculate the right-hand side of the equation
    angle = 50  # degrees
    target_tan = math.cos(math.radians(angle)) / (1 - math.sin(math.radians(angle)))
    
    # Calculate arctan of the target tangent value
    arctan_value = math.degrees(math.atan(target_tan))
    
    # We need to find the smallest positive x
    k = 0
    x = arctan_value + 160 + k * 180
    
    # Check for the smallest positive x
    while x <= 0 or x > 180:
        k += 1
        x = arctan_value + 160 + k * 180
    
    # Since we want the smallest positive integer, we take the ceiling of x
    x = math.ceil(x)
    
    return f"\\boxed{{{x}}}"

# Call the solve function to get the result
