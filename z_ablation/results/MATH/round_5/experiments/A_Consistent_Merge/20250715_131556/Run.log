def solve():
    # A function to determine the smallest positive integer n such that
    # exactly half of the unit fractions 1/k for k in [1, n] are terminating decimals.
    
    def is_terminating_decimal(k):
        # A fraction 1/k is a terminating decimal if and only if
        # the prime factorization of k contains only the primes 2 and 5.
        while k % 2 == 0:
            k //= 2
        while k % 5 == 0:
            k //= 5
        return k == 1  # If k is reduced to 1, it only had 2s and 5s as factors.

    n = 1
    while True:
        # Count the number of terminating decimals among 1/k for k in [1, n]
        terminating_count = sum(1 for k in range(1, n + 1) if is_terminating_decimal(k))
        
        # Check if exactly half of the fractions are terminating
        if terminating_count == n / 2:
            return f"\\boxed{{{n}}}"
        
        n += 1

# Call the solve function to get the result
result = solve()
print(result)
</python_code>

