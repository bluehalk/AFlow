def solve():
    # Define the function for the left-hand side and right-hand side of the equation
    def left_hand_side(x):
        return (1/5) * np.log2(x) if x > 0 else np.nan  # log2 is only defined for x > 0

    def right_hand_side(x):
        return np.sin(5 * np.pi * x)

    # Generate x values for plotting
    x_values = np.linspace(0.01, 1, 1000)  # Avoid x=0 to prevent log2(0)
    lhs_values = [left_hand_side(x) for x in x_values]
    rhs_values = [right_hand_side(x) for x in x_values]

    # Plot the two functions
    plt.figure(figsize=(10, 6))
    plt.plot(x_values, lhs_values, label=r'$\frac{1}{5}\log_2 x$', color='blue')
    plt.plot(x_values, rhs_values, label=r'$\sin(5\pi x)$', color='red')
    plt.axhline(0, color='black', lw=0.5, ls='--')
    plt.axvline(0, color='black', lw=0.5, ls='--')
    plt.title('Graph of $\frac{1}{5}\log_2 x$ and $\sin(5\pi x)$')
