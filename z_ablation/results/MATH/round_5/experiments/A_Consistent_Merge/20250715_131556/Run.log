    # Now we need to find a suitable n such that C is positive and M is positive.
    
    # We can iterate over possible values of n to find a valid solution.
    for n in range(1, 100):  # Assuming a reasonable upper limit for the family size
        C = 24 * n - 96 / n
        M = 8 * n - C
        
        # Check if both C and M are positive
