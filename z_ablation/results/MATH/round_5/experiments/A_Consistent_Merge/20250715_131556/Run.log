    # We need to express this in the form a * cos(pi/b)
    # We know cos(pi/4) = sqrt(2)/2, thus we can find a and b
    a = round(final_result * math.sqrt(2))  # a = result * sqrt(2)
    b = 4  # Since cos(pi/4) corresponds to b = 4
    
    return f"\\boxed{{({a}, {b})}}"

