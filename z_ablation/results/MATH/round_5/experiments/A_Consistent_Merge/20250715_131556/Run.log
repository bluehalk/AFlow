def factorial(n):
    """Calculate the factorial of n (n!)."""
    if n == 0 or n == 1:
        return 1
    result = 1
    for i in range(2, n + 1):
        result *= i
    return result

def prime_factors_count(n):
    """Return a dictionary with the count of prime factors of n!."""
    factors = {}
    for i in range(2, n + 1):
        num = i
        for j in range(2, num + 1):
            while num % j == 0:
                if j in factors:
                    factors[j] += 1
                else:
                    factors[j] = 1
                num //= j
    return factors

def total_cubes_dividing_factorials():
    """Calculate the number of positive cubes dividing 3! * 5! * 7!."""
    # Calculate the factorials
    f3 = factorial(3)
    f5 = factorial(5)
    f7 = factorial(7)
    
    # Calculate the product of the factorials
    product = f3 * f5 * f7
    
    # Get the prime factors of the product
    factors = prime_factors_count(3)  # Start with 3!
    for n in [5, 7]:
        f = prime_factors_count(n)
        for prime, count in f.items():
            if prime in factors:
                factors[prime] += count
            else:
                factors[prime] = count
    
    # Count the number of cubes
    cube_count = 1
    for count in factors.values():
        cube_count *= (count // 3 + 1)
    
    return f"\\boxed{{{cube_count}}}"

def solve():
    return total_cubes_dividing_factorials()

# Call the solve function to get the result
result = solve()
print(result)
