from math import factorial
from math import gcd

def count_distributions(cycle_length, orange, black, teal):
    # Count valid distributions of beads into cycles
    if cycle_length == 1:
        return 1  # Each bead can be placed in its own cycle
    elif cycle_length == 2:
        # For pairs, we can have combinations of colors
        count = 0
        for o in range(0, min(orange, cycle_length // 2) + 1):
            for b in range(0, min(black, cycle_length // 2) + 1):
                if o + b <= cycle_length // 2:
                    count += 1
        return count
    elif cycle_length == 3:
        # For cycles of length 3, we can have combinations of colors
        count = 0
        for o in range(0, min(orange, cycle_length) + 1):
            for b in range(0, min(black, cycle_length - o) + 1):
                t = cycle_length - o - b
                if t >= 0 and t <= teal:
                    count += 1
        return count
    elif cycle_length == 6:
        # For cycles of length 6, we can have combinations of colors
        count = 0
        for o in range(0, min(orange, cycle_length) + 1):
            for b in range(0, min(black, cycle_length - o) + 1):
                t = cycle_length - o - b
                if t >= 0 and t <= teal:
                    count += 1
        return count
    return 0

def count_flips(orange, black, teal):
    # Count fixed arrangements for flips
    count = 0
    # For flips, we can have pairs of beads
    if (orange + black + teal) % 2 == 0:
        half = (orange + black + teal) // 2
        for o in range(0, min(orange, half) + 1):
            for b in range(0, min(black, half - o) + 1):
                t = half - o - b
                if t >= 0 and t <= teal:
                    count += 1
    return count

def solve():
    orange = 3
    black = 3
    teal = 1
    total_beads = orange + black + teal
    n = total_beads
    symmetries = n + n  # n rotations + n flips

    fixed_rotations = 0
    for k in range(n):
        cycle_length = gcd(n, k)
        fixed_rotations += count_distributions(cycle_length, orange, black, teal)

    fixed_flips = count_flips(orange, black, teal)

    total_fixed = fixed_rotations + fixed_flips
    distinct_bracelets = total_fixed // symmetries

    return f"\\boxed{{{distinct_bracelets}}}"

