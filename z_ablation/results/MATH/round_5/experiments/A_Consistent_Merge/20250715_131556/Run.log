def solve():
    # Probability of winning in a single turn
    # Winning conditions: die shows 1 or 6 (2 outcomes) and coin shows heads (1 outcome)
    winning_die_outcomes = 2  # (1, 6)
    total_die_outcomes = 6     # (1, 2, 3, 4, 5, 6)
    winning_coin_outcomes = 1  # (heads)
    total_coin_outcomes = 2    # (heads, tails)

    # Probability of winning in one turn
    probability_win_one_turn = (winning_die_outcomes / total_die_outcomes) * (winning_coin_outcomes / total_coin_outcomes)

    # Probability of losing in one turn
    probability_lose_one_turn = 1 - probability_win_one_turn

    # We want the probability of winning before the fourth turn
    # This means winning in the first, second, or third turn
    # The probability of winning before the fourth turn can be calculated as:
    # P(win before 4th turn) = 1 - P(lose all 3 turns)
    
    probability_lose_all_three_turns = probability_lose_one_turn ** 3
    probability_win_before_fourth_turn = 1 - probability_lose_all_three_turns

    # Return the result in LaTeX format
    return f"\\boxed{{{probability_win_before_fourth_turn}}}"

# Call the solve function to get the result
