    sqrt768 = math.sqrt(768)  # Calculate sqrt(768)
    sqrt32_plus_sqrt768 = math.sqrt(32 + sqrt768)  # Calculate sqrt(32 + sqrt(768))
    final_result = math.sqrt(8 + sqrt32_plus_sqrt768)  # Calculate sqrt(8 + sqrt(32 + sqrt(768)))
    
