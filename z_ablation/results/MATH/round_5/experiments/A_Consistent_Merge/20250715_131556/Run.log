import numpy as np

def solve():
    # Define the input vectors and their images
    v1 = np.array([2, -1])
    v2 = np.array([1, -3])
    img1 = np.array([9, 3])
    img2 = np.array([7, -1])

    # Create the matrix A from the vectors
    A = np.array([v1, v2]).T  # Columns are the original vectors
    B = np.array([img1, img2]).T  # Columns are the images

    # Calculate the transformation matrix M using the direct method
    M = np.linalg.solve(A, B)  # Solve for M directly

    # Define the line y = 2x + 1
    x_values = np.linspace(-10, 10, 100)  # Generate x values
    line_points = np.array([x_values, 2 * x_values + 1])  # Points on the line

    # Apply the transformation matrix M to the line points
    transformed_points = M @ line_points

    # Extract the transformed y values
    transformed_y = transformed_points[1]

    # Fit a line to the transformed points to find the new line equation
    coefficients = np.polyfit(x_values, transformed_y, 1)  # Linear fit
    m, b = coefficients  # Slope and intercept

    # Format the result in LaTeX notation
    result = f"y = {m:.2f}x + {b:.2f}"
    return f"\\boxed{{{result}}}"

# Call the solve function to get the result
