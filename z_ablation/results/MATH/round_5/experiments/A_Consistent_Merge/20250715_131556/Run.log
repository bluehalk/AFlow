    from math import comb

    # Total number of pieces of fruit
    n = 8
    
    # Probability of choosing an orange, apple, or banana
    p_orange = 1/3
    p_apple = 1/3
    p_banana = 1/3

    # Calculate the probability of exactly 3 oranges
