    plt.ylabel('y')
    plt.ylim(-1.5, 1.5)
    plt.xlim(0, 1)
    plt.legend()
    plt.grid()
    plt.show()

    # Count the number of intersections
    intersections = 0
    for i in range(len(lhs_values) - 1):
        if (lhs_values[i] - rhs_values[i]) * (lhs_values[i + 1] - rhs_values[i + 1]) < 0:
            intersections += 1

    # Return the number of intersections in LaTeX format
    return r'\boxed{' + str(intersections) + '}'

# Call the solve function
