def solve():
    # Function to check if a number is divisible by all its non-zero digits
    def is_divisible_by_digits(n):
        digits = [int(d) for d in str(n) if d != '0']  # Get non-zero digits
        for d in digits:
            if n % d != 0:  # Check divisibility
                return False
        return True

    # Start searching from the smallest five-digit number
    for number in range(10000, 100000):
        str_number = str(number)
        if len(set(str_number)) == 5:  # Check if all digits are different
            if is_divisible_by_digits(number):
                return f"\\boxed{{{number}}}"  # Return the result in LaTeX format

# Call the solve function
