def solve():
    from math import comb

    # Total number of lamps
    total_lamps = 6  # 3 red + 3 blue

    # Total arrangements of 3 red and 3 blue lamps
    total_arrangements = comb(total_lamps, 3)  # Choose 3 positions for red lamps

    # Case 1: Leftmost lamp is red
    # If the leftmost lamp is red, we have 2 red and 3 blue lamps left to arrange
    arrangements_with_red_leftmost = comb(5, 2)  # Choose 2 positions for the remaining red lamps

    # Case 2: Leftmost lamp is red and the leftmost turned on lamp is also red
    # If the leftmost lamp is red, we need to consider the turned on lamps
    # We can choose 2 more lamps to turn on from the remaining 5 lamps
    # We need to ensure that at least one of the turned on lamps is red
    # Total ways to choose 3 lamps to turn on from 6
    total_turn_on_ways = comb(6, 3)

    # Ways to choose 3 lamps to turn on such that the leftmost is red
    # We can choose 2 more from the remaining 5 lamps (2 red, 3 blue)
    # We need to ensure at least one of the turned on lamps is red
    # Total ways to choose 3 lamps to turn on with at least 1 red
    # Total ways to choose 3 lamps to turn on with no red (only blue)
    no_red_turn_on_ways = comb(3, 3)  # Only blue lamps can be turned on

    # Valid ways to turn on lamps with at least one red
    valid_turn_on_ways = total_turn_on_ways - no_red_turn_on_ways

    # Probability that the leftmost lamp is red and the leftmost turned on lamp is red
    probability = valid_turn_on_ways / total_turn_on_ways

    # Final probability that the leftmost lamp is red and the leftmost turned on lamp is red
    final_probability = arrangements_with_red_leftmost / total_arrangements * probability

    return f"\\boxed{{{final_probability:.4f}}}"

print(solve())
