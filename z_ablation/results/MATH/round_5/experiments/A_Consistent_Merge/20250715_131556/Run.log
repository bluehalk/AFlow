def solve():
    from itertools import combinations_with_replacement
    from collections import Counter
    from math import factorial

    target_product = 336
    count = 0

    # Check all combinations of 4 digits from 1 to 9
    for digits in combinations_with_replacement(range(1, 10), 4):
        if digits[0] * digits[1] * digits[2] * digits[3] == target_product:
            count += 1  # Count each unique combination

    # Each valid combination can be arranged in 4! / (n1! * n2! * ...) ways
    total_count = 0
    for digits in combinations_with_replacement(range(1, 10), 4):
        if digits[0] * digits[1] * digits[2] * digits[3] == target_product:
            digit_count = Counter(digits)
            arrangements = factorial(4)
            for freq in digit_count.values():
                arrangements //= factorial(freq)
            total_count += arrangements

    return f"\\boxed{{{total_count}}}"

