import numpy as np

def solve():
    # Define points A, B, and C
    A = np.array([1, 8, 4])
    B = np.array([0, -1, 3])
    C = np.array([2, -3, -1])
    
    # Calculate the direction vector d from B to C
    d = C - B  # d = C - B
    # Calculate the vector BA from B to A
    BA = A - B  # BA = A - B
    
    # Calculate the projection of BA onto d
    d_norm_squared = np.dot(d, d)  # ||d||^2
    proj_BA_on_d = (np.dot(BA, d) / d_norm_squared) * d  # proj_d(BA)
    
    # Calculate the foot of the perpendicular P
    P = B + proj_BA_on_d  # P = B + proj_d(BA)
    
    # Format the result in LaTeX notation
    result = f"\\boxed{{({P[0]:.2f}, {P[1]:.2f}, {P[2]:.2f})}}"
    return result

# Call the solve function to get the result
