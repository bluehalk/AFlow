def solve():
    # Number of Democrats and Republicans
    num_democrats = 5
    num_republicans = 5
    
    # Since all members of each party must sit next to each other,
    # we can treat each party as a single block.
    
    # There are 2 blocks: one for Democrats and one for Republicans.
    # The number of ways to arrange these 2 blocks in a circle is (2-1)! = 1! = 1.
    
    # Within each block, the members can be arranged among themselves.
    # The number of arrangements for Democrats is 5! and for Republicans is 5!.
    
    from math import factorial
    
    arrangements_democrats = factorial(num_democrats)
    arrangements_republicans = factorial(num_republicans)
    
    # Total arrangements = arrangements of blocks * arrangements within each block
    total_arrangements = (factorial(2 - 1)) * arrangements_democrats * arrangements_republicans
    
    # Return the result in LaTeX format
    return f"\\boxed{{{total_arrangements}}}"

# Call the solve function to get the result
result = solve()
print(result)
</python_code>

