def solve():
    # Camera A parameters
    start_A = 360  # 6 AM in minutes
    interval_A = 11
    
    # Camera B parameters
    start_B = 420  # 7 AM in minutes
    interval_B = 7
    
    # Find common times
    common_times = []
    for n in range(0, (720 - start_A) // interval_A + 1):
        time_A = start_A + n * interval_A
        for m in range(0, (720 - start_B) // interval_B + 1):
            time_B = start_B + m * interval_B
            if time_A == time_B and time_A < 720:
                common_times.append(time_A)
    
    # Return the last common time before noon
    last_common_time = max(common_times)
    minutes_before_noon = 720 - last_common_time
    return f"\\boxed{{{minutes_before_noon}}}"

# Call the solve function to get the result
