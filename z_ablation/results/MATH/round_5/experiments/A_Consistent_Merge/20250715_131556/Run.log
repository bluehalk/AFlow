    # The difference in distance traveled by the top of her head and her feet
    difference = circumference_top_of_head - circumference_feet
    
    # The difference can be expressed in terms of π
    difference_in_terms_of_pi = difference / (2 * math.pi)  # divide by 2π to express in terms of π
    
