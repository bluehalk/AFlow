\[
\sum_{k=1}^{1728} \frac{1}{1 - \omega^k} = -\frac{1}{1729} \sum_{k=0}^{1728} \frac{1}{1 - \omega^k} = -\frac{1}{1729} \cdot 0 = 0,
\]

